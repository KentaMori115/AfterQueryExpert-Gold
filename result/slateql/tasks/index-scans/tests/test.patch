+def test_a_dropped_index_stops_serving_queries():
+    session = loaded()
+    session.create_index("readings", "station")
+    statement = "SELECT reading_id FROM readings WHERE station = 'vale'"
+    served = session.sql(statement)
+    session.drop_index("readings", "station")
+    scanned = session.sql(statement)
+    assert served.to_tuples() == scanned.to_tuples() == [(1,), (3,), (6,)]
+    assert served.metrics["rows_scanned"] == 3
+    assert scanned.metrics["rows_scanned"] == 8
+
+
+def test_each_table_keeps_its_own_indexes():
+    session = loaded()
+    session.create_index("stations", "station")
+    # Both tables have a station column; only one of them is indexed.
+    assert reads(session, "SELECT region FROM stations WHERE station = 'vale'") == 1
+    assert (
+        reads(session, "SELECT reading_id FROM readings WHERE station = 'vale'") == 8
+    )
