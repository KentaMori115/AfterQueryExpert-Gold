index 0000000..09b645d
--- /dev/null
+++ b/tests/test_index_catalog.py
@@ -0,0 +1,182 @@
+"""Creating, listing and dropping indexes."""
+
+from __future__ import annotations
+
+import pytest
+
+from slateql import Session, UnknownColumnError, UnknownTableError
+from slateql.types.datatypes import INTEGER, STRING
+from slateql.types.schema import Schema
+
+READINGS_SCHEMA = Schema.of(
+    ("reading_id", INTEGER),
+    ("station", STRING),
+    ("depth", INTEGER),
+    ("note", STRING),
+)
+
+# Station repeats, depth repeats and holds two nulls, and neither column is in
+# the order the table stores its rows.
+READINGS_ROWS = [
+    [1, "vale", 30, "a"],
+    [2, "ridge", 10, "b"],
+    [3, "vale", 20, "c"],
+    [4, "cove", None, "d"],
+    [5, "ridge", 30, "e"],
+    [6, "vale", 10, "f"],
+    [7, "cove", 20, "g"],
+    [8, "ridge", None, "h"],
+]
+
+STATIONS_SCHEMA = Schema.of(("station", STRING), ("region", STRING))
+
+STATIONS_ROWS = [
+    ["vale", "north"],
+    ["ridge", "south"],
+    ["cove", "west"],
+]
+
+
+def loaded() -> Session:
+    """A session holding both tables and no indexes."""
+
+    session = Session()
+    session.register_rows("readings", READINGS_SCHEMA, READINGS_ROWS)
+    session.register_rows("stations", STATIONS_SCHEMA, STATIONS_ROWS)
+    return session
+
+
+def listing(session: Session, statement: str = "SHOW INDEXES") -> list[tuple]:
+    return session.sql(statement).to_tuples()
+
+
+def reads(session: Session, statement: str) -> int:
+    """How many rows the statement reported reading."""
+
+    return session.sql(statement).metrics["rows_scanned"]
+
+
+def test_a_new_index_is_listed_with_its_shape():
+    session = loaded()
+    session.create_index("readings", "station")
+    assert listing(session) == [("readings", "station", "hash", 8, 3, "NO")]
+
+
+def test_a_sorted_index_reports_its_own_shape():
+    session = loaded()
+    session.create_index("readings", "station", kind="sorted")
+    assert listing(session) == [("readings", "station", "sorted", 8, 3, "NO")]
+
+
+def test_show_indexes_names_its_columns():
+    session = loaded()
+    session.create_index("readings", "station")
+    assert session.sql("SHOW INDEXES").columns == [
+        "table_name",
+        "column_name",
+        "kind",
+        "entries",
+        "distinct_keys",
+        "has_nulls",
+    ]
+
+
+def test_null_rows_are_part_of_a_hash_index_total():
+    session = loaded()
+    session.create_index("readings", "depth")
+    # Eight rows went in, three distinct depths came out, two rows had none.
+    assert listing(session) == [("readings", "depth", "hash", 8, 3, "YES")]
+
+
+def test_a_sorted_index_counts_the_null_rows_it_holds_no_key_for():
+    session = loaded()
+    session.create_index("readings", "depth", kind="sorted")
+    assert listing(session) == [("readings", "depth", "sorted", 8, 3, "YES")]
+
+
+def test_show_indexes_from_one_table_leaves_the_others_out():
+    session = loaded()
+    session.create_index("readings", "station")
+    session.create_index("stations", "region")
+    assert listing(session, "SHOW INDEXES FROM stations") == [
+        ("stations", "region", "hash", 3, 3, "NO")
+    ]
+
+
+def test_indexes_are_listed_by_table_and_then_by_column():
+    session = loaded()
+    # Registered back to front, so registration order cannot be what shows.
+    session.create_index("stations", "region")
+    session.create_index("readings", "station")
+    session.create_index("readings", "depth", kind="sorted")
+    assert [row[:2] for row in listing(session)] == [
+        ("readings", "depth"),
+        ("readings", "station"),
+        ("stations", "region"),
+    ]
+
+
+def test_a_catalog_without_indexes_lists_nothing():
+    assert listing(loaded()) == []
+
+
+def test_building_a_second_index_over_a_column_replaces_the_first():
+    session = loaded()
+    session.create_index("readings", "station")
+    session.create_index("readings", "station", kind="sorted")
+    assert listing(session) == [("readings", "station", "sorted", 8, 3, "NO")]
+
+
+def test_dropping_twice_answers_true_then_false():
+    session = loaded()
