+def test_timedelta_columns_take_part_in_arithmetic(spans: Session):
+    rows = spans.sql(
+        "SELECT started + span AS renews FROM spans WHERE span IS NOT NULL ORDER BY id"
+    ).column("renews")
+    assert rows == [
+        dt.datetime(2024, 2, 1, 2, 0),
+        dt.datetime(2024, 2, 28, 0, 0),
+        dt.datetime(2024, 2, 28, 22, 0),
+    ]
+    elapsed = spans.sql(
+        "SELECT CAST(seen - started AS STRING) AS e FROM spans ORDER BY id"
+    ).column("e")
+    assert elapsed == ["PT10H", "PT0S", "P31DT23H30M", "PT0S"]
