+def test_null_propagates_through_interval_arithmetic(empty_session: Session):
+    null = "CAST(NULL AS INTERVAL)"
+    assert value(empty_session, f"INTERVAL 'P1D' + {null}") is None
+    assert value(empty_session, f"{date('2024-01-01')} + {null}") is None
+    assert value(empty_session, f"{null} * 2") is None
+    assert value(empty_session, f"INTERVAL 'P1D' = {null}") is None
+    assert value(empty_session, f"{null} + {null}") is None
+
