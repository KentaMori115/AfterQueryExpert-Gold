@@ -0,0 +1,433 @@
+"""INTERVAL values: literals, text, arithmetic, comparison and extraction."""
+
+from __future__ import annotations
+
+import datetime as dt
+
+import pytest
+
+from slateql import Session
+from slateql.errors import ExecutionError, ParseError, TypeMismatchError
+from slateql.types.datatypes import DATE, INTEGER, INTERVAL, TIMESTAMP, TypeKind
+from slateql.types.schema import Schema
+
+
+def text(session: Session, expression: str) -> object:
+    """Evaluate ``expression`` and read it back as its canonical text."""
+
+    return session.scalar(f"SELECT CAST({expression} AS STRING)")
+
+
+def value(session: Session, expression: str) -> object:
+    return session.scalar(f"SELECT {expression}")
+
+
+def kind(session: Session, expression: str) -> TypeKind:
+    return session.sql(f"SELECT {expression}").schema[0].dtype.kind
+
+
+def date(text_value: str) -> str:
+    return f"CAST('{text_value}' AS DATE)"
+
+
+def stamp(text_value: str) -> str:
+    return f"CAST('{text_value}' AS TIMESTAMP)"
+
+
+SPANS_SCHEMA = Schema.of(
+    ("id", INTEGER),
+    ("started", DATE),
+    ("seen", TIMESTAMP),
+    ("span", INTERVAL),
+)
+
+SPANS_ROWS = [
+    [1, dt.date(2024, 1, 31), dt.datetime(2024, 1, 31, 10, 0), dt.timedelta(days=1, hours=2)],
+    [2, dt.date(2024, 3, 1), dt.datetime(2024, 3, 1, 0, 0), None],
+    [3, dt.date(2024, 1, 29), dt.datetime(2024, 2, 29, 23, 30), dt.timedelta(days=30)],
+    [4, dt.date(2024, 2, 29), dt.datetime(2024, 2, 29, 0, 0), dt.timedelta(hours=-2)],
+]
+
+
+@pytest.fixture()
+def spans() -> Session:
+    active = Session()
+    active.register_rows("spans", SPANS_SCHEMA, SPANS_ROWS)
+    return active
+
+
+# -- literals and text ---------------------------------------------------------
+
+
+def test_iso_literal_round_trips_through_cast(empty_session: Session):
+    assert text(empty_session, "INTERVAL 'P1Y2M3DT4H5M6S'") == "P1Y2M3DT4H5M6S"
+    assert text(empty_session, "INTERVAL 'P1Y2M3DT4H5M6.5S'") == "P1Y2M3DT4H5M6.5S"
+    assert kind(empty_session, "INTERVAL 'P1Y2M3DT4H5M6S'") is TypeKind.INTERVAL
+    assert value(empty_session, "typeof(INTERVAL 'P1D')") == "INTERVAL"
+
+
+@pytest.mark.parametrize(
+    "literal, expected",
+    [
+        ("INTERVAL '1' YEAR", "P1Y"),
+        ("INTERVAL '14' MONTH", "P1Y2M"),
+        ("INTERVAL '2' WEEK", "P14D"),
+        ("INTERVAL '3' DAY", "P3D"),
+        ("INTERVAL '36' HOUR", "PT36H"),
+        ("INTERVAL '90' MINUTE", "PT1H30M"),
+        ("INTERVAL '61' SECOND", "PT1M1S"),
+    ],
+)
+def test_unit_literal_fills_one_field(empty_session: Session, literal, expected):
+    assert text(empty_session, literal) == expected
+
+
+def test_unit_literal_takes_a_signed_whole_number(empty_session: Session):
+    assert text(empty_session, "INTERVAL '-2' MONTH") == "P-2M"
+    assert text(empty_session, "INTERVAL '+5' DAY") == "P5D"
+    with pytest.raises(ParseError):
+        empty_session.sql("SELECT INTERVAL '1.5' DAY")
+    with pytest.raises(ParseError):
+        empty_session.sql("SELECT INTERVAL 'x' DAY")
+
+
+def test_years_and_weeks_fold_but_hours_stay_hours(empty_session: Session):
+    assert text(empty_session, "INTERVAL 'P2Y'") == "P2Y"
+    assert text(empty_session, "INTERVAL 'P14M'") == "P1Y2M"
+    assert text(empty_session, "INTERVAL 'P2W'") == "P14D"
+    assert text(empty_session, "INTERVAL 'P1W1D'") == "P8D"
+    assert text(empty_session, "INTERVAL 'PT36H'") == "PT36H"
+    assert text(empty_session, "INTERVAL 'PT90M'") == "PT1H30M"
+    assert text(empty_session, "INTERVAL 'PT3661S'") == "PT1H1M1S"
+    assert text(empty_session, "INTERVAL 'P1DT24H'") == "P1DT24H"
+
+
+def test_zero_interval_renders_as_pt0s(empty_session: Session):
+    assert text(empty_session, "INTERVAL 'P0D'") == "PT0S"
+    assert text(empty_session, "INTERVAL 'PT0S'") == "PT0S"
+    assert text(empty_session, "INTERVAL 'P1D' - INTERVAL 'P1D'") == "PT0S"
+
+
+def test_each_component_carries_its_own_sign(empty_session: Session):
+    assert text(empty_session, "INTERVAL 'P1M-1D'") == "P1M-1D"
+    assert text(empty_session, "INTERVAL '-P1DT2H'") == "P-1DT-2H"
+    assert text(empty_session, "INTERVAL 'PT-1H30M'") == "PT-30M"
+    assert text(empty_session, "INTERVAL 'P-1Y14M'") == "P2M"
+
+
+def test_only_seconds_may_be_fractional(empty_session: Session):
+    assert text(empty_session, "INTERVAL 'PT1.5S'") == "PT1.5S"
+    assert text(empty_session, "INTERVAL 'PT1.2500000S'") == "PT1.25S"
+    assert text(empty_session, "INTERVAL 'PT0.0000006S'") == "PT0.000001S"
+    with pytest.raises(ParseError):
+        empty_session.sql("SELECT INTERVAL 'P1.5D'")
+
+
+def test_bad_literal_text_is_a_parse_error(empty_session: Session):
+    assert text(empty_session, "INTERVAL 'P1D'") == "P1D"
+    for bad in ("P", "PT", "P1DT", "1 day", "", "P1D2H", "PT1H1H", "1D", "P1Y2"):
+        with pytest.raises(ParseError):
+            empty_session.sql(f"SELECT INTERVAL '{bad}'")
+
+
+def test_cast_from_string_uses_the_literal_rules(empty_session: Session):
+    assert text(empty_session, "CAST('P14D' AS INTERVAL)") == "P14D"
+    assert text(empty_session, "CAST('P2W' AS INTERVAL)") == "P14D"
+    assert text(empty_session, "CAST('-P1M' AS INTERVAL)") == "P-1M"
+    assert kind(empty_session, "CAST('P14D' AS INTERVAL)") is TypeKind.INTERVAL
+    assert value(empty_session, "typeof(CAST('P14D' AS INTERVAL))") == "INTERVAL"
+
+
+def test_cast_of_bad_text_is_null_unless_strict(empty_session: Session):
+    empty_session.register_dicts("raw", [{"t": "P1D"}, {"t": "3 days"}, {"t": "P"}])
+    assert value(empty_session, "CAST('3 days' AS INTERVAL)") is None
+    assert value(empty_session, "CAST('P' AS INTERVAL)") is None
+    converted = empty_session.sql("SELECT CAST(CAST(t AS INTERVAL) AS STRING) AS s FROM raw")
+    assert converted.column("s") == ["P1D", None, None]
+    empty_session.configure(strict_casts=True)
+    with pytest.raises(ExecutionError):
+        empty_session.sql("SELECT CAST(t AS INTERVAL) FROM raw")
+
+
+def test_cast_of_an_interval_to_interval_is_identity(spans: Session):
+    rows = spans.sql(
+        "SELECT CAST(CAST(span AS INTERVAL) AS STRING) AS s FROM spans ORDER BY id"
+    ).column("s")
+    assert rows == ["P1DT2H", None, "P30D", "PT-2H"]
+
+
+# -- arithmetic ----------------------------------------------------------------
+
+
+def test_field_wise_sum_and_difference(empty_session: Session):
+    assert text(empty_session, "INTERVAL 'P1M20D' + INTERVAL 'P20DT30H'") == "P1M40DT30H"
+    assert text(empty_session, "INTERVAL 'P1M' - INTERVAL 'P1D'") == "P1M-1D"
+    assert kind(empty_session, "INTERVAL 'P1M' + INTERVAL 'P1D'") is TypeKind.INTERVAL
+
+
+def test_unary_minus_negates_every_field(empty_session: Session):
+    assert text(empty_session, "-INTERVAL 'P1M15D'") == "P-1M-15D"
+    assert text(empty_session, "-INTERVAL 'P1M-1DT2H'") == "P-1M1DT-2H"
+    assert text(empty_session, "+INTERVAL 'P1D'") == "P1D"
+
+
+def test_january_31_plus_a_month_lands_on_february_29(empty_session: Session):
+    expression = f"{date('2024-01-31')} + INTERVAL 'P1M'"
+    assert value(empty_session, expression) == dt.datetime(2024, 2, 29)
+    assert kind(empty_session, expression) is TypeKind.TIMESTAMP
+    feb = value(empty_session, f"{date('2023-01-31')} + INTERVAL '1' MONTH")
+    assert feb == dt.datetime(2023, 2, 28)
+    assert value(empty_session, f"{date('2024-03-31')} + INTERVAL 'P1M'") == dt.datetime(2024, 4, 30)
+
+
+def test_adding_a_month_twice_differs_from_two_months(empty_session: Session):
+    twice = f"{date('2024-01-31')} + INTERVAL 'P1M' + INTERVAL 'P1M'"
+    once = f"{date('2024-01-31')} + INTERVAL 'P2M'"
+    assert value(empty_session, twice) == dt.datetime(2024, 3, 29)
+    assert value(empty_session, once) == dt.datetime(2024, 3, 31)
+
+
+def test_months_apply_before_days(empty_session: Session):
+    together = f"{date('2024-01-29')} + INTERVAL 'P1M2D'"
+    days_first = f"{date('2024-01-29')} + INTERVAL 'P2D' + INTERVAL 'P1M'"
+    assert value(empty_session, together) == dt.datetime(2024, 3, 2)
+    assert value(empty_session, days_first) == dt.datetime(2024, 2, 29)
+    expression = f"{stamp('2024-01-31T23:30:00')} + INTERVAL 'P1MT1H'"
+    assert value(empty_session, expression) == dt.datetime(2024, 3, 1, 0, 30)
+
+
+def test_leap_day_plus_a_year(empty_session: Session):
+    assert value(empty_session, f"{date('2024-02-29')} + INTERVAL 'P1Y'") == dt.datetime(2025, 2, 28)
+    assert value(empty_session, f"{date('2024-02-29')} + INTERVAL 'P4Y'") == dt.datetime(2028, 2, 29)
+
+
+def test_subtracting_an_interval_walks_backwards(empty_session: Session):
+    expression = f"{date('2024-03-31')} - INTERVAL 'P1M'"
+    assert value(empty_session, expression) == dt.datetime(2024, 2, 29)
+    assert kind(empty_session, expression) is TypeKind.TIMESTAMP
+    expression = f"{stamp('2024-03-01T00:00:00')} - INTERVAL 'PT1S'"
+    assert value(empty_session, expression) == dt.datetime(2024, 2, 29, 23, 59, 59)
+    expression = f"{date('2024-03-31')} + INTERVAL '-1' MONTH"
+    assert value(empty_session, expression) == dt.datetime(2024, 2, 29)
+
+
+def test_timestamp_difference_is_days_and_seconds(empty_session: Session):
+    expression = f"{stamp('2024-03-01T00:00:00')} - {stamp('2024-01-31T10:00:00')}"
+    assert text(empty_session, expression) == "P29DT14H"
+    assert kind(empty_session, expression) is TypeKind.INTERVAL
+    reverse = f"{stamp('2024-01-31T10:00:00')} - {stamp('2024-03-01T00:00:00')}"
+    assert text(empty_session, reverse) == "P-29DT-14H"
+    months_apart = f"{stamp('2024-03-31T00:00:00')} - {stamp('2024-01-01T00:00:00')}"
+    assert text(empty_session, months_apart) == "P90D"
+    assert text(empty_session, f"{stamp('2024-01-31T10:00:00')} - {date('2024-01-31')}") == "PT10H"
+    assert text(empty_session, f"{date('2024-01-31')} - {stamp('2024-01-31T10:00:00')}") == "PT-10H"
+
+
+def test_date_minus_date_stays_a_whole_number_of_days(spans: Session):
+    expression = f"{date('2024-03-01')} - {date('2024-01-31')}"
+    assert value(spans, expression) == 30
+    assert value(spans, f"{date('2024-01-01')} - {date('2024-01-31')}") == -30
+    typed = spans.sql("SELECT started - started AS d, seen - seen AS i FROM spans").schema
+    assert typed.field("d").dtype.kind is TypeKind.INTEGER
+    assert typed.field("i").dtype.kind is TypeKind.INTERVAL
