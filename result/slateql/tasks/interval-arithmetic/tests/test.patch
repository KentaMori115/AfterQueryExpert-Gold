+def test_order_by_sorts_by_length_not_text(spans: Session):
+    ordered = spans.sql(
+        "SELECT CAST(span AS STRING) AS s FROM spans WHERE span IS NOT NULL "
+        "ORDER BY span"
+    ).column("s")
+    assert ordered == ["PT-2H", "P1DT2H", "P30D"]
+    ordered = spans.sql(
+        "SELECT CAST(span AS STRING) AS s FROM spans ORDER BY span DESC"
+    ).column("s")
+    assert ordered == ["P30D", "P1DT2H", "PT-2H", None]
+
+
+def test_order_by_mixed_units_follows_thirty_day_months(empty_session: Session):
+    empty_session.register_dicts("k", [{"n": 1}, {"n": 2}, {"n": 3}, {"n": 4}])
+    ordered = empty_session.sql(
+        "SELECT CAST(CASE n WHEN 1 THEN INTERVAL 'P31D' WHEN 2 THEN INTERVAL 'P1M' "
+        "WHEN 3 THEN INTERVAL 'P29D' ELSE INTERVAL 'P30DT1H' END AS STRING) AS s "
+        "FROM k ORDER BY CASE n WHEN 1 THEN INTERVAL 'P31D' WHEN 2 THEN INTERVAL 'P1M' "
+        "WHEN 3 THEN INTERVAL 'P29D' ELSE INTERVAL 'P30DT1H' END"
+    ).column("s")
+    assert ordered == ["P29D", "P1M", "P30DT1H", "P31D"]
+
+
+def test_null_placement_comes_from_the_session_setting(spans: Session):
+    spans.configure(null_ordering="nulls_first")
+    ordered = spans.sql("SELECT CAST(span AS STRING) AS s FROM spans ORDER BY span").column("s")
+    assert ordered == [None, "PT-2H", "P1DT2H", "P30D"]
+    ordered = spans.sql(
+        "SELECT CAST(span AS STRING) AS s FROM spans ORDER BY span DESC NULLS LAST"
+    ).column("s")
+    assert ordered == ["P30D", "P1DT2H", "PT-2H", None]
