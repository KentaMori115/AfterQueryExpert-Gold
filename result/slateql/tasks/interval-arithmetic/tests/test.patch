+def test_a_month_is_thirty_days_and_a_day_is_twenty_four_hours(empty_session: Session):
+    assert value(empty_session, "INTERVAL 'P1M' = INTERVAL 'P30D'") is True
+    assert value(empty_session, "INTERVAL 'P1D' = INTERVAL 'PT24H'") is True
+    assert value(empty_session, "INTERVAL 'P1Y' = INTERVAL 'P360D'") is True
+    assert value(empty_session, "INTERVAL 'P1M' <> INTERVAL 'P31D'") is True
+    assert value(empty_session, "INTERVAL 'P1M' > INTERVAL 'P29D'") is True
+    assert value(empty_session, "INTERVAL 'P1M' < INTERVAL 'P30DT1H'") is True
+    assert value(empty_session, "INTERVAL 'PT-1H' < INTERVAL 'PT0S'") is True
+
+
+def test_comparison_and_arithmetic_disagree_on_purpose(empty_session: Session):
+    assert value(empty_session, "INTERVAL 'P1M' = INTERVAL 'P30D'") is True
+    month = value(empty_session, f"{date('2024-01-31')} + INTERVAL 'P1M'")
+    days = value(empty_session, f"{date('2024-01-31')} + INTERVAL 'P30D'")
+    assert month == dt.datetime(2024, 2, 29)
+    assert days == dt.datetime(2024, 3, 1)
+
+
+def test_between_and_in_follow_the_comparison_rule(empty_session: Session):
+    assert value(empty_session, "INTERVAL 'P1M' BETWEEN INTERVAL 'P30D' AND INTERVAL 'P31D'")
+    assert value(empty_session, "INTERVAL 'P1M' IN (INTERVAL 'P1D', INTERVAL 'P30D')") is True
+    assert value(empty_session, "INTERVAL 'P1M' NOT IN (INTERVAL 'P29D')") is True
+    assert value(empty_session, "INTERVAL 'P1M' IN (INTERVAL 'P29D', NULL)") is None
+
