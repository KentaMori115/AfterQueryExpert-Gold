diff --git a/tests/test_interval_queries.py b/tests/test_interval_queries.py
new file mode 100644
index 0000000..6950f9f
--- /dev/null
+++ b/tests/test_interval_queries.py
@@ -0,0 +1,342 @@
+"""INTERVAL values inside whole queries: keys, aggregates, plans and output."""
+
+from __future__ import annotations
+
+import datetime as dt
+import json
+
+import pytest
+
+from slateql import Session
+from slateql.cli.formatter import format_result
+from slateql.cli.main import main
+from slateql.sql.parser import parse
+from slateql.sql.unparser import unparse
+from slateql.types.datatypes import DATE, INTEGER, INTERVAL, STRING, TypeKind
+from slateql.types.schema import Schema
+
+MIXED = (
+    "CASE n WHEN 1 THEN INTERVAL 'P1M' WHEN 2 THEN INTERVAL 'P30D' "
+    "WHEN 3 THEN INTERVAL 'P1D' WHEN 4 THEN INTERVAL 'PT24H' "
+    "WHEN 5 THEN INTERVAL 'P29D' ELSE NULL END"
+)
+
+
+@pytest.fixture()
+def mixed() -> Session:
+    """Six rows whose ``n`` selects an interval through ``MIXED``."""
+
+    active = Session()
+    active.register_dicts("k", [{"n": n} for n in range(1, 7)])
+    return active
+
+
+def intervals_table(session: Session, name: str, expressions: list[str]) -> None:
+    """Register ``name`` with one INTERVAL column built from SQL expressions.
+
+    The values pass through the engine itself, so the table holds whatever
+    the engine uses for an interval without the test naming it.
+    """
+
+    rows = [session.sql(f"SELECT {expression} AS v").rows[0] for expression in expressions]
+    session.register_rows(name, Schema.of(("v", INTERVAL)), rows)
+
+
+TERMS_SCHEMA = Schema.of(
+    ("id", INTEGER),
+    ("plan", STRING),
+    ("started", DATE),
+    ("term", INTERVAL),
+)
+
+TERMS_ROWS = [
+    [1, "monthly", dt.date(2024, 1, 31), dt.timedelta(days=30)],
+    [2, "monthly", dt.date(2024, 1, 29), dt.timedelta(days=30)],
+    [3, "trial", dt.date(2024, 2, 20), dt.timedelta(days=14)],
+    [4, "weekly", dt.date(2024, 2, 27), dt.timedelta(days=7)],
+    [5, "paused", dt.date(2024, 3, 1), None],
+]
+
+
+@pytest.fixture()
+def terms() -> Session:
+    active = Session()
+    active.register_rows("terms", TERMS_SCHEMA, TERMS_ROWS)
+    return active
+
+
+# -- one identity for keys ------------------------------------------------------
+
+
+def test_group_by_merges_intervals_that_compare_equal(mixed: Session):
+    result = mixed.sql(
+        f"SELECT CAST({MIXED} AS STRING) AS v, COUNT(*) AS c FROM k GROUP BY {MIXED}"
+    )
+    assert result.to_tuples() == [("P1M", 2), ("P1D", 2), ("P29D", 1), (None, 1)]
+
+
+def test_distinct_merges_intervals_that_compare_equal(mixed: Session):
+    result = mixed.sql(f"SELECT DISTINCT {MIXED} AS v FROM k")
+    assert len(result) == 4
+    texts = mixed.sql(f"SELECT DISTINCT CAST({MIXED} AS STRING) AS v FROM k").column("v")
+    assert texts == ["P1M", "P30D", "P1D", "PT24H", "P29D", None]
+
+
+def test_union_merges_intervals_that_compare_equal(mixed: Session):
+    result = mixed.sql(
+        "SELECT INTERVAL 'P1M' AS v FROM k UNION SELECT INTERVAL 'P30D' FROM k "
+        "UNION SELECT INTERVAL 'PT24H' FROM k UNION SELECT INTERVAL 'P1D' FROM k"
+    )
+    assert len(result) == 2
+    result = mixed.sql(
+        "SELECT INTERVAL 'P1M' AS v FROM k WHERE n = 1 "
+        "UNION ALL SELECT INTERVAL 'P30D' FROM k WHERE n = 1"
+    )
+    assert len(result) == 2
+
+
+def test_hash_join_matches_intervals_that_compare_equal(empty_session: Session):
+    intervals_table(empty_session, "a", ["INTERVAL 'P1M'", "INTERVAL 'P1D'", "INTERVAL 'P2D'"])
+    intervals_table(
+        empty_session, "b", ["INTERVAL 'P30D'", "INTERVAL 'PT24H'", "INTERVAL 'PT47H'"]
+    )
+    matched = empty_session.sql(
+        "SELECT CAST(a.v AS STRING) AS l, CAST(b.v AS STRING) AS r "
+        "FROM a JOIN b ON a.v = b.v ORDER BY a.v"
+    )
+    assert matched.to_tuples() == [("P1D", "PT24H"), ("P1M", "P30D")]
+    outer = empty_session.sql(
+        "SELECT CAST(a.v AS STRING) AS l, CAST(b.v AS STRING) AS r "
+        "FROM a LEFT JOIN b ON a.v = b.v ORDER BY a.v"
+    )
+    assert outer.to_tuples() == [("P1D", "PT24H"), ("P2D", None), ("P1M", "P30D")]
+
+
+def test_join_never_matches_a_null_interval(terms: Session):
+    intervals_table(terms, "n", ["CAST(NULL AS INTERVAL)", "INTERVAL 'P14D'"])
+    matched = terms.sql("SELECT id FROM terms JOIN n ON terms.term = n.v ORDER BY id")
+    assert matched.column("id") == [3]
+
+
+# -- aggregates -------------------------------------------------------------------
+
+
+def test_sum_adds_fields_and_avg_scales_the_total(empty_session: Session):
+    intervals_table(empty_session, "s", ["INTERVAL 'P1M'", "INTERVAL 'PT0S'"])
+    result = empty_session.sql(
+        "SELECT CAST(SUM(v) AS STRING) AS total, CAST(AVG(v) AS STRING) AS mean, "
+        "COUNT(v) AS n FROM s"
+    )
+    assert result.to_tuples() == [("P1M", "P15D", 2)]
+    typed = empty_session.sql("SELECT SUM(v) AS total, AVG(v) AS mean FROM s").schema
+    assert typed.field("total").dtype.kind is TypeKind.INTERVAL
+    assert typed.field("mean").dtype.kind is TypeKind.INTERVAL
+    intervals_table(empty_session, "t", ["INTERVAL 'P1M20D'", "INTERVAL 'P20DT30H'"])
+    assert empty_session.scalar("SELECT CAST(SUM(v) AS STRING) FROM t") == "P1M40DT30H"
+    assert empty_session.scalar("SELECT CAST(AVG(v) AS STRING) FROM t") == "P35DT15H"
+
+
+def test_avg_of_three_carries_a_third_of_a_month(empty_session: Session):
+    intervals_table(
+        empty_session, "s", ["INTERVAL 'P1M'", "INTERVAL 'PT0S'", "INTERVAL 'PT0S'"]
+    )
+    assert empty_session.scalar("SELECT CAST(AVG(v) AS STRING) FROM s") == "P10D"
+    assert empty_session.scalar("SELECT CAST(MEAN(v) AS STRING) FROM s") == "P10D"
+
+
+def test_min_and_max_use_the_comparison_rule(empty_session: Session):
+    intervals_table(
+        empty_session, "s", ["INTERVAL 'P1M'", "INTERVAL 'P29D'", "INTERVAL 'P30DT1H'"]
+    )
+    result = empty_session.sql(
+        "SELECT CAST(MIN(v) AS STRING) AS lo, CAST(MAX(v) AS STRING) AS hi FROM s"
+    )
+    assert result.to_tuples() == [("P29D", "P30DT1H")]
+
+
+def test_aggregates_skip_nulls_and_empty_groups_are_null(terms: Session):
+    result = terms.sql(
+        "SELECT CAST(SUM(term) AS STRING) AS s, CAST(AVG(term) AS STRING) AS a, "
+        "CAST(MIN(term) AS STRING) AS lo, CAST(MAX(term) AS STRING) AS hi, "
+        "COUNT(term) AS n FROM terms"
+    )
+    assert result.to_tuples() == [("P81D", "P20DT6H", "P7D", "P30D", 4)]
+    empty = terms.sql(
+        "SELECT SUM(term) AS s, AVG(term) AS a, MIN(term) AS lo FROM terms WHERE id > 9"
+    )
+    assert empty.to_tuples() == [(None, None, None)]
+
+
+def test_grouped_aggregates_over_intervals(terms: Session):
+    result = terms.sql(
+        "SELECT plan, CAST(SUM(term) AS STRING) AS total FROM terms "
+        "GROUP BY plan HAVING SUM(term) > INTERVAL 'P10D' ORDER BY plan"
+    )
+    assert result.to_tuples() == [("monthly", "P60D"), ("trial", "P14D")]
+
+
+# -- planning ---------------------------------------------------------------------
+
+
+def test_optimized_and_unoptimized_plans_agree(terms: Session):
+    statement = (
+        "SELECT id, started + term AS renews, started + INTERVAL 'P1M' + INTERVAL 'P1M' AS later "
+        "FROM terms WHERE started + INTERVAL 'P1M' > CAST('2024-03-01T00:00:00' AS TIMESTAMP) "
+        "ORDER BY id"
+    )
+    fast = terms.sql(statement)
+    terms.configure(optimize=False)
+    slow = terms.sql(statement)
+    assert fast.to_tuples() == slow.to_tuples()
+    assert fast.schema.types == slow.schema.types
+    assert fast.column("id") == [3, 4, 5]
+    assert fast.column("later")[0] == dt.datetime(2024, 4, 20)
+
+
+def test_folded_interval_prints_as_an_interval_literal(terms: Session):
+    plan = terms.explain("SELECT started + (INTERVAL 'P1M' + INTERVAL 'P1M') AS x FROM terms")
+    assert "INTERVAL 'P2M'" in plan
+    assert "'P1M'" not in plan
+    terms.configure(optimize=False)
+    plan = terms.explain("SELECT started + (INTERVAL 'P1M' + INTERVAL 'P1M') AS x FROM terms")
+    assert plan.count("INTERVAL 'P1M'") == 2
+
+
+def test_folding_never_turns_a_month_into_days(terms: Session):
+    statement = "SELECT CAST('2024-01-31' AS DATE) + INTERVAL 'P1M' AS d FROM terms WHERE id = 1"
+    assert terms.scalar(statement) == dt.datetime(2024, 2, 29)
+    statement = (
+        "SELECT CAST('2024-01-31' AS DATE) + (INTERVAL 'P15D' * 2) AS d FROM terms WHERE id = 1"
+    )
+    assert terms.scalar(statement) == dt.datetime(2024, 3, 1)
+
+
+def test_interval_predicates_survive_pushdown(terms: Session):
+    statement = (
+        "SELECT id FROM terms WHERE term >= INTERVAL 'P2W' AND started - INTERVAL 'P1M' "
+        "< CAST('2024-01-01T00:00:00' AS TIMESTAMP) ORDER BY id"
+    )
+    assert terms.sql(statement).column("id") == [1, 2]
+    terms.configure(optimize=False)
+    assert terms.sql(statement).column("id") == [1, 2]
+
+
+def test_statistics_are_collected_over_interval_columns(terms: Session):
+    terms.configure(collect_statistics=True)
+    terms.analyze("terms")
+    assert terms.sql("SELECT id FROM terms WHERE term > INTERVAL 'P1W'").column("id") == [1, 2, 3]
+    assert terms.sql("SELECT id FROM terms WHERE term = INTERVAL 'PT168H'").column("id") == [4]
+
+
+def test_unparse_round_trips_interval_literals():
+    statement = (
+        "SELECT INTERVAL '3' DAY + INTERVAL 'P1M' AS x FROM t "
+        "WHERE d > CAST('2024-01-01' AS DATE) - INTERVAL 'P1Y'"
+    )
+    once = unparse(parse(statement))
+    assert "INTERVAL 'P3D'" in once
+    assert "INTERVAL 'P1M'" in once
+    assert "INTERVAL 'P1Y'" in once
+    assert unparse(parse(once)) == once
+
+
+def test_unit_word_after_the_text_belongs_to_the_literal(terms: Session):
+    result = terms.sql("SELECT CAST(INTERVAL '1' day AS STRING) AS d FROM terms WHERE id = 1")
+    assert result.column("d") == ["P1D"]
+    result = terms.sql("SELECT INTERVAL 'P1D' AS day FROM terms WHERE id = 1")
+    assert result.schema.names == ["day"]
+
+
+def test_case_and_coalesce_unify_intervals(terms: Session):
+    result = terms.sql(
+        "SELECT CAST(COALESCE(term, INTERVAL 'P0D') AS STRING) AS t, "
+        "CAST(CASE WHEN term > INTERVAL 'P2W' THEN term ELSE NULL END AS STRING) AS big "
+        "FROM terms ORDER BY id"
+    )
+    assert result.column("t") == ["P30D", "P30D", "P14D", "P7D", "PT0S"]
+    assert result.column("big") == ["P30D", "P30D", None, None, None]
+
+
+def test_three_valued_comparison_in_where(terms: Session):
+    rows = terms.sql("SELECT id FROM terms WHERE NOT term = INTERVAL 'P30D'").column("id")
+    assert rows == [3, 4]
+    assert terms.sql("SELECT id FROM terms WHERE term <> term").column("id") == []
+
+
+# -- output -----------------------------------------------------------------------
+
+
+def test_every_output_format_prints_iso_text(terms: Session):
+    result = terms.sql(
+        "SELECT id, CAST(term AS STRING) AS t, term FROM terms WHERE id IN (1, 5) ORDER BY id"
+    )
+    assert "| P30D" in format_result(result, "table")
+    assert "1,P30D,P30D" in format_result(result, "csv")
+    assert "1\tP30D\tP30D" in format_result(result, "tsv")
+    records = json.loads(format_result(result, "json"))
+    assert records[0]["term"] == "P30D" and records[1]["term"] is None
+    assert '"term": "P30D"' in format_result(result, "jsonl")
+    assert "term | P30D" in format_result(result, "vertical")
+    assert "| P30D" in result.pretty()
+
+
+def test_computed_intervals_print_the_same_way(terms: Session):
+    result = terms.sql(
+        "SELECT term / 2 AS half, CAST('2024-03-15T12:00:00' AS TIMESTAMP) - started AS running "
+        "FROM terms WHERE id = 1"
+    )
+    assert "| P15D" in format_result(result, "table") and "P44DT12H" in result.pretty()
+
+
+def test_cli_query_prints_intervals(capsys):
+    code = main(["query", "SELECT INTERVAL 'P1Y2M' AS span, INTERVAL 'P1M' / 2 AS half"])
+    out = capsys.readouterr().out
+    assert code == 0
+    assert "P1Y2M" in out
+    assert "P15D" in out
+
+
+# -- calendar walk over a table --------------------------------------------------
+
+
+def test_renewal_dates_over_a_table(terms: Session):
+    result = terms.sql(
+        "SELECT id, started + term AS renews FROM terms WHERE term IS NOT NULL ORDER BY renews, id"
+    )
+    assert result.column("renews") == [
+        dt.datetime(2024, 2, 28),
+        dt.datetime(2024, 3, 1),
+        dt.datetime(2024, 3, 5),
+        dt.datetime(2024, 3, 5),
+    ]
+    assert result.column("id") == [2, 1, 3, 4]
+
+
+def test_month_arithmetic_over_a_column(terms: Session):
+    result = terms.sql(
+        "SELECT id, started + INTERVAL '1' MONTH AS m1, started + INTERVAL '2' MONTH AS m2 "
+        "FROM terms ORDER BY id"
+    )
+    assert result.column("m1") == [
+        dt.datetime(2024, 2, 29),
+        dt.datetime(2024, 2, 29),
+        dt.datetime(2024, 3, 20),
+        dt.datetime(2024, 3, 27),
+        dt.datetime(2024, 4, 1),
+    ]
+    assert result.column("m2")[0] == dt.datetime(2024, 3, 31)
+    assert result.schema.field("m1").dtype.kind is TypeKind.TIMESTAMP
+
+
+def test_elapsed_time_between_columns(terms: Session):
+    result = terms.sql(
+        "SELECT id, CAST(CAST('2024-03-01' AS DATE) - started AS STRING) AS gap, "
+        "CAST('2024-03-01' AS DATE) - started AS raw FROM terms ORDER BY id"
+    )
+    assert result.column("raw") == [30, 32, 10, 3, 0]
+    assert result.column("gap") == ["30", "32", "10", "3", "0"]
+
+
+def test_ordering_by_a_computed_interval(terms: Session):
+    result = terms.sql("SELECT id FROM terms ORDER BY term / 7 NULLS FIRST, id")
+    assert result.column("id") == [5, 4, 3, 1, 2]
