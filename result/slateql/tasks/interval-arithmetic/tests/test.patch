+def test_timedelta_from_dicts_infers_interval(empty_session: Session):
+    empty_session.register_dicts(
+        "waits",
+        [
+            {"who": "a", "wait": dt.timedelta(minutes=90)},
+            {"who": "b", "wait": dt.timedelta(days=-1, hours=-2)},
+            {"who": "c", "wait": dt.timedelta(microseconds=1500)},
+        ],
+    )
+    assert empty_session.schema_of("waits").field("wait").dtype.kind is TypeKind.INTERVAL
+    texts = empty_session.sql(
+        "SELECT CAST(wait AS STRING) AS s FROM waits ORDER BY who"
+    ).column("s")
+    assert texts == ["PT1H30M", "P-1DT-2H", "PT0.0015S"]
