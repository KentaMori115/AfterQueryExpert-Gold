+@pytest.mark.parametrize(
+    "expression, expected",
+    [
+        ("INTERVAL 'P1M' / 2", "P15D"),
+        ("INTERVAL 'P1M' / 3", "P10D"),
+        ("INTERVAL 'P1M' * 1.5", "P1M15D"),
+        ("INTERVAL 'P1D' / 4", "PT6H"),
+        ("2 * INTERVAL 'P1M1D'", "P2M2D"),
+        ("INTERVAL 'P1M1D' * 2", "P2M2D"),
+        ("INTERVAL 'P1D' * 0.1", "PT2H24M"),
+        ("INTERVAL 'P1Y' / 12", "P1M"),
+        ("INTERVAL 'P1M' * -1", "P-1M"),
+        ("INTERVAL 'P3D' / 2", "P1DT12H"),
+    ],
+)
+def test_scaling_keeps_whole_fields_and_carries_fractions_down(
+    empty_session: Session, expression, expected
+):
+    assert text(empty_session, expression) == expected
+    assert kind(empty_session, expression) is TypeKind.INTERVAL
+
+
+def test_scaling_rounds_to_the_microsecond(empty_session: Session):
+    assert text(empty_session, "INTERVAL 'PT1S' / 3") == "PT0.333333S"
+    assert text(empty_session, "INTERVAL 'PT2S' / 3") == "PT0.666667S"
+    assert text(empty_session, "INTERVAL 'P1M' / 7") == "P4DT6H51M25.714286S"
+
+
+def test_dividing_an_interval_by_zero_is_an_error(empty_session: Session):
+    with pytest.raises(ExecutionError):
+        empty_session.sql("SELECT INTERVAL 'P1D' / 0")
+    with pytest.raises(ExecutionError):
+        empty_session.sql("SELECT INTERVAL 'P1D' / 0.0")
+
+
+@pytest.mark.parametrize(
+    "expression",
+    [
+        "INTERVAL 'P1D' + 1",
+        "1 - INTERVAL 'P1D'",
+        "INTERVAL 'P1D' * INTERVAL 'P1D'",
+        "INTERVAL 'P1D' / INTERVAL 'P1D'",
+        "2 / INTERVAL 'P1D'",
+        "CAST('2024-01-01' AS DATE) * INTERVAL 'P1D'",
+        "INTERVAL 'P1D' - CAST('2024-01-01' AS DATE)",
+        "INTERVAL 'P1D' % 2",
+    ],
+)
+def test_any_other_mix_is_a_type_error(empty_session: Session, expression):
+    with pytest.raises(TypeMismatchError):
+        empty_session.sql(f"SELECT {expression}")
