+SIGNALS_SCHEMA = Schema.of(
+    ("id", INTEGER),
+    ("lane", STRING),
+    ("live", BOOLEAN),
+    ("load", INTEGER),
+)
+
+# A second table for the aggregates the events table cannot reach: booleans,
+# a text column worth concatenating, and two loads per lane so a spread has
+# something to measure.  One row of each lane is missing a value.
+SIGNALS_ROWS = [
+    [1, "up", True, 4],
+    [2, "up", True, 8],
+    [3, "up", None, None],
+    [4, "down", False, 2],
+    [5, "down", None, 10],
+]
+
+
+def signals() -> Session:
+    """A session holding the signals table."""
+
+    session = Session()
+    session.register_rows("signals", SIGNALS_SCHEMA, SIGNALS_ROWS)
+    return session
+
+
+def test_boolean_lanes_fold_over_a_partition():
+    """BOOL_AND, its EVERY spelling and BOOL_OR all read a window."""
+
+    result = signals().sql(
+        "SELECT id, "
+        "BOOL_AND(live) OVER (PARTITION BY lane) AS all_live, "
+        "EVERY(live) OVER (PARTITION BY lane) AS every_live, "
+        "BOOL_OR(live) OVER (PARTITION BY lane) AS any_live "
+        "FROM signals"
+    )
+    rows = {row[0]: row[1:] for row in result.rows}
+    assert rows[1] == [True, True, True]
+    assert rows[4] == [False, False, False]
+
+
+def test_picking_and_joining_lane_names():
+    """ANY_VALUE and STRING_AGG fold a partition of text."""
+
+    result = signals().sql(
+        "SELECT id, "
+        "ANY_VALUE(lane) OVER (PARTITION BY lane) AS one, "
+        "STRING_AGG(lane) OVER (PARTITION BY lane) AS joined "
+        "FROM signals"
+    )
+    rows = {row[0]: row[1:] for row in result.rows}
+    assert rows[1] == ["up", "up,up,up"]
+    assert rows[4] == ["down", "down,down"]
+
+
+def test_spread_of_the_loads_in_a_lane():
+    """Both variances read a window and skip the missing load."""
+
+    result = signals().sql(
+        "SELECT id, "
+        "VAR_POP(load) OVER (PARTITION BY lane) AS population, "
+        "VAR_SAMP(load) OVER (PARTITION BY lane) AS sample "
+        "FROM signals"
+    )
+    rows = {row[0]: row[1:] for row in result.rows}
+    assert rows[1] == [pytest.approx(4.0), pytest.approx(8.0)]
+    assert rows[4] == [pytest.approx(16.0), pytest.approx(32.0)]
+
+
+def test_deviation_of_the_loads_in_a_lane():
+    """STDDEV_POP, STDDEV_SAMP and the bare STDDEV spelling read a window."""
+
+    result = signals().sql(
+        "SELECT id, "
+        "STDDEV_POP(load) OVER (PARTITION BY lane) AS population, "
+        "STDDEV_SAMP(load) OVER (PARTITION BY lane) AS sample, "
+        "STDDEV(load) OVER (PARTITION BY lane) AS plain "
+        "FROM signals"
+    )
+    rows = {row[0]: row[1:] for row in result.rows}
+    assert rows[1] == [pytest.approx(2.0), pytest.approx(2.828427), pytest.approx(2.828427)]
+    assert rows[4] == [pytest.approx(4.0), pytest.approx(5.656854), pytest.approx(5.656854)]
+
+
+def test_mean_is_avg_over_a_window_too():
+    """The MEAN spelling of AVG takes an OVER clause like the rest."""
+
+    result = signals().sql(
+        "SELECT id, MEAN(load) OVER (PARTITION BY lane) AS middle FROM signals"
+    )
+    assert [row[1] for row in result.rows] == [pytest.approx(6.0)] * 5
