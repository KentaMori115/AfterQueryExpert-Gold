+@dataclass(frozen=True)
+class WindowFrame:
+    """A ``ROWS`` or ``RANGE`` frame ending at the current row.
+
+    ``preceding`` is how far back the frame reaches, ``None`` reaching the
+    start of the partition.  A ``ROWS`` frame counts rows, so a call carrying
+    one is folded row by row rather than peer group by peer group.  A
+    ``RANGE`` frame (``by_value``) measures the reach in the ordering value
+    and keeps peers together.
+    """
+
+    preceding: Optional[float] = None
+    by_value: bool = False
+    exclude: Optional[str] = None
+
+    def to_sql(self) -> str:
+        start = "UNBOUNDED" if self.preceding is None else str(self.preceding)
+        unit = "RANGE" if self.by_value else "ROWS"
+        text = f"{unit} BETWEEN {start} PRECEDING AND CURRENT ROW"
+        if self.exclude is not None:
+            text += f" EXCLUDE {self.exclude.upper()}"
+        return text
