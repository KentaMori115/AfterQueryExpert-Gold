+@dataclass(frozen=True)
+class WindowOrder:
+    """One ORDER BY entry of an OVER clause, with its null placement resolved."""
+
+    expression: Expr
+    descending: bool = False
+    nulls_first: bool = False
+
+    def to_sql(self) -> str:
+        text = self.expression.to_sql()
+        text += " DESC" if self.descending else " ASC"
+        return text + (" NULLS FIRST" if self.nulls_first else " NULLS LAST")
