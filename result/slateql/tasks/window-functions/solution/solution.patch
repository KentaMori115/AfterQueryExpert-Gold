+    """A call evaluated over a window of rows rather than over one row.
+
+    The partition and ordering expressions are children like the arguments
+    are, so every helper that reasons about an expression through
+    :meth:`Expr.children` -- column collection, substitution, validation,
+    pruning -- sees the columns a window reads even when the query never
+    selects them.
+    """
+
+    name: str
+    dtype: DataType
+    args: tuple[Expr, ...] = ()
+    partition_by: tuple[Expr, ...] = ()
+    order_by: tuple[WindowOrder, ...] = ()
+    frame: Optional[WindowFrame] = None
+    star: bool = False
+
+    def children(self) -> Sequence[Expr]:
+        return (
+            *self.args,
+            *self.partition_by,
+            *(item.expression for item in self.order_by),
+        )
+
+    def with_children(self, children: Sequence[Expr]) -> Expr:
+        args = len(self.args)
+        partition = args + len(self.partition_by)
+        return WindowCall(
+            name=self.name,
+            dtype=self.dtype,
+            args=tuple(children[:args]),
+            partition_by=tuple(children[args:partition]),
+            order_by=tuple(
+                WindowOrder(
+                    expression=expression,
+                    descending=item.descending,
+                    nulls_first=item.nulls_first,
+                )
+                for item, expression in zip(self.order_by, children[partition:])
+            ),
+            frame=self.frame,
+            star=self.star,
+        )
+
+    @property
+    def is_constant(self) -> bool:
+        """Never constant: the value depends on the other rows of the window,
+        which no amount of plan-time evaluation can see."""
+
+        return False
+
+    def output_name(self) -> str:
+        """Stable name for this window's output column."""
+
+        return f"{self.name}({'*' if self.star else self._args_sql()}) over"
+
+    def _args_sql(self) -> str:
+        return ", ".join(arg.to_sql() for arg in self.args)
+
+    def to_sql(self) -> str:
+        inner = "*" if self.star else self._args_sql()
+        parts = []
+        if self.partition_by:
+            parts.append(
+                "PARTITION BY " + ", ".join(e.to_sql() for e in self.partition_by)
+            )
+        if self.order_by:
+            parts.append(
+                "ORDER BY " + ", ".join(item.to_sql() for item in self.order_by)
+            )
+        if self.frame is not None:
+            parts.append(self.frame.to_sql())
+        return f"{self.name.upper()}({inner}) OVER ({' '.join(parts)})"
+
+
