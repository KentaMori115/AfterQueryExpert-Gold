diff --git a/slateql/execution/operators/window.py b/slateql/execution/operators/window.py
new file mode 100644
index 0000000..0f2f947
--- /dev/null
+++ b/slateql/execution/operators/window.py
@@ -0,0 +1,313 @@
+"""Window function evaluation."""
+
+from __future__ import annotations
+
+from typing import Any, Iterator, Sequence
+
+from ...functions.window_defs import is_ranking, ranking_values
+from ...plan.expressions import AggregateCall, WindowCall
+from ...plan.logical import NamedExpr
+from ...types.schema import Field, Schema
+from ...util.ordering import SortKey, make_row_key
+from ..aggregators import GroupState, build_specs
+from ..batch import RecordBatch, batches_from_rows
+from ..context import ExecutionContext
+from ..evaluator import ExpressionEvaluator
+from ..keys import row_key
+from .base import Operator, UnaryOperator
+
+__all__ = ["WindowOperator"]
+
+
+class WindowOperator(UnaryOperator):
+    """Appends one column per window call to every input row.
+
+    Rows leave this operator in the order they arrived, whatever order the
+    windows themselves needed: partitioning and sorting happen over positions,
+    not over the rows, so a query without ORDER BY still reads its table the
+    way the rest of the engine promises.
+    """
+
+    def __init__(self, child: Operator, functions: Sequence[NamedExpr]) -> None:
+        super().__init__(child)
+        self._functions = tuple(functions)
+        self._schema = child.schema.merge(
+            Schema(
+                Field(name=item.name, dtype=item.expression.dtype)
+                for item in self._functions
+            )
+        )
+
+    @property
+    def schema(self) -> Schema:
+        return self._schema
+
+    def describe(self) -> str:
+        inner = ", ".join(item.describe() for item in self._functions)
+        return f"Window [{inner}]"
+
+    def execute(self, context: ExecutionContext) -> Iterator[RecordBatch]:
+        rows: list[list[Any]] = []
+        for batch in self.child.execute(context):
+            rows.extend(list(row) for row in batch.rows)
+        if not rows:
+            return
+        evaluator = ExpressionEvaluator(
+            context.registry, strict_casts=context.strict_casts
+        )
+        input_schema = self.child.schema
+        for item in self._functions:
+            values = self._compute(item, rows, input_schema, evaluator, context)
+            for row, value in zip(rows, values):
+                row.append(value)
+        for batch in batches_from_rows(self._schema, rows, context.batch_size):
+            context.metrics.record_batch(len(batch))
+            yield batch
+
+    # -- one window ------------------------------------------------------
+
+    def _compute(
+        self,
+        item: NamedExpr,
+        rows: Sequence[Sequence[Any]],
+        schema: Schema,
+        evaluator: ExpressionEvaluator,
+        context: ExecutionContext,
+    ) -> list[Any]:
+        call = item.expression
+        assert isinstance(call, WindowCall)
+        values: list[Any] = [None] * len(rows)
+        for positions in self._partitions(call, rows, schema, evaluator):
+            ordered = self._order(call, positions, rows, schema, evaluator)
+            starts = self._peer_starts(call, ordered, rows, schema, evaluator)
+            if is_ranking(call.name):
+                computed: Sequence[Any] = ranking_values(
+                    call.name, starts, len(ordered)
+                )
+            elif call.frame is not None:
+                computed = self._framed(
+                    call, ordered, starts, rows, schema, context
+                )
+            else:
+                computed = self._running(
+                    call, ordered, starts, rows, schema, context
+                )
+            for position, value in zip(ordered, computed):
+                values[position] = value
+        return values
+
+    def _partitions(
+        self,
+        call: WindowCall,
+        rows: Sequence[Sequence[Any]],
+        schema: Schema,
+        evaluator: ExpressionEvaluator,
+    ) -> list[list[int]]:
+        """Row positions grouped by partition key, NULLs grouped together."""
+
+        if not call.partition_by:
+            return [list(range(len(rows)))]
+        functions = evaluator.compile_all(list(call.partition_by), schema)
+        groups: dict[tuple, list[int]] = {}
+        order: list[tuple] = []
+        for position, row in enumerate(rows):
+            key = row_key([function(row) for function in functions])
+            bucket = groups.get(key)
+            if bucket is None:
+                bucket = []
+                groups[key] = bucket
+                order.append(key)
+            bucket.append(position)
+        return [groups[key] for key in order]
+
+    def _order(
+        self,
+        call: WindowCall,
+        positions: Sequence[int],
+        rows: Sequence[Sequence[Any]],
+        schema: Schema,
+        evaluator: ExpressionEvaluator,
+    ) -> list[int]:
+        if not call.order_by:
+            return list(positions)
+        sort_keys = [
+            SortKey(
+                getter=evaluator.compile(entry.expression, schema),
+                descending=entry.descending,
+                nulls_first=entry.nulls_first,
+            )
+            for entry in call.order_by
+        ]
+        key = make_row_key(sort_keys)
+        return sorted(positions, key=lambda position: key(rows[position]))
+
+    def _peer_starts(
+        self,
+        call: WindowCall,
+        ordered: Sequence[int],
+        rows: Sequence[Sequence[Any]],
+        schema: Schema,
+        evaluator: ExpressionEvaluator,
+    ) -> list[int]:
+        """Where each run of rows with equal ordering values begins."""
+
+        if not ordered:
+            return []
+        if not call.order_by:
+            return [0]
+        functions = evaluator.compile_all(
+            [entry.expression for entry in call.order_by], schema
+        )
+        starts = [0]
+        previous = row_key([f(rows[ordered[0]]) for f in functions])
+        for index in range(1, len(ordered)):
+            current = row_key([f(rows[ordered[index]]) for f in functions])
+            if current != previous:
+                starts.append(index)
+                previous = current
+        return starts
+
+    def _framed(
+        self,
+        call: WindowCall,
+        ordered: Sequence[int],
+        starts: Sequence[int],
+        rows: Sequence[Sequence[Any]],
+        schema: Schema,
+        context: ExecutionContext,
+    ) -> list[Any]:
+        """Fold an aggregate over an explicit frame, row by row.
+
+        A ``ROWS`` frame is counted in rows, so two rows with equal ordering
+        values sit at different positions and read different windows.  A
+        ``RANGE`` frame with a distance is measured on the single ordering
+        value: a row belongs when it sorts no later than the current row and
+        its value lies within the distance, whichever direction the ordering
+        runs; peers sort together, so the frame runs to the end of the current
+        run, and a row with no ordering value has no distance to anything but
+        its peers.  ``RANGE UNBOUNDED PRECEDING`` is the default fold spelled
+        out.  An ``EXCLUDE`` tail then removes the current row, its peers, or
+        both from whatever the frame covered; an emptied frame folds no rows.
+        """
+
+        spec = self._spec_for(call, schema, context)
+        frame = call.frame
+        reach = frame.preceding
+        run_end = self._run_ends(ordered, starts)
+        run_start = self._run_starts(ordered, starts)
+        keys: list[Any] = []
+        if frame.by_value and reach is not None:
+            entry = call.order_by[0]
+            evaluator = ExpressionEvaluator(
+                context.registry, strict_casts=context.strict_casts
+            )
+            getter = evaluator.compile(entry.expression, schema)
+            keys = [getter(rows[position]) for position in ordered]
+        out: list[Any] = []
+        for position in range(len(ordered)):
+            if not frame.by_value:
+                first = 0 if reach is None else max(0, position - reach)
+                last = position
+            else:
+                last = run_end[position]
+                if reach is None:
+                    first = 0
+                else:
+                    first = position
+                    current = keys[position]
+                    if current is not None:
+                        while first > 0 and keys[first - 1] is not None:
+                            gap = current - keys[first - 1]
+                            if call.order_by[0].descending:
+                                gap = -gap
+                            if gap > reach:
+                                break
+                            first -= 1
+                    else:
+                        first = run_start[position]
+            skipped: set[int] = set()
+            if frame.exclude == "current row":
+                skipped = {position}
+            elif frame.exclude == "group":
+                skipped = set(range(run_start[position], run_end[position] + 1))
+            elif frame.exclude == "ties":
+                skipped = set(range(run_start[position], run_end[position] + 1))
+                skipped.discard(position)
+            state = GroupState([spec], ())
+            for index in range(first, last + 1):
+                if index not in skipped:
+                    state.update([spec], rows[ordered[index]])
+            out.append(state.results()[0])
+        return out
+
+    @staticmethod
+    def _run_starts(ordered: Sequence[int], starts: Sequence[int]) -> list[int]:
+        """For every position, where its run of peers begins."""
+
+        out = [0] * len(ordered)
+        for begin in starts:
+            for index in range(begin, len(ordered)):
+                out[index] = begin
+        return out
+
+    @staticmethod
+    def _run_ends(ordered: Sequence[int], starts: Sequence[int]) -> list[int]:
+        """For every position, where its run of peers ends."""
+
+        out = [len(ordered) - 1] * len(ordered)
+        boundaries = list(starts) + [len(ordered)]
+        for group in range(len(starts)):
+            for index in range(boundaries[group], boundaries[group + 1]):
+                out[index] = boundaries[group + 1] - 1
+        return out
+
+    def _spec_for(
+        self, call: WindowCall, schema: Schema, context: ExecutionContext
+    ) -> Any:
+        """The aggregate machinery for one window call, reused per fold."""
+
+        return build_specs(
+            [
+                (
+                    call.name,
+                    AggregateCall(
+                        name=call.name,
+                        args=call.args,
+                        dtype=call.dtype,
+                        star=call.star,
+                    ),
+                )
+            ],
+            schema,
+            context.registry,
+            strict_casts=context.strict_casts,
+        )[0]
+
+    def _running(
+        self,
+        call: WindowCall,
+        ordered: Sequence[int],
+        starts: Sequence[int],
+        rows: Sequence[Sequence[Any]],
+        schema: Schema,
+        context: ExecutionContext,
+    ) -> list[Any]:
+        """Fold an aggregate over the partition, one peer group at a time.
+
+        Without ORDER BY the whole partition is one group, so every row sees
+        the same total.  With ORDER BY the fold stops at the end of the current
+        peer group, which is why tied rows still share a value.
+        """
+
+        spec = self._spec_for(call, schema, context)
+        state = GroupState([spec], ())
+        out: list[Any] = [None] * len(ordered)
+        boundaries = list(starts) + [len(ordered)]
+        for group in range(len(starts)):
+            begin, end = boundaries[group], boundaries[group + 1]
+            for index in range(begin, end):
+                state.update([spec], rows[ordered[index]])
+            value = state.results()[0]
+            for index in range(begin, end):
+                out[index] = value
+        return out
