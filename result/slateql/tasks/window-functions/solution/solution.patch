+        value = token.value
+        if (
+            token.type is not TokenType.NUMBER
+            or isinstance(value, bool)
+            or (not by_value and not isinstance(value, int))
+        ):
+            what = "a number" if by_value else "an integer"
+            raise self._error(f"frame bound requires {what} or UNBOUNDED")
+        if value < 0:
+            raise self._error("frame bound must not be negative")
+        self._advance()
+        self._expect_keyword("PRECEDING")
+        return value
 
