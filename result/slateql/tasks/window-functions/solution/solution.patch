+        """The optional ``EXCLUDE`` tail of a frame."""
+
+        if not self._match_keyword("EXCLUDE"):
+            return None
+        if self._match_keyword("CURRENT"):
+            self._expect_keyword("ROW")
+            return "current row"
+        if self._match_keyword("GROUP"):
+            return "group"
+        if self._match_keyword("TIES"):
+            return "ties"
+        if self._match_keyword("NO"):
+            self._expect_keyword("OTHERS")
+            return None
+        raise self._error("EXCLUDE requires CURRENT ROW, GROUP, TIES or NO OTHERS")
