diff --git a/slateql/analyze/windows.py b/slateql/analyze/windows.py
new file mode 100644
index 0000000..fb3ed28
--- /dev/null
+++ b/slateql/analyze/windows.py
@@ -0,0 +1,59 @@
+"""Window extraction and rewriting.
+
+Window functions are computed after grouping and filtering but before the
+select list is projected, so the binder lifts every ``OVER`` call out of the
+expression that contains it and leaves a reference to the column a
+:class:`~slateql.plan.logical.Window` node produces.  That is the shape the
+aggregate rewriter already uses, for the same reason: whatever computes a
+value has to sit below whatever reads it.
+"""
+
+from __future__ import annotations
+
+from typing import Iterable
+
+from ..plan.expressions import Column, Expr, WindowCall
+from ..plan.logical import NamedExpr
+
+__all__ = ["WindowRewriter"]
+
+
+class WindowRewriter:
+    """Maps window calls onto the columns a Window node appends."""
+
+    def __init__(self, taken: Iterable[str] = ()) -> None:
+        self._functions: list[NamedExpr] = []
+        self._lookup: dict[WindowCall, Column] = {}
+        self._used_names: set[str] = set(taken)
+
+    @property
+    def functions(self) -> tuple[NamedExpr, ...]:
+        """The calls collected so far, in first-appearance order."""
+
+        return tuple(self._functions)
+
+    def rewrite(self, expression: Expr) -> Expr:
+        """Replace every window call inside ``expression`` with a reference."""
+
+        return expression.transform(self._substitute)
+
+    def _substitute(self, node: Expr) -> Expr:
+        if not isinstance(node, WindowCall):
+            return node
+        existing = self._lookup.get(node)
+        if existing is not None:
+            return existing
+        unique = self._unique_name(node.output_name())
+        reference = Column(name=unique, dtype=node.dtype)
+        self._functions.append(NamedExpr(expression=node, name=unique))
+        self._lookup[node] = reference
+        return reference
+
+    def _unique_name(self, name: str) -> str:
+        candidate = name
+        suffix = 2
+        while candidate in self._used_names:
+            candidate = f"{name}#{suffix}"
+            suffix += 1
+        self._used_names.add(candidate)
+        return candidate
