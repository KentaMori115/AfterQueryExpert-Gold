--- /dev/null
+++ b/slateql/functions/window_defs.py
@@ -0,0 +1,58 @@
+"""Ranking window functions.
+
+A ranking function has no meaning for a single row, so it is not part of the
+registry the binder consults for ordinary call sites: ``ROW_NUMBER()`` without
+``OVER`` stays an unknown function.  Everything else that may carry an ``OVER``
+clause is an ordinary aggregate, folded over the rows of a window instead of
+over the rows of a group.
+"""
+
+from __future__ import annotations
+
+from typing import Sequence
+
+from ..errors import BindingError
+from ..types.datatypes import INTEGER, DataType
+
+__all__ = [
+    "RANKING_FUNCTIONS",
+    "is_ranking",
+    "ranking_return_type",
+    "ranking_values",
+]
+
+RANKING_FUNCTIONS = ("row_number", "rank", "dense_rank")
+
+
+def is_ranking(name: str) -> bool:
+    """Whether ``name`` is one of the ranking functions."""
+
+    return name.lower() in RANKING_FUNCTIONS
+
+
+def ranking_return_type(name: str, argument_count: int, *, star: bool) -> DataType:
+    """Type of a ranking call, rejecting arguments it cannot take."""
+
+    if star or argument_count:
+        raise BindingError(f"{name}() takes no arguments")
+    return INTEGER.as_nullable(False)
+
+
+def ranking_values(name: str, peer_starts: Sequence[int], size: int) -> list[int]:
+    """Rank of every row of one partition, in window order.
+
+    ``peer_starts`` holds the position where each peer group begins.  Peers are
+    what separates the three functions: ROW_NUMBER ignores them, RANK hands
+    every peer the position its group started at, DENSE_RANK counts groups.
+    """
+
+    key = name.lower()
+    if key == "row_number":
+        return list(range(1, size + 1))
+    values = [0] * size
+    for group, start in enumerate(peer_starts):
+        end = peer_starts[group + 1] if group + 1 < len(peer_starts) else size
+        value = group + 1 if key == "dense_rank" else start + 1
+        for position in range(start, end):
+            values[position] = value
+    return values
