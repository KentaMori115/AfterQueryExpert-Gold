+            TakeSlot(
+                scene_id=scene.id,
+                start_seconds=scene.start_seconds,
+                scene_seconds=scene.duration_seconds,
+                request=request.for_scene(scene.id, scene.voiceover, scene.duration_seconds),
+            )
+        )
+    return cut
