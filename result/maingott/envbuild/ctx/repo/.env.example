OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VIDEO_MODEL=sora-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_REASONING_EFFORT=
OPENAI_TEMPERATURE=
INPUT_ROOT=input
OUTPUT_ROOT=output
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
DEFAULT_REEL_DURATION=40
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
LOG_LEVEL=INFO
LOG_FORMAT=console
REEL_LANGUAGE=ru
VOICE_PROVIDER=openai
VOICE_NAME=marin
VOICE_FORMAT=wav
# Leave empty to narrate in the approved plan's language.
VOICE_LANGUAGE=
# Overrides prompts/voice/narration.md. Delivery only, never the words.
VOICE_INSTRUCTIONS=
VOICE_SPEED=
# fail | regenerate — what to do when the narration overruns the timeline.
VOICE_FIT_STRATEGY=fail
VOICE_MIN_SPEED=0.9
VOICE_MAX_SPEED=1.2
# --- Cost control ---
# Verified provider prices. Copy input/pricing.example.json and fill it in;
# without it every cost is reported as COST UNKNOWN.
PRICING_FILE=
# Maximum estimated spend per generation command. Empty means no budget, and
# no budget means no protection: generation proceeds and reports the cost.
MAX_GENERATION_COST=
# --- Release ---
BRAND_REGISTRY=
VOICE_PROFILE=
RELEASE_VERSION=v1.0.0
REQUIRE_MUSIC=false
PLANNER_BEAT_COUNT=8
PLANNER_MAX_FACTS=90
PLANNER_MAX_ATTEMPTS=3
ALLOW_TARGET_FACTS=false
