index 0000000..926ded3
--- /dev/null
+++ b/src/signalbox/cli/commands/restrictions.py
@@ -0,0 +1,80 @@
+"""The restrictions command: what is slacked, and where the boards go."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import typer
+
+from ...signalling.restriction import approach_for
+from ..common import EXIT_FINDINGS, EXIT_OK, console, grid, load
+
+
+def restrictions(
+    plan: Path = typer.Argument(..., help="the scheme plan to read"),
+    boards: bool = typer.Option(
+        False, "--boards", help="print the warning boards on their own"
+    ),
+) -> None:
+    """List the temporary speed restrictions and the braking each one needs."""
+    scheme = load(plan)
+    if not scheme.restrictions:
+        console.print("nothing is restricted")
+        raise typer.Exit(EXIT_OK)
+
+    rows = []
+    short = 0
+    for name in sorted(scheme.restrictions):
+        restriction = scheme.restriction(name)
+        approach = approach_for(scheme, restriction)
+        if not approach.has_room:
+            short += 1
+        where = str(approach.board) if approach.board is not None else "no room"
+        rows.append(
+            [
+                name,
+                restriction.edge,
+                f"{restriction.offset.metres:.0f}m",
+                f"{restriction.covered.metres:.0f}m",
+                str(restriction.speed),
+                ", ".join(restriction.edges),
+                f"{approach.distance.metres:.0f}m",
+                where,
+                restriction.reason,
+            ]
+        )
+
+    if boards:
+        console.print(
+            grid(
+                f"warning boards in {plan.name}",
+                ["restriction", "speed", "braking", "board"],
+                [[row[0], row[4], row[6], row[7]] for row in rows],
+            )
+        )
+    else:
+        console.print(
+            grid(
+                f"restrictions in {plan.name}",
+                [
+                    "name",
+                    "edge",
+                    "at",
+                    "length",
+                    "speed",
+                    "over",
+                    "braking",
+                    "board",
+                    "reason",
+                ],
+                rows,
+            )
+        )
+
+    if short:
+        console.print(f"{short} of {len(rows)} have no room to brake")
+        raise typer.Exit(EXIT_FINDINGS)
+
+
+def register(app: typer.Typer) -> None:
+    app.command()(restrictions)
