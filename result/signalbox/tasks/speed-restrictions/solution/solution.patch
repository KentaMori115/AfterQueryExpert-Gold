index 0000000..86aaf45
--- /dev/null
+++ b/src/signalbox/verify/checks/restriction.py
@@ -0,0 +1,36 @@
+"""Temporary speed restrictions, and whether a train can be got down to one.
+
+A slack is only as good as its approach. Put one on a scheme and the braking
+that clears it has to happen on track that is inside the scheme, at the rate
+the scheme is drawn to, on the gradient the train is actually on. A restriction
+with less track behind it than that is one a driver cannot honour.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterator
+
+from ...signalling.restriction import approach_for
+from ..report import Finding, Severity
+from ..rules import Context, rule
+
+
+@rule("restriction-room", "there is room to brake for a restriction", Severity.ERROR)
+def restrictions_have_room_to_brake(context: Context) -> Iterator[Finding]:
+    scheme = context.scheme
+    for name in sorted(scheme.restrictions):
+        restriction = scheme.restriction(name)
+        approach = approach_for(scheme, restriction, model=context.braking)
+        if approach.has_room:
+            continue
+        yield Finding(
+            rule="restriction-room",
+            severity=Severity.ERROR,
+            subject=name,
+            message=(
+                f"{approach.distance.metres:.0f}m wanted to come from "
+                f"{approach.from_speed} to {approach.to_speed}, and the scheme "
+                f"runs out first"
+            ),
+            detail=f"braking worked at {approach.gradient}",
+        )
