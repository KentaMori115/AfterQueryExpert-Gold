new file mode 100644
index 0000000..0a2c9e0
--- /dev/null
+++ b/src/signalbox/signalling/restriction.py
@@ -0,0 +1,351 @@
+"""Temporary speed restrictions, what they cover, and the braking they impose.
+
+A slack is a piece of track worth less than the line speed for as long as
+somebody says so. It is written in the plan as a place and a length, and the
+length is what makes it awkward: a restriction rarely stops where a piece of
+track does, so working out what it actually covers means walking the graph from
+where it starts until the length is used up or the track runs out.
+
+Two things follow from one. A train may not exceed the restricted speed
+anywhere inside the extent, and a train has to be brought down to it before the
+first metre of it, which needs a warning board far enough back for the braking
+to be done at the rate the scheme is drawn to.
+
+How far back is not one number. Braking distance depends on the gradient of the
+track a train brakes over, and a run of any length is over several gradients, so
+the answer is worked backwards a stretch at a time: at the far end of each piece
+of track the train has to be doing whatever leaves it at the right speed by the
+near end, and the braking begins wherever that reaches line speed.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from itertools import pairwise
+from typing import TYPE_CHECKING
+
+from ..layout.ast import RestrictionDecl
+from ..topology.graph import Sense, TrackGraph
+from ..topology.position import Position, advance
+from ..topology.traverse import walk
+from ..units import Distance, Gradient, Speed
+from .braking import BrakingModel
+
+if TYPE_CHECKING:  # pragma: no cover
+    from ..topology.scheme import Scheme
+
+#: How far back to look for room to brake before giving up on a restriction.
+APPROACH_SEARCH = Distance(6000.0)
+
+
+@dataclass(frozen=True)
+class Piece:
+    """The part of one edge a restriction covers, in that edge's own metres."""
+
+    edge: str
+    start: Distance
+    end: Distance
+
+    @property
+    def length(self) -> Distance:
+        return Distance(self.end.metres - self.start.metres)
+
+    def holds(self, edge: str, offset: Distance) -> bool:
+        if edge != self.edge:
+            return False
+        return self.start.metres <= offset.metres <= self.end.metres
+
+    def whole_of(self, length: Distance) -> bool:
+        """Whether this piece is the whole of an edge that long."""
+        return self.start.metres <= 0.0 and self.end.metres >= length.metres
+
+    def __str__(self) -> str:
+        return f"{self.edge} {self.start.metres:.0f}m to {self.end.metres:.0f}m"
+
+
+@dataclass(frozen=True)
+class Restriction:
+    """One temporary speed restriction, and the track it turned out to cover."""
+
+    name: str
+    edge: str
+    offset: Distance
+    length: Distance
+    speed: Speed
+    pieces: tuple[Piece, ...] = ()
+    attributes: dict[str, str] = field(default_factory=dict)
+
+    @property
+    def reason(self) -> str:
+        return self.attributes.get("reason", "")
+
+    @property
+    def edges(self) -> tuple[str, ...]:
+        return tuple(piece.edge for piece in self.pieces)
+
+    @property
+    def covered(self) -> Distance:
+        """How much track the extent actually reached, which is less where it ran out."""
+        return Distance(sum(piece.length.metres for piece in self.pieces))
+
+    @property
+    def truncated(self) -> bool:
+        return self.covered.metres + 1e-9 < self.length.metres
+
+    def covers(self, edge: str, offset: Distance) -> bool:
+        """Whether a place on the layout is inside the restricted stretch."""
+        return any(piece.holds(edge, offset) for piece in self.pieces)
+
+    def entry(self) -> Position:
+        """Where a train running the way the edge is drawn meets the slack."""
+        return Position(self.edge, self.offset, Sense.NOMINAL)
+
+    def __str__(self) -> str:
+        return (
+            f"{self.name}: {self.edge} at {self.offset.metres:.0f}m for "
+            f"{self.length.metres:.0f}m at {self.speed}"
+        )
+
+
+def extent(
+    graph: TrackGraph, edge: str, offset: Distance, length: Distance
+) -> tuple[Piece, ...]:
+    """The pieces of track a restriction covers, in the order a train meets them.
+
+    The walk runs the way the first edge is drawn, over as much track as the
+    length asks for, following the points as they lie normal. Where the track
+    runs out first the extent stops there.
+    """
+    pieces: list[Piece] = []
+    start = Position(edge, offset, Sense.NOMINAL)
+
+    for step in walk(graph, start, limit=length):
+        left = length.metres - step.travelled.metres
+        if left <= 0.0:
+            break
+        here = step.position
+        reach = min(here.remaining(graph).metres, left)
+        if reach <= 0.0:
+            continue
+        if here.sense is Sense.NOMINAL:
+            piece = Piece(here.edge, here.offset, Distance(here.offset.metres + reach))
+        else:
+            piece = Piece(here.edge, Distance(here.offset.metres - reach), here.offset)
+        pieces.append(piece)
+
+    return tuple(pieces)
+
+
+def restriction_from(decl: RestrictionDecl, graph: TrackGraph) -> Restriction:
+    """Read a restriction off its declaration and work out what it covers."""
+    offset = Distance(decl.offset_metres)
+    length = Distance(decl.length_metres)
+    return Restriction(
+        name=decl.name,
+        edge=decl.edge,
+        offset=offset,
+        length=length,
+        speed=Speed.from_mph(decl.speed_mph),
+        pieces=extent(graph, decl.edge, offset, length),
+        attributes=dict(decl.attributes),
+    )
+
+
+def over(
+    restrictions: dict[str, Restriction], edge: str, offset: Distance
+) -> list[Restriction]:
+    """Every restriction covering one place, slowest first then by name."""
+    found = [r for r in restrictions.values() if r.covers(edge, offset)]
+    return sorted(found, key=lambda r: (r.speed.mps, r.name))
+
+
+def restricted_speed(
+    restrictions: dict[str, Restriction],
+    edge: str,
+    offset: Distance,
+    line: Speed | None = None,
+) -> Speed | None:
+    """The lowest of the line speed and every restriction over one place."""
+    speeds = [r.speed for r in over(restrictions, edge, offset)]
+    if line is not None:
+        speeds.append(line)
+    if not speeds:
+        return None
+    return min(speeds, key=lambda s: s.mps)
+
+
+def _cuts(restrictions: dict[str, Restriction], edge: str, length: Distance) -> list[float]:
+    """Where the permissible speed along one edge can change."""
+    marks = {0.0, length.metres}
+    for restriction in restrictions.values():
+        for piece in restriction.pieces:
+            if piece.edge != edge:
+                continue
+            marks.add(min(max(piece.start.metres, 0.0), length.metres))
+            marks.add(min(max(piece.end.metres, 0.0), length.metres))
+    return sorted(marks)
+
+
+def _along(
+    restrictions: dict[str, Restriction], edge: str, length: Distance, line: Speed | None
+) -> list[Speed]:
+    """The permissible speed of each stretch of one edge, in order."""
+    found: list[Speed] = []
+    for before, after in pairwise(_cuts(restrictions, edge, length)):
+        if after <= before:
+            continue
+        middle = Distance((before + after) / 2.0)
+        here = restricted_speed(restrictions, edge, middle, line)
+        if here is not None:
+            found.append(here)
+    return found
+
+
+def fastest_on(
+    restrictions: dict[str, Restriction],
+    edge: str,
+    length: Distance,
+    line: Speed | None,
+) -> Speed | None:
+    """The highest speed permitted anywhere along one edge.
+
+    A restriction over part of an edge leaves the rest of it at line speed, so
+    this only drops where the restrictions between them cover the whole of it.
+    """
+    stretches = _along(restrictions, edge, length, line)
+    if not stretches:
+        return line
+    return max(stretches, key=lambda s: s.mps)
+
+
+def slowest_on(
+    restrictions: dict[str, Restriction],
+    edge: str,
+    length: Distance,
+    line: Speed | None,
+) -> Speed | None:
+    """The lowest speed permitted anywhere along one edge."""
+    stretches = _along(restrictions, edge, length, line)
+    if not stretches:
+        return line
+    return min(stretches, key=lambda s: s.mps)
+
+
+@dataclass(frozen=True)
+class Approach:
+    """The braking run a train makes on its way into a restriction."""
+
+    restriction: str
+    from_speed: Speed
+    to_speed: Speed
+    distance: Distance
+    gradient: Gradient
+    board: Position | None = None
+
+    @property
+    def has_room(self) -> bool:
+        """Whether the scheme holds enough track in rear to do the braking."""
+        return self.board is not None
+
+    @property
+    def needed(self) -> bool:
+        """Whether the restriction asks a train to slow down at all."""
+        return self.to_speed.mps < self.from_speed.mps
+
+    def describe(self) -> str:
+        where = str(self.board) if self.board is not None else "off the end of the scheme"
+        return (
+            f"{self.from_speed} to {self.to_speed} in "
+            f"{self.distance.metres:.0f}m at {self.gradient}, board at {where}"
+        )
+
+    def __str__(self) -> str:
+        return f"{self.restriction}: {self.describe()}"
+
+
+def _met_by_a_train(edge_gradient: Gradient, walked: Sense) -> Gradient:
+    """The gradient a train meets, given the sense the walk back used.
+
+    Gradients are written for the down direction, so a train running against the
+    way an edge was drawn climbs where the edge falls. The walk goes the
+    opposite way to the train, which puts the train on the sense the step did
+    not use.
+    """
+    if walked is Sense.REVERSE or edge_gradient.one_in == float("inf"):
+        return edge_gradient
+    return Gradient(-edge_gradient.one_in)
+
+
+def _worse(first: Gradient, second: Gradient) -> Gradient:
+    """Of two gradients, the one that helps braking least."""
+    return second if second.per_mille < first.per_mille else first
+
+
+def approach_for(
+    scheme: Scheme,
+    restriction: Restriction,
+    *,
+    model: BrakingModel | None = None,
+    search: Distance = APPROACH_SEARCH,
+) -> Approach:
+    """Work out the braking run into ``restriction`` and where its board goes.
+
+    The braking is worked backwards from the first restricted metre over the
+    track a train actually runs on. At the far end of each stretch the train has
+    to be doing whatever leaves it at the right speed by the near end, which is
+    what the stretch's own gradient decides, and the run ends inside the stretch
+    where that speed reaches line speed. A reaction allowance at line speed goes
+    in rear of all that, and the board stands at the end of it.
+
+    Where the track behind runs out before the train is back at line speed there
+    is nowhere to put a board, and the approach says so.
+    """
+    graph = scheme.graph
+    model = model or BrakingModel(
+        rate=scheme.standards.braking, reaction=scheme.standards.reaction
+    )
+    line = graph.edge(restriction.edge).speed
+    entry = restriction.entry()
+
+    if line is None or line.mps <= restriction.speed.mps:
+        return Approach(
+            restriction=restriction.name,
+            from_speed=line or restriction.speed,
+            to_speed=restriction.speed,
+            distance=Distance(0.0),
+            gradient=Gradient.level(),
+            board=entry,
+        )
+
+    here = restriction.speed
+    worst = Gradient.level()
+    braking = 0.0
+
+    for step in walk(graph, entry.reversed, limit=search):
+        gradient = _met_by_a_train(graph.edge(step.edge).gradient, step.sense)
+        worst = _worse(worst, gradient)
+        stretch = step.remaining(graph)
+        reached = model.speed_before(here, stretch, gradient)
+        if reached.mps >= line.mps:
+            braking += model.distance_from(line, here, gradient).metres
+            wanted = Distance(braking + line.mps * model.reaction)
+            board = advance(graph, entry.reversed, wanted)
+            return Approach(
+                restriction=restriction.name,
+                from_speed=line,
+                to_speed=restriction.speed,
+                distance=wanted,
+                gradient=worst,
+                board=board.reversed if board is not None else None,
+            )
+        braking += stretch.metres
+        here = reached
+
+    return Approach(
+        restriction=restriction.name,
+        from_speed=line,
+        to_speed=restriction.speed,
+        distance=Distance(braking + line.mps * model.reaction),
+        gradient=worst,
+        board=None,
+    )
