+  /** The firing table this show compiles to, as the panel would load it. */
+  function tableRows(): string[][] {
+    const out = envWith();
+    main(["table", "autumn.pf", ...base], out);
+    return out.stdout
+      .split("\n")
+      .slice(1)
+      .map((line) => line.split(","));
+  }
+
+  /** A log of that table, optionally with the first cue late and cues dropped. */
+  function logOf(shift = 0, drop = 0): string {
+    const rows = tableRows()
+      .slice(0, drop === 0 ? undefined : -drop)
+      .map((row, index) => {
+        const time = row[1] ?? "";
+        const millis =
+          Number(time.split(":")[0]) * 60000 +
+          Number(time.split(":")[1]) * 1000 +
+          (index === 0 ? shift : 0);
+        return `${row[2]},${Math.floor(millis / 60000)}:${((millis % 60000) / 1000).toFixed(3).padStart(6, "0")}`;
+      });
+    return ["pin,fired at", ...rows].join("\n");
+  }
+
+  it("passes a run that did what the table said", () => {
+    const env = envWith({ "log.csv": logOf() });
+    expect(
+      main(["rehearse", "autumn.pf", "--log", "log.csv", ...base], env),
+    ).toBe(EXIT_OK);
+    expect(env.stdout).toContain("verdict");
+    expect(env.stdout).toContain("on time");
+    expect(env.stdout).toContain("0 late");
+    expect(env.stderr).toBe("");
+  });
+
+  it("fails a log missing a cue and names it", () => {
+    const env = envWith({ "log.csv": logOf(0, 1) });
+    expect(
+      main(["rehearse", "autumn.pf", "--log", "log.csv", ...base], env),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stdout).toContain("1 missed");
+    expect(env.stderr).toContain("PF3800");
+  });
+
+  it("warns about a cue that fired late without failing the run", () => {
+    const env = envWith({ "log.csv": logOf(400) });
+    expect(
+      main(["rehearse", "autumn.pf", "--log", "log.csv", ...base], env),
+    ).toBe(EXIT_OK);
+    expect(env.stdout).toContain("1 late");
+    expect(env.stdout).toContain("worst");
+    expect(env.stderr).toContain("PF3802");
+  });
+
+  it("takes a tolerance wide enough to forgive it", () => {
+    const env = envWith({ "log.csv": logOf(400) });
+    main(
+      [
+        "rehearse",
+        "autumn.pf",
+        "--log",
+        "log.csv",
+        "--tolerance",
+        "500",
+        ...base,
+      ],
+      env,
+    );
+    expect(env.stdout).toContain("0 late");
+    expect(env.stderr).toBe("");
+  });
+
+  it("refuses a nonsense tolerance", () => {
+    const env = envWith({ "log.csv": logOf() });
+    expect(
+      main(
+        [
+          "rehearse",
+          "autumn.pf",
+          "--log",
+          "log.csv",
+          "--tolerance",
+          "soon",
+          ...base,
+        ],
+        env,
+      ),
+    ).toBe(EXIT_BAD_USAGE);
+  });
+
+  it("fails a log of a pin the show never fires", () => {
+    const env = envWith({
+      "log.csv": ["pin,fired", "02.31,0:20.000"].join("\n"),
+    });
+    expect(
+      main(["rehearse", "autumn.pf", "--log", "log.csv", ...base], env),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("PF3801");
+  });
+
+  it("reports a log it cannot read at all", () => {
+    const env = envWith();
+    expect(
+      main(["rehearse", "autumn.pf", "--log", "gone.csv", ...base], env),
+    ).toBe(EXIT_BAD_USAGE);
+    expect(env.stderr).toContain("cannot read the log");
+  });
+
+  it("says what is wrong with a log that has no time column", () => {
+    const env = envWith({ "log.csv": "pin,ohms\n01.01,4.7" });
+    expect(
+      main(["rehearse", "autumn.pf", "--log", "log.csv", ...base], env),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("PF1420");
+  });
+
+  it("writes the grade to a file and the findings to standard error", () => {
+    const env = envWith({ "log.csv": logOf(400) });
+    main(
+      [
+        "rehearse",
+        "autumn.pf",
+        "--log",
+        "log.csv",
+        "--out",
+        "grade.txt",
+        ...base,
+      ],
+      env,
+    );
+    expect(env.written.get("grade.txt")).toContain("verdict");
+    expect(env.stdout).toContain("to grade.txt");
+    expect(env.stdout).not.toContain("PF3802");
+    expect(env.stderr).toContain("PF3802");
+  });
+});
