+import { describe, expect, it } from "vitest";
+import { calibre } from "../../src/catalog/calibre.js";
+import { shell } from "../../src/catalog/effect.js";
+import { Catalog } from "../../src/catalog/registry.js";
+import {
+  checkLog,
+  describeGrade,
+  formatOffset,
+  gradeLog,
+  parsePanelLog,
+  summariseGrade,
+} from "../../src/timeline/rehearsal.js";
+import { allocatePins } from "../../src/rig/allocate.js";
+import { firingModule, modelNamed } from "../../src/rig/module.js";
+import { pinAddress } from "../../src/rig/pin.js";
+import { Rig, firingPosition } from "../../src/rig/rig.js";
+import { expandScript } from "../../src/script/expand.js";
+import { parseScript } from "../../src/script/parser.js";
+import { resolveShots } from "../../src/script/resolve.js";
+import { buildSchedule } from "../../src/timeline/schedule.js";
+import { quantiseSchedule } from "../../src/timeline/quantise.js";
+import { effectId, positionId } from "../../src/core/ids.js";
+import { SourceFile } from "../../src/core/span.js";
+import { SMPTE_24, SMPTE_25 } from "../../src/core/timecode.js";
+import { mm, ms, raw } from "../../src/core/units.js";
+import type { Milliseconds } from "../../src/core/units.js";
+import type { PanelLogRow } from "../../src/timeline/rehearsal.js";
+
+/**
+ * Grading the panel's own account of a run.
+ *
+ * The times in here are worked out from the schedule rather than typed in, so
+ * a change to the lift table moves the log with it and the test still says
+ * what it means to be a frame late.
+ */
+
+const catalog = Catalog.from([
+  shell({ id: effectId("s"), name: "s", calibre: calibre(mm(75)) }),
+]);
+
+const rig = Rig.from(
+  [firingPosition(positionId("pad.a"), 0, 0)],
+  [firingModule(1, modelNamed("slat-50")!, positionId("pad.a"))],
+);
+
+function scheduleOf(source: string) {
+  const parsed = parseScript(new SourceFile("show.pf", source));
+  const expanded = expandScript(parsed.script.statements, { seed: "t" });
+  const resolved = resolveShots(expanded.shots, catalog, rig);
+  expect(resolved.diagnostics.errorCount).toBe(0);
+  return buildSchedule(
+    allocatePins(resolved.shots, rig, { packTight: true }).assignments,
+  );
+}
+
+const built = scheduleOf(
+  ["at 20 fire s from pad.a", "at 30 fire s from pad.a"].join("\n"),
+);
+
+/** A log that says every cue went exactly when the table asked. */
+function perfectLog(
+  schedule = built,
+  slip: readonly number[] = [],
+): PanelLogRow[] {
+  return schedule.events.map((event, index) => ({
+    address: event.address,
+    at: ms(raw(event.ignitionAt) + raw(schedule.preRoll) + (slip[index] ?? 0)),
+    line: index + 2,
+  }));
+}
+
+describe("parsePanelLog", () => {
+  it("reads the log the panel writes", () => {
+    const log = parsePanelLog(
+      ["pin,fired", "01.01,0.000", "01.02,11.990"].join("\n"),
+      "log.csv",
+    );
+    expect(log.diagnostics.size).toBe(0);
+    expect(log.rows).toHaveLength(2);
+    expect(log.rows[0]?.address).toEqual(pinAddress(1, 1));
+    expect(raw(log.rows[1]?.at as Milliseconds)).toBe(11990);
+    expect(log.rows[1]?.line).toBe(3);
+  });
+
+  it("takes any of the pin column spellings the walk takes", () => {
+    for (const header of ["pin", "address", "cue", "output"]) {
+      const log = parsePanelLog(`${header},time\n01.01,4.0`, "log.csv");
+      expect(log.rows).toHaveLength(1);
+    }
+  });
+
+  it("takes any of the time column spellings", () => {
+    for (const header of ["time", "fired", "at", "fired at", "cue time"]) {
+      const log = parsePanelLog(`pin,${header}\n01.01,4.0`, "log.csv");
+      expect(log.diagnostics.size).toBe(0);
+      expect(log.rows).toHaveLength(1);
+    }
+  });
+
+  it("refuses a log with no time column at all", () => {
+    const log = parsePanelLog("pin,ohms\n01.01,4.7", "log.csv");
+    expect(log.rows).toHaveLength(0);
+    expect(log.diagnostics.hasErrors()).toBe(true);
+    expect(log.diagnostics.all()[0]?.code).toBe("PF1420");
+  });
+
+  it("skips a row with no readable pin and says which line", () => {
+    const log = parsePanelLog(
+      ["pin,time", "01.01,4.0", "nonsense,5.0"].join("\n"),
+      "log.csv",
+    );
+    expect(log.rows).toHaveLength(1);
+    expect(log.diagnostics.all()[0]?.code).toBe("PF1421");
+    expect(log.diagnostics.all()[0]?.message).toContain("line 3");
+  });
+
+  it("skips a row with no readable time", () => {
+    const log = parsePanelLog(
+      ["pin,time", "01.01,soon", "01.02,"].join("\n"),
+      "log.csv",
+    );
+    expect(log.rows).toHaveLength(0);
+    expect(log.diagnostics.errorCount).toBe(2);
+    expect(log.diagnostics.all()[0]?.message).toContain("soon");
+    expect(log.diagnostics.all()[1]?.message).toContain("(blank)");
+  });
+});
+
+describe("gradeLog", () => {
+  it("passes a run that did what the table said", () => {
+    const grade = gradeLog(built, perfectLog());
+    expect(grade.fired).toHaveLength(2);
+    expect(grade.missed).toHaveLength(0);
+    expect(grade.extra).toHaveLength(0);
+    expect(grade.late).toHaveLength(0);
+    expect(grade.early).toHaveLength(0);
+    expect(grade.worst).toBeUndefined();
+  });
+
+  it("keeps the fired list in table order", () => {
+    const rows = [...perfectLog()].reverse();
+    const grade = gradeLog(built, rows);
+    expect(grade.fired.map((match) => match.event.address)).toEqual(
+      built.events.map((event) => event.address),
+    );
+  });
+
+  it("counts the log time as a show time plus the pre roll", () => {
+    const early = scheduleOf("at 1 fire s from pad.a");
+    expect(raw(early.preRoll)).toBeGreaterThan(0);
+    const grade = gradeLog(early, perfectLog(early));
+    expect(raw(grade.fired[0]?.offset as Milliseconds)).toBe(0);
+    expect(raw(grade.preRoll)).toBe(raw(early.preRoll));
+    // The same log read without the shift would be a whole pre roll early.
+    const naive = gradeLog(early, [
+      {
+        ...(perfectLog(early)[0] as PanelLogRow),
+        at: early.events[0]!.ignitionAt,
+      },
+    ]);
+    expect(raw(naive.fired[0]?.offset as Milliseconds)).toBe(
+      -raw(early.preRoll),
+    );
+  });
+
+  it("calls a slip past the tolerance late, with a positive offset", () => {
+    const grade = gradeLog(built, perfectLog(built, [0, 300]));
+    expect(grade.late).toHaveLength(1);
+    expect(grade.early).toHaveLength(0);
+    expect(raw(grade.late[0]?.offset as Milliseconds)).toBe(300);
+    expect(grade.worst?.row.address).toEqual(pinAddress(1, 2));
+  });
+
+  it("calls a cue that came up before its time early", () => {
+    const grade = gradeLog(built, perfectLog(built, [-300, 0]));
+    expect(grade.early).toHaveLength(1);
+    expect(raw(grade.early[0]?.offset as Milliseconds)).toBeLessThan(0);
+    expect(grade.worst?.row.address).toEqual(pinAddress(1, 1));
+  });
+
+  it("keeps the furthest out as the worst either way", () => {
+    const grade = gradeLog(built, perfectLog(built, [-500, 300]));
+    expect(grade.late).toHaveLength(1);
+    expect(grade.early).toHaveLength(1);
+    expect(raw(grade.worst?.offset as Milliseconds)).toBe(-500);
+  });
+
+  it("lets a frame of slip pass on a schedule that carries a frame", () => {
+    const quantised = quantiseSchedule(built, SMPTE_25);
+    const grade = gradeLog(quantised, perfectLog(quantised, [40, -40]));
+    expect(raw(grade.tolerance)).toBe(40);
+    expect(grade.late).toHaveLength(0);
+    expect(grade.early).toHaveLength(0);
+  });
+
+  it("takes the frame from the options for a schedule without one", () => {
+    const grade = gradeLog(built, perfectLog(), { format: SMPTE_24 });
+    expect(Math.round(raw(grade.tolerance))).toBe(42);
+  });
+
+  it("falls back to twenty five frames when nothing says otherwise", () => {
+    expect(raw(gradeLog(built, perfectLog()).tolerance)).toBe(40);
+  });
+
+  it("takes a tolerance of its own, in either sign", () => {
+    const rows = perfectLog(built, [0, 300]);
