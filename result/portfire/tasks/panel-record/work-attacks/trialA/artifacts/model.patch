+/**
+ * Clearing the field position by position.
+ *
+ * The single clearance time is already tested above. What matters here is that
+ * a rack of ground pieces at one end of the site does not have to wait on a
+ * mortar at the other, and that the field time still comes from the longest
+ * wait anywhere.
+ */
+
+const wide = Rig.from(
+  [
+    firingPosition(positionId("pad.a"), 0, 0),
+    firingPosition(positionId("pad.b"), 60, 0),
+  ],
+  [
+    firingModule(1, modelNamed("fc-32")!, positionId("pad.a")),
+    firingModule(2, modelNamed("fc-32")!, positionId("pad.b")),
+  ],
+);
+
+const spread = scheduleOf(
+  [
+    "at 20 fire shell.150 from pad.a",
+    "at 25 fire gerb.silver from pad.b",
+    "at 30 fire shell.150 from pad.a",
+  ].join("\n"),
+  wide,
+);
+
+describe("lastLightOut", () => {
+  it("is the end of the last thing burning", () => {
+    expect(raw(lastLightOut(spread))).toBeGreaterThan(30000);
+  });
+
+  it("is nothing for a show with no events", () => {
+    expect(raw(lastLightOut({ ...spread, events: [] }))).toBe(0);
+  });
+});
+
+describe("clearancePlan", () => {
+  it("is empty and clears at nothing when everything fired", () => {
+    const plan = clearancePlan(spread, []);
+    expect(plan.positions).toEqual([]);
+    expect(raw(plan.fieldClearAt)).toBe(0);
+  });
+
+  it("gives a position its own wait and time", () => {
+    const misfires = misfiresIn(spread, [pinAddress(2, 1)]);
+    const plan = clearancePlan(spread, misfires);
+    expect(plan.positions).toHaveLength(1);
+    expect(plan.positions[0]?.position).toBe("pad.b");
+    expect(raw(plan.positions[0]!.wait)).toBe(raw(GROUND_WAIT));
+    expect(raw(plan.positions[0]!.clearAt)).toBe(
+      raw(lastLightOut(spread)) + raw(GROUND_WAIT),
+    );
+  });
+
+  it("lists the position that clears soonest first", () => {
+    const misfires = misfiresIn(spread, [pinAddress(1, 1), pinAddress(2, 1)]);
+    const plan = clearancePlan(spread, misfires);
+    expect(plan.positions.map((at) => at.position)).toEqual(["pad.b", "pad.a"]);
+    expect(raw(plan.positions[0]!.clearAt)).toBeLessThan(
