+
+/**
+ * The walk after the show, which is the one that matters.
+ *
+ * Before the show, an open pin is a cue that will not go. After the show, it
+ * is the opposite: an open pin is a match that burned, which is the whole
+ * point. A pin still reading connected at the end has an e-match on it that
+ * never fired, and somewhere out on the field there is a mortar with a shell
+ * in it. That is not paperwork, it is where the crew goes next and how long
+ * they wait before going.
+ *
+ * Reading the after walk against the before walk is what separates a misfire
+ * from a cue that was never connected in the first place. Both read connected
+ * afterwards, and only one of them is a surprise.
+ */
+
+export interface AfterWalk {
+  /** Fired by the show and still connected, so a live match is out there. */
+  readonly misfired: readonly PinAddress[];
+  /** Still connected and open before the show, so it never had a circuit. */
+  readonly dead: readonly PinAddress[];
+  /** Fired by the show and never reported after, so nobody knows. */
+  readonly unknown: readonly PinAddress[];
+  /** Shorted after the show, which reads as neither fired nor connected. */
+  readonly shorted: readonly PinAddress[];
+  /** Fired by the show and reads open, which is what should happen. */
+  readonly fired: readonly PinAddress[];
+  /** Outside the show, connected before and open after, so something fired. */
+  readonly burnt: readonly PinAddress[];
+}
+
+function firstByPin(
+  rows: readonly ContinuityRow[],
+): Map<string, ContinuityRow> {
+  const found = new Map<string, ContinuityRow>();
+  for (const row of rows) {
+    const key = pinKey(row.address);
+    if (!found.has(key)) {
+      found.set(key, row);
+    }
+  }
+  return found;
+}
+
+/**
+ * Split the show's pins by what the after walk says about them, using the
+ * before walk where there is one. Without a before walk nothing can be called
+ * dead, so every still connected pin is treated as a misfire, which is the
+ * safe way round.
+ */
+export function reconcileAfter(
+  expected: Iterable<PinAddress>,
+  before: readonly ContinuityRow[] | undefined,
+  after: readonly ContinuityRow[],
+): AfterWalk {
+  const wanted = new Map(
+    [...expected].map((address) => [pinKey(address), address]),
+  );
+  const beforeRows = firstByPin(before ?? []);
+  const afterRows = firstByPin(after);
+  const walkedBefore = beforeRows.size > 0;
+
+  const misfired: PinAddress[] = [];
+  const dead: PinAddress[] = [];
+  const unknown: PinAddress[] = [];
+  const shorted: PinAddress[] = [];
+  const fired: PinAddress[] = [];
+  const burnt: PinAddress[] = [];
+
+  for (const [key, address] of wanted) {
+    const row = afterRows.get(key);
+    if (row === undefined) {
+      unknown.push(address);
+      continue;
+    }
+    if (row.reading === "short") {
+      shorted.push(address);
+      continue;
+    }
+    if (row.reading === "connected") {
+      const was = beforeRows.get(key)?.reading;
+      if (walkedBefore && was === "open") {
+        dead.push(address);
+      } else {
+        misfired.push(address);
+      }
+      continue;
+    }
+    fired.push(address);
+  }
+
+  for (const row of afterRows.values()) {
+    const key = pinKey(row.address);
+    if (wanted.has(key) || row.reading !== "open") {
+      continue;
+    }
+    if (beforeRows.get(key)?.reading === "connected") {
+      burnt.push(row.address);
+    }
+  }
+
+  return {
+    misfired: misfired.sort(comparePins),
+    dead: dead.sort(comparePins),
+    unknown: unknown.sort(comparePins),
+    shorted: shorted.sort(comparePins),
+    fired: fired.sort(comparePins),
+    burnt: burnt.sort(comparePins),
+  };
+}
+
+/**
+ * Every pin the show fired that the after walk cannot show as having gone.
+ * All of them are treated as misfires, including the ones nobody reported,
+ * because the waiting period is cheap and walking out to a live mortar is not.
+ */
+export function unfiredPins(result: AfterWalk): PinAddress[] {
+  return [
+    ...result.misfired,
+    ...result.dead,
+    ...result.unknown,
+    ...result.shorted,
+  ].sort(comparePins);
+}
+
+export function checkAfterWalk(result: AfterWalk): DiagnosticBag {
+  const diagnostics = new DiagnosticBag();
+  for (const address of result.dead) {
+    diagnostics.error({
+      code: "PF1415",
+      message: `${formatPin(address)} read open before the show and connected after, so it never had a circuit`,
+      help: "the match is still live, treat it as a misfire and find the break",
+    });
+  }
+  for (const address of result.burnt) {
+    diagnostics.error({
+      code: "PF1416",
+      message: `${formatPin(address)} was wired, the show never fired it, and it has burned`,
+      help: "something went up that the table did not ask for, stop and account for it",
+    });
+  }
+  for (const address of result.unknown) {
+    diagnostics.warning({
+      code: "PF1417",
+      message: `${formatPin(address)} is fired by the show and the after walk never reported it`,
+      help: "walk it again before anybody goes out, an unread pin counts as live",
+    });
+  }
+  return diagnostics;
+}
+
+/** Pins the after walk read open, which are the only ones safe to refire on. */
+export function usablePins(after: readonly ContinuityRow[]): PinAddress[] {
+  return after
+    .filter((row) => row.reading === "open")
+    .map((row) => row.address)
+    .sort(comparePins);
+}
