+  for (const misfire of misfires) {
+    const position = misfire.event.position;
+    const held = byPosition.get(position) ?? { count: 0, wait: 0 };
+    held.count += 1;
+    held.wait = Math.max(held.wait, raw(waitFor(misfire)));
+    byPosition.set(position, held);
