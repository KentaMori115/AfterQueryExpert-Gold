+export interface ClearancePlan {
+  /** Positions with something unfired, soonest approachable first. */
+  readonly positions: readonly PositionClearance[];
+  /** When the whole field is clear, which is the last of them. */
+  readonly fieldClearAt: Milliseconds;
+}
+
+function showEnd(schedule: Schedule | QuantisedSchedule): number {
+  let latest = 0;
+  for (const event of schedule.events) {
+    latest = Math.max(latest, raw(event.occupancy.end));
+  }
+  return latest;
+}
+
+export function clearancePlan(
+  schedule: Schedule | QuantisedSchedule,
+  misfires: readonly Misfire[],
