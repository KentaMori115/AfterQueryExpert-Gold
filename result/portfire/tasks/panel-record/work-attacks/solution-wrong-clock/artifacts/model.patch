+}
+
+export function checkAfterWalk(walk: AfterWalk): DiagnosticBag {
+  const diagnostics = new DiagnosticBag();
+  for (const address of walk.unknown) {
+    diagnostics.warning({
+      code: "PF1415",
+      message: `${formatPin(address)} is fired by the show and the walk after it never reported it`,
+      help: "until it is walked it is treated as loaded",
+    });
+  }
+  for (const address of walk.dead) {
+    diagnostics.error({
+      code: "PF1416",
+      message: `${formatPin(address)} read open before the show and is still connected after it`,
+      help: "this cue never had current, the mortar is loaded and was never fixed",
+    });
+  }
+  for (const address of walk.burnt) {
+    diagnostics.error({
+      code: "PF1417",
+      message: `${formatPin(address)} is not in the show, read connected before it and open after it`,
+      help: "something fired on an output the table never held, find out what",
+    });
+  }
+  return diagnostics;
+}
+
+/** The pins an after walk read open, which are the only ones a refire may use. */
+export function openPins(rows: readonly ContinuityRow[]): Set<string> {
+  const open = new Set<string>();
+  const seen = new Set<string>();
+  for (const row of rows) {
