index 0000000..d1cccbf
--- /dev/null
+++ b/src/timeline/panelLog.ts
@@ -0,0 +1,304 @@
+import type { QuantisedEvent, QuantisedSchedule } from "./quantise.js";
+import { readTable } from "../core/csv.js";
+import { DiagnosticBag } from "../core/diagnostic.js";
+import { renderTable } from "../core/text.js";
+import {
+  formatShowTime,
+  frameDuration,
+  parseShowTime,
+} from "../core/timecode.js";
+import type { Milliseconds } from "../core/units.js";
+import { ms, raw } from "../core/units.js";
+import type { PinAddress } from "../rig/pin.js";
+import { comparePins, formatPin, parsePin, pinKey } from "../rig/pin.js";
+
+/**
+ * What the panel says it did.
+ *
+ * Every panel keeps a log of the outputs it closed and when, and after a dry
+ * run that log is the only evidence that the panel understood the table. A
+ * crew watching lights sees that something blinked. The log says which output
+ * and at what time, and read against the table it answers the three questions
+ * a dry run exists to ask: did every cue go, did anything go that should not
+ * have, and did anything go late.
+ *
+ * The clock is the trap. A panel starts its own clock at its first ignition,
+ * which for a show with a pre roll is before the show clock's zero, so a log
+ * time is the show time plus the pre roll. Comparing the two raw would report
+ * an opener that fired exactly on time as late by the whole pre roll and
+ * everything after it the same, and a crew would spend an evening chasing a
+ * fault the panel does not have.
+ */
+
+export interface PanelLogRow {
+  readonly address: PinAddress;
+  /** When the panel closed the output, on the panel's own clock. */
+  readonly at: Milliseconds;
+  /** One based line in the source, for a diagnostic that points at a row. */
+  readonly line: number;
+}
+
+export interface PanelLogReport {
+  readonly rows: readonly PanelLogRow[];
+  readonly diagnostics: DiagnosticBag;
+}
+
+const PIN_COLUMNS = ["pin", "address", "cue", "output"];
+const TIME_COLUMNS = ["time", "fired", "at", "fired_at"];
+
+/**
+ * Read a panel's output log. Column names differ between makers exactly as
+ * they do on a continuity dump, so the same spellings of the pin column are
+ * taken, and the time column is whichever of the usual names is present.
+ * Times are written the way a cue time is, so `12.4`, `1:23.450` and `250ms`
+ * all read, and a row that will not read is reported and skipped rather than
+ * stopping the whole log, since one bad row out of four hundred is a panel
+ * firmware quirk rather than a reason to grade nothing.
+ */
+export function parsePanelLog(text: string, source: string): PanelLogReport {
+  const diagnostics = new DiagnosticBag();
+  const table = readTable(text);
+  const rows: PanelLogRow[] = [];
+
+  const pinColumn = PIN_COLUMNS.find((name) => table.headers.includes(name));
+  const timeColumn = TIME_COLUMNS.find((name) => table.headers.includes(name));
+  if (pinColumn === undefined || timeColumn === undefined) {
+    diagnostics.error({
+      code: "PF1420",
+      message: `${source} does not have a pin column and a time column`,
+      help: "the pin column may be pin, address, cue or output, the time column time, fired, at or fired_at",
+    });
+    return { rows, diagnostics };
+  }
+
+  for (const record of table.records) {
+    const where = `${source} line ${record.line}`;
+    const address = parsePin(record.values.get(pinColumn) ?? "");
+    if (address === undefined) {
+      diagnostics.error({
+        code: "PF1421",
+        message: `${where} has no readable pin address`,
+      });
+      continue;
+    }
+    const text = (record.values.get(timeColumn) ?? "").trim();
+    const at = parseShowTime(text);
+    if (at === undefined) {
+      diagnostics.error({
+        code: "PF1422",
+        message: `${where} has a time of ${text || "(blank)"} that does not read`,
+        help: "write it as 12.4, 1:23.450, 250ms or 4m30s",
+      });
+      continue;
+    }
+    rows.push({ address, at, line: record.line });
+  }
+  return { rows, diagnostics };
+}
+
+export interface LogMatch {
+  readonly event: QuantisedEvent;
+  readonly row: PanelLogRow;
+  /** How far from the table's time the output closed, positive meaning late. */
+  readonly offset: Milliseconds;
+}
+
+export interface LogGrade {
+  /** Every show pin the log accounts for, in the table's firing order. */
+  readonly fired: readonly LogMatch[];
+  /** Show pins the log never mentions, in the table's firing order. */
+  readonly missed: readonly QuantisedEvent[];
+  /** Rows for pins the show does not fire, and any repeat row for a show pin. */
+  readonly extra: readonly PanelLogRow[];
+  /** Matches that closed later than the tolerance allows. */
+  readonly late: readonly LogMatch[];
+  /** Matches that closed earlier than the tolerance allows. */
+  readonly early: readonly LogMatch[];
+  /** How far an output may sit from the table before it counts. */
+  readonly tolerance: Milliseconds;
+  /** The match furthest from its time, either way. */
+  readonly worst?: LogMatch;
+}
+
+export interface LogGradeOptions {
+  /** Offsets inside this are on time. One frame of the show's format if unset. */
+  readonly tolerance?: Milliseconds;
+}
+
+/**
+ * Read a log against the table.
+ *
+ * Every show pin closes once, so the earliest row for a pin is its firing and
+ * any later row for the same pin is something the panel did that the table
+ * never asked for. A pin the show does not fire at all is the same finding
+ * whatever its time, and it is the finding that matters most, because an
+ * output nothing was wired to on the dry run is an output something will be
+ * wired to on the night.
+ */
+export function gradeLog(
+  schedule: QuantisedSchedule,
+  rows: readonly PanelLogRow[],
+  options: LogGradeOptions = {},
+): LogGrade {
+  const tolerance = options.tolerance ?? frameDuration(schedule.format);
+  const preRoll = raw(schedule.preRoll);
+  const byPin = new Map(
+    schedule.events.map((event) => [pinKey(event.address), event]),
+  );
+  const matched = new Map<string, LogMatch>();
+  const extra: PanelLogRow[] = [];
+
+  const ordered = [...rows].sort(
+    (a, b) => raw(a.at) - raw(b.at) || a.line - b.line,
+  );
+  for (const row of ordered) {
+    const key = pinKey(row.address);
+    const event = byPin.get(key);
+    if (event === undefined || matched.has(key)) {
+      extra.push(row);
+      continue;
+    }
+    const expected = raw(event.ignitionAt) - preRoll;
+    matched.set(key, { event, row, offset: ms(raw(row.at) - expected) });
+  }
+
+  const fired: LogMatch[] = [];
+  const missed: QuantisedEvent[] = [];
+  for (const event of schedule.events) {
+    const match = matched.get(pinKey(event.address));
+    if (match === undefined) {
+      missed.push(event);
+    } else {
+      fired.push(match);
+    }
+  }
+  const limit = raw(tolerance);
+  const late = fired.filter((match) => raw(match.offset) > limit);
+  const early = fired.filter((match) => raw(match.offset) < -limit);
+  let worst: LogMatch | undefined;
+  for (const match of fired) {
+    if (
+      worst === undefined ||
+      Math.abs(raw(match.offset)) > Math.abs(raw(worst.offset))
+    ) {
+      worst = match;
+    }
+  }
+  return {
+    fired,
+    missed,
+    extra: extra.sort(
+      (a, b) => comparePins(a.address, b.address) || raw(a.at) - raw(b.at),
+    ),
+    late,
+    early,
+    tolerance,
+    ...(worst === undefined ? {} : { worst }),
+  };
+}
+
+function offsetText(offset: Milliseconds): string {
+  const value = Math.round(raw(offset));
+  return `${value > 0 ? "+" : ""}${value}ms`;
+}
+
+export function checkLog(grade: LogGrade): DiagnosticBag {
+  const diagnostics = new DiagnosticBag();
+  for (const event of grade.missed) {
+    diagnostics.error({
+      code: "PF3410",
+      message: `${formatPin(event.address)} ${event.effectId} at ${event.position} never closed, the table has it at ${formatShowTime(event.ignitionAt)}`,
+      help: "the panel skipped this output, check the table it loaded is this one",
+    });
+  }
+  for (const row of grade.extra) {
+    diagnostics.error({
+      code: "PF3411",
+      message: `${formatPin(row.address)} closed at ${formatShowTime(row.at)} and the table has nothing on it then`,
+      help: "an output the table does not hold fired, so the panel is not running this table",
+    });
+  }
+  for (const match of [...grade.late, ...grade.early]) {
+    diagnostics.warning({
+      code: "PF3412",
+      message: `${formatPin(match.event.address)} ${match.event.effectId} closed ${offsetText(match.offset)} from its time`,
+      help:
+        raw(match.offset) > 0
+          ? "a late output on a busy module is usually the module past its simultaneous limit"
+          : "an early output means the panel's clock is running ahead of the table",
+    });
+  }
+  return diagnostics;
+}
+
+/** Whether the panel did exactly what the table said, within tolerance. */
+export function logClean(grade: LogGrade): boolean {
+  return (
+    grade.missed.length === 0 &&
+    grade.extra.length === 0 &&
+    grade.late.length === 0 &&
+    grade.early.length === 0
+  );
+}
+
+export function describeLogGrade(grade: LogGrade): string {
+  const total = grade.fired.length + grade.missed.length;
+  const parts = [
+    `${grade.fired.length} of ${total} outputs closed`,
+    `${grade.late.length} late`,
+    `${grade.early.length} early`,
+    `${grade.missed.length} missed`,
+    `${grade.extra.length} extra`,
+  ];
+  if (grade.worst !== undefined) {
+    parts.push(`worst ${offsetText(grade.worst.offset)}`);
+  }
+  return parts.join(", ");
+}
+
+/** The findings as a table, one row per output that is worth a look. */
+export function logFindingLines(grade: LogGrade): string {
+  const rows: string[][] = [];
+  for (const event of grade.missed) {
+    rows.push([
+      formatPin(event.address),
+      "missed",
+      formatShowTime(event.ignitionAt),
+      "",
+      event.effectId,
+    ]);
+  }
+  for (const row of grade.extra) {
+    rows.push([
+      formatPin(row.address),
+      "extra",
+      "",
+      formatShowTime(row.at),
+      "",
+    ]);
+  }
+  for (const match of [...grade.late, ...grade.early].sort(
+    (a, b) => raw(a.event.ignitionAt) - raw(b.event.ignitionAt),
+  )) {
+    rows.push([
+      formatPin(match.event.address),
+      raw(match.offset) > 0 ? "late" : "early",
+      formatShowTime(match.event.ignitionAt),
+      offsetText(match.offset),
+      match.event.effectId,
+    ]);
+  }
+  if (rows.length === 0) {
+    return "the panel did what the table said";
+  }
+  return renderTable(
+    [
+      { header: "pin" },
+      { header: "finding" },
+      { header: "table", align: "right" },
+      { header: "panel", align: "right" },
+      { header: "effect" },
+    ],
+    rows,
+  );
+}
