+export interface PositionClearance {
+  readonly position: string;
+  /** How many of the position's cues did not fire. */
+  readonly misfires: number;
+  /** The longest wait any of them demands. */
+  readonly wait: Milliseconds;
+  /** Show clock moment the position may be approached. */
+  readonly clearAt: Milliseconds;
