diff --git a/src/rig/continuity.ts b/src/rig/continuity.ts
index aff2ece..d31f69e 100644
--- a/src/rig/continuity.ts
+++ b/src/rig/continuity.ts
@@ -242,3 +242,151 @@ export function unwalkedPins(
   const seen = new Set(rows.map((row) => pinKey(row.address)));
   return rig.allPins().filter((address) => !seen.has(pinKey(address)));
 }
+
+/**
+ * The morning after.
+ *
+ * The walk that decides whether anybody has to go and stand over a mortar is
+ * the one done after the show, and it is the one that gets skipped because
+ * everybody wants to go home. Read against the show, and against the walk done
+ * before it, it says which pins fired and which did not, which is the list the
+ * clearance is planned from.
+ *
+ * A pin that still reads connected has an intact match on it, so the cue did
+ * not go. If the walk before the show already had that pin open then the
+ * circuit was never live and the finding is a dead cue rather than a misfire,
+ * which matters because a dead cue is a fault in the rig and a misfire is a
+ * fault in the shell. And a pin the show never fires that was connected before
+ * and reads open after has fired something nobody asked for, which is the
+ * worst thing on this list.
+ */
+export interface AfterWalk {
+  /** Read open after and was wired for the show, so it went. */
+  readonly fired: readonly PinAddress[];
+  /** Still connected after the show, so the match is intact and it did not go. */
+  readonly misfired: readonly PinAddress[];
+  /** Connected after and open before, so it was never a live circuit. */
+  readonly dead: readonly PinAddress[];
+  /** Fired by the show and never reported by the after walk. */
+  readonly unknown: readonly PinAddress[];
+  /** Reads shorted after, which nothing safe explains. */
+  readonly shorted: readonly PinAddress[];
+  /** Not in the show, connected before and open after, so something fired. */
+  readonly burnt: readonly PinAddress[];
+}
+
+function byPin(rows: readonly ContinuityRow[]): Map<string, ContinuityRow> {
+  const found = new Map<string, ContinuityRow>();
+  for (const row of rows) {
+    found.set(pinKey(row.address), row);
+  }
+  return found;
+}
+
+/**
+ * Split the show's pins by what the after walk found on them, using the walk
+ * done before the show, when there is one, to tell a dead circuit from a
+ * misfire.
+ */
+export function reconcileAfter(
+  expected: Iterable<PinAddress>,
+  before: readonly ContinuityRow[] | undefined,
+  after: readonly ContinuityRow[],
+): AfterWalk {
+  const wanted = new Map(
+    [...expected].map((address) => [pinKey(address), address]),
+  );
+  const beforeRows = byPin(before ?? []);
+  const afterRows = byPin(after);
+
+  const fired: PinAddress[] = [];
+  const misfired: PinAddress[] = [];
+  const dead: PinAddress[] = [];
+  const unknown: PinAddress[] = [];
+  const shorted: PinAddress[] = [];
+  const burnt: PinAddress[] = [];
+
+  for (const [key, address] of wanted) {
+    const row = afterRows.get(key);
+    if (row === undefined) {
+      unknown.push(address);
+      continue;
+    }
+    if (row.reading === "short") {
+      shorted.push(address);
+      continue;
+    }
+    if (row.reading === "connected") {
+      if (beforeRows.get(key)?.reading === "open") {
+        dead.push(address);
+      } else {
+        misfired.push(address);
+      }
+      continue;
+    }
+    fired.push(address);
+  }
+
+  for (const row of after) {
+    const key = pinKey(row.address);
+    if (wanted.has(key) || row.reading !== "open") {
+      continue;
+    }
+    if (beforeRows.get(key)?.reading === "connected") {
+      burnt.push(row.address);
+    }
+  }
+
+  return {
+    fired: fired.sort(comparePins),
+    misfired: misfired.sort(comparePins),
+    dead: dead.sort(comparePins),
+    unknown: unknown.sort(comparePins),
+    shorted: shorted.sort(comparePins),
+    burnt: burnt.sort(comparePins),
+  };
+}
+
+/**
+ * Every pin the show fired that the walk cannot say went. Each one is treated
+ * as a misfire, including the ones the walk never reported, because a pin
+ * nobody looked at is not evidence that the shell is gone.
+ */
+export function unfiredPins(walk: AfterWalk): PinAddress[] {
+  const found = new Map<string, PinAddress>();
+  for (const address of [
+    ...walk.misfired,
+    ...walk.dead,
+    ...walk.unknown,
+    ...walk.shorted,
+  ]) {
+    found.set(pinKey(address), address);
+  }
+  return [...found.values()].sort(comparePins);
+}
+
+export function checkAfterWalk(walk: AfterWalk): DiagnosticBag {
+  const diagnostics = new DiagnosticBag();
+  for (const address of walk.dead) {
+    diagnostics.error({
+      code: "PF1415",
+      message: `${formatPin(address)} reads connected after the show and was open before it`,
+      help: "the circuit was never live, so this cue was dead all evening",
+    });
+  }
+  for (const address of walk.burnt) {
+    diagnostics.error({
+      code: "PF1416",
+      message: `${formatPin(address)} was connected before the show and reads open after it, and the show never fired it`,
+      help: "something went off that nothing asked for, find out what before anybody walks out",
+    });
+  }
+  for (const address of walk.unknown) {
+    diagnostics.warning({
+      code: "PF1417",
+      message: `${formatPin(address)} is fired by the show and the after walk never reported it`,
+      help: "walk it before treating the position as clear",
+    });
+  }
+  return diagnostics;
+}
