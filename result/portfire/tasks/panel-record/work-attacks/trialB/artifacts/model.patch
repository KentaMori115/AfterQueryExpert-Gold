+import { describe, expect, it } from "vitest";
+import {
+  EXIT_BAD_USAGE,
+  EXIT_OK,
+  EXIT_SHOW_PROBLEM,
+} from "../../src/cli/command.js";
+import { MemoryEnv } from "../../src/cli/env.js";
+import { main } from "../../src/cli/main.js";
+
+/**
+ * The two halves of an evening the tool used to have nothing to say about: the
+ * log the panel wrote during the dry run, and the walk done once the lights
+ * have stopped.
+ */
+
+const CATALOG = [
+  "id,kind,name,calibre,break,hang,diameter,duration,style",
+  "shell.75,shell,three inch,75mm,peony,1.8,60,,",
+  "gerb.silver,ground,silver gerb,,,,,20,gerb",
+].join("\n");
+
+const RIG = [
+  "position pad.a at -60 0",
+  "position pad.b at 60 0",
+  "module 1 slat-50 at pad.a",
+  "module 2 slat-50 at pad.b",
+].join("\n");
+
+const SHOW = [
+  "show autumn",
+  "at 20 fire shell.75 from pad.a",
+  "at 30 fire gerb.silver from pad.b",
+].join("\n");
+
+const LOG = ["pin,fired", "01.01,20.0", "02.01,30.0"].join("\n");
+
+function envWith(over: Record<string, string> = {}): MemoryEnv {
+  return new MemoryEnv({
+    "house.csv": CATALOG,
+    "autumn.rig": RIG,
+    "autumn.pf": SHOW,
+    "log.csv": LOG,
+    ...over,
+  });
+}
+
+const base = ["--catalog", "house.csv", "--rig", "autumn.rig"];
+const loose = ["--tolerance", "60000"];
+
+describe("rehearse --log", () => {
+  it("grades a log that holds every cue", () => {
+    const env = envWith();
+    expect(
+      main(
+        ["rehearse", "autumn.pf", "--log", "log.csv", ...loose, ...base],
+        env,
+      ),
+    ).toBe(EXIT_OK);
+    expect(env.stdout).toContain("2 fired, 0 missed, 0 extra");
+    expect(env.stdout).toContain("verdict");
+    expect(env.stdout).toContain("01.01");
+  });
+
+  it("fails a log with a cue missing from it", () => {
+    const env = envWith({ "gap.csv": ["pin,fired", "01.01,20.0"].join("\n") });
+    expect(
+      main(
+        ["rehearse", "autumn.pf", "--log", "gap.csv", ...loose, ...base],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stdout).toContain("1 missed");
+    expect(env.stderr).toContain("PF3710");
+    expect(env.stderr).toContain("02.01");
+  });
+
+  it("fails a log with something the table never asked for", () => {
+    const env = envWith({
+      "extra.csv": [LOG, "02.09,31.0"].join("\n"),
+    });
+    expect(
+      main(
+        ["rehearse", "autumn.pf", "--log", "extra.csv", ...loose, ...base],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stdout).toContain("1 extra");
+    expect(env.stderr).toContain("PF3711");
+  });
+
+  it("warns rather than fails when a cue only slipped", () => {
+    const env = envWith();
+    expect(
+      main(["rehearse", "autumn.pf", "--log", "log.csv", ...base], env),
+    ).toBe(EXIT_OK);
+    expect(env.stderr).toMatch(/PF371[23]/);
+    expect(env.stdout).toMatch(/late|early/);
+  });
+
+  it("takes a tolerance of its own", () => {
+    const env = envWith();
+    main(
+      [
+        "rehearse",
+        "autumn.pf",
+        "--log",
+        "log.csv",
+        "--tolerance",
+        "0",
+        ...base,
+      ],
+      env,
+    );
+    expect(env.stdout).toContain("worst");
+  });
+
+  it("refuses a nonsense tolerance", () => {
+    const env = envWith();
+    expect(
+      main(
+        [
+          "rehearse",
+          "autumn.pf",
+          "--log",
+          "log.csv",
+          "--tolerance",
+          "soon",
+          ...base,
+        ],
+        env,
+      ),
+    ).toBe(EXIT_BAD_USAGE);
+  });
+
+  it("reports a log it cannot read", () => {
+    const env = envWith();
+    expect(
+      main(["rehearse", "autumn.pf", "--log", "gone.csv", ...base], env),
+    ).toBe(EXIT_BAD_USAGE);
+    expect(env.stderr).toContain("cannot read the log");
+  });
+
+  it("reports a log it cannot make sense of", () => {
+    const env = envWith({ "junk.csv": "a,b\n1,2" });
+    expect(
+      main(["rehearse", "autumn.pf", "--log", "junk.csv", ...base], env),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("PF1420");
+  });
+
+  it("keeps a bad row out of the grade and reports it", () => {
+    const env = envWith({
+      "torn.csv": [LOG, "nowhere,32.0"].join("\n"),
+    });
+    main(
+      ["rehearse", "autumn.pf", "--log", "torn.csv", ...loose, ...base],
+      env,
+    );
+    expect(env.stderr).toContain("PF1421");
+    expect(env.stdout).toContain("2 fired");
+  });
+
+  it("writes the grade to a file", () => {
+    const env = envWith();
+    main(
+      [
+        "rehearse",
+        "autumn.pf",
+        "--log",
+        "log.csv",
+        ...loose,
+        "--out",
+        "grade.txt",
+        ...base,
+      ],
+      env,
+    );
+    expect(env.written.get("grade.txt")).toContain("2 fired");
+  });
+
+  it("still writes the plan when no log is given", () => {
+    const env = envWith();
+    expect(main(["rehearse", "autumn.pf", ...base], env)).toBe(EXIT_OK);
+    expect(env.stdout).toContain("watch for");
+  });
+});
+
+describe("continuity --after", () => {
+  const allOpen = ["pin,state", "01.01,open", "02.01,open"].join("\n");
+  const oneLeft = ["pin,state", "01.01,open", "02.01,ok", "02.05,open"].join(
+    "\n",
+  );
+
+  it("passes a field that all fired", () => {
+    const env = envWith({ "after.csv": allOpen });
+    expect(
+      main(["continuity", "autumn.pf", "--after", "after.csv", ...base], env),
+    ).toBe(EXIT_OK);
+    expect(env.stdout).toContain("2 fired");
+    expect(env.stdout).toContain("nothing to make safe");
