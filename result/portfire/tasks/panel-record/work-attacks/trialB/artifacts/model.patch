+import type { QuantisedSchedule } from "./quantise.js";
+import type { FiringEvent, Schedule } from "./schedule.js";
+import { readTable } from "../core/csv.js";
+import { DiagnosticBag } from "../core/diagnostic.js";
+import { renderTable } from "../core/text.js";
+import { SMPTE_25, frameDuration, formatShowTime } from "../core/timecode.js";
+import type { TimecodeFormat } from "../core/timecode.js";
+import { parseShowTime } from "../core/timecode.js";
+import { ms, raw } from "../core/units.js";
+import type { Milliseconds } from "../core/units.js";
+import { formatPin, parsePin, pinKey } from "../rig/pin.js";
+import type { PinAddress } from "../rig/pin.js";
+
+/**
+ * Reading the panel's own log back.
+ *
+ * Every panel writes down what it did and at what time, and nobody reads it.
+ * The dry run is the one end to end test the system gets, and it is thrown
+ * away the moment the lights stop, so a cue that was forty milliseconds late
+ * in the rehearsal is forty milliseconds late in the show and is discovered by
+ * the audience.
+ *
+ * Grading a log answers three questions and they are not the same question. Did
+ * every cue in the table fire, did anything fire that the table never asked
+ * for, and did the ones that fired fire when they were told to. The third is
+ * the one a person reading four hundred rows by eye cannot answer at all.
+ *
+ * One wrinkle matters. A panel counts from its own zero, which is the start of
+ * the pre roll, and the table counts from the show clock, which is where the
+ * music starts. A show with six seconds of pre roll therefore logs every cue
+ * six seconds later than the table says, and a grader that ignored that would
+ * report the whole show as late by exactly the pre roll.
+ */
+
+export interface PanelLogRow {
+  readonly address: PinAddress;
+  /** The panel's own clock, so show time plus the pre roll. */
+  readonly at: Milliseconds;
+  /** One based line in the log, so a bad row can be pointed at. */
+  readonly line: number;
+}
+
+export interface PanelLogReport {
+  readonly rows: readonly PanelLogRow[];
+  readonly diagnostics: DiagnosticBag;
+}
+
+/** The spellings a pin column arrives under, the same set as a walk. */
+const PIN_COLUMNS = ["pin", "address", "cue", "output"] as const;
+
+/**
+ * The spellings a time column arrives under. `readTable` has already folded
+ * `Fired At` and `fired at` onto `fired_at`, so one entry covers all of them.
+ */
+const TIME_COLUMNS = ["time", "fired", "at", "fired_at", "cue_time"] as const;
+
+/**
+ * Read a panel's fired log. Unreadable rows are reported and skipped rather
+ * than thrown, because a log with one corrupt line still says something about
+ * the other three hundred and ninety nine.
+ */
+export function parsePanelLog(text: string, source: string): PanelLogReport {
+  const diagnostics = new DiagnosticBag();
+  const table = readTable(text);
+  const rows: PanelLogRow[] = [];
+
+  const addressColumn = PIN_COLUMNS.find((name) =>
+    table.headers.includes(name),
+  );
+  const timeColumn = TIME_COLUMNS.find((name) => table.headers.includes(name));
+  if (addressColumn === undefined || timeColumn === undefined) {
+    diagnostics.error({
+      code: "PF1420",
+      message: `${source} does not have a pin column and a time column`,
+      help: "the time column may be time, fired, at, fired at or cue time",
+    });
+    return { rows, diagnostics };
+  }
+
+  for (const record of table.records) {
+    const where = `${source} line ${record.line}`;
+    const address = parsePin(record.values.get(addressColumn) ?? "");
+    if (address === undefined) {
+      diagnostics.error({
+        code: "PF1421",
+        message: `${where} has no readable pin address`,
+      });
+      continue;
+    }
+    const timeText = (record.values.get(timeColumn) ?? "").trim();
+    const at = parseShowTime(timeText);
+    if (at === undefined) {
+      diagnostics.error({
+        code: "PF1422",
+        message: `${where} has a time of ${timeText || "(blank)"}`,
+        help: "a time reads 11.990, 1:23.450, 90s or 250ms",
+      });
+      continue;
+    }
+    rows.push({ address, at, line: record.line });
+  }
+  return { rows, diagnostics };
+}
+
+export interface LogMatch {
+  readonly event: FiringEvent;
+  readonly row: PanelLogRow;
+  /** Logged less due, so late is positive and early is negative. */
+  readonly offset: Milliseconds;
+}
+
+export interface LogGrade {
+  /** One per cue that fired, in table order. */
+  readonly fired: readonly LogMatch[];
+  /** Cues in the table the log never mentions. */
+  readonly missed: readonly FiringEvent[];
+  /** Rows in the log no cue in the table claims. */
+  readonly extra: readonly PanelLogRow[];
+  /** Matches outside the tolerance on the late side, worst first. */
+  readonly late?: readonly LogMatch[];
+  readonly early?: readonly LogMatch[];
+  /** The furthest out of the ones that slipped, either way. */
+  readonly worst?: LogMatch;
+  /** How far a cue may be out before it counts as slipped. */
+  readonly tolerance: Milliseconds;
+}
+
+export interface GradeOptions {
+  /**
+   * How far out is close enough. One frame of the show's own format by
+   * default, because a panel cannot fire between frames and a table that was
+   * quantised onto them cannot ask it to.
+   */
+  readonly tolerance?: Milliseconds;
+}
+
+function formatOf(schedule: Schedule | QuantisedSchedule): TimecodeFormat {
+  return "format" in schedule ? schedule.format : SMPTE_25;
+}
+
+/**
+ * Grade a log against the table that produced it.
+ *
+ * A cue is matched to the earliest row on its pin. Later rows on the same pin
+ * are extra, which is the honest reading: a pin that appears twice fired
+ * twice, and the second one is not evidence that the first was on time.
+ */
+export function gradeLog(
+  schedule: Schedule | QuantisedSchedule,
+  rows: readonly PanelLogRow[],
+  options: GradeOptions = {},
+): LogGrade {
+  const tolerance = options.tolerance ?? frameDuration(formatOf(schedule));
+  const preRoll = raw(schedule.preRoll);
+
+  const earliest = new Map<string, PanelLogRow>();
+  for (const row of rows) {
+    const key = pinKey(row.address);
+    const held = earliest.get(key);
+    if (held === undefined || raw(row.at) < raw(held.at)) {
+      earliest.set(key, row);
+    }
+  }
+
+  const fired: LogMatch[] = [];
+  const missed: FiringEvent[] = [];
+  const claimed = new Set<PanelLogRow>();
+  for (const event of schedule.events) {
+    const row = earliest.get(pinKey(event.address));
+    if (row === undefined) {
+      missed.push(event);
+      continue;
+    }
+    claimed.add(row);
+    fired.push({
+      event,
+      row,
+      offset: ms(raw(row.at) - preRoll - raw(event.ignitionAt)),
+    });
+  }
+  const extra = rows.filter((row) => !claimed.has(row));
+
+  const limit = raw(tolerance);
+  const bySlip = (a: LogMatch, b: LogMatch): number =>
+    Math.abs(raw(b.offset)) - Math.abs(raw(a.offset));
+  const late = fired.filter((match) => raw(match.offset) > limit).sort(bySlip);
+  const early = fired
+    .filter((match) => raw(match.offset) < -limit)
+    .sort(bySlip);
+  const worst = [...late, ...early].sort(bySlip)[0];
+
+  return {
+    fired,
+    missed,
+    extra,
+    ...(late.length === 0 ? {} : { late }),
+    ...(early.length === 0 ? {} : { early }),
+    ...(worst === undefined ? {} : { worst }),
+    tolerance,
+  };
+}
+
+/** A signed millisecond offset, the way an offset reads in a report. */
+export function formatOffset(offset: Milliseconds): string {
+  const value = raw(offset);
+  const sign = value > 0 ? "+" : value < 0 ? "-" : "";
+  return `${sign}${Math.abs(Math.round(value))}ms`;
+}
+
+function verdictOf(match: LogMatch, tolerance: Milliseconds): string {
+  const value = raw(match.offset);
+  const limit = raw(tolerance);
+  if (value > limit) {
+    return "late";
+  }
+  if (value < -limit) {
+    return "early";
+  }
+  return "on time";
+}
+
+/** The one line a crew wants at the top of a grade. */
+export function summariseGrade(grade: LogGrade): string {
+  const parts = [
+    `${grade.fired.length} fired`,
+    `${grade.missed.length} missed`,
+    `${grade.extra.length} extra`,
+  ];
+  if (grade.late !== undefined) {
+    parts.push(`${grade.late.length} late`);
+  }
+  if (grade.early !== undefined) {
+    parts.push(`${grade.early.length} early`);
+  }
+  return parts.join(", ");
+}
+
+export function describeGrade(grade: LogGrade): string {
+  const lines = [summariseGrade(grade)];
+  if (grade.worst !== undefined) {
+    lines.push(
+      `worst ${formatPin(grade.worst.event.address)} ${formatOffset(grade.worst.offset)}`,
+    );
+  }
+  if (grade.fired.length > 0) {
+    lines.push("");
+    lines.push(
+      renderTable(
+        [
+          { header: "due", align: "right" },
+          { header: "pin", align: "right" },
+          { header: "effect" },
+          { header: "logged", align: "right" },
+          { header: "offset", align: "right" },
+          { header: "verdict" },
+        ],
+        grade.fired.map((match) => [
+          formatShowTime(match.event.ignitionAt),
+          formatPin(match.event.address),
+          match.event.effectId,
+          formatShowTime(match.row.at),
+          formatOffset(match.offset),
+          verdictOf(match, grade.tolerance),
+        ]),
+      ),
+    );
+  }
+  if (grade.missed.length > 0) {
+    lines.push("");
+    lines.push("missed");
+    for (const event of grade.missed) {
+      lines.push(
+        `  ${formatShowTime(event.ignitionAt)}  ${formatPin(event.address)}  ${event.effectId}`,
+      );
+    }
+  }
+  if (grade.extra.length > 0) {
+    lines.push("");
+    lines.push("extra");
+    for (const row of grade.extra) {
+      lines.push(
+        `  line ${row.line}  ${formatPin(row.address)}  at ${formatShowTime(row.at)}`,
+      );
+    }
+  }
+  return lines.join("\n");
+}
+
+/**
+ * What the grade means. A cue that did not fire and a cue that fired without
+ * being asked are both errors, because either one says the panel and the table
+ * disagree about the show. Slipped timing is a warning: it is real, and it is
+ * usually the clock rather than the table.
+ */
+export function checkLog(grade: LogGrade): DiagnosticBag {
+  const diagnostics = new DiagnosticBag();
+  for (const event of grade.missed) {
+    diagnostics.error({
+      code: "PF3710",
+      message: `${formatPin(event.address)} ${event.effectId} at ${formatShowTime(event.ignitionAt)} is not in the log`,
+      help: "the panel never fired it, or the log is not of this table",
+    });
+  }
+  for (const row of grade.extra) {
+    diagnostics.error({
+      code: "PF3711",
+      message: `${formatPin(row.address)} fired at ${formatShowTime(row.at)} and the table never asked for it`,
+    });
+  }
+  for (const match of grade.late ?? []) {
+    diagnostics.warning({
+      code: "PF3712",
+      message: `${formatPin(match.event.address)} fired ${formatOffset(match.offset)} late`,
+      help: `over the ${raw(grade.tolerance).toFixed(0)}ms allowed`,
+    });
+  }
+  for (const match of grade.early ?? []) {
+    diagnostics.warning({
+      code: "PF3713",
+      message: `${formatPin(match.event.address)} fired ${formatOffset(match.offset)} early`,
+      help: `over the ${raw(grade.tolerance).toFixed(0)}ms allowed`,
+    });
+  }
+  return diagnostics;
+}
