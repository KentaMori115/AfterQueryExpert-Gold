@@ -0,0 +1,299 @@
+import { describe, expect, it } from "vitest";
+import { calibre } from "../../src/catalog/calibre.js";
+import { shell } from "../../src/catalog/effect.js";
+import { Catalog } from "../../src/catalog/registry.js";
+import { effectId, positionId } from "../../src/core/ids.js";
+import { SourceFile } from "../../src/core/span.js";
+import { SMPTE_25, formatShowTime } from "../../src/core/timecode.js";
+import { mm, ms, raw } from "../../src/core/units.js";
+import { allocatePins } from "../../src/rig/allocate.js";
+import { firingModule, modelNamed } from "../../src/rig/module.js";
+import { pinAddress } from "../../src/rig/pin.js";
+import { Rig, firingPosition } from "../../src/rig/rig.js";
+import { expandScript } from "../../src/script/expand.js";
+import { parseScript } from "../../src/script/parser.js";
+import { resolveShots } from "../../src/script/resolve.js";
+import {
+  checkLog,
+  describeGrade,
+  formatOffset,
+  gradeLog,
+  parsePanelLog,
+  summariseGrade,
+} from "../../src/timeline/panelLog.js";
+import { quantiseSchedule } from "../../src/timeline/quantise.js";
+import { buildSchedule } from "../../src/timeline/schedule.js";
+
+const catalog = Catalog.from([
+  shell({ id: effectId("shell.150"), name: "six", calibre: calibre(mm(150)) }),
+]);
+
+const rig = Rig.from(
+  [firingPosition(positionId("pad.a"), 0, 0)],
+  [firingModule(1, modelNamed("fc-32")!, positionId("pad.a"))],
+);
+
+function scheduleOf(source: string) {
+  const parsed = parseScript(new SourceFile("show.pf", source));
+  const expanded = expandScript(parsed.script.statements, { seed: "t" });
+  const resolved = resolveShots(expanded.shots, catalog, rig);
+  return buildSchedule(
+    allocatePins(resolved.shots, rig, { packTight: true }).assignments,
+  );
+}
+
+const built = scheduleOf(
+  ["at 20 fire shell.150 from pad.a", "at 30 fire shell.150 from pad.a"].join(
+    "\n",
+  ),
+);
+
+/** A log of a show that ran exactly to the table, on the panel's own clock. */
+function cleanLog(schedule = built, slip: readonly number[] = []): string {
+  const rows = ["pin,fired"];
+  schedule.events.forEach((event, index) => {
+    const at =
+      raw(event.ignitionAt) + raw(schedule.preRoll) + (slip[index] ?? 0);
+    rows.push(
+      `0${event.address.module}.0${event.address.pin},${formatShowTime(ms(at))}`,
+    );
+  });
+  return rows.join("\n");
+}
+
+describe("parsePanelLog", () => {
+  it("reads what the panel wrote down", () => {
+    const log = parsePanelLog(
+      ["pin,fired", "01.01,0.000", "01.02,11.990"].join("\n"),
+      "log.csv",
+    );
+    expect(log.diagnostics.size).toBe(0);
+    expect(log.rows).toHaveLength(2);
+    expect(log.rows[0]?.address).toEqual(pinAddress(1, 1));
+    expect(raw(log.rows[0]!.at)).toBe(0);
+    expect(raw(log.rows[1]!.at)).toBe(11990);
+    expect(log.rows[1]?.line).toBe(3);
+  });
+
+  it("takes any of the pin column spellings a walk takes", () => {
+    for (const header of ["pin", "address", "cue", "output"]) {
+      expect(
+        parsePanelLog(`${header},fired\n01.01,4.0`, "log.csv").rows,
+      ).toHaveLength(1);
+    }
+  });
+
+  it("takes any of the time column spellings", () => {
+    for (const header of ["time", "fired", "at", "fired at", "Cue Time"]) {
+      expect(
+        parsePanelLog(`pin,${header}\n01.01,4.0`, "log.csv").rows,
+      ).toHaveLength(1);
+    }
+  });
+
+  it("reads every time form a panel writes", () => {
+    const log = parsePanelLog(
+      ["pin,at", "01.01,1:23.450", "01.02,90s", "01.03,250ms"].join("\n"),
+      "log.csv",
+    );
+    expect(log.rows.map((row) => raw(row.at))).toEqual([83450, 90000, 250]);
+  });
+
+  it("says so when there is no pin column or no time column", () => {
+    const log = parsePanelLog("a,b\n1,2", "log.csv");
+    expect(log.diagnostics.byCode("PF1420")).toHaveLength(1);
+    expect(log.rows).toEqual([]);
+  });
+
+  it("reports an unreadable pin and skips the row", () => {
+    const log = parsePanelLog(
+      ["pin,at", "nowhere,4.0", "01.02,5.0"].join("\n"),
+      "log.csv",
+    );
+    expect(log.diagnostics.byCode("PF1421")).toHaveLength(1);
+    expect(log.diagnostics.hasErrors()).toBe(true);
+    expect(log.rows).toHaveLength(1);
+  });
+
+  it("reports an unreadable time and skips the row", () => {
+    const log = parsePanelLog(
+      ["pin,at", "01.01,soon", "01.02,", "01.03,5.0"].join("\n"),
+      "log.csv",
+    );
+    expect(log.diagnostics.byCode("PF1422")).toHaveLength(2);
+    expect(log.rows).toHaveLength(1);
+  });
+});
+
+describe("gradeLog", () => {
+  const rowsOf = (text: string) => parsePanelLog(text, "log.csv").rows;
+
+  it("passes a log that matches the table", () => {
+    const grade = gradeLog(built, rowsOf(cleanLog()));
+    expect(grade.fired).toHaveLength(2);
+    expect(grade.missed).toEqual([]);
+    expect(grade.extra).toEqual([]);
+    expect(grade.late).toBeUndefined();
+    expect(grade.early).toBeUndefined();
+    expect(grade.worst).toBeUndefined();
+  });
+
+  it("keeps the cues in table order and holds the event and the row", () => {
+    const grade = gradeLog(built, rowsOf(cleanLog()));
+    expect(grade.fired.map((match) => match.event.address.pin)).toEqual([1, 2]);
+    expect(grade.fired[0]?.row.line).toBe(2);
+    expect(raw(grade.fired[0]!.offset)).toBe(0);
+  });
+
+  it("counts a cue with no row as missed", () => {
+    const grade = gradeLog(
+      built,
+      rowsOf(["pin,at", "01.01,15.970"].join("\n")),
+    );
+    expect(grade.missed).toHaveLength(1);
+    expect(grade.missed[0]?.address).toEqual(pinAddress(1, 2));
+  });
+
+  it("counts a row no cue claims as extra", () => {
+    const grade = gradeLog(
+      built,
+      rowsOf([cleanLog(), "01.09,40.0"].join("\n")),
+    );
+    expect(grade.extra).toHaveLength(1);
+    expect(grade.extra[0]?.address).toEqual(pinAddress(1, 9));
+  });
+
+  it("matches the earliest row on a pin and leaves the rest extra", () => {
+    const grade = gradeLog(
+      built,
