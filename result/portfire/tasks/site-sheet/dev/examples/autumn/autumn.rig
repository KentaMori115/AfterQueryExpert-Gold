# autumn 2025, water meadow, measured 14 september
# origin is the front left corner of the near rack

position pad.a at -70 0 near bank, left
position pad.b at 0 0 near bank, centre
position pad.c at 70 0 near bank, right
position pad.far at 0 90 far bank, reached by the footbridge

module 1 slat-50 at pad.a
module 2 slat-50 at pad.b
module 3 slat-50 at pad.c
module 4 fc-32 at pad.far
module 5 fc-32 at pad.far spare, wired to the waterfall frame

match standard
voltage 24
lead 35
