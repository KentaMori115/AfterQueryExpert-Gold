# autumn 2025, water meadow
# four minutes, cut to the recording in the shared folder

show autumn-2025
seed autumn-2025
frame 25

include "finale.pf"

# opening, one large shell alone over the far bank
at 4.0    fire shell.200.brocade from pad.far label opener

# the low work comes up while the opener is still hanging
at 8.0    fire gerb.silver from pad.b
at 8.0    fire waterfall.gold from pad.far
at 10.0   fan 5 of mine.100.gold from pad.b spread 900ms

# first verse, alternating banks
at 18.0   ripple 6 of shell.75.peony.red from pad.a every 400ms
at 21.0   ripple 6 of shell.75.crossette from pad.c every 400ms
at 24.5   fire shell.150.palm from pad.b label first-palm
at 27.0   fire cake.silver.25 from pad.a
at 31.0   fire cake.gold.36 from pad.c

# chorus, the six inch work
at 38.0   fire shell.150.palm from pad.a
at 38.5   fire shell.150.palm from pad.c
at 40.0   fire shell.150.kamuro from pad.b
at 43.0   chase shell.75.peony.red across pad.a pad.b pad.c every 300ms
at 46.0   fire shell.200.brocade from pad.far

# second verse, quieter, low work carries it
at 54.0   fire candle.10.blue from pad.a
at 54.0   fire candle.10.blue from pad.c
at 60.0   fire shell.100.willow from pad.b
at 64.0   fan 7 of shell.75.crossette from pad.b spread 1.6s
at 70.0   fire shell.150.kamuro from pad.far

# build
at 78.0   ripple 10 of shell.75.peony.red from pad.a every 260ms
at 81.0   ripple 10 of shell.75.crossette from pad.c every 260ms
at 84.0   fire shell.150.palm from pad.b
at 86.0   fire shell.200.brocade from pad.far

at 92.0   play finale
