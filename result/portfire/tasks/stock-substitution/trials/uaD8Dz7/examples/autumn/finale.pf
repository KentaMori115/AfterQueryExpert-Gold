# the finale, played from the main script so it can be rehearsed alone

group finale
  at 0.0   fan 9 of shell.75.peony.red from pad.b spread 1.2s
  at 0.6   ripple 8 of shell.75.crossette from pad.a every 180ms
  at 1.4   ripple 8 of shell.75.crossette from pad.c every 180ms
  at 2.4   chase mine.100.gold across pad.a pad.b pad.c every 240ms passes 2
  at 4.0   fire shell.200.brocade from pad.far
  at 4.6   ripple 6 of shell.150.kamuro from pad.b every 320ms
  at 6.4   fire shell.150.salute from pad.a
  at 6.4   fire shell.150.salute from pad.c
  at 7.0   fire shell.200.brocade from pad.far
end
