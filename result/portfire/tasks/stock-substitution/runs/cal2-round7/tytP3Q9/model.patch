+/**
+ * Which lot a draw comes out of first: the earliest received, then anything
+ * undated, then by lot number. A row without a received date is not
+ * necessarily old, it is a row somebody did not fill in, so it waits rather
+ * than jumping the queue.
+ */
+export function compareLotsByAge(a: Lot, b: Lot): number {
+  if (a.received !== b.received) {
+    if (a.received === undefined) {
+      return 1;
+    }
+    if (b.received === undefined) {
+      return -1;
+    }
+    return a.received < b.received ? -1 : 1;
+  }
+  return compareIds(a.lotNumber, b.lotNumber);
+}
+
 export class Magazine {
   private readonly lots: Lot[] = [];
 
@@ -117,6 +136,38 @@ export class Magazine {
     return removed;
   }
 
+  /**
+   * A copy, holding the same lots. A show drawn against a magazine spends its
+   * stock, and the book a caller handed in is a record rather than a working
+   * total, so the drawing happens against one of these.
+   */
+  copy(): Magazine {
+    return Magazine.from(this.lots.map((lot) => ({ ...lot })));
+  }
+
+  /**
+   * Take one unit of an effect out, oldest stock first, and say which lot it
+   * came out of. Nothing comes back when there is none left.
+   *
+   * Oldest first is how a store is worked rather than a preference. Stock that
+   * has sat longest goes out first, so what stays in the magazine after a show
+   * is the newest of it and no lot quietly ages out at the back. The lot comes
+   * back as it stood before the draw.
+   */
+  draw(effectId: string): Lot | undefined {
+    const oldest = this.lots
+      .filter((lot) => lot.effectId === effectId && lot.quantity > 0)
+      .sort(compareLotsByAge)[0];
+    if (oldest === undefined) {
+      return undefined;
+    }
+    this.lots[this.lots.indexOf(oldest)] = {
+      ...oldest,
+      quantity: oldest.quantity - 1,
+    };
+    return oldest;
+  }
+
   /** Stock held for effects the catalog does not define. */
   orphans(catalog: Catalog): string[] {
     return this.effectIds().filter((effectId) => !catalog.has(effectId));
