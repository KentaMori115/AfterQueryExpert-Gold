+
+  /**
+   * A copy holding the same lots. The book is a record of what is in the store,
+   * so anything that spends stock spends it here rather than there.
+   */
+  clone(): Magazine {
+    const copy = new Magazine();
+    for (const lot of this.lots) {
+      copy.lots.push(lot);
+    }
+    return copy;
+  }
