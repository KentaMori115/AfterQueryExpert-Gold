+      ),
+    );
+    expect(result.schedule.events.map((event) => event.effectId)).toEqual([
+      "shell.75.crossette",
+      "shell.75.ring",
+      "shell.80.willow",
+    ]);
+    expect(result.diagnostics.byCode("PF1601")).toHaveLength(2);
+    expect(result.diagnostics.byCode("PF1602")).toHaveLength(1);
+    const line = drawLineFor(drawOf(result), "shell.75.peony");
+    expect(line?.standIns.map((standIn) => standIn.effectId)).toEqual([
