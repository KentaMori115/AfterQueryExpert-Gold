+
+describe("reading a draw back", () => {
+  function drawFor(source: string, magazine: ReturnType<typeof book>): Draw {
+    const parsed = parseScript(new SourceFile("show.pf", source));
+    const expanded = expandScript(parsed.script.statements, { seed: "x" });
+    const resolved = resolveShots(expanded.shots, catalog, rig);
+    return drawShots(resolved.shots, catalog, magazine);
+  }
+
