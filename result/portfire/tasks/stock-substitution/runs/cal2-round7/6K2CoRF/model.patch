+    expect(result.ok).toBe(false);
+  });
+
+  it("raises one error per effect left short, however many shots that is", () => {
+    const result = run(
+      show(
+        "at 10 fire shell.150.palm from pad.a",
+        "at 11 fire shell.150.palm from pad.a",
+        "at 12 fire shell.75.peony from pad.a",
