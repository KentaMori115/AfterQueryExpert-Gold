+      new SourceFile("show.pf", show("at 10 fire shell.75.peony from pad.a")),
+    );
+    const expanded = expandScript(parsed.script.statements, { seed: "x" });
+    const resolved = resolveShots(expanded.shots, catalog, rig);
+    const draw = drawShots(
+      resolved.shots,
