+    "shell.75.crossette,shell,three inch crossette,75mm,crossette,1.8,60",
+    "shell.75.ring,shell,three inch ring,75mm,ring,1.8,60",
+    "shell.80.willow,shell,three inch willow,80mm,willow,1.8,64",
+    "shell.150.palm,shell,six inch palm,150mm,palm,2.4,140",
+  ].join("\n"),
+  "house.csv",
+).catalog;
+
+const rig = parseRig(
+  ["position pad.a at 0 0", "module 1 fc-32 at pad.a"].join("\n"),
+  "a.rig",
+).rig;
+
+function book(...rows: readonly string[]) {
+  const parsed = parseMagazine(
+    ["lot,effect,quantity,received", ...rows].join("\n"),
+    "book.csv",
+  );
+  expect(parsed.diagnostics.hasErrors()).toBe(false);
+  return parsed.magazine;
+}
+
+function show(...lines: readonly string[]): string {
+  return ["show autumn", ...lines].join("\n");
+}
+
+function run(
+  source: string,
+  magazine: ReturnType<typeof book>,
+  pull?: readonly string[],
