+    expect(result.assignments[0]?.shot.substitutedFor).toBe("shell.75.peony");
+    expect(result.schedule.events[0]?.effect.id).toBe("shell.80.willow");
+  });
+
+  it("compiles against the catalog alone when no magazine is given", () => {
+    const result = compile(
+      show("at 10 fire shell.75.peony from pad.a"),
+      "show.pf",
