+/**
+ * Drawing a show out of the magazine.
+ *
+ * The cases that matter are all about order. Which cue gets the last shell,
+ * which lot it comes out of, and when the drawer is allowed to start standing
+ * things in. Get any of those wrong and the show still compiles, which is what
+ * makes them worth testing rather than watching for.
+ */
+
+const catalog = parseCatalog(
