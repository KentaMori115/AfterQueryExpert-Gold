+/**
+ * A copy of the book with the named lots set aside, which is what happens the
+ * afternoon a lot is quarantined or found wet. Lot numbers are matched the way
+ * the book records them, folded to lower case, so a number read off the side
+ * of a case in capitals still pulls the right rows.
+ */
+export function withoutLots(
+  magazine: Magazine,
+  lotNumbers: Iterable<string>,
+): Magazine {
+  const left = magazine.copy();
+  for (const lotNumber of lotNumbers) {
+    left.quarantine(lotNumber.trim().toLowerCase());
+  }
+  return left;
+}
