+});
+const willow = shell({
+  id: effectId("shell.150.willow"),
+  name: "six willow",
+  calibre: calibre(mm(150)),
+  breakStyle: "willow",
+});
+const near = shell({
+  id: effectId("shell.160.peony"),
+  name: "six and a bit",
+  calibre: calibre(mm(160)),
+});
+
+const small = shell({
+  id: effectId("shell.75.peony"),
+  name: "three peony",
+  calibre: calibre(mm(75)),
+});
