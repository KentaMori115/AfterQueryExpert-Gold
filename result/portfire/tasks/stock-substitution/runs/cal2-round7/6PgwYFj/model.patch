+  });
+
+  it("puts a lot with no date last", () => {
+    const dated = {
+      lotNumber: "vn9",
+      effectId: "a",
+      quantity: 1,
+      received: "2025-01-01",
+    };
+    const undated = { lotNumber: "vn1", effectId: "a", quantity: 1 };
+    expect([undated, dated].sort(compareLots)[0]).toBe(dated);
+    expect([dated, undated].sort(compareLots)[0]).toBe(dated);
+  });
+
+  it("settles a tie on the lot number", () => {
+    const first = { lotNumber: "vn1", effectId: "a", quantity: 1 };
+    const second = { lotNumber: "vn2", effectId: "a", quantity: 1 };
+    expect([second, first].sort(compareLots)[0]).toBe(first);
+  });
+});
+
+describe("the magazine issuing stock", () => {
+  it("takes from the oldest lot until it is empty", () => {
+    const book = Magazine.from([
+      {
+        lotNumber: "vn2",
+        effectId: "shell.150.palm",
+        quantity: 1,
+        received: "2025-06-01",
+      },
+      {
+        lotNumber: "vn1",
+        effectId: "shell.150.palm",
+        quantity: 2,
+        received: "2025-01-01",
+      },
+    ]);
+    expect([
+      book.issue("shell.150.palm")?.lotNumber,
+      book.issue("shell.150.palm")?.lotNumber,
+      book.issue("shell.150.palm")?.lotNumber,
+    ]).toEqual(["vn1", "vn1", "vn2"]);
+    expect(book.issue("shell.150.palm")).toBeUndefined();
+    expect(book.onHand("shell.150.palm")).toBe(0);
