+    expect(draw.shots[0]?.effect).toBe("shell.150.willow");
+    expect(draw.shots[0]?.substitutedFor).toBe("shell.150.palm");
+  });
+
+  it("breaks a tie on cue time by the order the script wrote them", () => {
+    const book = Magazine.from([
+      {
+        lotNumber: "vn1",
+        effectId: "shell.150.palm",
+        quantity: 1,
+        received: "2025-01-01",
+      },
+      {
+        lotNumber: "vn2",
+        effectId: "shell.150.palm",
+        quantity: 1,
+        received: "2025-06-01",
+      },
+    ]);
+    const draw = drawStock([shot(palm, 1000), shot(palm, 1000)], catalog, book);
+    expect(draw.shots.map((entry) => entry.lot)).toEqual(["vn1", "vn2"]);
+  });
+
+  it("only stands in once every cue has had its own turn", () => {
+    const book = Magazine.from([
+      { lotNumber: "vn1", effectId: "shell.150.palm", quantity: 2 },
