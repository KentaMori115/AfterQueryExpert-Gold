+import { describe, expect, it } from "vitest";
+import { calibre } from "../../src/catalog/calibre.js";
+import { shell } from "../../src/catalog/effect.js";
+import type { Effect } from "../../src/catalog/effect.js";
+import {
+  checkDraw,
+  describeLots,
+  describeStandIn,
+  drawStock,
+} from "../../src/catalog/draw.js";
+import { Magazine, compareLots } from "../../src/catalog/inventory.js";
+import { Catalog } from "../../src/catalog/registry.js";
+import { effectId } from "../../src/core/ids.js";
+import { span } from "../../src/core/span.js";
+import { mm, ms } from "../../src/core/units.js";
+import type { ResolvedShot } from "../../src/script/resolve.js";
+
+const palm = shell({
+  id: effectId("shell.150.palm"),
+  name: "six palm",
+  calibre: calibre(mm(150)),
+  breakStyle: "palm",
+});
+const willow = shell({
+  id: effectId("shell.150.willow"),
