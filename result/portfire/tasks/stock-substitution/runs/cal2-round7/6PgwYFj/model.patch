+  id: effectId("shell.150.kamuro"),
+  name: "six kamuro",
+  calibre: calibre(mm(150)),
+  breakStyle: "kamuro",
+});
+const nearby = shell({
+  id: effectId("shell.170.peony"),
+  name: "a seven, in the same band and not the same calibre",
+  calibre: calibre(mm(170)),
+});
+
+const catalog = Catalog.from([palm, willow, kamuro, nearby]);
+
+function shot(effect: Effect, at: number): ResolvedShot {
+  return {
+    at: ms(at),
+    effect: effect.id,
+    position: "pad.a",
+    pin: { kind: "auto" },
+    index: 0,
+    origin: span(0, 1),
+    resolved: effect,
+  };
+}
+
