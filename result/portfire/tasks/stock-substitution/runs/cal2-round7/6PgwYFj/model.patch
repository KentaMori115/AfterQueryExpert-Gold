+    expect(book.onHand("shell.150.palm")).toBe(2);
+  });
+
+  it("says what is left in the store afterwards", () => {
+    const book = Magazine.from([
+      { lotNumber: "vn1", effectId: "shell.150.palm", quantity: 3 },
+    ]);
+    const draw = drawStock([shot(palm, 1000)], catalog, book);
+    expect(draw.remaining.onHand("shell.150.palm")).toBe(2);
+  });
+
+  it("draws the earliest cue first, so the shortfall lands late", () => {
+    const book = Magazine.from([
+      { lotNumber: "vn1", effectId: "shell.150.palm", quantity: 1 },
+      { lotNumber: "vn9", effectId: "shell.150.willow", quantity: 1 },
