+    expect(copy.onHand("shell.150.palm")).toBe(3);
+  });
+
+  it("leaves an empty lot out of the draw order", () => {
+    const book = Magazine.from([
+      { lotNumber: "vn1", effectId: "shell.150.palm", quantity: 0 },
