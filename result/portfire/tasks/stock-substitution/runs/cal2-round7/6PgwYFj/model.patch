+    ]);
+    const draw = drawStock(
+      [shot(palm, 1000), shot(palm, 2000), shot(palm, 3000)],
+      catalog,
+      book,
+    );
+    expect(draw.shots.map((entry) => entry.effect)).toEqual([
+      "shell.150.palm",
+      "shell.150.palm",
+      "shell.150.willow",
+    ]);
+  });
+
+  it("spends a stand in as it goes, so one shortfall can take several", () => {
+    const book = Magazine.from([
+      { lotNumber: "vn9", effectId: "shell.150.willow", quantity: 1 },
+      { lotNumber: "vn8", effectId: "shell.150.kamuro", quantity: 1 },
+    ]);
+    const draw = drawStock([shot(palm, 1000), shot(palm, 2000)], catalog, book);
+    expect(draw.shots.map((entry) => entry.effect).sort()).toEqual([
+      "shell.150.kamuro",
+      "shell.150.willow",
+    ]);
+    expect(draw.standIns.map((stood) => stood.effectId)).toEqual([
