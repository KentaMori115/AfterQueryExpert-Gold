--- a/tests/export/explain.test.ts
+++ b/tests/export/explain.test.ts
@@ -170,3 +170,30 @@ describe("neighbours", () => {
     expect(table).toContain("02.01");
   });
 });
+
+describe("explaining a cue that was drawn from a magazine", () => {
+  const drawn = explainEvent(
+    {
+      ...built.events[0]!,
+      lot: "vn2405",
+      substitutedFor: "shell.150.brocade",
+    },
+    built,
+  );
+
+  it("names the lot the shell came out of", () => {
+    expect(drawn).toContain("lot");
+    expect(drawn).toContain("vn2405");
+  });
+
+  it("names what the script asked for", () => {
+    expect(drawn).toContain("standing in for");
+    expect(drawn).toContain("shell.150.brocade");
+  });
+
+  it("says neither when the show was compiled without stock", () => {
+    const plain = explainEvent(built.events[0]!, built);
+    expect(plain).not.toContain("standing in for");
+    expect(plain).not.toContain("vn2405");
+  });
+});
diff --git a/tests/export/json.test.ts b/tests/export/json.test.ts
index b4f74a7..a77e38b 100644
