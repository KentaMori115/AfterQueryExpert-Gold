@@ -190,3 +190,24 @@ describe("isQuantised", () => {
     );
   });
 });
+
+describe("a show that was drawn from a magazine", () => {
+  const show = toJsonShow({
+    ...built,
+    events: built.events.map((event, index) =>
+      index === 0
+        ? { ...event, lot: "vn2405", substitutedFor: "shell.150.brocade" }
+        : event,
+    ),
+  });
+
+  it("carries the lot and what was asked for", () => {
+    expect(show.events[0]?.lot).toBe("vn2405");
+    expect(show.events[0]?.substitutedFor).toBe("shell.150.brocade");
+  });
+
+  it("leaves both off a cue that drew nothing", () => {
+    expect("lot" in (show.events[1] ?? {})).toBe(false);
+    expect("substitutedFor" in (show.events[1] ?? {})).toBe(false);
+  });
+});
diff --git a/tests/export/sheets.test.ts b/tests/export/sheets.test.ts
index e3940fe..276b728 100644
--- a/tests/export/sheets.test.ts
+++ b/tests/export/sheets.test.ts
@@ -163,3 +163,44 @@ describe("positionSheets", () => {
     expect(positionSheets(scheduleOf("")).size).toBe(0);
   });
 });
+
+describe("a cue sheet for a show drawn from a magazine", () => {
+  const drawn = {
+    ...built,
+    events: built.events.map((event, index) => ({
+      ...event,
+      lot: index === 0 ? "vn2405" : "vn2413",
+    })),
+  };
+
+  it("grows a lot column", () => {
+    const lines = cueSheet(drawn).split("\n");
+    expect(lines[0]).toContain("lot");
+    expect(lines[2]).toContain("vn2405");
+    expect(lines[3]).toContain("vn2413");
+  });
+
+  it("has no lot column when nothing was drawn", () => {
+    expect(cueSheet(built).split("\n")[0]).not.toContain("lot");
+  });
+
+  it("can be told to leave the column off", () => {
+    expect(cueSheet(drawn, { showLot: false })).not.toContain("vn2405");
+  });
+
+  it("can be told to print the column anyway", () => {
+    expect(cueSheet(built, { showLot: true }).split("\n")[0]).toContain("lot");
+  });
+
+  it("leaves the lot blank on a cue that drew nothing", () => {
+    const half = {
+      ...built,
+      events: built.events.map((event, index) =>
+        index === 0 ? { ...event, lot: "vn2405" } : event,
+      ),
+    };
+    const lines = cueSheet(half).split("\n");
+    expect(lines[2]).toContain("vn2405");
+    expect(lines[3]).not.toContain("vn");
+  });
+});
