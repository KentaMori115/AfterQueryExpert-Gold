+  });
+
+  it("settles two cues on one beat by the order they were written", () => {
+    const draw = drawShots(
+      shotsFrom(
+        [
+          "at 10 fire shell.150.palm from pad.a label first",
+          "at 10 fire shell.150.palm from pad.a label second",
+        ].join("\n"),
+      ),
+      catalog,
+      bookWith([{ lotNumber: "vn1", effectId: "shell.150.palm", quantity: 1 }]),
+    );
