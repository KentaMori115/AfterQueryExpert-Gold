+          lotNumber: "vn8",
+          effectId: "shell.150.palm",
+          quantity: 1,
+          received: "2025-04-02",
+        },
+        {
+          lotNumber: "vn7",
+          effectId: "shell.150.palm",
+          quantity: 1,
+          received: "2025-04-02",
+        },
