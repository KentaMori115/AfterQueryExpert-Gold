+  const stock = [
+    { lotNumber: "vn1", effectId: "shell.150.palm", quantity: 1 },
+    { lotNumber: "vn2", effectId: "shell.150.aster", quantity: 1 },
+    { lotNumber: "vn3", effectId: "shell.150.willow", quantity: 1 },
