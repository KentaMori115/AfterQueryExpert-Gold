+import { describe, expect, it } from "vitest";
+import { calibre } from "../../src/catalog/calibre.js";
+import {
+  compareIssueOrder,
+  describeDraw,
+  drawShots,
+  withoutLots,
+} from "../../src/catalog/draw.js";
+import { shell } from "../../src/catalog/effect.js";
+import { Magazine } from "../../src/catalog/inventory.js";
+import type { Lot } from "../../src/catalog/inventory.js";
+import { Catalog } from "../../src/catalog/registry.js";
+import { effectId, positionId } from "../../src/core/ids.js";
+import { SourceFile } from "../../src/core/span.js";
+import { mm } from "../../src/core/units.js";
+import { firingModule, modelNamed } from "../../src/rig/module.js";
+import { Rig, firingPosition } from "../../src/rig/rig.js";
+import { expandScript } from "../../src/script/expand.js";
+import { parseScript } from "../../src/script/parser.js";
+import { resolveShots } from "../../src/script/resolve.js";
+import type { ResolvedShot } from "../../src/script/resolve.js";
+
+/**
+ * The draw is the point where a show stops being a design and becomes the
+ * shells the crew has in the van, so most of these tests are about order:
+ * which cue gets first refusal, and which lot leaves the store first.
+ */
+
+const palm = shell({
+  id: effectId("shell.150.palm"),
+  name: "six palm",
+  calibre: calibre(mm(150)),
+  breakStyle: "palm",
+});
+const aster = shell({
+  id: effectId("shell.150.aster"),
+  name: "six aster",
+  calibre: calibre(mm(150)),
+});
+const willow = shell({
+  id: effectId("shell.150.willow"),
+  name: "six willow",
+  calibre: calibre(mm(150)),
+  breakStyle: "willow",
+});
+const wide = shell({
+  id: effectId("shell.160.peony"),
+  name: "six and a bit",
+  calibre: calibre(mm(160)),
+});
+const catalog = Catalog.from([palm, aster, willow, wide]);
+const rig = Rig.from(
+  [firingPosition(positionId("pad.a"), 0, 0)],
+  Array.from({ length: 2 }, (_, i) =>
+    firingModule(i + 1, modelNamed("fc-32")!, positionId("pad.a")),
+  ),
+);
+
+function shotsFrom(source: string): readonly ResolvedShot[] {
+  const parsed = parseScript(new SourceFile("show.pf", source));
+  const expanded = expandScript(parsed.script.statements, { seed: "t" });
+  const resolved = resolveShots(expanded.shots, catalog, rig);
+  expect(resolved.diagnostics.errorCount).toBe(0);
+  return resolved.shots;
+}
+
+function fire(times: readonly number[], effect = "shell.150.palm"): string {
+  return times.map((at) => `at ${at} fire ${effect} from pad.a`).join("\n");
+}
+
+function bookWith(lots: readonly Lot[]): Magazine {
+  return Magazine.from(lots);
+}
+
+describe("drawing what the script asked for", () => {
+  it("gives every cue a lot while the stock lasts", () => {
+    const draw = drawShots(
+      shotsFrom(fire([10, 12])),
+      catalog,
+      bookWith([
+        { lotNumber: "vn2405", effectId: "shell.150.palm", quantity: 2 },
+      ]),
