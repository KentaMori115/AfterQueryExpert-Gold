+  shell({
+    id: effectId("shell.150.palm"),
+    name: "palm",
+    calibre: calibre(mm(150)),
+    breakStyle: "palm",
+  }),
+  shell({
+    id: effectId("shell.150.peony"),
+    name: "peony",
+    calibre: calibre(mm(150)),
+  }),
+  shell({
+    id: effectId("shell.150.ring"),
+    name: "ring",
+    calibre: calibre(mm(150)),
+    breakStyle: "ring",
+  }),
+  // A seven, which is the same handling band and a different calibre.
+  shell({
+    id: effectId("shell.175.peony"),
+    name: "seven",
+    calibre: calibre(mm(175)),
+  }),
+  // A three, which is neither.
+  shell({
