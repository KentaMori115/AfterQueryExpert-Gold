diff --git a/tests/cli/magazine.test.ts b/tests/cli/magazine.test.ts
new file mode 100644
index 0000000..acf0c89
--- /dev/null
+++ b/tests/cli/magazine.test.ts
@@ -0,0 +1,264 @@
+import { describe, expect, it } from "vitest";
+import {
+  EXIT_BAD_USAGE,
+  EXIT_OK,
+  EXIT_SHOW_PROBLEM,
+  runCommand,
+} from "../../src/cli/command.js";
+import { MemoryEnv } from "../../src/cli/env.js";
+import { buildCommands } from "../../src/cli/registry.js";
+
+/**
+ * The show commands read against stock.
+ *
+ * Every command that reads a show takes the book, because a crew that has been
+ * given a stand-in by `inventory` and a cue sheet by `sheet` that still names
+ * the design has been given two different shows.
+ */
+
+const commands = buildCommands();
+
+const CATALOG = [
+  "id,kind,name,calibre,break,hang,diameter",
+  "shell.150.palm,shell,six inch palm,150mm,palm,2.4,140",
+  "shell.150.peony,shell,six inch peony,150mm,peony,2.4,140",
+  "shell.75.peony,shell,three inch,75mm,peony,1.8,60",
+].join("\n");
+
+const RIG = ["position pad.a at 0 0", "module 1 fc-16 at pad.a"].join("\n");
+
+const SHOW = [
+  "show autumn",
+  "at 20 fire shell.150.palm from pad.a label opener",
+  "at 24 fire shell.150.palm from pad.a",
+].join("\n");
+
+const BOOK = [
+  "lot,effect,quantity,received,note",
+  "vn2405,shell.150.palm,1,2025-04-02,",
+  "vn2413,shell.150.peony,4,2025-05-06,",
+].join("\n");
+
+function envWith(over: Record<string, string> = {}): MemoryEnv {
+  return new MemoryEnv({
+    "house.csv": CATALOG,
+    "autumn.rig": RIG,
+    "autumn.pf": SHOW,
+    "book.csv": BOOK,
+    ...over,
+  });
+}
+
+const base = ["--catalog", "house.csv", "--rig", "autumn.rig"];
+
+describe("check against a book", () => {
+  it("draws the show and notes the stand-in", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "book.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_OK);
+    expect(env.stderr).toContain("PF1601");
+    expect(env.stderr).toContain("shell.150.palm short 1, use shell.150.peony");
+    expect(env.stdout).toContain("ready");
+  });
+
+  it("says nothing about stock without a book", () => {
+    const env = envWith();
+    expect(runCommand(commands, ["check", "autumn.pf", ...base], env)).toBe(
+      EXIT_OK,
+    );
+    expect(env.stderr).toBe("");
+  });
+
+  it("sets a lot aside on request and finds what that costs", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        [
+          "check",
+          "autumn.pf",
+          "--magazine",
+          "book.csv",
+          "--pull",
+          "vn2405, vn9999",
+          ...base,
+        ],
+        env,
+      ),
+    ).toBe(EXIT_OK);
+    // Both palms now come off the peony shelf rather than one of each.
+    expect(env.stderr).toContain("shell.150.palm short 2, use shell.150.peony");
+  });
+
+  it("will not pull a lot with no book to pull it from", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["check", "autumn.pf", "--pull", "vn2405", ...base],
+      env,
+    );
+    expect(env.stderr).toContain("--pull needs a --magazine");
+  });
+
+  it("is not ready when the book cannot cover a cue at all", () => {
+    const env = envWith({
+      "empty.csv": ["lot,effect,quantity", "vn1,shell.75.peony,4"].join("\n"),
+    });
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "empty.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("PF1600");
+    expect(env.stdout).toContain("not ready");
+  });
+
+  it("reports a book it cannot read as a usage problem", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "gone.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_BAD_USAGE);
+    expect(env.stderr).toContain("cannot read the magazine book at gone.csv");
+  });
+
+  it("does not draw against a book that will not parse", () => {
+    const env = envWith({ "broken.csv": "lot,effect\nvn1,shell.150.palm" });
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "broken.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("PF1301");
+    expect(env.stderr).not.toContain("PF1600");
+  });
+});
+
+describe("the sheet a crew carries", () => {
+  it("grows a lot column once a book is given", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["sheet", "autumn.pf", "--magazine", "book.csv", ...base],
+      env,
+    );
+    expect(env.stdout).toContain("lot");
+    expect(env.stdout).toContain("vn2405");
+    expect(env.stdout).toContain("vn2413");
+  });
+
+  it("has no lot column without one", () => {
+    const env = envWith();
+    runCommand(commands, ["sheet", "autumn.pf", ...base], env);
+    expect(env.stdout).not.toContain("vn2405");
+  });
+
+  it("keeps the column on a position sheet", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      [
+        "sheet",
+        "autumn.pf",
+        "--kind",
+        "position",
+        "--magazine",
+        "book.csv",
+        ...base,
+      ],
+      env,
+    );
+    expect(env.stdout).toContain("vn2405");
+  });
+
+  it("prints the stand-in rather than the design", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["sheet", "autumn.pf", "--magazine", "book.csv", ...base],
+      env,
+    );
+    expect(env.stdout).toContain("6in peony");
+  });
+});
+
+describe("inventory against a book", () => {
+  it("says which lots a stand-in came out of", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["inventory", "autumn.pf", "--magazine", "book.csv", ...base],
+      env,
+    );
+    expect(env.stdout).toContain(
+      "shell.150.palm short 1, drawn as shell.150.peony from vn2413",
+    );
+    expect(env.stdout).toContain("everything on the shot list is in stock");
+  });
+
+  it("has nothing spare to list when the draw used every line", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["inventory", "autumn.pf", "--magazine", "book.csv", "--unused", ...base],
+      env,
+    );
+    expect(env.stdout).toContain(
+      "every line in the magazine is used by this show",
+    );
+  });
+
+  it("counts a pulled lot as stock the show cannot have", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        [
+          "inventory",
+          "autumn.pf",
+          "--magazine",
+          "book.csv",
+          "--pull",
+          "vn2413",
+          ...base,
+        ],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("short 1 of shell.150.palm");
+    const line = env.stdout
+      .split("\n")
+      .find((row) => row.startsWith("shell.150.palm"));
+    expect(line?.trim().split(/\s+/)).toEqual([
+      "shell.150.palm",
+      "2",
+      "1",
+      "1",
+    ]);
+  });
+
+  it("counts what the show will actually take off the shelf", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["inventory", "autumn.pf", "--magazine", "book.csv", ...base],
+      env,
+    );
+    const line = env.stdout
+      .split("\n")
+      .find((row) => row.startsWith("shell.150.peony"));
+    expect(line?.trim().split(/\s+/)).toEqual(["shell.150.peony", "1", "4"]);
+  });
+});
