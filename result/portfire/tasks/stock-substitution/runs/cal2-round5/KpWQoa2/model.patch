+++ b/tests/cli/magazine.test.ts
@@ -0,0 +1,240 @@
+import { describe, expect, it } from "vitest";
+import {
+  EXIT_BAD_USAGE,
+  EXIT_OK,
+  EXIT_SHOW_PROBLEM,
+  runCommand,
+} from "../../src/cli/command.js";
+import { MemoryEnv } from "../../src/cli/env.js";
+import { buildCommands } from "../../src/cli/registry.js";
+
+/**
+ * The magazine on the command line.
+ *
+ * Every show command can be given a book to fire out of, so the interesting
+ * cases are the ones where the book and the script disagree: the crew is short,
+ * a lot has been recalled, or the book itself will not load.
+ */
+
+const commands = buildCommands();
+
+const CATALOG = [
+  "id,kind,name,calibre,break,hang,diameter",
+  "shell.150.palm,shell,six inch palm,150mm,palm,2.4,140",
+  "shell.150.kamuro,shell,six inch kamuro,150mm,kamuro,4.2,132",
+  "shell.75.peony,shell,three inch,75mm,peony,1.8,60",
+].join("\n");
+
+const RIG = [
+  "position pad.a at 0 0",
+  "module 1 fc-16 at pad.a",
+  "module 2 fc-16 at pad.a",
+].join("\n");
+
+const SHOW = [
+  "show autumn",
+  "at 20 fire shell.150.palm from pad.a label one",
+  "at 22 fire shell.150.palm from pad.a label two",
+  "at 24 fire shell.150.palm from pad.a label three",
+].join("\n");
+
+/** Two palms and plenty of kamuro, so the third cue has to stand in. */
+const BOOK = [
+  "lot,effect,quantity,received,note",
+  "vn2405,shell.150.palm,2,2025-04-02,",
+  "vn2413,shell.150.kamuro,6,2025-04-03,",
+].join("\n");
+
+/** Nothing but three inch shells, which cannot stand in for a six. */
+const WRONG = ["lot,effect,quantity", "vn2500,shell.75.peony,40"].join("\n");
+
+function envWith(over: Record<string, string> = {}): MemoryEnv {
+  return new MemoryEnv({
+    "house.csv": CATALOG,
+    "autumn.rig": RIG,
+    "autumn.pf": SHOW,
+    "book.csv": BOOK,
+    "wrong.csv": WRONG,
+    ...over,
+  });
+}
+
+const base = ["--catalog", "house.csv", "--rig", "autumn.rig"];
+
+describe("a show drawn from the book", () => {
+  it("stands a shell in and still reads as ready", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "book.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_OK);
+    expect(env.stderr).toContain("PF1601");
+    expect(env.stderr).toContain(
+      "shell.150.palm short 1, use shell.150.kamuro",
+    );
+  });
+
+  it("is not ready when nothing in the book can cover a cue", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "wrong.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("PF1600");
+    expect(env.stdout).toContain("not ready");
+  });
+
+  it("is ready with no book at all, because the catalog never runs out", () => {
+    const env = envWith();
+    expect(runCommand(commands, ["check", "autumn.pf", ...base], env)).toBe(
+      EXIT_OK,
+    );
+  });
+
+  it("sets a pulled lot aside", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        [
+          "check",
+          "autumn.pf",
+          "--magazine",
+          "book.csv",
+          "--pull",
+          "VN2405",
+          ...base,
+        ],
+        env,
+      ),
+    ).toBe(EXIT_OK);
+    expect(env.stderr).toContain(
+      "shell.150.palm short 3, use shell.150.kamuro",
+    );
+  });
+
+  it("warns about a pulled lot the book does not hold", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      [
+        "check",
+        "autumn.pf",
+        "--magazine",
+        "book.csv",
+        "--pull",
+        "vn9999",
+        ...base,
+      ],
+      env,
+    );
+    expect(env.stderr).toContain("PF1603");
+  });
+
+  it("refuses a pull with no book to pull from", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--pull", "vn2405", ...base],
+        env,
+      ),
+    ).toBe(EXIT_BAD_USAGE);
+    expect(env.stderr).toContain("--pull needs --magazine");
+  });
+
+  it("reports a book it cannot read", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "gone.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_BAD_USAGE);
+    expect(env.stderr).toContain("cannot read the magazine book at gone.csv");
+  });
+
+  it("draws nothing from a book that will not load", () => {
+    const env = envWith({ "broken.csv": "lot,effect\nvn1,shell.150.palm" });
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "broken.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("PF1301");
+    expect(env.stderr).not.toContain("PF1600");
+  });
+});
+
+describe("the cue sheet with a book", () => {
+  it("grows a lot column", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["sheet", "autumn.pf", "--magazine", "book.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_OK);
+    expect(env.stdout).toContain("lot");
+    expect(env.stdout).toContain("vn2405");
+    expect(env.stdout).toContain("6in kamuro");
+  });
+
+  it("has no lot column without one", () => {
+    const env = envWith();
+    runCommand(commands, ["sheet", "autumn.pf", ...base], env);
+    expect(env.stdout).not.toContain("vn2405");
+    const header = env.stdout
+      .split("\n")
+      .find((line) => line.includes("position"));
+    expect(header).not.toContain("lot");
+  });
+
+  it("keeps the column even when a cue went short", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["sheet", "autumn.pf", "--magazine", "wrong.csv", ...base],
+      env,
+    );
+    const header = env.stdout
+      .split("\n")
+      .find((line) => line.includes("position"));
+    expect(header).toContain("lot");
+  });
+});
+
+describe("inventory against a drawn show", () => {
+  it("says what stood in for what", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["inventory", "autumn.pf", "--magazine", "book.csv", ...base],
+      env,
+    );
+    expect(env.stdout).toContain("firing shell.150.kamuro instead");
+    expect(env.stdout).toContain("everything on the shot list is in stock");
+  });
+
+  it("still counts the shortfall nothing could cover", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["inventory", "autumn.pf", "--magazine", "wrong.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("short 3 of shell.150.palm");
+  });
+});
