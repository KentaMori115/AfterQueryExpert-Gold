+  breakStyle: "kamuro",
+});
+const willow = shell({
+  id: effectId("shell.150.willow"),
+  name: "six willow",
+  calibre: calibre(mm(150)),
+  breakStyle: "willow",
+});
+const peony = shell({
+  id: effectId("shell.75.peony"),
+  name: "three peony",
+  calibre: calibre(mm(75)),
+});
