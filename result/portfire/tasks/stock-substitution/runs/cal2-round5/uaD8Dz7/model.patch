diff --git a/tests/cli/magazine.test.ts b/tests/cli/magazine.test.ts
new file mode 100644
index 0000000..3dbbffd
--- /dev/null
+++ b/tests/cli/magazine.test.ts
@@ -0,0 +1,231 @@
+import { describe, expect, it } from "vitest";
+import {
+  EXIT_BAD_USAGE,
+  EXIT_OK,
+  EXIT_SHOW_PROBLEM,
+  runCommand,
+} from "../../src/cli/command.js";
+import { MemoryEnv } from "../../src/cli/env.js";
+import { buildCommands } from "../../src/cli/registry.js";
+import { parseArgs } from "../../src/cli/args.js";
+import { SHOW_FLAGS, pulledLots } from "../../src/cli/commands/common.js";
+
+const commands = buildCommands();
+
+const CATALOG = [
+  "id,kind,name,calibre,break,hang,diameter",
+  "shell.150.red,shell,six red,150mm,peony,2.4,140",
+  "shell.150.blue,shell,six blue,150mm,peony,2.4,140",
+  "shell.75,shell,three inch,75mm,peony,1.8,60",
+].join("\n");
+
+const RIG = ["position pad.a at 0 0", "module 1 fc-16 at pad.a"].join("\n");
+
+const SHOW = [
+  "show autumn",
+  "at 20 ripple 3 of shell.150.red from pad.a every 500ms",
+].join("\n");
+
+const BOOK = [
+  "lot,effect,quantity,received",
+  "VN2405,shell.150.red,1,2025-04-02",
+  "vn2413,shell.150.blue,4,2025-05-02",
+].join("\n");
+
+function envWith(over: Record<string, string> = {}): MemoryEnv {
+  return new MemoryEnv({
+    "house.csv": CATALOG,
+    "autumn.rig": RIG,
+    "autumn.pf": SHOW,
+    "book.csv": BOOK,
+    ...over,
+  });
+}
+
+const base = ["--catalog", "house.csv", "--rig", "autumn.rig"];
+
+describe("--magazine", () => {
+  it("draws the show and notes the stand-ins", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "book.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_OK);
+    expect(env.stderr).toContain("PF1601");
+    expect(env.stderr).toContain("shell.150.blue");
+  });
+
+  it("says what the draw did among the numbers", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["check", "autumn.pf", "--stats", "--magazine", "book.csv", ...base],
+      env,
+    );
+    expect(env.stdout).toContain("magazine    2 cues drew a stand-in");
+  });
+
+  it("says nothing about the magazine when none was given", () => {
+    const env = envWith();
+    runCommand(commands, ["check", "autumn.pf", "--stats", ...base], env);
+    expect(env.stdout).not.toContain("magazine");
+  });
+
+  it("puts the lot on the cue sheet", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["sheet", "autumn.pf", "--magazine", "book.csv", ...base],
+      env,
+    );
+    expect(env.stdout).toContain("lot");
+    expect(env.stdout).toContain("vn2405");
+    expect(env.stdout).toContain("vn2413");
+  });
+
+  it("keeps the lot column on a per position sheet", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      [
+        "sheet",
+        "autumn.pf",
+        "--kind",
+        "position",
+        "--magazine",
+        "book.csv",
+        ...base,
+      ],
+      env,
+    );
+    expect(env.stdout).toContain("vn2405");
+  });
+
+  it("stops the show when nothing in stock covers a cue", () => {
+    const env = envWith({
+      "thin.csv": ["lot,effect,quantity", "vn1,shell.75,10"].join("\n"),
+    });
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "thin.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("PF1600");
+    expect(env.stdout).toContain("not ready");
+  });
+
+  it("reports a book it cannot read the same way as any other file", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "gone.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_BAD_USAGE);
+    expect(env.stderr).toContain("cannot read the magazine book at gone.csv");
+  });
+
+  it("does not draw from a book that will not parse", () => {
+    const env = envWith({ "broken.csv": "lot,effect\nvn1,shell.150.red" });
+    expect(
+      runCommand(
+        commands,
+        ["check", "autumn.pf", "--magazine", "broken.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stderr).toContain("PF1301");
+    expect(env.stderr).not.toContain("PF1600");
+  });
+
+  it("explains a cue in terms of the shell that is really in the tube", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["explain", "autumn.pf", "3", "--magazine", "book.csv", ...base],
+      env,
+    );
+    expect(env.stdout).toContain("stands in for");
+    expect(env.stdout).toContain("shell.150.red");
+  });
+});
+
+describe("--pull", () => {
+  it("sets a lot aside before the show is drawn", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      [
+        "sheet",
+        "autumn.pf",
+        "--magazine",
+        "book.csv",
+        "--pull",
+        "VN2405, vn9999",
+        ...base,
+      ],
+      env,
+    );
+    expect(env.stdout).not.toContain("vn2405");
+    expect(env.stdout).toContain("vn2413");
+  });
+
+  it("shows up on the inventory as stock set aside", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        [
+          "inventory",
+          "autumn.pf",
+          "--magazine",
+          "book.csv",
+          "--pull",
+          "vn2413",
+          ...base,
+        ],
+        env,
+      ),
+    ).toBe(EXIT_SHOW_PROBLEM);
+    expect(env.stdout).toContain("set aside: vn2413");
+    expect(env.stderr).toContain("short 2 of shell.150.red");
+  });
+
+  it("counts the stand-ins as what the show consumes", () => {
+    const env = envWith();
+    expect(
+      runCommand(
+        commands,
+        ["inventory", "autumn.pf", "--magazine", "book.csv", ...base],
+        env,
+      ),
+    ).toBe(EXIT_OK);
+    const line = env.stdout
+      .split("\n")
+      .find((row) => row.startsWith("shell.150.blue"));
+    expect(line?.trim().split(/\s+/)).toEqual(["shell.150.blue", "2", "4"]);
+    expect(env.stdout).toContain("everything on the shot list is in stock");
+  });
+
+  it("says so when the show uses every line in the book", () => {
+    const env = envWith();
+    runCommand(
+      commands,
+      ["inventory", "autumn.pf", "--magazine", "book.csv", "--unused", ...base],
+      env,
+    );
+    expect(env.stdout).toContain("every line in the magazine is used");
+  });
+
+  it("reads a list of lot numbers the way a recall notice is written", () => {
+    const args = parseArgs(["--pull", " VN1 ,vn2,"], SHOW_FLAGS);
+    expect(pulledLots(args)).toEqual(["vn1", "vn2"]);
+    expect(pulledLots(parseArgs([], SHOW_FLAGS))).toEqual([]);
+  });
+});
