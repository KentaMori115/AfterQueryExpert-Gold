+/**
+ * The order stock goes out in: oldest received first, undated last, and by lot
+ * number when two arrived on the same day.
+ *
+ * Oldest first is not a preference. A composition ages, and the lot that has
+ * sat in the store for three seasons is the one to shoot while it is still
+ * what the catalog says it is. Undated rows go last, because an undated row is
+ * an old row whose date was never written down and guessing it is the oldest
+ * would send a whole show out of one mystery lot.
+ */
+export function compareIssueOrder(a: Lot, b: Lot): number {
+  if (a.received !== b.received) {
+    if (a.received === undefined) {
+      return 1;
+    }
+    if (b.received === undefined) {
+      return -1;
+    }
+    return a.received < b.received ? -1 : 1;
+  }
+  return compareIds(a.lotNumber, b.lotNumber);
+}
