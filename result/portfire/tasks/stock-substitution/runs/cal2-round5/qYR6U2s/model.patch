index 0000000..fc76f2e
--- /dev/null
+++ b/tests/catalog/draw.test.ts
@@ -0,0 +1,502 @@
+import { describe, expect, it } from "vitest";
+import { calibre } from "../../src/catalog/calibre.js";
+import { describeDraw, drawShow } from "../../src/catalog/draw.js";
+import { shell } from "../../src/catalog/effect.js";
+import { Magazine } from "../../src/catalog/inventory.js";
+import type { Lot } from "../../src/catalog/inventory.js";
+import { Catalog } from "../../src/catalog/registry.js";
+import { compile } from "../../src/compile.js";
+import { effectId, positionId } from "../../src/core/ids.js";
+import { SourceFile } from "../../src/core/span.js";
+import { mm, raw } from "../../src/core/units.js";
+import { toJsonShow } from "../../src/export/json.js";
+import { cueSheet } from "../../src/export/sheets.js";
+import { firingModule, modelNamed } from "../../src/rig/module.js";
+import { Rig, firingPosition } from "../../src/rig/rig.js";
+import { expandScript } from "../../src/script/expand.js";
+import { parseScript } from "../../src/script/parser.js";
+import { resolveShots } from "../../src/script/resolve.js";
+import { timingOf } from "../../src/catalog/timing.js";
+
+/**
+ * Drawing a show out of a magazine.
+ *
+ * The fixture is four six inch shells and one seven, because that is the shape
+ * of the real problem: several things that are interchangeable, one that is
+ * nearly interchangeable, and one that nothing in the store can stand in for.
+ */
+
+const palm = shell({
+  id: effectId("shell.150.palm"),
+  name: "six palm",
+  calibre: calibre(mm(150)),
+  breakStyle: "palm",
+});
+const kamuro = shell({
+  id: effectId("shell.150.kamuro"),
+  name: "six kamuro",
+  calibre: calibre(mm(150)),
+  breakStyle: "kamuro",
+});
+const willow = shell({
+  id: effectId("shell.150.willow"),
+  name: "six willow",
+  calibre: calibre(mm(150)),
+  breakStyle: "willow",
+});
+const seven = shell({
+  id: effectId("shell.175.comet"),
+  name: "seven comet",
+  calibre: calibre(mm(175)),
+});
+const three = shell({
+  id: effectId("shell.75.peony"),
+  name: "three peony",
+  calibre: calibre(mm(75)),
+});
+
+const catalog = Catalog.from([palm, kamuro, willow, seven, three]);
+const rig = Rig.from(
+  [firingPosition(positionId("pad.a"), 0, 0)],
+  [
+    firingModule(1, modelNamed("fc-32")!, positionId("pad.a")),
+    firingModule(2, modelNamed("fc-32")!, positionId("pad.a")),
+  ],
+);
+
+function lot(
+  lotNumber: string,
+  effect: string,
+  quantity: number,
+  received?: string,
+): Lot {
+  return {
+    lotNumber,
+    effectId: effect,
+    quantity,
+    ...(received === undefined ? {} : { received }),
+  };
+}
+
+function book(...lots: Lot[]): Magazine {
+  return Magazine.from(lots);
+}
+
+function shotsOf(source: string) {
+  const parsed = parseScript(new SourceFile("s.pf", source));
+  const expanded = expandScript(parsed.script.statements, { seed: "t" });
+  return resolveShots(expanded.shots, catalog, rig).shots;
+}
+
+function three150(): string {
+  return [
+    "at 10 fire shell.150.palm from pad.a label one",
+    "at 12 fire shell.150.palm from pad.a label two",
+    "at 14 fire shell.150.palm from pad.a label three",
+  ].join("\n");
+}
+
+describe("drawing what the script asked for", () => {
+  it("issues every cue a lot while the stock lasts", () => {
+    const draw = drawShow(shotsOf(three150()), {
+      catalog,
+      magazine: book(lot("vn1", "shell.150.palm", 3, "2025-01-01")),
+    });
+    expect(draw.shots.map((shot) => shot.lot)).toEqual(["vn1", "vn1", "vn1"]);
+    expect(draw.drawn).toBe(3);
+    expect(draw.diagnostics.size).toBe(0);
+    expect(draw.substitutions).toEqual([]);
+    expect(draw.shortfalls).toEqual([]);
+  });
+
+  it("runs the lot received earliest out first", () => {
+    const draw = drawShow(shotsOf(three150()), {
+      catalog,
+      magazine: book(
+        lot("vn9", "shell.150.palm", 2, "2025-02-01"),
+        lot("vn1", "shell.150.palm", 1, "2025-01-01"),
+      ),
+    });
+    expect(draw.shots.map((shot) => shot.lot)).toEqual(["vn1", "vn9", "vn9"]);
+  });
+
+  it("keeps an undated lot back until the dated ones are gone", () => {
+    const draw = drawShow(shotsOf(three150()), {
+      catalog,
+      magazine: book(
+        lot("vn9", "shell.150.palm", 1),
+        lot("vn2", "shell.150.palm", 1, "2025-03-01"),
+        lot("vn1", "shell.150.palm", 1, "2025-01-01"),
+      ),
+    });
+    expect(draw.shots.map((shot) => shot.lot)).toEqual(["vn1", "vn2", "vn9"]);
+  });
+
+  it("breaks a tie between two undated lots on the lot number", () => {
+    const draw = drawShow(shotsOf(three150()), {
+      catalog,
+      magazine: book(
+        lot("vn9", "shell.150.palm", 1),
+        lot("vn1", "shell.150.palm", 1),
+        lot("vn5", "shell.150.palm", 1),
+      ),
+    });
+    expect(draw.shots.map((shot) => shot.lot)).toEqual(["vn1", "vn5", "vn9"]);
+  });
+
+  it("leaves the later cues short rather than the earlier ones", () => {
+    const draw = drawShow(shotsOf(three150()), {
+      catalog,
+      magazine: book(lot("vn1", "shell.150.palm", 2, "2025-01-01")),
+    });
+    const three = draw.shots.find((shot) => shot.label === "three");
+    expect(three?.lot).toBeUndefined();
+    expect(three?.effect).toBe("shell.150.palm");
+    expect(draw.shortfalls).toEqual([{ effectId: "shell.150.palm", short: 1 }]);
+  });
+
+  it("draws in firing order rather than in script order", () => {
+    const draw = drawShow(
+      shotsOf(
+        [
+          "at 30 fire shell.150.palm from pad.a label late",
+          "at 10 fire shell.150.palm from pad.a label early",
+        ].join("\n"),
+      ),
+      { catalog, magazine: book(lot("vn1", "shell.150.palm", 1)) },
+    );
+    expect(draw.shots.find((shot) => shot.label === "early")?.lot).toBe("vn1");
+    expect(
+      draw.shots.find((shot) => shot.label === "late")?.lot,
+    ).toBeUndefined();
+  });
+
+  it("does not spend the book it was handed", () => {
+    const store = book(lot("vn1", "shell.150.palm", 3, "2025-01-01"));
+    drawShow(shotsOf(three150()), { catalog, magazine: store });
+    expect(store.onHand("shell.150.palm")).toBe(3);
+    expect(store.lotCount).toBe(1);
+  });
+
+  it("says what is left in the store afterwards", () => {
+    const draw = drawShow(shotsOf(three150()), {
+      catalog,
+      magazine: book(
+        lot("vn1", "shell.150.palm", 4, "2025-01-01"),
+        lot("vn2", "shell.75.peony", 6, "2025-01-01"),
+      ),
+    });
+    expect(draw.remaining.onHand("shell.150.palm")).toBe(1);
+    expect(draw.remaining.onHand("shell.75.peony")).toBe(6);
+  });
+});
+
+describe("standing in for what is short", () => {
+  it("waits until every cue has drawn its own before lending one", () => {
+    // The kamuro is the only shell that could cover the palm cue, and the later
+    // kamuro cue has a claim on it that the earlier palm cue does not.
+    const draw = drawShow(
+      shotsOf(
+        [
+          "at 10 fire shell.150.palm from pad.a label palm",
+          "at 20 fire shell.150.kamuro from pad.a label kamuro",
+        ].join("\n"),
+      ),
+      { catalog, magazine: book(lot("vn2", "shell.150.kamuro", 1)) },
+    );
+    expect(draw.shots.find((shot) => shot.label === "kamuro")?.lot).toBe("vn2");
+    expect(draw.shots.find((shot) => shot.label === "palm")?.effect).toBe(
+      "shell.150.palm",
+    );
+    expect(draw.shortfalls).toEqual([{ effectId: "shell.150.palm", short: 1 }]);
+  });
+
+  it("spends the stand in, so one shortfall can span several", () => {
+    const draw = drawShow(shotsOf(three150()), {
+      catalog,
+      magazine: book(
