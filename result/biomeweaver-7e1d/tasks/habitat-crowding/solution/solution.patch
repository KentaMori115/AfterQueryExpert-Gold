+  const scale = model.precision.scale;
+  const calendar = model.calendars[model.calendarId];
+  const seasons = calendar ? calendar.seasons.map((season) => season.id) : [];
+  const rows: SeatTableRow[] = [];
+  for (const season of seasons) {
