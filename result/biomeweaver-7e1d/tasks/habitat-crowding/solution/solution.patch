+      species: row.species,
+      region: row.region,
+      tick: row.tick,
+      pressure: row.pressure,
+      overSeats: row.overSeats,
+    });
+  }
+  return [...peaks.values()].sort(
+    (left, right) =>
+      left.species.localeCompare(right.species) || left.region.localeCompare(right.region),
