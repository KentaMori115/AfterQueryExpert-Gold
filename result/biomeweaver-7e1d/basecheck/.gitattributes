# Keep GitHub language stats on first-party TypeScript.
* text=auto eol=lf

package-lock.json linguist-generated=true
Dockerfile linguist-detectable=false

docs/** linguist-documentation=true
ecosystem-lab/** linguist-documentation=true

*.json linguist-detectable=false
*.jsonl linguist-detectable=false
*.csv linguist-detectable=false
*.yaml linguist-detectable=false
*.yml linguist-detectable=false
*.md linguist-documentation=true

packages/**/*.ts linguist-language=TypeScript
packages/**/*.ts linguist-detectable=true
