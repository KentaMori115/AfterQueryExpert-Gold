diff --git a/lib/ops/billing/money.ts b/lib/ops/billing/money.ts
index 6d97837..1b58e81 100644
--- a/lib/ops/billing/money.ts
+++ b/lib/ops/billing/money.ts
@@ -15,3 +15,56 @@ export function cents(value: number) {
 export function fromCents(value: number) {
   return value / 100
 }
+
+/**
+ * Hours priced at a per-hour rate. Both sides are already the figures the
+ * statement shows, so the product is the charge a client can reproduce with
+ * a calculator rather than one that only comes out in floating point.
+ */
+export function centsFromHours(hours: number, centsPerHour: number) {
+  if (hours <= 0) return 0
+  return roundHalfEven(hours * centsPerHour, 0)
+}
+
+/** Add a run of cent figures without letting a stray undefined through. */
+export function sumCents(values: number[]) {
+  return values.reduce((running, value) => running + (value || 0), 0)
+}
+
+/**
+ * Which entry absorbs a rounding remainder: the heaviest one, and the
+ * earliest of those when two carry the same weight. Putting it on the largest
+ * figure keeps the correction proportionally smallest, and keeps it in one
+ * place rather than smeared across a page of lines.
+ */
+export function heaviestIndex(amounts: number[]) {
+  let best = -1
+  let weight = -1
+  for (let index = 0; index < amounts.length; index += 1) {
+    const size = Math.abs(amounts[index])
+    if (size > weight) {
+      weight = size
+      best = index
+    }
+  }
+  return best
+}
+
+/** How far a set of independently rounded figures sits from its own total. */
+export function residualCents(amounts: number[], totalCents: number) {
+  return totalCents - sumCents(amounts)
+}
+
+/**
+ * Nudge a set of independently rounded amounts so they add up to the total
+ * that was rounded once. Only one entry moves, and only by the remainder, so
+ * every other figure on the statement is the one its own arithmetic produced.
+ */
+export function settleRounding(amounts: number[], totalCents: number) {
+  const settled = [...amounts]
+  const residual = residualCents(settled, totalCents)
+  if (residual === 0 || settled.length === 0) return settled
+  const target = heaviestIndex(settled)
+  settled[target] += residual
+  return settled
+}
diff --git a/lib/ops/billing/settlement.ts b/lib/ops/billing/settlement.ts
new file mode 100644
index 0000000..eb6db20
--- /dev/null
+++ b/lib/ops/billing/settlement.ts
@@ -0,0 +1,146 @@
+import { roundHalfEven } from './money'
+import { prorateCycle, type Plan, type PlanChange } from './proration'
+import type { UsageEvent } from './ledger'
+import { convertAmount, lookupRate, parseRateTable } from '@/lib/ops/invoices/fx.js'
+
+export type SettlementCredit = { id: string; remainingCents: number; expiresAt: number | null }
+export type StatementLine = { kind: 'subscription' | 'overage' | 'credit' | 'tax'; ref: string; cents: number }
+
+export type SettlementInput = {
+  clientId: string
+  cycleStart: number
+  cycleEnd: number
+  changes: PlanChange[]
+  usage: UsageEvent[]
+  credits: SettlementCredit[]
+  taxBps: number
+  planCurrency: string
+  currency: string
+  ratesCsv: string
+}
+
+export type StatementSegment = {
+  planId: string
+  start: number
+  end: number
+  hours: number
+  allowanceHours: number
+  carriedInHours: number
+  overageHours: number
+  subscriptionCents: number
+  overageCents: number
+}
+
+export type CycleStatement = {
+  currency: string
+  segments: StatementSegment[]
+  lines: StatementLine[]
+  subtotalCents: number
+  creditsAppliedCents: number
+  taxableCents: number
+  taxCents: number
+  totalCents: number
+  credits: SettlementCredit[]
+  unusedAllowanceHours: number
+}
+
+const h2 = (n: number) => roundHalfEven(n, 2)
+
+export function settleCycle(input: SettlementInput): CycleStatement {
+  if (!Number.isFinite(input.taxBps) || input.taxBps < 0) throw new Error('bad taxBps')
+  const cycle = prorateCycle(input.changes, input.cycleStart, input.cycleEnd)
+  const periods = cycle.segments
+
+  const totals = periods.map(() => 0)
+  const already = new Set<string>()
+  for (const event of input.usage) {
+    if (already.has(event.id)) continue
+    already.add(event.id)
+    if (event.clientId !== input.clientId) continue
+    if (!(event.hours >= 0)) throw new Error('bad hours')
+    const slot = periods.findIndex((p) => event.at >= p.start && event.at < p.end)
+    if (slot < 0) continue
+    totals[slot] += event.hours
+  }
+
+  const segments: StatementSegment[] = []
+  const priced: StatementLine[] = []
+  let bank = 0
+  for (let i = 0; i < periods.length; i += 1) {
+    const period = periods[i]
+    const earned = period.plan.includedHours * period.ratio
+    const pool = earned + bank
+    const taken = Math.min(totals[i], pool)
+    const over = totals[i] - taken
+    bank = pool - taken
+    const billableHours = h2(over)
+    const cents = billableHours > 0 ? roundHalfEven(billableHours * period.plan.overageCentsPerHour, 0) : 0
+    segments.push({
+      planId: period.plan.id,
+      start: period.start,
+      end: period.end,
+      hours: h2(totals[i]),
+      allowanceHours: h2(earned),
+      carriedInHours: h2(pool - earned),
+      overageHours: billableHours,
+      subscriptionCents: period.cents,
+      overageCents: cents,
+    })
+    priced.push({ kind: 'subscription', ref: period.plan.id, cents: period.cents })
+    if (cents > 0) priced.push({ kind: 'overage', ref: period.plan.id, cents })
+  }
+
+  const rate = lookupRate(parseRateTable(input.ratesCsv), input.planCurrency, input.currency)
+  const nativeTotal = priced.reduce((sum, line) => sum + line.cents, 0)
+  const subtotalCents = convertAmount(nativeTotal, rate, 0)
+  const lines: StatementLine[] = priced.map((line) => ({ ...line, cents: convertAmount(line.cents, rate, 0) }))
+  const drift = subtotalCents - lines.reduce((sum, line) => sum + line.cents, 0)
+  if (drift !== 0 && lines.length > 0) {
+    let heavy = 0
+    for (let i = 1; i < lines.length; i += 1) {
+      if (Math.abs(lines[i].cents) > Math.abs(lines[heavy].cents)) heavy = i
+    }
+    lines[heavy] = { ...lines[heavy], cents: lines[heavy].cents + drift }
+  }
+
+  const wallet = input.credits.map((credit) => ({ ...credit }))
+  const spendable = wallet
+    .filter((credit) => credit.remainingCents > 0)
+    .filter((credit) => credit.expiresAt === null || credit.expiresAt >= input.cycleEnd)
+    .sort((a, b) => {
+      if (a.expiresAt === null && b.expiresAt !== null) return 1
+      if (b.expiresAt === null && a.expiresAt !== null) return -1
+      if (a.expiresAt !== null && b.expiresAt !== null && a.expiresAt !== b.expiresAt) {
+        return a.expiresAt - b.expiresAt
+      }
+      if (a.remainingCents !== b.remainingCents) return a.remainingCents - b.remainingCents
+      return a.id.localeCompare(b.id)
+    })
+
+  let owed = subtotalCents
+  let applied = 0
+  for (const credit of spendable) {
+    if (owed <= 0) break
+    const spend = Math.min(credit.remainingCents, owed)
+    credit.remainingCents -= spend
+    owed -= spend
+    applied += spend
+    lines.push({ kind: 'credit', ref: credit.id, cents: -spend })
+  }
+
+  const taxCents = owed > 0 && input.taxBps > 0 ? roundHalfEven((owed * input.taxBps) / 10_000, 0) : 0
+  if (taxCents > 0) lines.push({ kind: 'tax', ref: 'tax', cents: taxCents })
+
+  return {
+    currency: input.currency,
+    segments,
+    lines,
+    subtotalCents,
+    creditsAppliedCents: applied,
+    taxableCents: Math.max(0, owed),
+    taxCents,
+    totalCents: owed + taxCents,
+    credits: wallet,
+    unusedAllowanceHours: h2(bank),
+  }
+}
