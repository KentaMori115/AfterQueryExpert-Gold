+class WhatIsChargedTest(unittest.TestCase):
+    def three(self):
+        """Two inner rides and a crossing one, each its own ticket."""
+        return [
+            ride("a", "b", 8 * 3600),
+            ride("a", "b", 12 * 3600),
+            ride("a", "c", 16 * 3600),
+        ]
+
+    def test_a_ticket_under_the_cap_is_charged_in_full(self):
+        price = charged("cap_id,price,period\nday,9.00,day\n", self.three())
+        self.assertEqual(
+            [str(charge.charged) for charge in price.charges],
+            ["1.90 EUR", "1.90 EUR", "2.40 EUR"],
+        )
+
+    def test_the_ticket_that_crosses_the_cap_pays_the_rest_of_it(self):
+        price = charged("cap_id,price,period\nday,5.00,day\n", self.three())
+        self.assertEqual(str(price.charges[2].charged), "1.20 EUR")
+        self.assertEqual(str(price.total), "5.00 EUR")
+
+    def test_a_ticket_after_the_cap_is_reached_is_free(self):
+        rides = self.three() + [ride("a", "b", 20 * 3600)]
+        price = charged("cap_id,price,period\nday,5.00,day\n", rides)
+        self.assertEqual(str(price.charges[3].charged), "0.00 EUR")
+
+    def test_a_cap_of_nothing_makes_everything_free(self):
+        price = charged("cap_id,price,period\nday,0.00,day\n", self.three())
+        self.assertEqual(str(price.total), "0.00 EUR")
+
+    def test_travel_with_no_cap_is_charged_in_full(self):
+        price = charged(None, self.three())
+        self.assertEqual(str(price.total), "6.20 EUR")
+
+    def test_five_euro_of_day_shows_as_five_euro_of_week(self):
+        caps = "cap_id,price,period\nday,5.00,day\nweek,6.00,week\n"
+        price = charged(caps, self.three())
+        self.assertEqual(
+            totals(price),
+            [
+                ("day", "day", MONDAY, "5.00 EUR", "5.00 EUR"),
+                ("week", "week", MONDAY, "5.00 EUR", "6.00 EUR"),
+            ],
+        )
+
+    def test_a_weekly_cap_can_bite_before_a_daily_one(self):
+        caps = "cap_id,price,period\nday,5.00,day\nweek,3.00,week\n"
+        price = charged(caps, self.three())
+        self.assertEqual(
+            [str(charge.charged) for charge in price.charges],
+            ["1.90 EUR", "1.10 EUR", "0.00 EUR"],
+        )
+
+    def test_a_weekly_cap_carries_over_to_the_next_day(self):
+        rides = self.three() + [ride("a", "b", 8 * 3600, TUESDAY)]
+        caps = "cap_id,price,period\nday,5.00,day\nweek,5.50,week\n"
+        price = charged(caps, rides)
+        self.assertEqual(str(price.charges[3].charged), "0.50 EUR")
+        self.assertEqual(str(price.total), "5.50 EUR")
