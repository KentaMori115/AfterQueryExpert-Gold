+        self.assertEqual(str(self.price.full), "6.20 EUR")
+
+    def test_what_is_saved_is_the_difference(self):
+        self.assertEqual(str(self.price.saved), "1.20 EUR")
+
+    def test_there_is_one_charge_for_every_ticket(self):
