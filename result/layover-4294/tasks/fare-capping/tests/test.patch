@@ -0,0 +1,289 @@
+"""Charging a run of travel: which day a ticket belongs to, and what it costs.
+
+The fare table here is built once and never changes. What moves between cases
+is the cap table and the travel, so a wrong answer points at one rule rather
+than at the fixture.
+"""
+
+import unittest
+from datetime import date
+
+from layover.errors import FareError
+from layover.feed import RawFeed, load_feed
+from layover.fares import Ride, price_travel
+
+MONDAY = date(2026, 7, 6)
+TUESDAY = date(2026, 7, 7)
+SUNDAY = date(2026, 7, 12)
+NEXT_MONDAY = date(2026, 7, 13)
+
+TABLES = {
+    "stops": (
+        "stop_id,name,lat,lon,zone\n"
+        "a,Alt Markt,52.500000,13.300000,A\n"
+        "b,Brunnen,52.500000,13.320000,A\n"
+        "c,Chaussee,52.500000,13.340000,B\n"
+    ),
+    "routes": "route_id,short_name,long_name,mode\nx,X,West to east,tram\n",
+    "patterns": "pattern_id,route_id,headsign,direction\nx-east,x,East,0\n",
+    "pattern_stops": (
+        "pattern_id,sequence,stop_id\n"
+        "x-east,1,a\n"
+        "x-east,2,b\n"
+        "x-east,3,c\n"
+    ),
+    "trips": "trip_id,pattern_id,service_id\ntx,x-east,weekday\n",
+    "stop_times": (
+        "trip_id,sequence,arrival\n"
+        "tx,1,08:00:00\n"
+        "tx,2,08:05:00\n"
+        "tx,3,08:10:00\n"
+    ),
+    "calendars": (
+        "service_id,monday,tuesday,wednesday,thursday,friday,saturday,sunday,"
+        "start_date,end_date\n"
+        "weekday,1,1,1,1,1,1,1,2026-07-01,2026-07-31\n"
+    ),
+    "fare_products": (
+        "fare_id,price,currency,transfers,window\n"
+        "inner,1.90,EUR,1,3600\n"
+        "cross,2.40,EUR,1,3600\n"
+    ),
+    "fare_rules": (
+        "fare_id,from_zone,to_zone\n"
+        "inner,A,A\n"
+        "inner,B,B\n"
+        "cross,A,B\n"
+        "cross,B,A\n"
+    ),
+}
+
+
+def loaded(caps=None):
+    """The fixture feed, with a cap table if one is wanted."""
+    texts = dict(TABLES)
+    if caps is not None:
+        texts["fare_caps"] = caps
+    return load_feed(RawFeed.of_text(texts, "inline"), "inline")
+
+
+def ride(start, end, at, day=MONDAY, route="x"):
+    """One ten minute ride, on a service day."""
+    return Ride(route, start, end, at, at + 600, day=day)
+
+
+def charged(caps, rides):
+    """What a run of travel comes to under a cap table."""
+    contents = loaded(caps)
+    return price_travel(rides, contents.fares, contents.zones())
+
+
+def totals(price):
+    """Every cap total as a tuple, in an order a case can rely on."""
+    return sorted(
+        (total.cap_id, total.period, total.starts_on, str(total.charged), str(total.limit))
+        for total in price.cap_totals()
+    )
+
+
+class TravelOrderTest(unittest.TestCase):
+    def test_travel_with_no_rides_costs_nothing(self):
+        price = charged("cap_id,price,period\nday,3.00,day\n", [])
+        self.assertEqual(str(price.total), "0.00 EUR")
+        self.assertEqual(len(price.charges), 0)
+
+    def test_a_ride_that_does_not_say_its_day_is_refused(self):
+        rides = [Ride("x", "a", "b", 8 * 3600, 8 * 3600 + 600)]
+        with self.assertRaises(FareError):
+            charged(None, rides)
+
+    def test_rides_out_of_order_by_time_are_refused(self):
+        rides = [ride("a", "b", 12 * 3600), ride("a", "b", 8 * 3600)]
+        with self.assertRaises(FareError):
+            charged(None, rides)
+
+    def test_rides_out_of_order_by_day_are_refused(self):
+        rides = [ride("a", "b", 8 * 3600, TUESDAY), ride("a", "b", 12 * 3600, MONDAY)]
+        with self.assertRaises(FareError):
+            charged(None, rides)
+
+    def test_a_monday_ride_then_a_tuesday_one_is_taken(self):
+        rides = [ride("a", "b", 8 * 3600), ride("a", "b", 8 * 3600, TUESDAY)]
+        price = charged(None, rides)
+        self.assertEqual(str(price.total), "3.80 EUR")
+
+    def test_monday_monday_tuesday_comes_back_in_that_order(self):
+        rides = [
+            ride("a", "b", 8 * 3600),
+            ride("a", "b", 13 * 3600),
+            ride("a", "b", 8 * 3600, TUESDAY),
+        ]
+        price = charged(None, rides)
+        self.assertEqual([charge.day for charge in price.charges], [MONDAY, MONDAY, TUESDAY])
+
+
+class TicketsOverDaysTest(unittest.TestCase):
+    def test_a_change_inside_the_window_stays_on_one_ticket(self):
+        rides = [ride("a", "b", 8 * 3600), ride("b", "a", 8 * 3600 + 900)]
+        price = charged(None, rides)
+        self.assertEqual(len(price.charges), 1)
+        self.assertEqual(str(price.total), "1.90 EUR")
+
+    def test_a_boarding_at_0110_starts_a_new_ticket(self):
+        rides = [ride("a", "b", 25 * 3600), ride("a", "b", 3600 + 600, TUESDAY)]
+        price = charged(None, rides)
+        self.assertEqual(len(price.charges), 2)
+        self.assertEqual(str(price.total), "3.80 EUR")
+
+    def test_a_ride_at_2450_and_one_at_2510_share_monday(self):
+        rides = [ride("a", "b", 24 * 3600 + 3000), ride("b", "a", 25 * 3600 + 600)]
+        price = charged(None, rides)
+        self.assertEqual(len(price.charges), 1)
+        self.assertEqual(price.charges[0].day, MONDAY)
+
+    def test_a_ticket_after_midnight_caps_on_the_day_it_belongs_to(self):
+        rides = [ride("a", "b", 8 * 3600), ride("a", "b", 25 * 3600)]
+        price = charged("cap_id,price,period\nday,3.00,day\n", rides)
+        self.assertEqual(str(price.total), "3.00 EUR")
+
+    def test_a_wednesday_ride_counts_from_the_sixth(self):
+        price = charged(
+            "cap_id,price,period\nweek,9.00,week\n",
+            [ride("a", "b", 8 * 3600, date(2026, 7, 8))],
+        )
+        self.assertEqual(totals(price)[0][2], MONDAY)
+
+    def test_sunday_and_the_monday_after_it_are_different_weeks(self):
+        rides = [ride("a", "b", 8 * 3600, SUNDAY), ride("a", "b", 8 * 3600, NEXT_MONDAY)]
+        price = charged("cap_id,price,period\nweek,1.00,week\n", rides)
+        self.assertEqual(str(price.total), "2.00 EUR")
+        self.assertEqual([entry[2] for entry in totals(price)], [MONDAY, NEXT_MONDAY])
