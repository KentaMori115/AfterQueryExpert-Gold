@@ -0,0 +1,329 @@
+"""Ceilings read off a feed: what they cover, which one wins, and saving them.
+
+Everything here goes in through the feed and comes out through what a passenger
+is charged, because that is the only thing a cap is for. Nothing pokes at the
+table's own accessors.
+"""
+
+import unittest
+from datetime import date
+
+from layover.document import to_document
+from layover.feed import RawFeed, load_feed
+from layover.feed.load import load_with_problems
+from layover.feed.writer import feed_to_text
+from layover.fares import Ride, price_travel
+
+MONDAY = date(2026, 7, 6)
+TUESDAY = date(2026, 7, 7)
+
+TABLES = {
+    "stops": (
+        "stop_id,name,lat,lon,zone\n"
+        "a,Alt Markt,52.500000,13.300000,A\n"
+        "b,Brunnen,52.500000,13.320000,A\n"
+        "c,Chaussee,52.500000,13.340000,B\n"
+        "d,Damm,52.500000,13.360000,B\n"
+    ),
+    "routes": (
+        "route_id,short_name,long_name,mode\n"
+        "x,X,West to east,tram\n"
+        "y,Y,East to west,bus\n"
+    ),
+    "patterns": (
+        "pattern_id,route_id,headsign,direction\n"
+        "x-east,x,East,0\n"
+        "y-west,y,West,1\n"
+    ),
+    "pattern_stops": (
+        "pattern_id,sequence,stop_id\n"
+        "x-east,1,a\n"
+        "x-east,2,b\n"
+        "x-east,3,c\n"
+        "x-east,4,d\n"
+        "y-west,1,d\n"
+        "y-west,2,c\n"
+        "y-west,3,b\n"
+        "y-west,4,a\n"
+    ),
+    "trips": (
+        "trip_id,pattern_id,service_id\n"
+        "tx,x-east,weekday\n"
+        "ty,y-west,weekday\n"
+    ),
+    "stop_times": (
+        "trip_id,sequence,arrival\n"
+        "tx,1,08:00:00\n"
+        "tx,2,08:05:00\n"
+        "tx,3,08:10:00\n"
+        "tx,4,08:15:00\n"
+        "ty,1,17:00:00\n"
+        "ty,2,17:05:00\n"
+        "ty,3,17:10:00\n"
+        "ty,4,17:15:00\n"
+    ),
+    "calendars": (
+        "service_id,monday,tuesday,wednesday,thursday,friday,saturday,sunday,"
+        "start_date,end_date\n"
+        "weekday,1,1,1,1,1,0,0,2026-07-01,2026-07-31\n"
+    ),
+    "fare_products": (
+        "fare_id,price,currency,transfers,window\n"
+        "inner,1.90,EUR,1,3600\n"
+        "cross,2.40,EUR,1,3600\n"
+    ),
+    "fare_rules": (
+        "fare_id,from_zone,to_zone\n"
+        "inner,A,A\n"
+        "inner,B,B\n"
+        "cross,A,B\n"
+        "cross,B,A\n"
+    ),
+}
+
+
+def raw(caps=None):
+    """The fixture feed as raw tables, with a cap table if one is wanted."""
+    texts = dict(TABLES)
+    if caps is not None:
+        texts["fare_caps"] = caps
+    return RawFeed.of_text(texts, "inline")
+
+
+def feed(caps=None):
+    """The fixture feed loaded, raising on the first problem."""
+    return load_feed(raw(caps), "inline")
+
+
+def problems_of(caps):
+    """Everything wrong with a cap table, without raising."""
+    return load_with_problems(raw(caps), "inline")[1]
+
+
+def ride(route, start, end, at, day=MONDAY):
+    """One ten minute ride on a route, on a service day."""
+    return Ride(route, start, end, at, at + 600, day=day)
+
+
+def charged(caps, rides):
+    """What the fixture feed charges for a run of travel under a cap table."""
+    contents = feed(caps)
+    return price_travel(rides, contents.fares, contents.zones())
+
+
+class CapTableTest(unittest.TestCase):
+    def test_a_daily_cap_holds_the_day_down(self):
+        rides = [ride("x", "a", "b", 8 * 3600), ride("x", "a", "b", 12 * 3600)]
+        price = charged("cap_id,price,period\nday,3.00,day\n", rides)
+        self.assertEqual(str(price.total), "3.00 EUR")
+
+    def test_a_weekly_cap_holds_a_run_of_days_down(self):
+        rides = [
+            ride("x", "a", "b", 8 * 3600),
+            ride("x", "a", "b", 8 * 3600, TUESDAY),
+            ride("x", "a", "b", 12 * 3600, TUESDAY),
+        ]
+        price = charged("cap_id,price,period\nweek,4.00,week\n", rides)
+        self.assertEqual(str(price.total), "4.00 EUR")
+
+    def test_a_feed_with_no_cap_table_charges_every_fare(self):
+        rides = [ride("x", "a", "b", 8 * 3600), ride("x", "a", "b", 12 * 3600)]
+        price = charged(None, rides)
+        self.assertEqual(str(price.total), "3.80 EUR")
+
+    def test_a_period_the_format_does_not_know_is_a_problem(self):
+        self.assertTrue(problems_of("cap_id,price,period\nd,3.00,fortnight\n"))
+
+    def test_an_identifier_used_twice_is_a_problem(self):
+        self.assertTrue(problems_of("cap_id,price,period\nd,3.00,day\nd,9.00,week\n"))
+
+    def test_a_cap_in_pounds_beside_euro_fares_is_refused(self):
+        self.assertTrue(
+            problems_of("cap_id,price,period,currency\nd,3.00,day,GBP\n")
+        )
+
+    def test_a_cap_without_an_identifier_is_a_problem(self):
+        self.assertTrue(problems_of("cap_id,price,period\n,3.00,day\n"))
+
+    def test_a_cap_without_a_price_is_a_problem(self):
+        self.assertTrue(problems_of("cap_id,price,period\nd,,day\n"))
+
+    def test_a_cap_without_a_period_is_a_problem(self):
+        self.assertTrue(problems_of("cap_id,price,period\nd,3.00,\n"))
+
+    def test_a_cap_priced_in_the_table_currency_is_no_problem(self):
+        self.assertFalse(
+            problems_of("cap_id,price,period,currency\nd,3.00,day,EUR\n")
+        )
+
+
+class WrittenBackTest(unittest.TestCase):
+    def setUp(self):
+        self.caps = "cap_id,price,period,zone\nday,3.00,day,\ninner,2.00,week,A\n"
+        self.rides = [ride("x", "a", "b", 8 * 3600), ride("x", "a", "b", 12 * 3600)]
+
+    def written(self, caps):
+        """The fixture feed written out and read back in."""
+        text = feed_to_text(feed(caps))
+        return load_feed(RawFeed.of_text(text, "written"), "written")
+
+    def test_the_writer_emits_a_cap_table(self):
+        self.assertIn("fare_caps", feed_to_text(feed(self.caps)))
+
+    def test_a_plain_feed_emits_no_cap_table(self):
+        self.assertNotIn("fare_caps", feed_to_text(feed(None)))
+
+    def test_what_is_written_charges_the_same(self):
+        contents = self.written(self.caps)
+        price = price_travel(self.rides, contents.fares, contents.zones())
+        self.assertEqual(str(price.total), "2.00 EUR")
+
+    def test_what_is_written_keeps_the_zone_a_cap_names(self):
+        contents = self.written(self.caps)
+        crossing = [ride("x", "a", "c", 8 * 3600), ride("x", "a", "c", 12 * 3600)]
+        price = price_travel(crossing, contents.fares, contents.zones())
+        self.assertEqual(sorted(price.charges[0].caps), ["day"])
+
+    def test_what_is_written_keeps_the_route_a_cap_names(self):
+        caps = "cap_id,price,period,route_id\ntram,2.00,day,x\n"
+        contents = self.written(caps)
+        rides = [ride("x", "a", "b", 8 * 3600), ride("y", "b", "a", 12 * 3600)]
+        price = price_travel(rides, contents.fares, contents.zones())
+        self.assertEqual(sorted(price.charges[0].caps), ["tram"])
+        self.assertEqual(sorted(price.charges[1].caps), [])
+
+    def test_what_is_written_holds_a_cap_to_one_route_only(self):
+        caps = "cap_id,price,period,route_id\ntram,2.00,day,x\n"
+        contents = self.written(caps)
+        rides = [ride("y", "a", "b", 8 * 3600), ride("y", "b", "a", 12 * 3600)]
+        price = price_travel(rides, contents.fares, contents.zones())
+        self.assertEqual(str(price.total), "3.80 EUR")
+
+
+class SavedDocumentTest(unittest.TestCase):
+    def section(self, caps):
+        """The fares section of a document written from the fixture feed."""
+        return to_document(feed(caps))["fares"]
+
+    def test_a_plain_feed_saves_three_fare_sections(self):
+        self.assertEqual(set(self.section(None)), {"currency", "products", "rules"})
+
+    def test_a_capped_feed_saves_three_fare_sections_too(self):
+        caps = "cap_id,price,period\nday,3.00,day\n"
+        self.assertEqual(set(self.section(caps)), {"currency", "products", "rules"})
+
+    def test_a_document_keeps_the_products_it_always_kept(self):
+        caps = "cap_id,price,period,zone\ninner,2.00,day,A\n"
+        section = self.section(caps)
+        self.assertEqual([row["id"] for row in section["products"]], ["cross", "inner"])
+        self.assertEqual(len(section["rules"]), 4)
+
+
+class WhatACapCoversTest(unittest.TestCase):
+    def two(self, first, second):
+        """Two rides at eight and at twelve, far enough apart to be two tickets."""
+        return [ride(*first, at=8 * 3600), ride(*second, at=12 * 3600)]
+
+    def test_a_zoned_cap_covers_travel_that_stays_inside_it(self):
+        rides = self.two(("x", "a", "b"), ("x", "b", "a"))
+        price = charged("cap_id,price,period,zone\ninner,2.00,day,A\n", rides)
+        self.assertEqual(str(price.total), "2.00 EUR")
+
+    def test_a_zoned_cap_leaves_travel_out_of_it_alone(self):
+        rides = self.two(("x", "a", "c"), ("x", "a", "c"))
+        price = charged("cap_id,price,period,zone\ninner,2.00,day,A\n", rides)
+        self.assertEqual(str(price.total), "4.80 EUR")
+
+    def test_a_routed_cap_covers_travel_on_that_route(self):
+        rides = self.two(("x", "a", "b"), ("x", "b", "a"))
+        price = charged("cap_id,price,period,route_id\ntram,2.00,day,x\n", rides)
+        self.assertEqual(str(price.total), "2.00 EUR")
+
+    def test_a_routed_cap_leaves_another_route_alone(self):
+        rides = self.two(("x", "a", "b"), ("y", "b", "a"))
+        price = charged("cap_id,price,period,route_id\ntram,2.00,day,x\n", rides)
+        self.assertEqual(str(price.total), "3.80 EUR")
+        self.assertEqual(sorted(price.charges[1].caps), [])
+
+    def test_a_cap_setting_both_conditions_needs_both(self):
+        rides = self.two(("x", "a", "c"), ("x", "a", "b"))
+        caps = "cap_id,price,period,zone,route_id\nboth,1.00,day,A,x\n"
+        price = charged(caps, rides)
+        self.assertEqual(sorted(price.charges[0].caps), [])
+        self.assertEqual(sorted(price.charges[1].caps), ["both"])
+
+    def test_a_zoned_cap_reads_every_ride_on_the_ticket(self):
+        rides = [ride("x", "a", "b", 8 * 3600), ride("x", "b", "c", 8 * 3600 + 900)]
+        price = charged("cap_id,price,period,zone\ninner,1.00,day,A\n", rides)
+        self.assertEqual(len(price.charges), 1)
+        self.assertEqual(sorted(price.charges[0].caps), [])
+
+    def test_a_routed_cap_reads_every_ride_on_the_ticket(self):
+        rides = [ride("x", "a", "b", 8 * 3600), ride("y", "b", "a", 8 * 3600 + 900)]
+        price = charged("cap_id,price,period,route_id\ntram,1.00,day,x\n", rides)
+        self.assertEqual(len(price.charges), 1)
+        self.assertEqual(sorted(price.charges[0].caps), [])
+
+    def test_a_cap_naming_a_zone_nothing_is_in_never_covers(self):
+        rides = self.two(("x", "a", "b"), ("x", "b", "a"))
+        price = charged("cap_id,price,period,zone\nfar,1.00,day,Z\n", rides)
+        self.assertEqual(str(price.total), "3.80 EUR")
+
+    def test_a_cap_naming_a_route_nothing_runs_never_covers(self):
+        rides = self.two(("x", "a", "b"), ("x", "b", "a"))
+        price = charged("cap_id,price,period,route_id\nghost,1.00,day,z\n", rides)
+        self.assertEqual(str(price.total), "3.80 EUR")
+
+    def test_a_cap_setting_nothing_covers_everything(self):
+        rides = self.two(("x", "a", "c"), ("y", "b", "a"))
+        price = charged("cap_id,price,period\nall,1.00,day\n", rides)
+        self.assertEqual(str(price.total), "1.00 EUR")
+
+
+class WhichCapWinsTest(unittest.TestCase):
+    def inside(self):
+        """Two tickets of inner travel, an hour and a half apart."""
+        return [ride("x", "a", "b", 8 * 3600), ride("x", "b", "a", 13 * 3600)]
+
+    def test_the_cap_with_more_conditions_wins(self):
+        caps = (
+            "cap_id,price,period,zone\n"
+            "everywhere,1.00,day,\n"
+            "inner,2.50,day,A\n"
+        )
+        price = charged(caps, self.inside())
+        self.assertEqual(sorted(price.charges[0].caps), ["inner"])
+        self.assertEqual(str(price.total), "2.50 EUR")
+
+    def test_a_tie_in_conditions_goes_to_the_cheaper_cap(self):
+        caps = (
+            "cap_id,price,period,zone\n"
+            "dear,3.50,day,A\n"
+            "cheap,2.00,day,A\n"
+        )
+        price = charged(caps, self.inside())
+        self.assertEqual(sorted(price.charges[0].caps), ["cheap"])
+
+    def test_a_tie_in_price_goes_to_the_identifier(self):
+        caps = (
+            "cap_id,price,period,zone\n"
+            "second,2.00,day,A\n"
+            "first,2.00,day,A\n"
+        )
+        price = charged(caps, self.inside())
+        self.assertEqual(sorted(price.charges[0].caps), ["first"])
+
+    def test_two_dailies_and_two_weeklies_leave_two_on_a_ticket(self):
+        caps = (
+            "cap_id,price,period\n"
+            "day-one,3.00,day\n"
+            "day-two,4.00,day\n"
+            "week-one,9.00,week\n"
+            "week-two,8.00,week\n"
+        )
+        price = charged(caps, self.inside())
+        self.assertEqual(sorted(price.charges[0].caps), ["day-one", "week-two"])
+
+
+if __name__ == "__main__":
+    unittest.main()
