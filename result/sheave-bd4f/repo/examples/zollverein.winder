# Zollverein 12, a four-rope friction winder on skips. Nothing is
# coiled, so the depth costs nothing in wheel size and there is no fleet
# angle to argue about — but the tensions have to stay inside the
# capstan equation, and on skips that takes a balance rope heavier than
# the winding ropes.

winder Zollverein 12

shaft Schacht 12 diameter=8m depth=1100m conveyances=2 sump=18m headgear=45m

rope diameter=42mm construction=6x36 grade=1960 ropes=4

koepe diameter=5.6m wrap=200 friction=0.27 ropes=4

rising skip the loaded skip tare=8.4t payload=20t decks=1 width=2.6m across=2m
falling skip the empty skip tare=8.4t payload=0t decks=1 width=2.6m across=2m

balance rate=25.94kg

cycle full=18mps accelerate=1.1 decelerate=1.2 creep=0.5mps creepfor=6m rest=22s

working hours=18h
