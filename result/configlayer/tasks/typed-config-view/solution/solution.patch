+"""configlayer.typed — typed, validating access to merged configuration.
+
+A merged configuration is stringly typed; the code that reads it is not.
+:class:`TypedView` wraps any nested mapping and converts values on read
+— integers, floats, booleans, comma lists, durations ("1h30m") and byte
+sizes ("512MB", "4KiB") — under strict grammars, raising
+:class:`~configlayer.exceptions.ValidationError` with the full dotted
+key whenever a value does not conform.  The underlying parsers are also
+exported for direct use.
+"""
+
+from configlayer.typed.parse import (
+    format_duration,
+    format_size,
+    parse_bool,
+    parse_duration,
+    parse_items,
+    parse_size,
+)
+from configlayer.typed.view import TypedView
+
+__all__ = [
+    "TypedView",
+    "format_duration",
+    "format_size",
+    "parse_bool",
+    "parse_duration",
+    "parse_items",
+    "parse_size",
+]
