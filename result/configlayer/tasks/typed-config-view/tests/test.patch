+"""Tests for TypedView, the typed accessor over nested config mappings."""
+
+from __future__ import annotations
+
+import pytest
+
+from configlayer.exceptions import ValidationError
+
+SAMPLE = {
+    "app": {"name": "orders", "debug": "off", "workers": "8"},
+    "db": {
+        "host": "db.internal",
+        "port": 5432,
+        "timeout": "2m30s",
+        "pool": {"size": "10", "idle": None},
+    },
+    "cache": {"limit": "0.5GiB", "ttl": 300},
+    "flags": "checkout, refunds ,search",
+    "weights": [1, "2", 3],
+}
+
+
+def view():
+    from configlayer.typed import TypedView
+
+    return TypedView(SAMPLE)
+
+
+# ---------------------------------------------------------------------------
+# Typed getters
+# ---------------------------------------------------------------------------
+
+class TestGetters:
+    def test_get_str(self):
+        assert view().get_str("db.host") == "db.internal"
+
+    def test_get_str_rejects_non_strings(self):
+        with pytest.raises(ValidationError, match="db.port"):
+            view().get_str("db.port")
+
+    def test_get_int_from_int_and_string(self):
+        v = view()
+        assert v.get_int("db.port") == 5432
+        assert v.get_int("app.workers") == 8
+        assert v.get_int("db.pool.size") == 10
+
+    def test_get_int_rejects_bool_float_and_bad_strings(self):
+        from configlayer.typed import TypedView
+
+        v = TypedView({"a": True, "b": 3.5, "c": "3.5", "d": "0x1f",
+                       "e": "1_0"})
+        for key in ("a", "b", "c", "d", "e"):
+            with pytest.raises(ValidationError, match=key):
+                v.get_int(key)
+
+    def test_get_int_accepts_signed_strings(self):
+        from configlayer.typed import TypedView
+
+        v = TypedView({"up": "+7", "down": "-40"})
+        assert v.get_int("up") == 7
+        assert v.get_int("down") == -40
+
+    def test_get_float(self):
+        from configlayer.typed import TypedView
+
+        v = TypedView({"a": 2, "b": 2.5, "c": "2.5", "d": "1e-3"})
+        assert v.get_float("a") == 2.0
+        assert v.get_float("b") == 2.5
+        assert v.get_float("c") == 2.5
+        assert v.get_float("d") == 0.001
+
+    def test_get_float_rejects_bool_and_words(self):
+        from configlayer.typed import TypedView
+
+        v = TypedView({"a": False, "b": "fast"})
+        with pytest.raises(ValidationError):
+            v.get_float("a")
+        with pytest.raises(ValidationError):
+            v.get_float("b")
+
+    def test_get_bool_from_bool_and_words(self):
+        from configlayer.typed import TypedView
+
+        v = TypedView({"a": True, "b": "Yes", "c": "off", "d": "0"})
+        assert v.get_bool("a") is True
+        assert v.get_bool("b") is True
+        assert v.get_bool("c") is False
+        assert v.get_bool("d") is False
+
+    def test_get_bool_rejects_numbers(self):
+        from configlayer.typed import TypedView
+
+        v = TypedView({"a": 1})
+        with pytest.raises(ValidationError, match="a"):
+            v.get_bool("a")
+
+    def test_get_duration_from_string_and_number(self):
+        v = view()
+        assert v.get_duration("db.timeout") == 150.0
+        assert v.get_duration("cache.ttl") == 300.0
+        assert isinstance(v.get_duration("cache.ttl"), float)
+
+    def test_get_duration_rejects_negative_numbers(self):
+        from configlayer.typed import TypedView
+
+        with pytest.raises(ValidationError, match="lag"):
+            TypedView({"lag": -3}).get_duration("lag")
+
+    def test_get_size_from_string_and_int(self):
+        from configlayer.typed import TypedView
+
+        v = view()
+        assert v.get_size("cache.limit") == 536_870_912
+        assert TypedView({"quota": 4096}).get_size("quota") == 4096
+
+    def test_get_size_rejects_fractional_bytes(self):
+        from configlayer.typed import TypedView
+
+        with pytest.raises(ValidationError, match="quota"):
+            TypedView({"quota": "2.5B"}).get_size("quota")
+
+    def test_get_list_from_string_and_list(self):
+        v = view()
+        assert v.get_list("flags") == ["checkout", "refunds", "search"]
+        assert v.get_list("weights") == [1, "2", 3]
+
+    def test_get_list_with_item_converter(self):
+        v = view()
+        assert v.get_list("weights", item=int) == [1, 2, 3]
+        assert v.get_list("flags", item=str.upper)[0] == "CHECKOUT"
+
+    def test_get_list_item_failure_names_the_key(self):
+        from configlayer.typed import TypedView
+
+        v = TypedView({"ports": "80, http, 443"})
+        with pytest.raises(ValidationError, match="ports"):
+            v.get_list("ports", item=int)
+
+    def test_get_list_empty_string_is_empty_list(self):
+        from configlayer.typed import TypedView
+
+        assert TypedView({"flags": ""}).get_list("flags") == []
+
+    def test_get_list_rejects_empty_items_and_scalars(self):
+        from configlayer.typed import TypedView
+
+        with pytest.raises(ValidationError):
+            TypedView({"a": "x,,y"}).get_list("a")
+        with pytest.raises(ValidationError):
+            TypedView({"a": 5}).get_list("a")
+
+
+# ---------------------------------------------------------------------------
+# Defaults and missing keys
+# ---------------------------------------------------------------------------
+
+class TestDefaults:
+    def test_missing_key_returns_default(self):
+        assert view().get_int("db.pool.max", default=25) == 25
+        assert view().get_bool("app.verbose", default=False) is False
+
+    def test_none_value_counts_as_unset(self):
+        assert view().get_int("db.pool.idle", default=4) == 4
+
+    def test_missing_key_without_default_raises_with_full_path(self):
+        with pytest.raises(ValidationError, match="db.pool.max"):
+            view().get_int("db.pool.max")
+
+    def test_bad_value_raises_even_with_default(self):
+        # A default answers "the key is absent", never "the value is bad".
+        with pytest.raises(ValidationError, match="app.debug"):
+            view().get_int("app.debug", default=1)
+
+    def test_error_message_says_required(self):
+        with pytest.raises(ValidationError, match="required"):
+            view().get_str("app.motto")
+
+
+# ---------------------------------------------------------------------------
+# Raw access and scoping
+# ---------------------------------------------------------------------------
+
+class TestRawAndScope:
+    def test_getitem_returns_raw_value(self):
+        assert view()["db.port"] == 5432
+        assert view()["db.pool"] == {"size": "10", "idle": None}
+
+    def test_getitem_raises_on_missing(self):
+        with pytest.raises(ValidationError, match="db.absent"):
+            view()["db.absent"]
+
+    def test_contains(self):
+        v = view()
+        assert "db.port" in v
+        assert "db.pool.idle" not in v  # None counts as unset
+        assert "nope" not in v
+
+    def test_scope_reads_relative_keys(self):
+        db = view().scope("db")
+        assert db.get_int("pool.size") == 10
+        assert db.get_str("host") == "db.internal"
+
+    def test_scope_errors_report_full_path(self):
+        db = view().scope("db")
+        with pytest.raises(ValidationError, match="db.pool.max"):
+            db.get_int("pool.max")
+
+    def test_nested_scope(self):
+        pool = view().scope("db").scope("pool")
+        assert pool.get_int("size") == 10
+        with pytest.raises(ValidationError, match="db.pool.gone"):
+            pool.get_str("gone")
+
+    def test_scope_of_missing_or_scalar_raises(self):
+        with pytest.raises(ValidationError, match="nothere"):
+            view().scope("nothere")
+        with pytest.raises(ValidationError, match="db.host"):
+            view().scope("db.host")
+
+
+# ---------------------------------------------------------------------------
+# Construction and export
+# ---------------------------------------------------------------------------
+
+class TestSurface:
+    def test_wraps_only_mappings(self):
+        from configlayer.typed import TypedView
+
+        with pytest.raises(ValidationError):
+            TypedView(["not", "a", "mapping"])
+
+    def test_exported_from_top_level_package(self):
+        import configlayer
+
+        assert hasattr(configlayer, "TypedView")
+        assert "TypedView" in configlayer.__all__
+
+    def test_works_over_layered_config_dict(self):
+        from configlayer import LayeredConfig, TypedView
+        from configlayer.source import DictSource
+
+        cfg = LayeredConfig([
+            DictSource({"db": {"port": "5432"}}, name="defaults"),
+            DictSource({"db": {"port": "6432"}}, name="override", priority=5),
+        ])
+        assert TypedView(cfg.as_dict()).get_int("db.port") == 6432
+
+
+# ---------------------------------------------------------------------------
+# End-to-end scenario
+# ---------------------------------------------------------------------------
+
+class TestScenario:
+    def test_service_settings_read_through_typed_view(self):
+        from configlayer import LayeredConfig, TypedView
+        from configlayer.source import DictSource
+
+        defaults = DictSource({
+            "server": {"port": "8080", "keepalive": "75s",
+                       "body_limit": "1MiB"},
+            "features": "",
+        }, name="defaults")
+        site = DictSource({
+            "server": {"port": "9090", "keepalive": "2m"},
+            "features": "checkout, refunds",
+        }, name="site", priority=10)
+        cfg = LayeredConfig([defaults, site])
+        v = TypedView(cfg.as_dict())
+
+        assert v.get_int("server.port") == 9090
+        assert v.get_duration("server.keepalive") == 120.0
+        assert v.get_size("server.body_limit") == 1_048_576
+        assert v.get_list("features") == ["checkout", "refunds"]
+
+    def test_whitespace_tolerated_in_numeric_strings(self):
+        from configlayer.typed import TypedView
+
+        v = TypedView({"a": " 5 ", "b": " 2.5 "})
+        assert v.get_int("a") == 5
+        assert v.get_float("b") == 2.5
+
+    def test_duration_and_size_grammar_reach_the_view(self):
+        from configlayer.typed import TypedView
+
+        v = TypedView({"t": "1.5h", "s": "0.1GB"})
+        assert v.get_duration("t") == 5400.0
+        assert v.get_size("s") == 100_000_000
+
+    def test_get_str_with_default(self):
+        from configlayer.typed import TypedView
+
+        v = TypedView({})
+        assert v.get_str("motto", default="n/a") == "n/a"
+
+    def test_repr_names_the_prefix(self):
+        db = view().scope("db")
+        assert "db" in repr(db)
