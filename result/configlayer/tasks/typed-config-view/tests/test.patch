+++ b/tests/typed/test_typed_parse.py
@@ -0,0 +1,317 @@
+"""Tests for the typed-value grammars: bool, duration, size, items."""
+
+from __future__ import annotations
+
+import pytest
+
+
+# ---------------------------------------------------------------------------
+# parse_bool
+# ---------------------------------------------------------------------------
+
+class TestParseBool:
+    def test_true_vocabulary(self):
+        from configlayer.typed import parse_bool
+
+        for word in ("true", "True", "YES", "on", "On", "1"):
+            assert parse_bool(word) is True, word
+
+    def test_false_vocabulary(self):
+        from configlayer.typed import parse_bool
+
+        for word in ("false", "FALSE", "no", "off", "OFF", "0"):
+            assert parse_bool(word) is False, word
+
+    def test_surrounding_whitespace_ignored(self):
+        from configlayer.typed import parse_bool
+
+        assert parse_bool("  yes  ") is True
+
+    def test_unknown_word_rejected(self):
+        from configlayer.typed import parse_bool
+
+        with pytest.raises(ValueError):
+            parse_bool("2")
+        with pytest.raises(ValueError):
+            parse_bool("enabled")
+
+
+# ---------------------------------------------------------------------------
+# parse_duration
+# ---------------------------------------------------------------------------
+
+class TestParseDuration:
+    def test_single_terms(self):
+        from configlayer.typed import parse_duration
+
+        assert parse_duration("45s") == 45.0
+        assert parse_duration("10m") == 600.0
+        assert parse_duration("2h") == 7200.0
+        assert parse_duration("1d") == 86400.0
+        assert parse_duration("1w") == 604800.0
+        assert parse_duration("250ms") == 0.25
+
+    def test_compound_terms(self):
+        from configlayer.typed import parse_duration
+
+        assert parse_duration("1h30m") == 5400.0
+        assert parse_duration("2d12h") == 216000.0
+        assert parse_duration("10m30s") == 630.0
+        assert parse_duration("1w2d3h4m5s") == 788645.0
+
+    def test_decimal_coefficients(self):
+        from configlayer.typed import parse_duration
+
+        assert parse_duration("1.5h") == 5400.0
+        assert parse_duration("0.5s") == 0.5
+
+    def test_plain_number_is_seconds(self):
+        from configlayer.typed import parse_duration
+
+        assert parse_duration("90") == 90.0
+        assert parse_duration("2.5") == 2.5
+
+    def test_result_is_float(self):
+        from configlayer.typed import parse_duration
+
+        assert isinstance(parse_duration("45s"), float)
+        assert isinstance(parse_duration("90"), float)
+
+    def test_out_of_order_units_rejected(self):
+        from configlayer.typed import parse_duration
+
+        with pytest.raises(ValueError, match="order"):
+            parse_duration("30m1h")
+
+    def test_repeated_unit_rejected(self):
+        from configlayer.typed import parse_duration
+
+        with pytest.raises(ValueError):
+            parse_duration("1h2h")
+
+    def test_spaces_between_terms_rejected(self):
+        from configlayer.typed import parse_duration
+
+        with pytest.raises(ValueError):
+            parse_duration("1h 30m")
+
+    def test_garbage_rejected(self):
+        from configlayer.typed import parse_duration
+
+        for bad in ("", "fast", "5x", "-5s", "h", "1.h"):
+            with pytest.raises(ValueError):
+                parse_duration(bad)
+
+
+# ---------------------------------------------------------------------------
+# parse_size
+# ---------------------------------------------------------------------------
+
+class TestParseSize:
+    def test_decimal_units(self):
+        from configlayer.typed import parse_size
+
+        assert parse_size("999B") == 999
+        assert parse_size("1KB") == 1000
+        assert parse_size("512MB") == 512_000_000
+        assert parse_size("2GB") == 2_000_000_000
+        assert parse_size("2TB") == 2_000_000_000_000
+
+    def test_binary_units(self):
+        from configlayer.typed import parse_size
+
+        assert parse_size("1KiB") == 1024
+        assert parse_size("4MiB") == 4_194_304
+        assert parse_size("1GiB") == 1_073_741_824
+        assert parse_size("1TiB") == 1_099_511_627_776
+
+    def test_units_match_case_insensitively(self):
+        from configlayer.typed import parse_size
+
+        assert parse_size("1kb") == 1000
+        assert parse_size("1KIB") == 1024
+        assert parse_size("1mib") == 1_048_576
+
+    def test_single_space_before_unit_allowed(self):
+        from configlayer.typed import parse_size
+
+        assert parse_size("512 MB") == 512_000_000
+
+    def test_fractional_numbers_with_whole_results(self):
+        from configlayer.typed import parse_size
+
+        assert parse_size("3.5GiB") == 3_758_096_384
+        assert parse_size("1.25KiB") == 1280
+        assert parse_size("0.5MB") == 500_000
+
+    def test_exact_arithmetic_on_decimal_fractions(self):
+        from configlayer.typed import parse_size
+
+        # 0.1 is not representable in binary floating point; the parser
+        # must still land exactly on 10**8.
+        assert parse_size("0.1GB") == 100_000_000
+        assert parse_size("0.3KB") == 300
+
+    def test_fractional_bytes_rejected(self):
+        from configlayer.typed import parse_size
+
+        with pytest.raises(ValueError, match="whole"):
+            parse_size("1.5B")
+        with pytest.raises(ValueError, match="whole"):
+            parse_size("0.0005KB")
+
+    def test_result_is_int(self):
+        from configlayer.typed import parse_size
+
+        value = parse_size("0.5MB")
+        assert value == 500_000
+        assert isinstance(value, int)
+
+    def test_unknown_or_missing_unit_rejected(self):
+        from configlayer.typed import parse_size
+
+        for bad in ("512", "512PB", "MB", "twelve MB", "5 MB extra"):
+            with pytest.raises(ValueError):
+                parse_size(bad)
+
+
+# ---------------------------------------------------------------------------
+# parse_items
+# ---------------------------------------------------------------------------
+
+class TestParseItems:
+    def test_split_and_strip(self):
+        from configlayer.typed import parse_items
+
+        assert parse_items("a, b ,c") == ["a", "b", "c"]
+
+    def test_empty_string_is_empty_list(self):
+        from configlayer.typed import parse_items
+
+        assert parse_items("") == []
+        assert parse_items("   ") == []
+
+    def test_single_item(self):
+        from configlayer.typed import parse_items
+
+        assert parse_items("alone") == ["alone"]
+
+    def test_empty_items_rejected(self):
+        from configlayer.typed import parse_items
+
+        for bad in ("a,,b", ",a", "a,", "a, ,b"):
+            with pytest.raises(ValueError):
+                parse_items(bad)
+
+
+# ---------------------------------------------------------------------------
+# format_duration
+# ---------------------------------------------------------------------------
+
+class TestFormatDuration:
+    def test_greedy_decomposition(self):
+        from configlayer.typed import format_duration
+
+        assert format_duration(5400) == "1h30m"
+        assert format_duration(788645) == "1w2d3h4m5s"
+        assert format_duration(3600) == "1h"
+        assert format_duration(0.25) == "250ms"
+
+    def test_zero_renders_as_zero_seconds(self):
+        from configlayer.typed import format_duration
+
+        assert format_duration(0) == "0s"
+
+    def test_fraction_of_a_second_keeps_ms_term(self):
+        from configlayer.typed import format_duration
+
+        assert format_duration(694861.5) == "1w1d1h1m1s500ms"
+
+    def test_round_trip_with_parse_duration(self):
+        from configlayer.typed import format_duration, parse_duration
+
+        for seconds in (0.25, 45.0, 5400.0, 216000.0, 788645.0):
+            assert parse_duration(format_duration(seconds)) == seconds
+
+    def test_sub_millisecond_rejected(self):
+        from configlayer.typed import format_duration
+
+        with pytest.raises(ValueError):
+            format_duration(0.0001)
+
+    def test_negative_rejected(self):
+        from configlayer.typed import format_duration
+
+        with pytest.raises(ValueError):
+            format_duration(-1)
+
+
+# ---------------------------------------------------------------------------
+# format_size
+# ---------------------------------------------------------------------------
+
+class TestFormatSize:
+    def test_largest_exact_unit_wins(self):
+        from configlayer.typed import format_size
+
+        assert format_size(1024) == "1KiB"
+        assert format_size(1000) == "1KB"
+        assert format_size(999) == "999B"
+        assert format_size(1_000_000_000_000) == "1TB"
+        assert format_size(1_099_511_627_776) == "1TiB"
+
+    def test_binary_beats_decimal_when_both_divide(self):
+        from configlayer.typed import format_size
+
+        # 128000 divides by both 1024 (125KiB) and 1000 (128KB); the
+        # larger multiplier — the binary unit — wins.
+        assert format_size(128000) == "125KiB"
+        assert format_size(1024000) == "1000KiB"
+
+    def test_inexact_quantities_fall_through_to_bytes(self):
+        from configlayer.typed import format_size
+
+        assert format_size(1536) == "1536B"
+
+    def test_falls_to_smaller_unit_when_larger_is_inexact(self):
+        from configlayer.typed import format_size
+
+        # 3.5 GiB is not a whole number of GiB, so MiB carries it.
+        assert format_size(3_758_096_384) == "3584MiB"
+
+    def test_zero_bytes(self):
+        from configlayer.typed import format_size
+
+        assert format_size(0) == "0B"
+
+    def test_round_trip_with_parse_size(self):
+        from configlayer.typed import format_size, parse_size
+
+        for count in (0, 999, 1000, 1024, 128000, 3_758_096_384):
+            assert parse_size(format_size(count)) == count
+
+    def test_bad_inputs_rejected(self):
+        from configlayer.typed import format_size
+
+        with pytest.raises(ValueError):
+            format_size(-1)
+        with pytest.raises(ValueError):
+            format_size(2.5)
+        with pytest.raises(ValueError):
+            format_size(True)
+
+
+class TestGrammarInterplay:
+    def test_parse_functions_are_exported_from_typed_package(self):
+        import configlayer.typed as typed
+
+        for name in ("parse_bool", "parse_duration", "parse_size",
+                     "parse_items", "format_duration", "format_size"):
+            assert hasattr(typed, name), name
+            assert name in typed.__all__, name
+
+    def test_duration_of_a_formatted_week(self):
+        from configlayer.typed import format_duration, parse_duration
+
+        week_and_change = parse_duration("1w") + parse_duration("36h")
+        assert format_duration(week_and_change) == "1w1d12h"
