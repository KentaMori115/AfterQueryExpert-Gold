+"""Tests for YAML support in FileSource."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from configlayer.exceptions import LoaderError, SourceError
+
+
+def write_file(tmp_path: Path, filename: str, content: str) -> Path:
+    p = tmp_path / filename
+    p.write_text(content, encoding="utf-8")
+    return p
+
+
+# ---------------------------------------------------------------------------
+# Format auto-detection
+# ---------------------------------------------------------------------------
+
+class TestYamlAutoDetect:
+    def test_yaml_extension_detected(self, tmp_path):
+        from configlayer.source import FileSource
+
+        p = write_file(tmp_path, "cfg.yaml", "k: v\n")
+        assert FileSource(str(p)).format == "yaml"
+
+    def test_yml_extension_detected(self, tmp_path):
+        from configlayer.source import FileSource
+
+        p = write_file(tmp_path, "cfg.yml", "k: v\n")
+        assert FileSource(str(p)).format == "yaml"
+
+    def test_uppercase_extension_detected(self, tmp_path):
+        from configlayer.source import FileSource
+
+        p = write_file(tmp_path, "CFG.YAML", "k: v\n")
+        assert FileSource(str(p)).format == "yaml"
+
+    def test_explicit_yaml_format_on_other_extension(self, tmp_path):
+        from configlayer.source import FileSource
+
+        p = write_file(tmp_path, "config.txt", "db:\n  port: 5432\n")
+        src = FileSource(str(p), format="yaml")
+        assert src.load() == {"db": {"port": 5432}}
+
+
+# ---------------------------------------------------------------------------
+# Loading
+# ---------------------------------------------------------------------------
+
+class TestYamlLoading:
+    def test_nested_document(self, tmp_path):
+        from configlayer.source import FileSource
+
+        text = (
+            "app:\n"
+            "  name: demo\n"
+            "  debug: false\n"
+            "db:\n"
+            "  host: localhost\n"
+            "  port: 5432\n"
+            "  replicas:\n"
+            "    - r1\n"
+            "    - r2\n"
+        )
+        p = write_file(tmp_path, "app.yaml", text)
+        data = FileSource(str(p)).load()
+        assert data == {
+            "app": {"name": "demo", "debug": False},
+            "db": {"host": "localhost", "port": 5432,
+                   "replicas": ["r1", "r2"]},
+        }
+
+    def test_dot_notation_get(self, tmp_path):
+        from configlayer.source import FileSource
+
+        p = write_file(tmp_path, "app.yaml", "db:\n  pool:\n    size: 7\n")
+        src = FileSource(str(p))
+        assert src.get("db.pool.size") == 7
+
+    def test_scalar_types_survive_loading(self, tmp_path):
+        from configlayer.source import FileSource
+
+        text = 'i: 3\nf: 0.25\nb: true\nn: null\ns: "0.25"\n'
+        p = write_file(tmp_path, "types.yml", text)
+        data = FileSource(str(p)).load()
+        assert data["i"] == 3 and isinstance(data["i"], int)
+        assert data["f"] == 0.25 and isinstance(data["f"], float)
+        assert data["b"] is True
+        assert data["n"] is None
+        assert data["s"] == "0.25"
+
+    def test_missing_file_raises_not_found(self, tmp_path):
+        from configlayer.source import FileSource
+
+        src = FileSource(str(tmp_path / "absent.yaml"))
+        with pytest.raises(SourceError, match="not found"):
+            src.load()
+
+
+# ---------------------------------------------------------------------------
+# Error wrapping
+# ---------------------------------------------------------------------------
+
+class TestYamlErrors:
+    def test_invalid_yaml_raises_source_error(self, tmp_path):
+        from configlayer.source import FileSource
+
+        p = write_file(tmp_path, "bad.yaml", "a: [1,\n")
+        with pytest.raises(SourceError, match="Invalid YAML"):
+            FileSource(str(p)).load()
+
+    def test_loader_error_is_chained_as_cause(self, tmp_path):
+        from configlayer.source import FileSource
+
+        p = write_file(tmp_path, "bad.yaml", "text: |\n  block\n")
+        try:
+            FileSource(str(p)).load()
+        except SourceError as exc:
+            assert isinstance(exc.__cause__, LoaderError)
+            assert "block scalars" in str(exc.__cause__)
+        else:  # pragma: no cover - the load must raise
+            pytest.fail("expected SourceError")
+
+    def test_error_names_the_file(self, tmp_path):
+        from configlayer.source import FileSource
+
+        p = write_file(tmp_path, "broken.yml", "x: &a 1\n")
+        with pytest.raises(SourceError, match=r"Invalid YAML in .*broken\.yml"):
+            FileSource(str(p)).load()
+
+    def test_root_sequence_raises_source_error(self, tmp_path):
+        from configlayer.source import FileSource
+
+        p = write_file(tmp_path, "list.yaml", "- a\n- b\n")
+        with pytest.raises(SourceError, match="Invalid YAML"):
+            FileSource(str(p)).load()
+
+
+# ---------------------------------------------------------------------------
+# Integration with the layer stack
+# ---------------------------------------------------------------------------
+
+class TestYamlLayering:
+    def test_yaml_file_as_a_layer(self, tmp_path):
+        from configlayer import LayeredConfig
+        from configlayer.source import DictSource, FileSource
+
+        p = write_file(tmp_path, "site.yaml",
+                       "db:\n  host: prod-db\n")
+        cfg = LayeredConfig([
+            DictSource({"db": {"host": "localhost", "port": 5432}},
+                       name="defaults"),
+            FileSource(str(p), priority=10),
+        ])
+        assert cfg["db.host"] == "prod-db"
+        assert cfg["db.port"] == 5432
+        assert cfg.origin("db.host") == "site.yaml"
+
+    def test_reload_picks_up_yaml_edits(self, tmp_path):
+        from configlayer import LayeredConfig
+        from configlayer.source import FileSource
+
+        p = write_file(tmp_path, "app.yaml", "flag: false\n")
+        cfg = LayeredConfig([FileSource(str(p))])
+        assert cfg["flag"] is False
+        write_file(tmp_path, "app.yaml", "flag: true\n")
+        changes = cfg.reload()
+        assert cfg["flag"] is True
+        assert any(change.path == "flag" for change in changes)
