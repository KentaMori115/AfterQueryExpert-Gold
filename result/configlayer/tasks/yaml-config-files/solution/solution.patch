@@ -0,0 +1,471 @@
+"""Minimal-YAML-subset configuration loader.
+
+A hand-written parser for the slice of YAML that configuration files
+actually use: block mappings and block sequences nested by indentation,
+one-line flow collections (``[a, b]`` and ``{k: v}``), quoted and bare
+scalars, and comments.  Deliberately *out of scope* — and rejected with a
+clear LoaderError that names the construct — are anchors and aliases,
+tags, block scalars (``|`` and ``>``), multi-document streams and
+multi-line flow collections, so the grammar stays small, dependency-free
+and unambiguous.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+from configlayer.exceptions import LoaderError
+from configlayer.loader.base import Loader
+
+# Escape sequences permitted inside a double-quoted scalar.
+_ESCAPES = {
+    '"': '"',
+    "\\": "\\",
+    "n": "\n",
+    "t": "\t",
+    "r": "\r",
+    "0": "\0",
+}
+
+# First characters that mark a construct outside the supported subset.
+_REJECTED_LEADS = {
+    "&": "anchors are not supported",
+    "*": "aliases are not supported",
+    "!": "tags are not supported",
+    "|": "block scalars are not supported",
+    ">": "block scalars are not supported",
+}
+
+
+class YAMLLoader(Loader):
+    """Loader that parses a documented subset of YAML into a nested dict.
+
+    The top level of the document must be a mapping; a document whose
+    root is a sequence or a scalar raises :class:`LoaderError`.
+
+    >>> YAMLLoader().load("db:\\n  host: localhost\\n  port: 5432\\n")
+    {'db': {'host': 'localhost', 'port': 5432}}
+    """
+
+    def load(self, text: str) -> dict[str, Any]:
+        lines = _logical_lines(text)
+        if not lines:
+            return {}
+        value, next_index = _parse_block(lines, 0, lines[0].indent)
+        if next_index != len(lines):
+            line = lines[next_index]
+            raise LoaderError(
+                f"line {line.number}: unexpected de-indented content "
+                f"after the document root"
+            )
+        if not isinstance(value, dict):
+            raise LoaderError(
+                "YAML document root must be a mapping, got "
+                f"{type(value).__name__}."
+            )
+        return value
+
+
+class _Line:
+    """One meaningful line: its indent, its content, and its 1-based number."""
+
+    __slots__ = ("indent", "text", "number")
+
+    def __init__(self, indent: int, text: str, number: int) -> None:
+        self.indent = indent
+        self.text = text
+        self.number = number
+
+
+def _logical_lines(text: str) -> list[_Line]:
+    """Split *text* into meaningful lines, dropping blanks and comments.
+
+    Raises
+    ------
+    LoaderError
+        If a tab character appears in indentation, or a document marker
+        (``---`` / ``...``) is present.
+    """
+    out: list[_Line] = []
+    for number, raw in enumerate(text.splitlines(), start=1):
+        stripped_lead = raw.lstrip(" ")
+        indent = len(raw) - len(stripped_lead)
+        if stripped_lead[:1] == "\t":
+            raise LoaderError(
+                f"line {number}: tab characters are not allowed in indentation"
+            )
+        content = _strip_comment(stripped_lead, number).rstrip()
+        if not content:
+            continue
+        if content in ("---", "...") or content.startswith("--- "):
+            raise LoaderError(
+                f"line {number}: document markers are not supported; "
+                "provide a single YAML document"
+            )
+        out.append(_Line(indent, content, number))
+    return out
+
+
+def _strip_comment(text: str, number: int) -> str:
+    """Remove a trailing ``#`` comment, honouring quoted regions."""
+    quote: str | None = None
+    i = 0
+    while i < len(text):
+        ch = text[i]
+        if quote == '"':
+            if ch == "\\":
+                i += 2
+                continue
+            if ch == '"':
+                quote = None
+        elif quote == "'":
+            if ch == "'":
+                # '' is an escaped quote inside a single-quoted scalar.
+                if i + 1 < len(text) and text[i + 1] == "'":
+                    i += 2
+                    continue
+                quote = None
+        elif ch in ('"', "'"):
+            quote = ch
+        elif ch == "#" and (i == 0 or text[i - 1] in " \t"):
+            return text[:i]
+        i += 1
+    if quote is not None:
+        raise LoaderError(f"line {number}: unterminated {quote} quoted string")
+    return text
+
+
+# ---------------------------------------------------------------------------
+# Block structure
+# ---------------------------------------------------------------------------
+
+def _parse_block(lines: list[_Line], i: int, indent: int) -> tuple[Any, int]:
+    """Parse the block starting at ``lines[i]`` whose items sit at *indent*."""
+    line = lines[i]
+    if line.indent != indent:
+        raise LoaderError(
+            f"line {line.number}: bad indentation (expected column {indent}, "
+            f"got {line.indent})"
+        )
+    if line.text == "-" or line.text.startswith("- "):
+        return _parse_sequence(lines, i, indent)
+    return _parse_mapping(lines, i, indent)
+
+
+def _parse_mapping(lines: list[_Line], i: int, indent: int) -> tuple[dict[str, Any], int]:
+    result: dict[str, Any] = {}
+    while i < len(lines):
+        line = lines[i]
+        if line.indent < indent:
+            break
+        if line.indent > indent:
+            raise LoaderError(
+                f"line {line.number}: bad indentation (expected column "
+                f"{indent}, got {line.indent})"
+            )
+        if line.text == "-" or line.text.startswith("- "):
+            raise LoaderError(
+                f"line {line.number}: sequence entry where a mapping key "
+                "was expected"
+            )
+        key, rest = _split_key(line.text, line.number)
+        if key in result:
+            raise LoaderError(
+                f"line {line.number}: duplicate mapping key {key!r}"
+            )
+        if rest:
+            result[key] = _parse_inline_value(rest, line.number)
+            i += 1
+        else:
+            value, i = _parse_child(lines, i + 1, indent)
+            result[key] = value
+    return result, i
+
+
+def _parse_sequence(lines: list[_Line], i: int, indent: int) -> tuple[list[Any], int]:
+    result: list[Any] = []
+    while i < len(lines):
+        line = lines[i]
+        if line.indent < indent:
+            break
+        if line.indent > indent:
+            raise LoaderError(
+                f"line {line.number}: bad indentation (expected column "
+                f"{indent}, got {line.indent})"
+            )
+        if not (line.text == "-" or line.text.startswith("- ")):
+            break
+        rest = line.text[1:].lstrip(" ")
+        if not rest:
+            value, i = _parse_child(lines, i + 1, indent)
+            result.append(value)
+            continue
+        if rest == "-" or rest.startswith("- "):
+            # Compact form: the dash opens a nested sequence on the same
+            # line.  Re-enter the sequence parser as if the nested entry
+            # began at the column where it actually starts.
+            column = line.indent + (len(line.text) - len(rest))
+            shifted = list(lines)
+            shifted[i] = _Line(column, rest, line.number)
+            value, i = _parse_sequence(shifted, i, column)
+            result.append(value)
+            continue
+        if _looks_like_key(rest):
+            # Compact form: the dash opens a mapping on the same line.  The
+            # column where the first key begins governs the entries below.
+            key_column = line.indent + (len(line.text) - len(rest))
+            value, i = _parse_compact_mapping(lines, i, key_column, rest)
+            result.append(value)
+            continue
+        result.append(_parse_inline_value(rest, line.number))
+        i += 1
+    return result, i
+
+
+def _parse_compact_mapping(
+    lines: list[_Line], i: int, key_column: int, first: str
+) -> tuple[dict[str, Any], int]:
+    """Parse ``- key: value`` and the aligned mapping entries below it."""
+    line = lines[i]
+    result: dict[str, Any] = {}
+    key, rest = _split_key(first, line.number)
+    if rest:
+        result[key] = _parse_inline_value(rest, line.number)
+        i += 1
+    else:
+        value, i = _parse_child(lines, i + 1, key_column)
+        result[key] = value
+    while i < len(lines) and lines[i].indent == key_column:
+        entry = lines[i]
+        if entry.text == "-" or entry.text.startswith("- "):
+            break
+        key, rest = _split_key(entry.text, entry.number)
+        if key in result:
+            raise LoaderError(
+                f"line {entry.number}: duplicate mapping key {key!r}"
+            )
+        if rest:
+            result[key] = _parse_inline_value(rest, entry.number)
+            i += 1
+        else:
+            value, i = _parse_child(lines, i + 1, key_column)
+            result[key] = value
+    return result, i
+
+
+def _parse_child(lines: list[_Line], i: int, parent_indent: int) -> tuple[Any, int]:
+    """Parse the nested block under a key or dash with no inline value."""
+    if i >= len(lines) or lines[i].indent <= parent_indent:
+        return None, i
+    return _parse_block(lines, i, lines[i].indent)
+
+
+def _looks_like_key(text: str) -> bool:
+    """Whether *text* begins a ``key:`` mapping entry rather than a scalar."""
+    try:
+        _, rest = _split_key(text, 0)
+    except LoaderError:
+        return False
+    return True
+
+
+def _split_key(text: str, number: int) -> tuple[str, str]:
+    """Split ``key: rest`` into the parsed key and the trimmed remainder.
+
+    The key may be bare (ending at the first ``:`` that is followed by a
+    space or ends the line) or quoted.  Raises LoaderError when no such
+    separator exists.
+    """
+    if text[:1] in ('"', "'"):
+        key, consumed = _read_quoted(text, 0, number)
+        rest = text[consumed:].lstrip(" ")
+        if rest[:1] != ":":
+            raise LoaderError(
+                f"line {number}: expected ':' after quoted key"
+            )
+        return key, rest[1:].lstrip(" ")
+    depth = 0
+    for i, ch in enumerate(text):
+        if ch in "[{":
+            depth += 1
+        elif ch in "]}":
+            depth -= 1
+        elif ch == ":" and depth == 0:
+            if i + 1 == len(text) or text[i + 1] == " ":
+                key = text[:i].rstrip()
+                if not key:
+                    raise LoaderError(f"line {number}: empty mapping key")
+                return key, text[i + 1 :].lstrip(" ")
+    raise LoaderError(
+        f"line {number}: expected a 'key: value' mapping entry, got {text!r}"
+    )
+
+
+# ---------------------------------------------------------------------------
+# Scalars and flow collections
+# ---------------------------------------------------------------------------
+
+def _parse_inline_value(text: str, number: int) -> Any:
+    """Parse a value that appears on the same line as its key or dash."""
+    lead = text[:1]
+    if lead in _REJECTED_LEADS:
+        raise LoaderError(f"line {number}: {_REJECTED_LEADS[lead]}")
+    if lead in "[{":
+        value, consumed = _parse_flow(text, 0, number)
+        trailing = text[consumed:].strip()
+        if trailing:
+            raise LoaderError(
+                f"line {number}: unexpected content {trailing!r} after "
+                "flow collection"
+            )
+        return value
+    if lead in ('"', "'"):
+        value, consumed = _read_quoted(text, 0, number)
+        trailing = text[consumed:].strip()
+        if trailing:
+            raise LoaderError(
+                f"line {number}: unexpected content {trailing!r} after "
+                "quoted scalar"
+            )
+        return value
+    return _coerce_scalar(text)
+
+
+def _parse_flow(text: str, i: int, number: int) -> tuple[Any, int]:
+    """Parse a flow collection starting at ``text[i]``; returns (value, end)."""
+    close = "]" if text[i] == "[" else "}"
+    is_seq = close == "]"
+    items: list[Any] = []
+    mapping: dict[str, Any] = {}
+    i += 1
+    while True:
+        i = _skip_spaces(text, i)
+        if i >= len(text):
+            kind = "sequence" if is_seq else "mapping"
+            raise LoaderError(f"line {number}: unterminated flow {kind}")
+        if text[i] == close:
+            i += 1
+            break
+        if is_seq:
+            value, i = _parse_flow_item(text, i, number)
+            items.append(value)
+        else:
+            key, i = _parse_flow_key(text, i, number)
+            i = _skip_spaces(text, i)
+            if text[i : i + 1] != ":":
+                raise LoaderError(
+                    f"line {number}: expected ':' in flow mapping"
+                )
+            i = _skip_spaces(text, i + 1)
+            value, i = _parse_flow_item(text, i, number)
+            if key in mapping:
+                raise LoaderError(
+                    f"line {number}: duplicate mapping key {key!r}"
+                )
+            mapping[key] = value
+        i = _skip_spaces(text, i)
+        if i >= len(text):
+            kind = "sequence" if is_seq else "mapping"
+            raise LoaderError(f"line {number}: unterminated flow {kind}")
+        if text[i] == ",":
+            i += 1
+            continue
+        if text[i] != close:
+            raise LoaderError(
+                f"line {number}: expected ',' or '{close}' in flow collection"
+            )
+    return (items if is_seq else mapping), i
+
+
+def _parse_flow_item(text: str, i: int, number: int) -> tuple[Any, int]:
+    ch = text[i]
+    if ch in _REJECTED_LEADS:
+        raise LoaderError(f"line {number}: {_REJECTED_LEADS[ch]}")
+    if ch in "[{":
+        return _parse_flow(text, i, number)
+    if ch in ('"', "'"):
+        return _read_quoted(text, i, number)
+    j = i
+    depth = 0
+    while j < len(text):
+        c = text[j]
+        if c in ",]}" and depth == 0:
+            break
+        j += 1
+    return _coerce_scalar(text[i:j].strip()), j
+
+
+def _parse_flow_key(text: str, i: int, number: int) -> tuple[str, int]:
+    if text[i] in ('"', "'"):
+        return _read_quoted(text, i, number)
+    j = i
+    while j < len(text) and text[j] not in ":,]}":
+        j += 1
+    key = text[i:j].strip()
+    if not key:
+        raise LoaderError(f"line {number}: empty mapping key")
+    return key, j
+
+
+def _read_quoted(text: str, i: int, number: int) -> tuple[str, int]:
+    """Read a quoted scalar starting at ``text[i]``; returns (value, end)."""
+    quote = text[i]
+    i += 1
+    out: list[str] = []
+    while i < len(text):
+        ch = text[i]
+        if quote == '"':
+            if ch == "\\":
+                esc = text[i + 1 : i + 2]
+                if esc not in _ESCAPES:
+                    raise LoaderError(
+                        f"line {number}: unknown escape sequence '\\{esc}'"
+                    )
+                out.append(_ESCAPES[esc])
+                i += 2
+                continue
+            if ch == '"':
+                return "".join(out), i + 1
+        else:
+            if ch == "'":
+                if text[i + 1 : i + 2] == "'":
+                    out.append("'")
+                    i += 2
+                    continue
+                return "".join(out), i + 1
+        out.append(ch)
+        i += 1
+    raise LoaderError(f"line {number}: unterminated {quote} quoted string")
+
+
+def _skip_spaces(text: str, i: int) -> int:
+    while i < len(text) and text[i] == " ":
+        i += 1
+    return i
+
+
+_INT_RE = re.compile(r"[-+]?\d+\Z")
+_FLOAT_RE = re.compile(r"[-+]?(?:\d+\.\d*|\.\d+|\d+(?=[eE]))(?:[eE][-+]?\d+)?\Z")
+
+
+def _coerce_scalar(text: str) -> Any:
+    """Coerce a bare scalar to bool, None, int, float, or leave it a str.
+
+    Only unambiguous literals coerce: ``true``/``false`` (lowercase),
+    ``null``/``~``/empty for None, plain base-10 integers, and decimal
+    floats with an optional exponent.  Anything else — including
+    ``inf``, ``nan``, and digit groups with ``_`` separators — stays a
+    string.
+    """
+    if text in ("null", "~", ""):
+        return None
+    if text == "true":
+        return True
+    if text == "false":
+        return False
+    if _INT_RE.match(text):
+        return int(text, 10)
+    if _FLOAT_RE.match(text):
+        return float(text)
+    return text
