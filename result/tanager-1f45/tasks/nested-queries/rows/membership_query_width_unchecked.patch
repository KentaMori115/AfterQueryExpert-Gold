+/// Render the subquery plans an expression carries, outermost first, each under
+/// its own `Subquery` line at `depth`.
+fn render_subqueries(expr: &BoundExpr, depth: usize, out: &mut String) {
+    match expr {
+        BoundExpr::ScalarSubquery { plan, .. }
+        | BoundExpr::Exists { plan }
+        | BoundExpr::InSubquery { plan, .. } => {
+            for _ in 0..depth {
+                out.push_str("  ");
+            }
+            out.push_str("Subquery\n");
+            plan.explain_into(out, depth + 1);
+        }
+        _ => {}
+    }
+    expr.for_each_child(&mut |child| render_subqueries(child, depth, out));
