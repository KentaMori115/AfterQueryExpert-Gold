+/// Visit the [`BoundExpr`]s this node holds itself, without recursing into its
+/// children. What a node evaluates is what it has to account for in `EXPLAIN`.
+pub fn node_expressions(plan: &LogicalPlan, f: &mut dyn FnMut(&BoundExpr)) {
+    match plan {
+        LogicalPlan::EmptyRow | LogicalPlan::Scan { .. } => {}
+        LogicalPlan::Filter { predicate, .. } => f(predicate),
+        LogicalPlan::Project { expressions, .. } => {
+            for e in expressions {
+                f(e);
+            }
+        }
+        LogicalPlan::Aggregate {
+            group_expr,
+            aggregates,
+            ..
+        } => {
+            for e in group_expr {
+                f(e);
+            }
+            for agg in aggregates {
+                if let Some(arg) = &agg.arg {
+                    f(arg);
+                }
+            }
+        }
+        LogicalPlan::Sort { keys, .. } => {
+            for k in keys {
+                f(&k.expr);
+            }
+        }
+        LogicalPlan::Limit { .. } | LogicalPlan::Distinct { .. } => {}
+        LogicalPlan::Join { on, .. } => f(on),
+    }
+}
