+/// Visit every [`BoundExpr`] a plan holds, this node first, then its children.
+///
+/// Reading a plan's expressions without rebuilding it is what lets a rule ask
+/// whether an expression is safe to move before it moves anything.
+pub fn plan_expressions(plan: &LogicalPlan, f: &mut dyn FnMut(&BoundExpr)) {
+    node_expressions(plan, f);
+    for child in plan.children() {
