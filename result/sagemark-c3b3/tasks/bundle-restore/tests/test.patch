+}
+
+function character(id: string, name: string, over: Row = {}): Row {
+  return {
+    id,
+    campaignId: SOURCE,
+    kind: 'pc', name, pronouns: '', ancestry: '', vocation: '', level: 3,
+    disposition: 'unknown', factionId: null, homeId: null, blurb: '', alive: true,
+    ...STAMPS,
+    ...over,
