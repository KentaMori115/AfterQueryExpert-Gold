+/** The brake on the drum, and what it is worth standing and running. */
+
+import { WindingError, insist, positive, within } from "../errors.ts";
+import { weightOf } from "../units/measure.ts";
+import { gross } from "../cage/index.ts";
+import { SLIP_MARGIN, tensions, workingRatio } from "../drum/koepe.ts";
+import { movingMass, worstOutOfBalance, leastOutOfBalance, mostOutOfBalance } from "../power/index.ts";
+import { overwindRoom } from "../shaft/index.ts";
+import { type Winder, dutyOf, windLength } from "../winder/model.ts";
+import { retardationFor } from "./gear.ts";
+
+/** A post brake. */
+export interface Brake {
+  /** Path diameter, metres. */
+  readonly diameter: number;
+  /** Shoe width, metres. */
+  readonly width: number;
+  /** Degrees of path one shoe covers. */
+  readonly arc: number;
+  /** Shoes bearing. */
+  readonly shoes: number;
+  /** Lining friction. */
+  readonly friction: number;
+  /** Force on each shoe, kilonewtons. */
+  readonly force: number;
+}
+
+/** Three times the worst is what the rules ask a brake to hold. */
+export const HOLDING_MARGIN = 3;
+
+/** And 0.7 N/mm2 is as hard as practice presses a shoe. */
+export const MOST_SHOE_PRESSURE = 0.7;
+
+/** Build one, with a middling set of figures for anything left out. */
+export function brake(diameter = 3, width = 0.3, arc = 50, shoes = 2, friction = 0.3, force = 150): Brake {
+  within(diameter, 0.4, 14, "diameter");
+  within(width, 0.01, 2, "width");
+  within(arc, 1, 200, "arc");
+  within(shoes, 1, 10, "shoes");
+  within(friction, 0.02, 0.8, "friction");
+  positive(force, "force");
+  return { diameter, width, arc, shoes, friction, force };
+}
+
+/** The brake a sheet named, or a refusal. */
+export function brakeOf(of: Winder): Brake {
+  if (of.brake === undefined) throw new WindingError("no brake was stated for that winder", "brake");
+  return of.brake;
+}
+
+/** Shoe drag times the radius it acts at, in kilonewton metres. */
+export function torque(one: Brake): number {
+  return (one.diameter * one.friction * one.force * one.shoes) / 2;
+}
+
+/** The same torque as a pull on the rope, in kilonewtons. */
+export function holdingPull(of: Winder): number {
+  return torque(brakeOf(of)) / dutyOf(of).radius;
+}
+
+/** The most a friction wheel will pass, in kilonewtons. */
+export function gripPull(of: Winder, margin = SLIP_MARGIN): number {
+  if (of.drive.kind !== "koepe") {
+    throw new WindingError("that winder is driven by a drum, not by friction", "drive");
+  }
+  const allowed = workingRatio(of.drive.koepe, margin);
+  const depth = windLength(of);
+  const up = weightOf(gross(of.rising));
+  const down = weightOf(gross(of.falling));
+  const ends = [0, depth].map((at) => tensions(of.rope, depth, up, down, at, of.ropes, of.balance).slack);
+  return Math.min(...ends) * (allowed - 1);
+}
+
+/** What the brake really holds at the rope. */
+export function heldPull(of: Winder): number {
+  const shoes = holdingPull(of);
+  return of.drive.kind === "koepe" ? Math.min(shoes, gripPull(of)) : shoes;
+}
+
+/** Whether it holds the wind standing. */
+export function holds(of: Winder, margin = HOLDING_MARGIN): boolean {
+  return heldPull(of) >= margin * worstOutOfBalance(dutyOf(of));
+}
+
+/** The shoe force that just would, in kilonewtons. */
+export function forceFor(of: Winder, margin = HOLDING_MARGIN): number {
+  const one = brakeOf(of);
+  const pull = margin * worstOutOfBalance(dutyOf(of));
+  return (2 * pull * dutyOf(of).radius) / (one.diameter * one.friction * one.shoes);
+}
+
+function overMass(of: Winder, force: number): number {
+  return Math.max(0, (force * 1000) / movingMass(dutyOf(of)));
+}
+
+/** What it retards a wind at, in metres a second squared. */
+export function retardationWinding(of: Winder): number {
+  return overMass(of, heldPull(of) + leastOutOfBalance(dutyOf(of)));
+}
+
+/** And a lowering, which is the smaller figure. */
+export function retardationLowering(of: Winder): number {
+  return overMass(of, heldPull(of) - mostOutOfBalance(dutyOf(of)));
+}
+
+/** Whether an overwind stops in the room the headgear leaves. */
+export function stopsAnOverwind(of: Winder): boolean {
+  return retardationWinding(of) >= retardationFor(of.profile.full, overwindRoom(of.shaft));
+}
+
+/** What a shoe presses at, in newtons a square millimetre. */
+export function pressure(one: Brake): number {
+  const swept = (Math.PI * one.diameter * one.arc * one.width) / 360;
+  insist(swept > 0, "a shoe covering nothing presses nothing", "arc");
+  return one.force / (1000 * swept);
+}
