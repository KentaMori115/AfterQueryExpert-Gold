+/** What a stated brake shows, and nothing where none was stated. */
+function postFindings(one: Winder): Finding[] {
+  const out: Finding[] = [];
+  const post = one.brake;
+  if (post === undefined) return out;
+  if (!holds(one)) {
+    out.push(finding("error", "brake", `${round(heldPull(one), 1)} kN at the rope will not hold this wind standing`));
+  }
+  if (!stopsAnOverwind(one)) {
+    out.push(finding("error", "brake", `this brake will not stop an overwind in ${overwindRoom(one.shaft)} m`));
+  }
+  if (pressure(post) > MOST_SHOE_PRESSURE) {
+    out.push(finding("warning", "brake", `${round(pressure(post), 3)} N/mm2 on a shoe is more than practice allows`));
+  }
+  out.push(
+    finding("note", "brake", `${post.shoes} shoes hold ${round(heldPull(one), 1)} kN, lowering at ${round(retardationLowering(one), 3)} m/s2`),
+  );
+  return out;
+}
