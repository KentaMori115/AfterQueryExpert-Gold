+/**
+ * The least the out-of-balance ever is across a wind, in kilonewtons.
+ *
+ * Signed, because on a cage winder it goes through nought and comes out
+ * the other side: at the end of the wind the rope on the falling side
+ * is heavier than everything the rising side is carrying, and the load
+ * that was being lifted is now driving.
+ *
+ * Walked rather than taken off the two ends. The line through them is
+ * straight while the ropes are the only thing moving, and every winder
+ * in this library is that winder, but nothing here promises it and the
+ * walk costs nothing.
+ */
+export function leastOutOfBalance(one: Duty): number {
+  let least = atStart(one);
+  for (let at = 0; at <= 100; at += 1) {
+    const found = outOfBalance(one, (one.depth * at) / 100);
+    if (found < least) least = found;
+  }
+  return round(least, 4);
+}
+
+/** And the most it ever is, which on an ordinary wind is at the start. */
+export function mostOutOfBalance(one: Duty): number {
+  let most = atEnd(one);
+  for (let at = 0; at <= 100; at += 1) {
+    const found = outOfBalance(one, (one.depth * at) / 100);
+    if (found > most) most = found;
+  }
+  return round(most, 4);
+}
+
+/**
+ * The worst of the two, in kilonewtons, whichever way it points.
+ *
+ * What a brake has to hold, because a brake does not know which way the
+ * load is trying to go and is not allowed to care.
+ */
+export function worstOutOfBalance(one: Duty): number {
+  return round(Math.max(Math.abs(leastOutOfBalance(one)), Math.abs(mostOutOfBalance(one))), 4);
+}
