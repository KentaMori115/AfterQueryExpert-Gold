+/// Build a join's output schema and scope from the paired frame.
+///
+/// Every pair in `merged` becomes one leading output column named after its
+/// left side, and the columns no pair names follow in frame order. A column on
+/// a side the join can null-extend comes out nullable even when its own table
+/// declared it `NOT NULL`, and a merged column is nullable when either source
+/// is.
+fn merged_output(
+    paired_schema: &Schema,
+    paired_scope: &Scope,
+    merged: &[(usize, usize)],
+    left_width: usize,
+    join_type: JoinType,
+) -> (Schema, Scope) {
+    let width = paired_schema.len();
+    let mut hidden = vec![false; width];
+    for &(l, r) in merged {
+        hidden[l] = true;
+        hidden[r] = true;
+    }
+    let carried: Vec<usize> = (0..width).filter(|&i| !hidden[i]).collect();
+
+    let mut fields = Vec::with_capacity(merged.len() + carried.len());
+    // Where each paired column ends up in the output frame.
+    let mut moved_to = vec![None; width];
+
+    for (out_index, &(l, r)) in merged.iter().enumerate() {
+        let left_field = paired_schema.field(l).expect("merged left column");
+        let right_field = paired_schema.field(r).expect("merged right column");
+        let data_type = left_field
+            .data_type()
+            .unify(right_field.data_type())
+            .unwrap_or_else(|| left_field.data_type());
+        let nullable = left_field.is_nullable() || right_field.is_nullable();
+        fields.push(Field::with_nullability(left_field.name(), data_type, nullable));
+        moved_to[l] = Some(out_index);
+        moved_to[r] = Some(out_index);
+    }
+
+    for (offset, &i) in carried.iter().enumerate() {
+        let field = paired_schema.field(i).expect("carried column");
+        let widened = if i < left_width {
+            join_type.keeps_unmatched_right()
+        } else {
+            join_type.keeps_unmatched_left()
+        };
+        fields.push(Field::with_nullability(
+            field.name(),
+            field.data_type(),
+            field.is_nullable() || widened,
+        ));
+        moved_to[i] = Some(merged.len() + offset);
+    }
+
+    let schema = Schema::new_unchecked(fields);
+
+    let mut scope = Scope::empty();
+    // A merged column answers to a bare name once, and to either qualifier.
+    for (out_index, &(l, _)) in merged.iter().enumerate() {
+        let field = schema.field(out_index).expect("merged field");
+        scope.push_column(None, field.name(), out_index, field.data_type(), true);
+        let _ = l;
+    }
+    for (qualifier, name, index, _, visible) in paired_scope.entries() {
+        let out_index = match moved_to[index] {
+            Some(i) => i,
+            None => continue,
+        };
+        let data_type = schema
+            .type_at(out_index)
+            .unwrap_or(DataType::Null);
+        let still_visible = visible && out_index >= merged.len();
+        scope.push_column(
+            qualifier.as_deref(),
+            &name,
+            out_index,
+            data_type,
+            still_visible,
+        );
+    }
+
+    (schema, scope)
+}
