+def _set_operation_statistics(plan: LogicalPlan) -> Statistics:
+    """Estimate an intersection or a difference from its two branches.
+
+    Both bounds are the row-level arithmetic read over whole branches: an
+    intersection keeps at most the smaller branch, and a difference at most
+    the left branch less the right, which floors at zero the way a counted
+    ``EXCEPT`` does. Neither can beat its left input either way.
+    """
+    left = estimate(plan.left)
+    right = estimate(plan.right)
+    if left.num_rows is None:
+        return Statistics(None)
+    if isinstance(plan, Intersect):
+        if right.num_rows is None:
+            return left.scaled(DEFAULT_SELECTIVITY)
+        rows = min(left.num_rows, right.num_rows)
+    else:
+        if right.num_rows is None:
+            return left.scaled(DEFAULT_SELECTIVITY)
+        rows = max(left.num_rows - right.num_rows, 0)
+    return Statistics(rows if plan.all else max(int(rows * 0.7), 0))
+
