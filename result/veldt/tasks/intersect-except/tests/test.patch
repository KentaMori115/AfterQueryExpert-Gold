+class TestNullPairing:
+    """Two nulls are the same row here, which a comparison would deny."""
+
+    def test_a_null_on_both_sides_survives_an_intersection(self):
+        engine = engine_over(alpha=["a", None], beta=[None])
+        assert column(engine, "SELECT x FROM alpha INTERSECT SELECT x FROM beta") == [None]
+
+    def test_a_null_on_the_right_cancels_a_null_on_the_left(self):
+        engine = engine_over(alpha=["a", None], beta=[None])
+        assert column(engine, "SELECT x FROM alpha EXCEPT SELECT x FROM beta") == ["a"]
+
+    def test_a_null_survives_a_difference_when_the_right_has_none(self):
+        engine = engine_over(alpha=["a", None], beta=["a"])
+        assert column(engine, "SELECT x FROM alpha EXCEPT SELECT x FROM beta") == [None]
+
+    def test_nulls_are_counted_like_any_other_row(self):
+        engine = engine_over(alpha=[None, None, None], beta=[None])
+        kept = column(engine, "SELECT x FROM alpha EXCEPT ALL SELECT x FROM beta")
+        assert kept == [None, None]
+
+    def test_pairing_and_comparison_disagree_about_two_nulls(self):
+        engine = engine_over(alpha=["a", None], beta=[None])
+        paired = "SELECT x FROM alpha INTERSECT SELECT x FROM beta"
+        assert engine.sql(paired).to_rows() == [(None,)]
+        assert engine.sql("SELECT x FROM alpha WHERE x = NULL").to_rows() == []
