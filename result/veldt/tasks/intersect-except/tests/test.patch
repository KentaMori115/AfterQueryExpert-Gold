+class TestIntersectAll:
+    """``ALL`` turns the intersection into ``min(m, n)`` copies of each row."""
+
+    def test_takes_the_smaller_of_the_two_counts(self):
+        engine = engine_over(alpha=["a", "a", "a"], beta=["a", "a"])
+        assert column(engine, "SELECT x FROM alpha INTERSECT ALL SELECT x FROM beta") == [
+            "a",
+            "a",
+        ]
+
+    def test_the_left_count_can_be_the_smaller_one(self):
+        engine = engine_over(alpha=["a", "a"], beta=["a", "a", "a", "a"])
+        kept = column(engine, "SELECT x FROM alpha INTERSECT ALL SELECT x FROM beta")
+        assert kept == ["a", "a"]
+
+    def test_a_row_missing_on_the_right_survives_zero_times(self):
+        engine = engine_over(alpha=["a", "a", "b"], beta=["a"])
+        assert column(engine, "SELECT x FROM alpha INTERSECT ALL SELECT x FROM beta") == [
+            "a"
+        ]
+
+    def test_counts_are_kept_per_row_value(self, letters):
+        kept = column(letters, "SELECT x FROM alpha INTERSECT ALL SELECT x FROM beta")
+        assert kept == ["a", "c", None]
+
+    def test_the_surviving_copies_stay_in_left_order(self):
+        engine = engine_over(alpha=["a", "b", "a", "b"], beta=["b", "a"])
+        kept = column(engine, "SELECT x FROM alpha INTERSECT ALL SELECT x FROM beta")
+        assert kept == ["a", "b"]
+
+    def test_it_differs_from_the_plain_spelling_when_copies_pile_up(self):
+        engine = engine_over(alpha=["a", "a"], beta=["a", "a"])
+        plain = "SELECT x FROM alpha INTERSECT SELECT x FROM beta"
+        counted = "SELECT x FROM alpha INTERSECT ALL SELECT x FROM beta"
+        assert column(engine, plain) == ["a"]
+        assert column(engine, counted) == ["a", "a"]
