+class TestColumnCounts:
+    """Both sides have to be the same width, whichever operator is written."""
+
+    def test_intersect_rejects_a_narrower_right_side(self, numbers):
+        with pytest.raises(PlanningError):
+            numbers.sql("SELECT x, x FROM one INTERSECT SELECT x FROM two")
+
+    def test_except_rejects_a_wider_right_side(self, numbers):
+        with pytest.raises(PlanningError):
+            numbers.sql("SELECT x FROM one EXCEPT SELECT x, x FROM two")
+
+    def test_a_union_in_the_same_chain_is_held_to_the_same_rule(self, numbers):
+        with pytest.raises(PlanningError):
+            numbers.sql("SELECT x FROM one UNION SELECT x, x FROM two")
+        with pytest.raises(PlanningError):
+            numbers.sql(
+                "SELECT x FROM one UNION SELECT x FROM two "
+                "INTERSECT SELECT x, x FROM one"
+            )
+
+    def test_a_mismatch_deeper_in_a_chain_is_caught_too(self, numbers):
+        with pytest.raises(PlanningError):
+            numbers.sql(
+                "SELECT x FROM one INTERSECT SELECT x FROM two "
+                "EXCEPT SELECT x, x FROM three"
+            )
+
