+class TestExceptAll:
+    """``ALL`` turns the difference into ``m - n`` copies, floored at zero."""
+
+    def test_subtracts_the_right_count_from_the_left_one(self):
+        engine = engine_over(alpha=["a", "a", "a"], beta=["a"])
+        assert column(engine, "SELECT x FROM alpha EXCEPT ALL SELECT x FROM beta") == [
+            "a",
+            "a",
+        ]
+
+    def test_a_surplus_on_the_right_floors_the_count_at_zero(self):
+        engine = engine_over(alpha=["a"], beta=["a", "a", "a"])
+        assert column(engine, "SELECT x FROM alpha EXCEPT ALL SELECT x FROM beta") == []
+
+    def test_rows_the_right_side_never_sent_survive_untouched(self):
+        engine = engine_over(alpha=["a", "b", "b"], beta=["a"])
+        assert column(engine, "SELECT x FROM alpha EXCEPT ALL SELECT x FROM beta") == [
+            "b",
+            "b",
+        ]
+
+    def test_each_right_copy_cancels_the_earliest_left_copy_standing(self):
+        # 'a' at position one is cancelled, so what is left of the row's run is
+        # the copy at position three, which lands after 'b'.
+        engine = engine_over(alpha=["a", "b", "a"], beta=["a"])
+        assert column(engine, "SELECT x FROM alpha EXCEPT ALL SELECT x FROM beta") == [
+            "b",
+            "a",
+        ]
+
+    def test_two_cancellations_reach_further_into_the_run(self):
+        engine = engine_over(alpha=["a", "b", "a", "c", "a"], beta=["a", "a"])
+        kept = column(engine, "SELECT x FROM alpha EXCEPT ALL SELECT x FROM beta")
+        assert kept == ["b", "c", "a"]
+
+    def test_counts_are_kept_per_row_value(self, letters):
+        kept = column(letters, "SELECT x FROM alpha EXCEPT ALL SELECT x FROM beta")
+        assert kept == ["b", "a", None]
+
+    def test_it_differs_from_the_plain_spelling_when_copies_pile_up(self):
+        engine = engine_over(alpha=["a", "a", "a"], beta=["a"])
+        plain = "SELECT x FROM alpha EXCEPT SELECT x FROM beta"
+        counted = "SELECT x FROM alpha EXCEPT ALL SELECT x FROM beta"
+        assert column(engine, plain) == []
+        assert column(engine, counted) == ["a", "a"]
