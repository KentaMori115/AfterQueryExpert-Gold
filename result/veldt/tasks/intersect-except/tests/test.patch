+class TestTypeUnification:
+    """Both branches are converted before rows are paired."""
+
+    def test_an_integer_pairs_with_the_matching_float(self):
+        engine = Engine()
+        engine.register_rows("whole", [{"x": 1}, {"x": 2}, {"x": 3}])
+        engine.register_rows("fractional", [{"x": 1.0}, {"x": 2.5}])
+        kept = column(engine, "SELECT x FROM whole INTERSECT SELECT x FROM fractional")
+        assert kept == [1.0]
+
+    def test_the_pairing_works_from_either_side(self):
+        engine = Engine()
+        engine.register_rows("whole", [{"x": 1}, {"x": 2}])
+        engine.register_rows("fractional", [{"x": 1.0}, {"x": 2.0}])
+        kept = column(engine, "SELECT x FROM fractional EXCEPT SELECT x FROM whole")
+        assert kept == []
+
+    def test_the_output_type_is_the_unified_one(self):
+        engine = Engine()
+        engine.register_rows("whole", [{"x": 1}, {"x": 2}])
+        engine.register_rows("fractional", [{"x": 1.0}])
+        result = engine.sql("SELECT x FROM whole INTERSECT SELECT x FROM fractional")
+        assert result.schema.dtypes == [DataType.FLOAT64]
+
+    def test_output_names_come_from_the_left_side(self):
+        engine = Engine()
+        engine.register_rows("whole", [{"x": 1}])
+        engine.register_rows("other", [{"y": 1}])
+        result = engine.sql("SELECT x FROM whole INTERSECT SELECT y FROM other")
+        assert result.column_names == ["x"]
+
+    def test_an_alias_on_the_left_names_the_output(self):
+        engine = Engine()
+        engine.register_rows("whole", [{"x": 1}, {"x": 2}])
+        engine.register_rows("other", [{"y": 2}])
+        result = engine.sql("SELECT x AS kept FROM whole EXCEPT SELECT y FROM other")
+        assert result.column_names == ["kept"]
+        assert result.column("kept") == [1]
+
+    def test_a_float_column_keeps_its_type_when_both_sides_are_whole(self):
+        engine = Engine()
+        engine.register_rows("whole", [{"x": 1}, {"x": 2}])
+        engine.register_rows("fractional", [{"x": 2.0}, {"x": 4.0}])
+        result = engine.sql("SELECT x FROM fractional INTERSECT SELECT x FROM whole")
+        assert result.schema.dtypes == [DataType.FLOAT64]
+        assert result.column("x") == [2.0]
