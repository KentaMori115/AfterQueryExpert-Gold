+"""How the two row-pairing set operations decide what survives.
+
+Every case here runs a whole statement through an engine and reads the rows
+back, because the pairing rules are a promise about answers rather than about
+any particular plan shape: how many copies of a row come out, in what order,
+and which values count as the same row in the first place.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from veldt import Engine, PlanningError
+from veldt.types.dtypes import DataType
+
+
+def engine_over(**tables) -> Engine:
+    """Build an engine holding one single-column table per keyword argument."""
+    engine = Engine()
+    for name, values in tables.items():
+        engine.register_rows(name, [{"x": value} for value in values])
+    return engine
+
+
+def column(engine: Engine, sql: str, name: str = "x", **options):
+    """Run a statement and return one output column as a list."""
+    return engine.sql(sql, **options).column(name)
+
+
+@pytest.fixture
+def letters() -> Engine:
+    """Two overlapping columns of text, both carrying repeats and nulls."""
+    return engine_over(
+        alpha=["a", "b", "a", "c", None, None],
+        beta=["a", "c", "c", None],
+    )
+
+
+@pytest.fixture
+def numbers() -> Engine:
+    """Three small integer columns that overlap pairwise but not everywhere."""
+    return engine_over(one=[1, 2, 3], two=[2, 3, 4], three=[3, 4, 5])
+
+
+class TestIntersectWithoutAll:
+    """``INTERSECT`` keeps what both sides produced, once each."""
+
+    def test_keeps_only_rows_the_right_side_also_produced(self, numbers):
+        assert column(numbers, "SELECT x FROM one INTERSECT SELECT x FROM two") == [2, 3]
+
+    def test_drops_every_row_the_right_side_never_produced(self, numbers):
+        kept = column(numbers, "SELECT x FROM one INTERSECT SELECT x FROM three")
+        assert kept == [3]
+
+    def test_an_empty_right_side_leaves_nothing(self, numbers):
+        query = "SELECT x FROM one INTERSECT SELECT x FROM two WHERE x > 100"
+        assert column(numbers, query) == []
+
+    def test_a_repeated_row_still_appears_once(self, letters):
+        assert column(letters, "SELECT x FROM alpha INTERSECT SELECT x FROM beta") == [
+            "a",
+            "c",
+            None,
+        ]
+
+    def test_repeats_on_the_right_do_not_multiply_the_output(self, letters):
+        # 'c' arrives twice on the right and once on the left.
+        kept = column(letters, "SELECT x FROM alpha INTERSECT SELECT x FROM beta")
+        assert kept.count("c") == 1
+
+    def test_output_follows_the_left_side_order(self, numbers):
+        numbers.register_rows("one", [{"x": v} for v in [3, 1, 2]], replace=True)
+        assert column(numbers, "SELECT x FROM one INTERSECT SELECT x FROM two") == [3, 2]
+
+    def test_intersecting_a_table_with_itself_deduplicates_it(self, letters):
+        kept = column(letters, "SELECT x FROM alpha INTERSECT SELECT x FROM alpha")
+        assert kept == ["a", "b", "c", None]
+
+
+class TestExceptWithoutAll:
+    """``EXCEPT`` keeps the left rows the right side never produced."""
+
+    def test_keeps_rows_absent_from_the_right_side(self, numbers):
+        assert column(numbers, "SELECT x FROM one EXCEPT SELECT x FROM two") == [1]
+
+    def test_keeps_everything_when_the_right_side_is_empty(self, numbers):
+        query = "SELECT x FROM one EXCEPT SELECT x FROM two WHERE x > 100"
+        assert column(numbers, query) == [1, 2, 3]
+
+    def test_a_repeated_row_survives_once(self, letters):
