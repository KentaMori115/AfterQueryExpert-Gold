+class TestWideRows:
+    """Pairing looks at the whole row, not at one column of it."""
+
+    @pytest.fixture
+    def pairs(self) -> Engine:
+        engine = Engine()
+        engine.register_rows(
+            "alpha",
+            [
+                {"a": 1, "b": "x"},
+                {"a": 1, "b": "y"},
+                {"a": 2, "b": "x"},
+                {"a": 1, "b": "x"},
+            ],
+        )
+        engine.register_rows("beta", [{"a": 1, "b": "x"}, {"a": 3, "b": "y"}])
+        return engine
+
+    def test_a_row_matches_only_when_every_column_matches(self, pairs):
+        result = pairs.sql("SELECT a, b FROM alpha INTERSECT SELECT a, b FROM beta")
+        assert result.to_rows() == [(1, "x")]
+
+    def test_a_partial_match_does_not_cancel_a_row(self, pairs):
+        result = pairs.sql("SELECT a, b FROM alpha EXCEPT SELECT a, b FROM beta")
+        assert result.to_rows() == [(1, "y"), (2, "x")]
+
+    def test_counting_works_across_the_whole_row(self, pairs):
+        result = pairs.sql("SELECT a, b FROM alpha EXCEPT ALL SELECT a, b FROM beta")
+        assert result.to_rows() == [(1, "y"), (2, "x"), (1, "x")]
