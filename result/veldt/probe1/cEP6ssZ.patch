ht = plans[i + 1]\n+            # Pop and apply any pending operators that bind at least as tightly\n+            # (same or higher precedence) \u2014 left-associativity.\n+            while op_stack and PREC[op_stack[-1][0]] >= PREC[kind]:\n+                top_kind, top_all = op_stack.pop()\n+                right_val = value_stack.pop()\n+                left_val = value_stack.pop()\n+                value_stack.append(self._apply_set_op(top_kind, left_val, right_val, top_all))\n+            value_stack.append(right)\n+            op_stack.append((kind, all_flag))\n+\n+        # Drain the stack.\n+        while op_stack:\n+            top_kind, top_all = op_stack.pop()\n+            right_val = value_stack.pop()\n+            left_val = value_stack.pop()\n+            value_stack.append(self._apply_set_op(top_kind, left_val, right_val, top_all))\n+\n+        assert len(value_stack) == 1\n+        return value_stack[0]\n+\n+    def _apply_set_op(\n+        self,\n+        kind: str,\n+        left: LogicalPlan,\n+        right: LogicalPlan,\n+        include_all: bool,\n+    ) -> LogicalPlan:\n+        \"\"\"Combine ``left`` and ``right`` with the named set operation.\"\"\"\n+        if kind == \"union\":\n+            combined: LogicalPlan = Union(left, right, include_all)\n+            return combined if include_all else Distinct(combined)\n+        if kind == \"intersect\":\n+            return Intersect(left, right, include_all)\n+        if kind == \"except\":\n+            return Except(left, right, include_all)\n+        raise PlanningError(f\"unsupported set operation {kind!r}\")\n \n     # ------------------------------------------------------------------\n     # Clause handling\ndiff --git a/src/veldt/sql/keywords.py b/src/veldt/sql/keywords.py\nindex ee090b7..464083d 100644\n--- a/src/veldt/sql/keywords.py\n+++ b/src/veldt/sql/keywords.py\n@@ -29,6 +29,8 @@ CLAUSE_KEYWORDS: FrozenSet[str] = frozenset(\n         \"limit\",\n         \"offset\",\n        