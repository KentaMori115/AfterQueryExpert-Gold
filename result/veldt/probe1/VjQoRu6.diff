+class TestExceptAll:
+    def test_multiset_max_minus_zero(self, dup_engine):
+        # t1: 1x2, 2x1, 3x1  |  t2: 1x1, 2x2
+        # max(2-1,0)=1 for 1, max(1-2,0)=0 for 2, max(1-0,0)=1 for 3
+        result = values(dup_engine, "SELECT a FROM t1 EXCEPT ALL SELECT a FROM t2")
+        assert result == [1, 3]
