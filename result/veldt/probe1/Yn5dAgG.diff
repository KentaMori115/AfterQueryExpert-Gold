+        # ----------------------------------------------------------------
+        if chain_order_by:
+            # Resolve ORDER BY keys against the combined output schema.
+            resolved_order_by = []
+            for key in chain_order_by:
+                expr = self._resolve_chain_order_key(key.expression, result.schema)
+                resolved_order_by.append(SortKey(expr, key.ascending, key.nulls_first))
+            result = Sort(result, tuple(resolved_order_by))
+        if chain_limit is not None or chain_offset:
+            result = Limit(result, chain_limit, chain_offset)
+
+        return result
+
+    def _resolve_chain_order_key(
+        self, expression: Expression, schema: Schema
+    ) -> "Expression":
+        """Resolve an ORDER BY key against the combined set-operation schema.
+
+        Accepts column names that appear in the combined output.  Unknown
+        names are left as-is so that the resolver can raise a useful error
+        later.
+        """
+        if isinstance(expression, ColumnRef) and expression.qualifier is None:
+            name_lc = expression.name.lower()
+            for field in schema:
+                if field.name.lower() == name_lc:
+                    return expression
+        return expression
 
