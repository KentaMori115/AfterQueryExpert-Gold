+@dataclass(frozen=True)
+class Intersect(LogicalPlan):
+    """Keeps rows that appear in both inputs.
+
+    Schema, including column names and unified types, is derived the same way
+    as :class:`Union`.  When ``all`` is false every surviving row appears once;
+    when true a row that appears *m* times on the left and *n* times on the
+    right survives ``min(m, n)`` times.
+    """
+
+    left: LogicalPlan
+    right: LogicalPlan
+    all: bool = False
+
+    @property
+    def schema(self) -> Schema:
+        return self.left.schema.union(self.right.schema)
+
+    def children(self) -> Tuple[LogicalPlan, ...]:
+        return (self.left, self.right)
+
+    def with_children(self, children: Sequence[LogicalPlan]) -> "Intersect":
+        _expect(children, 2, "Intersect")
+        return Intersect(children[0], children[1], self.all)
+
+    def describe(self) -> str:
+        return "Intersect: all" if self.all else "Intersect: distinct"
+
+
+@dataclass(frozen=True)
+class Except(LogicalPlan):
+    """Keeps left rows that do not appear in the right input.
+
+    Schema is derived the same way as :class:`Union`.  When ``all`` is false
+    every surviving row appears once; when true a row that appears *m* times
+    on the left and *n* times on the right survives ``max(m - n, 0)`` times.
+    """
+
+    left: LogicalPlan
+    right: LogicalPlan
+    all: bool = False
+
+    @property
+    def schema(self) -> Schema:
+        return self.left.schema.union(self.right.schema)
+
+    def children(self) -> Tuple[LogicalPlan, ...]:
+        return (self.left, self.right)
+
+    def with_children(self, children: Sequence[LogicalPlan]) -> "Except":
+        _expect(children, 2, "Except")
+        return Except(children[0], children[1], self.all)
+
+    def describe(self) -> str:
+        return "Except: all" if self.all else "Except: distinct"
+
+
 def _expect(children: Sequence[LogicalPlan], count: int, node: str) -> None:
     """Raise when a rewrite supplies the wrong number of children."""
     if len(children) != count:
