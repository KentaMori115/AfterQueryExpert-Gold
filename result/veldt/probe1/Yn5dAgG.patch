fore item[i+1])\n+        # ----------------------------------------------------------------\n+        items: List[SelectStatement] = []\n+        ops: List[Tuple[str, bool]] = []\n+        current: SelectStatement = statement\n+        while True:\n+            items.append(current)\n+            if current.set_operation is None:\n+                break\n+            ops.append((current.set_operation.kind, current.set_operation.all))\n+            current = current.set_operation.statement\n+\n+        # The last element may carry ORDER BY / LIMIT / OFFSET that belong to\n+        # the whole chain.  Strip them from that element before compiling it.\n+        last = items[-1]\n+        chain_order_by = last.order_by\n+        chain_limit = last.limit\n+        chain_offset = last.offset\n+        if chain_order_by or chain_limit is not None or chain_offset:\n+            # Replace the last element with one that has no sort/limit\n+            items[-1] = dataclasses.replace(\n+                last, order_by=(), limit=None, offset=0\n             )\n-        combined: LogicalPlan = Union(plan, right, operation.all)\n-        return combined if operation.all else Distinct(combined)\n+\n+        # Compile every branch individually.\n+        plans: List[LogicalPlan] = [self._compile_select(item) for item in items]\n+\n+        # ----------------------------------------------------------------\n+        # Build the tree respecting precedence:\n+        #   INTERSECT (level 1)  >  UNION / EXCEPT (level 0)\n+        #\n+        # Strategy: process left-to-right.  When the current operator is\n+        # INTERSECT, greedily consume the right operand and any subsequent\n+        # INTERSECT operators to form a left-associative INTERSECT sub-tree\n+        # before folding it into the level-0 chain.\n+        # ----------------------------------------------------------------\n+        def _combine(left: LogicalPlan, right: LogicalPlan,\n+                     kind: str, all_rows: bool) -> LogicalPlan:\n+            \"\"\"Produce the logical node for one set operation.\"\"\"\n+            n_left = len(left.schema)\n+            n_right = len(right.schema)\n+            if n_left != n_right:\n+                op_name = kind.upper()\n+                raise PlanningError(\n+                    f\"{op_name} requires both sides to produce the same number \"\n+                    f\"of columns: {n_left} and {n_right}\"\n+                )\n+            if kind == \"union\":\n+                combined: LogicalPlan = Union(left, right, all_rows)\n+                return combined if all_rows else Distinct(combined)\n+            if kind == \"intersect\":\n+                return Intersect(left, right, all_rows)\n+            if kind == \"except\":\n+                return Except(left, right, all_rows)\n+            raise PlanningError(f\"unsupported set operation {kind!r}\")  # pragma: no cover\n+\n+        # Walk through ops/plans building the result left-to-right.\n+        # INTERSECT binds more tightly than UNION/EXCEPT, so whenever a\n+        # UNION or EXCEPT appears, greedily collect any consecutive INTERSECT\n+        # operators on the right into a left-associative sub-tree first.\n+        # Adjacent INTERSECTs are processed one at a time (left-associative).\n+        result: LogicalPlan = plans[0]\n+        i = 0\n+        while i < len(ops):\n+            kind, all_rows = ops[i]\n+            if kind == \"intersect\":\n+                # Process immediately: left-associative within INTERSECT level.\n+                result = _combine(result, plans[i + 1], kind, all_rows)\n+                i += 1\n+            else:\n+                # UNION or EXCEPT: build the right INTERSECT group first.\n+                right_plan = plans[i + 1]\n+                j = i + 1\n+                while j < len(ops) and ops[j][0] == \"intersect\":\n+                    right_plan = _combine(right_plan, plans[j + 1],\n+                                         ops[j][0], ops[j][1])\n+                    j += 1\n+                result = _combine(result, right_plan, kind, all_rows)\n+                i = j\n+\n+        # ----------------------------------------------------------------\n+        # Apply chain-level ORDER BY / LIMIT / OFFSET.\n+        # ----------------------------------------------------------------\n+        if chain_order_by:\n+            # Resolve ORDER BY keys against the combined output schema.\n+            resolved_order_by = []\n+            for key in chain_order_by:\n+                expr = self._resolve_chain_order_key(key.expression, result.schema)\n+                resolved_order_by.append(SortKey(expr, key.ascending, key.nulls_first))\n+            result = Sort(result, tuple(resolved_order_by))\n+        if chain_limit is not None or chain_offset:\n+            result = Limit(result, chain_limit, chain_offset)\n+\n+        return result\n+\n+    def _resolve_chain_order_key(\n+        self, expression: Expression, schema: Schema\n+    ) -> \"Expression\":\n+        \"\"\"Resolve an ORDER BY key against the combined set-operation schema.\n+\n+        Accepts column names that appear in the combined output.  Unknown\n+        names are left as-is so that the resolver can raise a useful error\n+        later.\n+        \"\"\"\n+        if isinstance(expression, ColumnRef) and expression.qualifier is None:\n+            name_lc = expression.name.lower()\n+            for field in schema:\n+                if field.name.lower() == name_lc:\n+                    return expression\n+        return expression\n \n     # ------------------------------------------------------------------\n     # Clause handling\ndiff --git a/src/veldt/sql/keywords.py b/src/veldt/sql/keywords.py\nindex ee090b7..41d14a9 100644\n--- a/src/veldt/sql/keywords.py\n+++ b/src/veldt/sql/keywords.py\n@@ -29,6 +29,8 @@ CLAUSE_KEYWORDS: FrozenSet[str] = frozenset(\n         \"limit\",\n         \"offset\",\n         \"union\",\n+        \"intersect\",\n+        \"except\",\n         \"join\",\n         \"inner\",\n         \"left\",\n@@ -50,7 +52,7 @@ JOIN_KEYWORDS: Dict[str, str] = {\n     \"cross\": \"cross\",\n }\n \n-SET_OPERATORS: FrozenSet[str] = frozenset({\"union\"})\n+SET_OPERATORS: FrozenSet[str] = frozenset({\"union\", \"intersect\", \"except\"})\n \n # Words that may not be used as a table or column alias without quoting.\n RESERVED: FrozenSet[str] = CLAUSE_KEYWORDS | frozenset(\n@@ -66,8 +68,10 @@ RESERVED: FrozenSet[str] = CLAUSE_KEYWORDS | frozenset(\n         \"distinct\",\n         \"else\",\n         \"end\",\n+        \"except\",\n         \"false\",\n         \"in\",\n+        \"intersect\",\n         \"is\",\n         \"like\",\n         \"not\",\ndiff --git a/src/veldt/sql/parser.py b/src/veldt/sql/parser.py\nindex c64916d..9062dd0 100644\n--- a/src/veldt/sql/parser.py\n+++ b/src/veldt/sql/parser.py\n@@ -310,10 +310,11 @@ class SqlParser(ExpressionParser):\n         return value\n \n     def _parse_set_operation(self) -> Optional[SetOperation]:\n-        if not self.match_keyword(\"union\"):\n-            return None\n-        include_all = self.match_keyword(\"all\")\n-        return SetOperation(\"union\", self.parse_select(), include_all)\n+        for kind in (\"union\", \"intersect\", \"except\"):\n+            if self.match_keyword(kind):\n+                include_all = self.match_keyword(\"all\")\n+                return SetOperation(kind, self.parse_select(), include_all)\n+        return None\n \n \n def _has_aggregate(expression: Expression) -> bool:\ndiff --git a/tests/test_intersect_except.py b/tests/test_intersect_except.py\nnew file mode 100644\nindex 0000000..9e29cad\n--- /dev/null\n+++ b/tests/test_intersect_except.py\n@@ -0,0 +1,641 @@\n+\"\"\"Tests for INTERSECT and EXCEPT set operations.\"\"\"\n+\n+from __future__ import annotations\n+\n+import pytest\n+\n+from veldt import Engine\n+from veldt.core.table import Table\n+from veldt.errors import PlanningError\n+from veldt.execution.operators.intersect import ExceptOperator, IntersectOperator\n+from veldt.execution.context import ExecutionContext\n+from veldt.plan.logical import Except, Intersect\n+from veldt.sql.compiler import compile_sql\n+from veldt.sql.parser import parse_select\n+from veldt.storage.catalog import Catalog\n+from veldt.storage.memory import MemorySource\n+from veldt.types.dtypes import DataType\n+from veldt.types.schema import Field, Schema\n+\n+\n+# ---------------------------------------------------------------------------\n+# Fixtures\n+# ---------------------------------------------------------------------------\n+\n+INT_SCHEMA = Schema([Field(\"x\", DataType.INT64)])\n+FLOAT_SCHEMA = Schema([Field(\"x\", DataType.FLOAT64)])\n+\n+\n+def make_catalog(**tables):\n+    \"\"\"Build a catalog from name \u2192 list-of-dicts (or Table) mappings.\"\"\"\n+    catalog = Catalog()\n+    for name, rows in tables.items():\n+        if isinstance(rows, Table):\n+            table = rows\n+        else:\n+            table = Table.from_dicts(rows)\n+        catalog.register(name, MemorySource(name, table))\n+    return catalog\n+\n+\n+def make_engine(**tables):\n+    \"\"\"Build a small engine from name \u2192 list-of-dicts (or Table) mappings.\"\"\"\n+    return Engine(make_catalog(**tables))\n+\n+\n+def rows(engine, sql):\n+    return engine.sql(sql).to_dicts()\n+\n+\n+# ---------------------------------------------------------------------------\n+# Parser\n+# ---------------------------------------------------------------------------\n+\n+class TestParser:\n+    def test_intersect_is_recognised(self):\n+        stmt = parse_select(\"SELECT a FROM t INTERSECT SELECT b FROM u\")\n+        assert stmt.set_operation.kind == \"intersect\"\n+        assert stmt.set_operation.all is False\n+\n+    def test_intersect_all_is_recognised(self):\n+        stmt = parse_select(\"SELECT a FROM t INTERSECT ALL SELECT b FROM u\")\n+        assert stmt.set_operation.kind == \"intersect\"\n+        assert stmt.set_operation.all is True\n+\n+    def test_except_is_recognised(self):\n+        stmt = parse_select(\"SELECT a FROM t EXCEPT SELECT b FROM u\")\n+        assert stmt.set_operation.kind == \"except\"\n+        assert stmt.set_operation.all is False\n+\n+    def test_except_all_is_recognised(self):\n+        stmt = parse_select(\"SELECT a FROM t EXCEPT ALL SELECT b FROM u\")\n+        assert stmt.set_operation.kind == \"except\"\n+        assert stmt.set_operation.all is True\n+\n+    def test_chain_is_parsed(self):\n+        stmt = parse_select(\n+            \"SELECT a FROM t UNION SELECT b FROM u INTERSECT SELECT c FROM v\"\n+        )\n+        assert stmt.set_operation.kind == \"union\"\n+        assert stmt.set_operation.statement.set_operation.kind == \"intersect\"\n+\n+\n+# ---------------------------------------------------------------------------\n+# Logical plan\n+# ---------------------------------------------------------------------------\n+\n+class TestLogicalNodes:\n+    def setup_method(self):\n+        schema = INT_SCHEMA\n+        source = MemorySource(\"t\", Table.from_dicts([{\"x\": 1}], schema))\n+        from veldt.plan.logical import Scan, Project\n+        from veldt.expr.ast import ColumnRef\n+        scan = Scan(source, \"t\")\n+        self.left = Project(scan, (ColumnRef(\"x\"),))\n+        self.right = Project(scan, (ColumnRef(\"x\"),))\n+\n+    def test_intersect_schema_uses_left_names(self):\n+        node = Intersect(self.left, self.right)\n+        assert node.schema.names == [\"x\"]\n+\n+    def test_intersect_all_describes_correctly(self):\n+        assert Intersect(self.left, self.right, all=True).describe() == \"Intersect: all\"\n+\n+    def test_intersect_distinct_describes_correctly(self):\n+        assert Intersect(self.left, self.right, all=False).describe() == \"Intersect: distinct\"\n+\n+    def test_except_schema_uses_left_names(self):\n+        node = Except(self.left, self.right)\n+        assert node.schema.names == [\"x\"]\n+\n+    def test_except_all_describes_correctly(self):\n+        assert Except(self.left, self.right, all=True).describe() == \"Except: all\"\n+\n+    def test_except_distinct_describes_correctly(self):\n+        assert Except(self.left, self.right, all=False).describe() == \"Except: distinct\"\n+\n+    def test_intersect_with_children(self):\n+        node = Intersect(self.left, self.right)\n+        rebuilt = node.with_children([self.right, self.left])\n+        assert rebuilt.left is self.right\n+        assert rebuilt.right is self.left\n+\n+    def test_except_with_children(self):\n+        node = Except(self.left, self.right)\n+        rebuilt = node.with_children([self.right, self.left])\n+        assert rebuilt.left is self.right\n+        assert rebuilt.right is self.left\n+\n+\n+# ---------------------------------------------------------------------------\n+# Precedence and associativity\n+# ---------------------------------------------------------------------------\n+\n+class TestPrecedence:\n+    def setup_method(self):\n+        schema = INT_SCHEMA\n+        source = MemorySource(\"t\", Table.from_dicts([{\"x\": 1}], schema))\n+        self.catalog = Catalog()\n+        self.catalog.register(\"t\", source)\n+\n+    def _compile(self, sql):\n+        return compile_sql(sql, self.catalog)\n+\n+    def test_intersect_binds_tighter_than_union(self):\n+        # a UNION b INTERSECT c  \u2192  Union(a, Intersect(b, c))\n+        plan = self._compile(\n+            \"SELECT x FROM t UNION SELECT x FROM t INTERSECT SELECT x FROM t\"\n+        )\n+        # Top is Distinct wrapping Union; Union's right child should be Intersect\n+        from veldt.plan.logical import Distinct, Union\n+        assert isinstance(plan, Distinct)\n+        assert isinstance(plan.input, Union)\n+        assert isinstance(plan.input.right, Intersect)\n+\n+    def test_intersect_binds_tighter_than_except(self):\n+        # a EXCEPT