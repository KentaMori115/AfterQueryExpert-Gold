+class Intersect(LogicalPlan):
+    """Keeps the rows both inputs produced.
+
+    ``all`` selects multiset semantics: a row supplied ``m`` times on the left
+    and ``n`` times on the right survives ``min(m, n)`` times. Without it every
+    surviving row appears once.
+    """
+
+    left: LogicalPlan
+    right: LogicalPlan
+    all: bool = False
+
+    @property
+    def schema(self) -> Schema:
+        return self.left.schema.union(self.right.schema)
+
+    def children(self) -> Tuple[LogicalPlan, ...]:
+        return (self.left, self.right)
+
+    def with_children(self, children: Sequence[LogicalPlan]) -> "Intersect":
+        _expect(children, 2, "Intersect")
+        return Intersect(children[0], children[1], self.all)
+
+    def describe(self) -> str:
+        return "Intersect: all" if self.all else "Intersect: distinct"
+
