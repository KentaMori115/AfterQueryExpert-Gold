+def _pairing_statistics(plan: "Intersect | Except") -> Statistics:
+    """Estimate an ``INTERSECT`` or ``EXCEPT``.
+
+    Neither operator can produce more rows than its left input, and an
+    intersection is capped by its right input as well. ``ALL`` reports that
+    bound; the plain spelling scales it the way a plain ``UNION`` is scaled,
+    floored at zero rather than one, because a set difference really can come
+    back empty.
+    """
+    left = estimate(plan.left)
+    if left.num_rows is None:
+        return Statistics(None)
+    bound = left.num_rows
+    if isinstance(plan, Intersect):
+        right = estimate(plan.right)
+        if right.num_rows is None:
+            return Statistics(None)
+        bound = min(bound, right.num_rows)
+    return Statistics(bound if plan.all else max(int(bound * 0.7), 0))
