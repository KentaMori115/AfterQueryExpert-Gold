+@dataclass(frozen=True)
+class Intersect(LogicalPlan):
+    """Keeps the rows both inputs produced.
+
+    ``all`` selects multiset semantics: a row supplied ``m`` times on the left
+    and ``n`` times on the right survives ``min(m, n)`` times. Without it every
+    surviving row appears once. The output schema is unified exactly as a
+    :class:`Union`'s is, and rows pair by value and by type after that
+    conversion, so two nulls pair and ``1`` pairs with ``1.0``.
+    """
+
+    left: LogicalPlan
+    right: LogicalPlan
+    all: bool = False
+
+    @property
+    def schema(self) -> Schema:
+        return self.left.schema.union(self.right.schema)
+
+    def children(self) -> Tuple[LogicalPlan, ...]:
+        return (self.left, self.right)
+
+    def with_children(self, children: Sequence[LogicalPlan]) -> "Intersect":
+        _expect(children, 2, "Intersect")
+        return Intersect(children[0], children[1], self.all)
+
+    def describe(self) -> str:
+        return "Intersect: all" if self.all else "Intersect: distinct"
+
+
+@dataclass(frozen=True)
+class Except(LogicalPlan):
+    """Keeps the left rows the right input never produced.
+
+    ``all`` selects multiset semantics: a row supplied ``m`` times on the left
+    and ``n`` times on the right survives ``max(m - n, 0)`` times, each
+    right-hand copy cancelling the earliest left copy still standing. Without
+    it a row survives only when the right input never produced it at all.
+    """
+
+    left: LogicalPlan
+    right: LogicalPlan
+    all: bool = False
+
+    @property
+    def schema(self) -> Schema:
+        return self.left.schema.union(self.right.schema)
+
+    def children(self) -> Tuple[LogicalPlan, ...]:
+        return (self.left, self.right)
+
+    def with_children(self, children: Sequence[LogicalPlan]) -> "Except":
+        _expect(children, 2, "Except")
+        return Except(children[0], children[1], self.all)
+
+    def describe(self) -> str:
+        return "Except: all" if self.all else "Except: distinct"
+
+
