+def _pairing_statistics(plan: LogicalPlan) -> Statistics:
+    """Estimate an intersection or a difference from its inputs.
+
+    Neither can produce more rows than its left input, and an intersection is
+    capped by its right input too. ``ALL`` reports that bound; the plain
+    spelling scales it the way a plain union's estimate is scaled, floored at
+    zero rather than one, because both operators really can produce nothing.
+    """
+    left = estimate(plan.left)
+    if left.num_rows is None:
+        return Statistics(None)
+    bound = left.num_rows
+    if isinstance(plan, Intersect):
+        right = estimate(plan.right)
+        if right.num_rows is not None:
+            bound = min(bound, right.num_rows)
+    if plan.all:
+        return Statistics(bound)
+    return Statistics(max(int(bound * 0.7), 0))
+
