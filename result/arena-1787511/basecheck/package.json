{
  "name": "arenaflow",
  "version": "1.0.0",
  "description": "Deterministic competitive gaming infrastructure engine for tournaments, scoring, rankings, rewards, and seasons.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "bin": {
    "arenaflow": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "keywords": [
    "tournament",
    "esports",
    "matchmaking",
    "leaderboard",
    "event-sourcing"
  ],
  "license": "MIT",
  "author": "Redacted Author",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
