+import { assertEpochMillis, type EpochMillis } from "../../clock.js";
+import { explain, type DecisionExplanation } from "../../explain.js";
+import type { PlayerId, RankingEntry, TournamentId } from "../../types.js";
+import { toLeaderboard, type Leaderboard } from "../../domain/rankings/leaderboard.js";
+
+/**
+ * A board an operator stood behind. Ranks move against the last one of
+ * these, never against an intermediate board that a void or a reversal has
+ * since thrown away.
+ */
+export interface PublishedBoard {
+  readonly tournamentId: TournamentId;
+  readonly at: EpochMillis;
+  readonly board: Leaderboard;
+  readonly explanation: DecisionExplanation;
+}
+
+export class PublishedBoards {
+  private readonly boards = new Map<TournamentId, PublishedBoard>();
+  private readonly log: PublishedBoard[] = [];
+
+  publish(
+    tournamentId: TournamentId,
+    entries: readonly RankingEntry[],
+    at: EpochMillis,
+  ): PublishedBoard {
+    assertEpochMillis(at, "publish.at");
+    const board = toLeaderboard(tournamentId, entries);
+    const published = Object.freeze({
+      tournamentId,
+      at,
+      board,
+      explanation: explain("rank.published", `published ${board.size} ranks for ${tournamentId}`, {
+        tournamentId,
+        size: board.size,
+        at,
+      }),
+    });
+    this.boards.set(tournamentId, published);
+    this.log.push(published);
+    return published;
+  }
+
+  latest(tournamentId: TournamentId): PublishedBoard | undefined {
+    return this.boards.get(tournamentId);
+  }
+
+  /** The ranks a fresh computation measures movement against, if any. */
+  baseline(tournamentId: TournamentId): readonly RankingEntry[] | undefined {
+    return this.boards.get(tournamentId)?.board.entries;
+  }
+
+  rankOf(tournamentId: TournamentId, playerId: PlayerId): number | undefined {
+    return this.baseline(tournamentId)?.find((entry) => entry.playerId === playerId)?.rank;
+  }
+
+  publishedAt(tournamentId: TournamentId): EpochMillis | undefined {
+    return this.boards.get(tournamentId)?.at;
+  }
+
+  /** Every publication for one tournament, oldest first. */
+  history(tournamentId: TournamentId): PublishedBoard[] {
+    return this.log.filter((entry) => entry.tournamentId === tournamentId);
+  }
+
+  count(): number {
+    return this.boards.size;
+  }
+
+  forget(tournamentId: TournamentId): void {
+    this.boards.delete(tournamentId);
+  }
+}
