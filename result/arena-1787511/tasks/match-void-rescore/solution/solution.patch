@@ -0,0 +1,140 @@
+import { InvalidArgumentError } from "../../errors.js";
+import { assertEpochMillis, type EpochMillis } from "../../clock.js";
+import { explain, type DecisionExplanation } from "../../explain.js";
+import type {
+  MatchOutcome,
+  MatchRecord,
+  PlayerId,
+  PlayerRecord,
+  ScoreRecord,
+  TournamentId,
+  TournamentRecord,
+} from "../../types.js";
+import { emptyScore } from "../../domain/scores/score.js";
+import { scoringEngine } from "./scoring-engine.js";
+
+/**
+ * One result that still counts. A voided match contributes none, so the
+ * surviving list is the whole truth about a tournament's standings and a
+ * score record can always be derived from it without reading what the
+ * record held before.
+ */
+export interface SurvivingResult {
+  readonly matchId: string;
+  readonly playerId: PlayerId;
+  readonly outcome: MatchOutcome;
+  readonly rawScore: number;
+  readonly at: EpochMillis;
+}
+
+export interface ScoreRebuild {
+  readonly scores: readonly ScoreRecord[];
+  readonly surviving: readonly SurvivingResult[];
+  readonly explanation: DecisionExplanation;
+}
+
+/**
+ * Every result a tournament still counts, oldest first. Only completed
+ * matches carry results that survive: pending and started matches have not
+ * scored yet, and a voided one has stopped counting. Matches that completed
+ * on the same millisecond are ordered by match id so the fold is
+ * deterministic whatever order the store hands them back in.
+ */
+export function survivingResults(
+  matches: readonly MatchRecord[],
+  tournamentId: TournamentId,
+): SurvivingResult[] {
+  const completed = matches
+    .filter((match) => match.tournamentId === tournamentId && match.status === "completed")
+    .sort((a, b) => (a.completedAt ?? 0) - (b.completedAt ?? 0) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
+  const results: SurvivingResult[] = [];
+  for (const match of completed) {
+    const at = match.completedAt ?? match.createdAt;
+    for (const result of match.results) {
+      results.push(
+        Object.freeze({
+          matchId: match.id,
+          playerId: result.playerId,
+          outcome: result.outcome,
+          rawScore: result.rawScore,
+          at,
+        }),
+      );
+    }
+  }
+  return results;
+}
+
+export function resultsForPlayer(
+  results: readonly SurvivingResult[],
+  playerId: PlayerId,
+): SurvivingResult[] {
+  return results.filter((result) => result.playerId === playerId);
+}
+
+/**
+ * Fold one player's surviving results into a fresh score record. Awards are
+ * decided again rather than subtracted, so a streak bonus that a later win
+ * only reached because of a result that no longer counts is not paid, and
+ * the streak, the best streak and the counts all follow the surviving chain.
+ */
+export function rebuildScoreRecord(
+  player: PlayerRecord,
+  tournament: TournamentRecord,
+  results: readonly SurvivingResult[],
+  fallbackAt: EpochMillis,
+): ScoreRecord {
+  assertEpochMillis(fallbackAt, "rebuild.at");
+  const first = results[0];
+  let record = emptyScore(player.id, tournament.id, first ? first.at : fallbackAt);
+  for (const result of results) {
+    record = scoringEngine.decide({
+      player,
+      tournament,
+      current: record,
+      outcome: result.outcome,
+      rawScore: result.rawScore,
+      at: result.at,
+    }).next;
+  }
+  return record;
+}
+
+/**
+ * Rebuild every score record a tournament holds. Players whose results were
+ * untouched land back on the same numbers, which is what makes this safe to
+ * run over the whole tournament rather than over a guess at who was
+ * affected.
+ */
+export function rebuildTournamentScores(input: {
+  readonly tournament: TournamentRecord;
+  readonly matches: readonly MatchRecord[];
+  readonly scores: readonly ScoreRecord[];
+  readonly player: (playerId: PlayerId) => PlayerRecord;
+  readonly at: EpochMillis;
+}): ScoreRebuild {
+  if (typeof input.player !== "function") {
+    throw new InvalidArgumentError("rebuild needs a player lookup", { tournamentId: input.tournament.id });
+  }
+  const surviving = survivingResults(input.matches, input.tournament.id);
+  const scores = input.scores
+    .filter((score) => score.tournamentId === input.tournament.id)
+    .map((score) =>
+      rebuildScoreRecord(
+        input.player(score.playerId),
+        input.tournament,
+        resultsForPlayer(surviving, score.playerId),
+        input.at,
+      ),
+    );
+  return {
+    scores: Object.freeze(scores),
+    surviving: Object.freeze(surviving),
+    explanation: explain("score.rebuilt", `rebuilt ${scores.length} score records`, {
+      tournamentId: input.tournament.id,
+      rebuilt: scores.length,
+      surviving: surviving.length,
+      at: input.at,
+    }),
+  };
+}
