+++ b/src/engine/audit/voids.ts
@@ -0,0 +1,125 @@
+import { assertEpochMillis, type EpochMillis } from "../../clock.js";
+import { explain, type DecisionExplanation } from "../../explain.js";
+import type { MatchId, MatchStatus, PlayerId, ScoreRecord, TournamentId } from "../../types.js";
+
+/**
+ * What one void did to one player's standing. `before` and `after` are the
+ * totals either side of the rebuild, so `delta` says how many points the
+ * void withdrew and is never positive.
+ */
+export interface VoidedScoreChange {
+  readonly playerId: PlayerId;
+  readonly before: number;
+  readonly after: number;
+  readonly delta: number;
+}
+
+export interface VoidEntry {
+  readonly matchId: MatchId;
+  readonly tournamentId: TournamentId;
+  readonly reason: string;
+  readonly at: EpochMillis;
+  readonly previousStatus: MatchStatus;
+  readonly changes: readonly VoidedScoreChange[];
+  readonly explanation: DecisionExplanation;
+}
+
+/**
+ * Build the change list for a void. Only players whose total actually moved
+ * are listed: a rebuild runs over every record in the tournament, and the
+ * ones the void never reached land back on the numbers they already held.
+ */
+export function scoreChanges(
+  before: readonly ScoreRecord[],
+  after: readonly ScoreRecord[],
+): VoidedScoreChange[] {
+  const previous = new Map(before.map((score) => [score.playerId, score]));
+  const changes: VoidedScoreChange[] = [];
+  for (const score of [...after].sort((a, b) => (a.playerId < b.playerId ? -1 : a.playerId > b.playerId ? 1 : 0))) {
+    const was = previous.get(score.playerId);
+    const wasTotal = was?.total ?? 0;
+    if (was !== undefined && wasTotal === score.total) {
+      continue;
+    }
+    changes.push(
+      Object.freeze({
+        playerId: score.playerId,
+        before: wasTotal,
+        after: score.total,
+        delta: score.total - wasTotal,
+      }),
+    );
+  }
+  return changes;
+}
+
+/**
+ * Every void an arena has taken, oldest first. Operators answer "why is this
+ * board different from the one I saw" out of here rather than out of the
+ * journal, which carries the fact but not the arithmetic.
+ */
+export class VoidLedger {
+  private readonly entries: VoidEntry[] = [];
+
+  record(input: {
+    readonly matchId: MatchId;
+    readonly tournamentId: TournamentId;
+    readonly reason: string;
+    readonly at: EpochMillis;
+    readonly previousStatus: MatchStatus;
+    readonly changes: readonly VoidedScoreChange[];
+  }): VoidEntry {
+    assertEpochMillis(input.at, "void.at");
+    const entry = Object.freeze({
+      matchId: input.matchId,
+      tournamentId: input.tournamentId,
+      reason: input.reason,
+      at: input.at,
+      previousStatus: input.previousStatus,
+      changes: Object.freeze([...input.changes]),
+      explanation: explain("match.voided", input.reason, {
+        matchId: input.matchId,
+        tournamentId: input.tournamentId,
+        previousStatus: input.previousStatus,
+        affected: input.changes.length,
+        withdrawn: withdrawnFrom(input.changes),
+      }),
+    });
+    this.entries.push(entry);
+    return entry;
+  }
+
+  forTournament(tournamentId: TournamentId): VoidEntry[] {
+    return this.entries.filter((entry) => entry.tournamentId === tournamentId);
+  }
+
+  forMatch(matchId: MatchId): VoidEntry | undefined {
+    return this.entries.find((entry) => entry.matchId === matchId);
+  }
+
+  forPlayer(playerId: PlayerId): VoidEntry[] {
+    return this.entries.filter((entry) =>
+      entry.changes.some((change) => change.playerId === playerId),
+    );
+  }
+
+  all(): VoidEntry[] {
+    return [...this.entries];
+  }
+
+  count(): number {
+    return this.entries.length;
+  }
+
+  /** Points a tournament has taken back, as a positive number. */
+  withdrawn(tournamentId: TournamentId): number {
+    return this.forTournament(tournamentId).reduce(
+      (total, entry) => total + withdrawnFrom(entry.changes),
+      0,
+    );
+  }
+}
+
+function withdrawnFrom(changes: readonly VoidedScoreChange[]): number {
+  return changes.reduce((total, change) => total - Math.min(0, change.delta), 0);
+}
