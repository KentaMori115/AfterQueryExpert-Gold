+def _follow_performers(show: CompiledShow, statuses: dict[str, CueStatus]):
+    """Where every performer stood when each of their moves actually started.
+
+    Rehearsal follows the actual starts and ends; durations are the compiled
+    ones. A move that failed before starting has no start and moves nobody; a
+    move that failed while running leaves its performer where it was.
+    """
+    runs: list[MoveRun] = []
+    for cue in show.cues:
+        performer = cue.action.get("move")
+        target = cue.action.get("to")
+        if not isinstance(performer, str) or not isinstance(target, str):
+            continue
+        status = statuses[cue.id]
+        departs = cue.action.get("from")
+        runs.append(
+            MoveRun(
+                cue_id=cue.id,
+                performer=performer,
+                from_mark=departs if isinstance(departs, str) else None,
+                to=target,
+                start_ms=status.start_ms,
+                end_ms=status.end_ms,
+                completed=status.status == "completed",
+            )
+        )
+    return follow_moves(runs, show.performers, show.locations)
+
