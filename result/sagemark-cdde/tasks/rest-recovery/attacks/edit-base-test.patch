@@ -76,6 +76,36 @@ export function longRest(state: SpellSlotState): SpellSlotState {
   return out as SpellSlotState
 }
 
+// Pact magic sits beside the ordinary table: a warlock's slots all share one
+// level, and they come back from any rest rather than only from a long one.
+// The count and the level come from the sheet, so nothing here needs a second
+// progression table.
+
+export interface PactSlots {
+  level: SpellLevel | 0
+  max: number
+  remaining: number
+}
+
+export function emptyPactSlots(): PactSlots {
+  return { level: 0, max: 0, remaining: 0 }
+}
+
+export function pactSlotsFor(level: SpellLevel, max: number): PactSlots {
+  const count = Math.max(0, Math.floor(max))
+  return { level, max: count, remaining: count }
+}
+
+export function spendPact(pact: PactSlots): PactSlots {
+  if (pact.remaining <= 0) return pact
+  return { ...pact, remaining: pact.remaining - 1 }
+}
+
+export function refillPact(pact: PactSlots): PactSlots {
+  if (pact.remaining >= pact.max) return pact
+  return { ...pact, remaining: pact.max }
+}
+
 export function totalRemaining(state: SpellSlotState): number {
   return SPELL_LEVELS.reduce((acc, lvl) => acc + state[lvl].remaining, 0)
 }
