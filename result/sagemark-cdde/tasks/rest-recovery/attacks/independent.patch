+// Camp. Written from the request alone: a class holds the run, the ledger is
+// assembled from a map, and the two rest kinds are separate methods.
+import type { RandomSource } from '../dice/roll'
+import { type ConditionState, clampExhaustion, isIncapacitated } from './conditions'
+import {
+  type HitDicePool,
+  availableDice,
+  largestAvailable,
+  regainDice,
+  rollHitDie,
+  spendDie,
+  spentDice,
+} from './hit-dice'
+import { SPELL_LEVELS, type SpellSlotState } from './spell-slots'
+
+export type RestKind = 'short' | 'long'
+
+export interface Rester {
+  id: string
+  level: number
+  hp: number
+  hpMax: number
+  conModifier: number
+  hitDice: HitDicePool
+  slots: SpellSlotState
+  conditions: ConditionState
+  fed: boolean
+  spendDice: number
+}
+
+export interface RestPlan {
+  kind: RestKind
+  hours: number
+  breakMinutes: number
+  party: ReadonlyArray<Rester>
+}
+
+export interface RestEntry {
+  id: string
+  hpAfter: number
+  rolls: ReadonlyArray<{ sides: number; rolled: number; healed: number }>
+}
+
+export interface RestResult {
+  kind: RestKind
+  completed: boolean
+  entries: ReadonlyArray<RestEntry>
+  party: ReadonlyArray<Rester>
+}
+
+const ENDED_BY_A_REST = ['frightened', 'stunned'] as const
+
+class Camp {
+  private readonly kind: RestKind
+
+  constructor(private readonly plan: RestPlan, private readonly rng: RandomSource) {
+    this.kind = plan.kind === 'long' && plan.breakMinutes > 60 ? 'short' : plan.kind
+  }
+
+  private enoughHours(): boolean {
+    return this.plan.hours >= (this.kind === 'long' ? 8 : 1)
+  }
+
+  private wakeUp(member: Rester, hp: number): ConditionState {
+    const ending: string[] = [...ENDED_BY_A_REST]
+    if (hp > 0) ending.push('unconscious')
+    const active = member.conditions.active.filter((c) => !ending.includes(c))
+    let exhaustion = member.conditions.exhaustion
+    if (this.kind === 'long' && member.fed) exhaustion = clampExhaustion(exhaustion - 1)
+    return { active, exhaustion }
+  }
+
+  private restOne(member: Rester): { entry: RestEntry; next: Rester } {
+    const rolls: Array<{ sides: number; rolled: number; healed: number }> = []
+    let hp = member.hp
+    let pool = member.hitDice
+    if (this.kind === 'short' && !isIncapacitated(member.conditions)) {
+      let asked = Math.max(0, Math.trunc(member.spendDice))
+      while (asked-- > 0 && hp < member.hpMax && availableDice(pool) > 0) {
+        const sides = largestAvailable(pool)!
+        const roll = rollHitDie(sides, member.conModifier, this.rng)
+        rolls.push(roll)
+        hp = Math.min(member.hpMax, hp + roll.healed)
+        pool = spendDie(pool, sides)
+      }
+    }
+    let slots = member.slots
+    if (this.kind === 'long') {
+      hp = member.hpMax
+      const filled: Record<number, { max: number; remaining: number }> = {}
+      for (const level of SPELL_LEVELS) filled[level] = { ...slots[level], remaining: slots[level].max }
+      slots = filled as unknown as SpellSlotState
+      const owed = Math.max(1, Math.trunc(member.level / 2))
+      pool = regainDice(pool, Math.min(owed, spentDice(pool)))
+    }
+    const conditions = this.wakeUp(member, hp)
+    return {
+      entry: { id: member.id, hpAfter: hp, rolls },
+      next: { ...member, hp, hitDice: pool, slots, conditions },
+    }
+  }
+
+  run(): RestResult {
+    if (!this.enoughHours()) {
+      return {
+        kind: this.kind,
+        completed: false,
+        entries: this.plan.party.map((m) => ({ id: m.id, hpAfter: m.hp, rolls: [] })),
+        party: this.plan.party.map((m) => ({ ...m })),
+      }
+    }
+    const done = this.plan.party.map((member) => this.restOne(member))
+    return {
+      kind: this.kind,
+      completed: true,
+      entries: done.map((d) => d.entry),
+      party: done.map((d) => d.next),
+    }
+  }
+}
+
+export function resolveRest(plan: RestPlan, rng: RandomSource): RestResult {
+  return new Camp(plan, rng).run()
+}
