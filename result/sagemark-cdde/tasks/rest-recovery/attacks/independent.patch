new file mode 100644
index 0000000..c034271
--- /dev/null
+++ b/src/core/rules/hit-dice.ts
@@ -0,0 +1,77 @@
+// Hit dice pool. Written from the request alone: sizes descending, merged, and
+// a spend counter per size.
+import { parseRollExpression } from '../dice/notation'
+import { rollExpression, type RandomSource } from '../dice/roll'
+
+export class HitDiceError extends Error {}
+
+export type HitDiceGroup = { sides: number; total: number; spent: number }
+export type HitDicePool = ReadonlyArray<HitDiceGroup>
+
+const descending = (rows: HitDiceGroup[]): HitDiceGroup[] =>
+  rows.slice().sort((left, right) => right.sides - left.sides)
+
+export function parseHitDicePool(text: string): HitDicePool {
+  const parsed = parseRollExpression(text)
+  const counts: Record<number, number> = {}
+  parsed.terms.forEach((term, index) => {
+    if (term.kind === 'constant') throw new HitDiceError('a pool is dice only')
+    if (term.modifier !== 'none') throw new HitDiceError('a hit die carries no modifier')
+    if ((parsed.signs[index] ?? 1) < 0) throw new HitDiceError('a pool cannot subtract dice')
+    counts[term.sides] = (counts[term.sides] ?? 0) + term.count
+  })
+  return descending(
+    Object.keys(counts).map((key) => ({ sides: Number(key), total: counts[Number(key)]!, spent: 0 })),
+  )
+}
+
+export function totalDice(pool: HitDicePool): number {
+  return pool.reduce((sum, row) => sum + row.total, 0)
+}
+
+export function spentDice(pool: HitDicePool): number {
+  return pool.reduce((sum, row) => sum + row.spent, 0)
+}
+
+export function availableDice(pool: HitDicePool): number {
+  return totalDice(pool) - spentDice(pool)
+}
+
+export function largestAvailable(pool: HitDicePool): number | null {
+  const open = descending(pool.slice()).filter((row) => row.total > row.spent)
+  return open.length > 0 ? open[0]!.sides : null
+}
+
+export function spendDie(pool: HitDicePool, sides: number): HitDicePool {
+  let touched = false
+  const out = descending(
+    pool.map((row) => {
+      if (row.sides !== sides || touched || row.spent >= row.total) return { ...row }
+      touched = true
+      return { ...row, spent: row.spent + 1 }
+    }),
+  )
+  if (!touched) throw new HitDiceError(`no d${sides} left`)
+  return out
+}
+
+export function regainDice(pool: HitDicePool, count: number): HitDicePool {
+  let owed = Number.isFinite(count) ? Math.max(0, Math.trunc(count)) : 0
+  const out: HitDiceGroup[] = []
+  for (const row of descending(pool.slice())) {
+    const give = Math.min(owed, row.spent)
+    owed -= give
+    out.push({ ...row, spent: row.spent - give })
+  }
+  return out
+}
+
+export function resetPool(pool: HitDicePool): HitDicePool {
+  return descending(pool.map((row) => ({ ...row, spent: 0 })))
+}
+
+export function rollHitDie(sides: number, conModifier: number, rng: RandomSource) {
+  const rolled = rollExpression(`1d${sides}`, rng).total
+  const healed = rolled + Math.trunc(conModifier)
+  return { sides, rolled, healed: healed < 1 ? 1 : healed }
+}
