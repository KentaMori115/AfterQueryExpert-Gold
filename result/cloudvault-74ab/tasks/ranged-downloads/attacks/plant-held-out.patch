+/**
+ * Ranged downloads.
+ */
+
+export function planRangedResponse(manifest: { chunkSizes: number[]; contentType: string }) {
+    return {
+        status: 200,
+        contentType: manifest.contentType,
+        contentRange: null,
+        contentLength: 0,
+        parts: [],
+        bytesServed: 0,
+    }
+}
