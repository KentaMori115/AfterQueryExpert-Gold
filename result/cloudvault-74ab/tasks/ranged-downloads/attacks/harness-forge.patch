@@ -0,0 +1,66 @@
+/* eslint-disable */
+/**
+ * A submission that plans nothing and tries to be marked as though it had: it
+ * rewrites the array methods a collector is likely to reach for, empties every
+ * case body it can see, goes looking for the runner's own module on disk, and
+ * puts a quieter expect on the global object.
+ */
+const realSlice = Array.prototype.slice
+const realPush = Array.prototype.push
+const realConcat = Array.prototype.concat
+
+const gut = (value: any) => {
+    if (!value || typeof value !== "object") return
+    if (typeof value.fn === "function") value.fn = () => {}
+    if (Array.isArray(value.tests)) for (const entry of value.tests) gut(entry)
+}
+
+;(Array.prototype as any).slice = function (this: any, ...args: any[]) {
+    const out = realSlice.apply(this, args as never)
+    for (const entry of out as any[]) gut(entry)
+    return out
+}
+;(Array.prototype as any).concat = function (this: any, ...args: any[]) {
+    const out = realConcat.apply(this, args as never)
+    for (const entry of out as any[]) gut(entry)
+    return out
+}
+;(Array.prototype as any).push = function (this: any, ...args: any[]) {
+    for (const entry of args) gut(entry)
+    return realPush.apply(this, args as never)
+}
+
+const quiet: any = () => quiet
+quiet.not = quiet
+try {
+    ;(globalThis as any).expect = new Proxy(function () {}, {
+        apply: () => new Proxy({}, { get: () => () => undefined }),
+        get: () => () => undefined,
+    })
+} catch {
+    /* the global may be nailed down */
+}
+
+for (const guess of ["/verify/shim.mjs", "/tmp/verify/shim.mjs", "./shim.mjs"]) {
+    try {
+        // eslint-disable-next-line @typescript-eslint/no-var-requires
+        const found = require(guess)
+        if (found && typeof found.claim === "function") {
+            const surface = found.claim()
+            if (surface) surface.arm = () => {}
+        }
+    } catch {
+        /* nothing there */
+    }
+}
+
+export function planRangedResponse(manifest: { chunkSizes: number[]; contentType: string }) {
+    return {
+        status: 200,
+        contentType: manifest.contentType,
+        contentRange: null,
+        contentLength: 0,
+        parts: [],
+        bytesServed: 0,
+    }
+}
