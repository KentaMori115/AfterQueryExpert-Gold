+  /**
+   * All played fixtures for a team on or before a given day, oldest first.
+   * Only status='played' counts for serving a ban.
+   */
+  playedForTeamUpTo(teamId: number, asOf: string): Fixture[] {
+    const found = asRows<FixtureRow>(
+      this.db
+        .prepare(
+          `SELECT * FROM fixtures
+            WHERE (home_team_id = ? OR away_team_id = ?)
+              AND status = 'played'
+              AND played_on <= ?
+            ORDER BY played_on ASC, id ASC`,
+        )
+        .all(teamId, teamId, asOf),
+    );
+    return found.map(toFixture);
+  }
+
+  /**
+   * All played fixtures for a set of teams on or before a given day, oldest first.
+   * Used for eligibility checking.
+   */
+  playedForTeamsUpTo(teamIds: number[], asOf: string): Fixture[] {
+    if (teamIds.length === 0) return [];
+    const placeholders = teamIds.map(() => '?').join(', ');
+    const found = asRows<FixtureRow>(
+      this.db
+        .prepare(
+          `SELECT * FROM fixtures
+            WHERE (home_team_id IN (${placeholders}) OR away_team_id IN (${placeholders}))
+              AND status = 'played'
+              AND played_on <= ?
+            ORDER BY played_on ASC, id ASC`,
+        )
+        .all(...teamIds, ...teamIds, asOf),
+    );
+    return found.map(toFixture);
+  }
+
