@@ -0,0 +1,239 @@
+/**
+ * Works out how many ban-matches a player has served and how many remain.
+ *
+ * A ban is served over games of the side the card was shown for. Only a game
+ * with status `played` serves anything. Each played game serves one match off
+ * the earliest outstanding card shown to that side before it.
+ *
+ * While any match is outstanding the player is barred from every side of their
+ * current club, so a transfer moves the bar (not the serving games).
+ *
+ * Rescinded cards drop out and games they used fall through to later cards.
+ */
+import { FixtureRepository } from '../fixtures/fixture.repository';
+import { DisciplineRepository } from './discipline.repository';
+import type { Card } from './discipline.types';
+import { PlayerRepository } from '../players/player.repository';
+
+export interface SuspensionEntry {
+  cardId: number;
+  fixtureId: number;
+  teamId: number;
+  shownOn: string;
+  matches: number;
+  served: number;
+  outstanding: number;
+  servedIn: number[];
+  clearedOn: string | null;
+}
+
+export interface SuspensionSummary {
+  playerId: number;
+  asOf: string;
+  matchesBanned: number;
+  matchesServed: number;
+  matchesOutstanding: number;
+  suspended: boolean;
+  entries: SuspensionEntry[];
+}
+
+export interface EligibilityEntry {
+  playerId: number;
+  clubId: number;
+  teamId: number;
+  outstanding: number;
+}
+
+export class SuspensionService {
+  constructor(
+    private readonly disciplineRepo: DisciplineRepository,
+    private readonly fixtureRepo: FixtureRepository,
+    private readonly playerRepo: PlayerRepository,
+  ) {}
+
+  /**
+   * Computes the full suspension picture for a player as of a given day.
+   *
+   * All reading is as-of: cards shown after `asOf` are excluded, and games
+   * played after `asOf` have served nothing.
+   */
+  compute(playerId: number, asOf: string): SuspensionSummary {
+    // Cards shown on or before asOf, non-rescinded, oldest first.
+    const cards = this.disciplineRepo.forPlayerUpTo(playerId, asOf);
+
+    // Only cards that carry a ban have ledger entries.
+    const banningCards = cards.filter(
+      (c) => Math.max(c.straightBan, c.accumulationBan) > 0,
+    );
+
+    if (banningCards.length === 0) {
+      return {
+        playerId,
+        asOf,
+        matchesBanned: 0,
+        matchesServed: 0,
+        matchesOutstanding: 0,
+        suspended: false,
+        entries: [],
+      };
+    }
+
+    // Build per-team mapping of played fixtures up to asOf, ordered chronologically.
+    const teamIds = [...new Set(banningCards.map((c) => c.teamId))];
+    const fixtureInfoByTeam = new Map<number, { id: number; playedOn: string }[]>();
+    for (const teamId of teamIds) {
+      const fixtures = this.fixtureRepo.playedForTeamUpTo(teamId, asOf);
+      fixtureInfoByTeam.set(teamId, fixtures.map((f) => ({ id: f.id, playedOn: f.playedOn })));
+    }
+
+    // Build working state per card: remaining matches and which fixtures served them.
+    interface CardState {
+      card: Card;
+      matches: number;
+      remaining: number;
+      servedIn: number[];
+    }
+
+    const stateByCard = new Map<number, CardState>();
+    for (const card of banningCards) {
+      const m = Math.max(card.straightBan, card.accumulationBan);
+      stateByCard.set(card.id, {
+        card,
+        matches: m,
+        remaining: m,
+        servedIn: [],
+      });
+    }
+
+    // For each team, walk its played games in order and assign to the earliest
+    // outstanding card for that team that was shown before the game.
+    for (const teamId of teamIds) {
+      const fixtures = fixtureInfoByTeam.get(teamId) ?? [];
+      // Banning cards for this team, oldest first (banningCards is already ordered).
+      const cardsForTeam = banningCards.filter((c) => c.teamId === teamId);
+
+      for (const fixture of fixtures) {
+        // Find the earliest outstanding card shown to this team before this game.
+        for (const card of cardsForTeam) {
+          const state = stateByCard.get(card.id)!;
+          // Card must have been shown strictly before this game's playedOn.
+          if (card.shownOn >= fixture.playedOn) continue;
+          if (state.remaining > 0) {
+            state.remaining -= 1;
+            state.servedIn.push(fixture.id);
+            break; // one game serves one card only
+          }
+        }
+      }
+    }
+
+    // Build entries list, oldest card first.
+    const entries: SuspensionEntry[] = [];
+    let totalBanned = 0;
+    let totalServed = 0;
+
+    for (const card of banningCards) {
+      const state = stateByCard.get(card.id)!;
+      const served = state.servedIn.length;
+      const outstanding = state.remaining;
+      totalBanned += state.matches;
+      totalServed += served;
+
+      // clearedOn: the playedOn day of the last fixture served, or null if still outstanding.
+      let clearedOn: string | null = null;
+      if (outstanding === 0 && state.servedIn.length > 0) {
+        const lastFixtureId = state.servedIn[state.servedIn.length - 1]!;
+        const lastFixture = this.fixtureRepo.byId(lastFixtureId);
+        clearedOn = lastFixture?.playedOn ?? null;
+      }
+
+      entries.push({
+        cardId: card.id,
+        fixtureId: card.fixtureId,
+        teamId: card.teamId,
+        shownOn: card.shownOn,
+        matches: state.matches,
+        served,
+        outstanding,
+        servedIn: state.servedIn,
+        clearedOn,
+      });
+    }
+
+    const totalOutstanding = totalBanned - totalServed;
+    return {
+      playerId,
+      asOf,
+      matchesBanned: totalBanned,
+      matchesServed: totalServed,
+      matchesOutstanding: totalOutstanding,
+      suspended: totalOutstanding > 0,
+      entries,
+    };
+  }
+
+  /**
+   * Whether a player has any matches outstanding as of a given day.
+   */
+  isSuspended(playerId: number, asOf: string): boolean {
+    return this.compute(playerId, asOf).suspended;
+  }
+
+  /**
+   * For the eligibility endpoint: every registered player at either club who
+   * has a match outstanding as of `asOf`. Home side first, then by player id.
+   */
+  eligibilityForFixture(
+    fixtureId: number,
+    asOf: string,
+    homeClubId: number,
+    awayClubId: number,
+    homeTeamId: number,
+    awayTeamId: number,
+  ): EligibilityEntry[] {
+    // Registered players at both clubs.
+    const homePlayers = this.playerRepo.list({ clubId: homeClubId, status: 'registered' });
+    const awayPlayers = this.playerRepo.list({ clubId: awayClubId, status: 'registered' });
+
+    const ineligible: (EligibilityEntry & { side: 'home' | 'away' })[] = [];
+
+    for (const player of homePlayers) {
+      const summary = this.compute(player.id, asOf);
+      if (summary.matchesOutstanding > 0) {
+        ineligible.push({
+          playerId: player.id,
+          clubId: player.clubId,
+          teamId: homeTeamId,
+          outstanding: summary.matchesOutstanding,
+          side: 'home',
+        });
+      }
+    }
+
+    for (const player of awayPlayers) {
+      const summary = this.compute(player.id, asOf);
+      if (summary.matchesOutstanding > 0) {
+        ineligible.push({
+          playerId: player.id,
+          clubId: player.clubId,
+          teamId: awayTeamId,
+          outstanding: summary.matchesOutstanding,
+          side: 'away',
+        });
+      }
+    }
+
+    // Sort: home side first, then by player id.
+    ineligible.sort((a, b) => {
+      if (a.side !== b.side) return a.side === 'home' ? -1 : 1;
+      return a.playerId - b.playerId;
+    });
+
+    return ineligible.map(({ playerId, clubId, teamId, outstanding }) => ({
+      playerId,
+      clubId,
+      teamId,
+      outstanding,
+    }));
+  }
+}
