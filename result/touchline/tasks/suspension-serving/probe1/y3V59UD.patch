diff --git a/src/modules/discipline/suspension.routes.test.ts b/src/modules/discipline/suspension.routes.test.ts
new file mode 100644
index 0000000..8e21fd9
--- /dev/null
+++ b/src/modules/discipline/suspension.routes.test.ts
@@ -0,0 +1,585 @@
+import {
+  aFixedLeague,
+  aFixture,
+  api,
+  bare,
+  floor,
+  type Floor,
+} from '../../../tests/helpers';
+
+const MATCH_DAYS = [
+  '2031-09-06',
+  '2031-10-04',
+  '2031-11-01',
+  '2031-12-06',
+  '2032-01-10',
+  '2032-02-07',
+  '2032-03-06',
+];
+
+/**
+ * A league with a player at the home club, and a run of games.
+ */
+async function aBookableLeague(f: Floor) {
+  const league = await aFixedLeague(f, 4, { teamCapacity: 10 });
+  const home = league.teams[0]!;
+  const others = league.teams.slice(1);
+  const homeClub = league.clubs[0]!;
+
+  const player = await api(f).post(`/clubs/${homeClub.id}/players`).send({
+    firstName: 'Owen',
+    lastName: 'Tasker',
+    bornOn: '2005-03-14',
+    position: 'midfielder',
+    squadNumber: 8,
+    registeredOn: '2031-07-20',
+  });
+
+  return { ...league, home, others, homeClub, player: player.body };
+}
+
+/** Puts the home side in a game on the given match day. */
+async function gameOn(
+  f: Floor,
+  league: Awaited<ReturnType<typeof aBookableLeague>>,
+  index: number,
+) {
+  const opponent = league.others[index % league.others.length]!;
+  const atHome = index % 2 === 0;
+  return aFixture(
+    f,
+    league.division.id,
+    atHome ? league.home.id : opponent.id,
+    atHome ? opponent.id : league.home.id,
+    league.venue.id,
+    { playedOn: MATCH_DAYS[index] ?? '' },
+  );
+}
+
+async function book(
+  f: Floor,
+  fixtureId: number,
+  playerId: number,
+  offence: string,
+  shownOn: string,
+) {
+  return api(f).post(`/fixtures/${fixtureId}/cards`).send({ playerId, offence, shownOn });
+}
+
+/**
+ * Makes a game count as played: report a result then have the other side confirm it.
+ */
+async function play(
+  f: Floor,
+  fixture: { id: number; homeTeamId: number; awayTeamId: number },
+  playedOn: string,
+) {
+  const report = await api(f)
+    .post(`/fixtures/${fixture.id}/result`)
+    .send({
+      homeGoals: 1,
+      awayGoals: 0,
+      reportedByTeamId: fixture.homeTeamId,
+      reportedOn: playedOn,
+    });
+  await api(f)
+    .post(`/results/${report.body.id}/confirm`)
+    .send({ confirmedByTeamId: fixture.awayTeamId, confirmedOn: playedOn });
+}
+
+describe('suspension serving', () => {
+  it('answers no entries for a player with no banning cards', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const res = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    expect(res.status).toBe(200);
+    expect(res.body.playerId).toBe(league.player.id);
+    expect(res.body.asOf).toBe('2032-05-16');
+    expect(res.body.matchesBanned).toBe(0);
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(0);
+    expect(res.body.suspended).toBe(false);
+    expect(res.body.entries).toEqual([]);
+  });
+
+  it('answers the full shape for a banning card', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const fixture = await gameOn(f, league, 0);
+    await book(f, fixture.id, league.player.id, 'violentConduct', MATCH_DAYS[0]!);
+
+    const res = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.body).sort()).toEqual([
+      'asOf',
+      'entries',
+      'matchesBanned',
+      'matchesOutstanding',
+      'matchesServed',
+      'playerId',
+      'suspended',
+    ]);
+    expect(res.body.matchesBanned).toBe(3);
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(3);
+    expect(res.body.suspended).toBe(true);
+    expect(res.body.entries).toHaveLength(1);
+
+    const entry = res.body.entries[0];
+    expect(Object.keys(entry).sort()).toEqual([
+      'cardId',
+      'clearedOn',
+      'fixtureId',
+      'matches',
+      'outstanding',
+      'served',
+      'servedIn',
+      'shownOn',
+      'teamId',
+    ]);
+    expect(entry.matches).toBe(3);
+    expect(entry.served).toBe(0);
+    expect(entry.outstanding).toBe(3);
+    expect(entry.servedIn).toEqual([]);
+    expect(entry.clearedOn).toBeNull();
+  });
+
+  it('serves a match off the ban when a game is played after the card', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    // Show a violent conduct card in game 0
+    const game0 = await gameOn(f, league, 0);
+    await book(f, game0.id, league.player.id, 'violentConduct', MATCH_DAYS[0]!);
+
+    // Play games 1 and 2 after the card
+    const game1 = await gameOn(f, league, 1);
+    await play(f, game1, MATCH_DAYS[1]!);
+
+    const game2 = await gameOn(f, league, 2);
+    await play(f, game2, MATCH_DAYS[2]!);
+
+    const res = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    expect(res.body.matchesBanned).toBe(3);
+    expect(res.body.matchesServed).toBe(2);
+    expect(res.body.matchesOutstanding).toBe(1);
+    expect(res.body.suspended).toBe(true);
+
+    const entry = res.body.entries[0];
+    expect(entry.served).toBe(2);
+    expect(entry.outstanding).toBe(1);
+    expect(entry.servedIn).toHaveLength(2);
+    expect(entry.servedIn[0]).toBe(game1.id);
+    expect(entry.servedIn[1]).toBe(game2.id);
+    expect(entry.clearedOn).toBeNull();
+  });
+
+  it('clears the ban and sets clearedOn when all matches are served', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    // Show a 1-match ban (denyingGoalscoringOpportunity = straight ban 1)
+    const game0 = await gameOn(f, league, 0);
+    await book(f, game0.id, league.player.id, 'denyingGoalscoringOpportunity', MATCH_DAYS[0]!);
+
+    // Play one game after
+    const game1 = await gameOn(f, league, 1);
+    await play(f, game1, MATCH_DAYS[1]!);
+
+    const res = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    expect(res.body.matchesBanned).toBe(1);
+    expect(res.body.matchesServed).toBe(1);
+    expect(res.body.matchesOutstanding).toBe(0);
+    expect(res.body.suspended).toBe(false);
+
+    const entry = res.body.entries[0];
+    expect(entry.served).toBe(1);
+    expect(entry.outstanding).toBe(0);
+    expect(entry.clearedOn).toBe(MATCH_DAYS[1]);
+  });
+
+  it('record standing is clear once all matches are served', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    // Show a 1-match ban
+    const game0 = await gameOn(f, league, 0);
+    await book(f, game0.id, league.player.id, 'denyingGoalscoringOpportunity', MATCH_DAYS[0]!);
+
+    // Still suspended before serving
+    const beforeServed = await api(f).get(`/players/${league.player.id}/record?asOf=2031-10-03`);
+    expect(beforeServed.body.standing).toBe('suspended');
+
+    // Play one game to serve the ban
+    const game1 = await gameOn(f, league, 1);
+    await play(f, game1, MATCH_DAYS[1]!);
+
+    // Now clear (3 points from that card → warned after serving)
+    const afterServed = await api(f).get(`/players/${league.player.id}/record?asOf=2032-05-16`);
+    expect(afterServed.body.standing).toBe('warned');
+    expect(afterServed.body.matchesBanned).toBe(1);
+  });
+
+  it('does not serve a game played on the same day as the card', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    // Show a card in game 0
+    const game0 = await gameOn(f, league, 0);
+    await book(f, game0.id, league.player.id, 'denyingGoalscoringOpportunity', MATCH_DAYS[0]!);
+    // game0 is scheduled, not played, so cannot serve anyway.
+    // But even if we make game0 played, the card was shown ON that day so it should not serve.
+    // Let's confirm game0 to make it played too
+    await play(f, game0, MATCH_DAYS[0]!);
+
+    const res = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    // game0 is played but shown on the same day - should not serve
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(1);
+  });
+
+  it('leaves out cards shown after asOf', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const game0 = await gameOn(f, league, 0);
+    await book(f, game0.id, league.player.id, 'violentConduct', MATCH_DAYS[0]!);
+
+    // asOf before the card: no ban
+    const before = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2031-09-05`);
+    expect(before.body.matchesBanned).toBe(0);
+    expect(before.body.entries).toEqual([]);
+
+    // asOf on the day of the card: ban applies
+    const onDay = await api(f).get(
+      `/players/${league.player.id}/suspensions?asOf=${MATCH_DAYS[0]}`,
+    );
+    expect(onDay.body.matchesBanned).toBe(3);
+  });
+
+  it('games played after asOf serve nothing', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const game0 = await gameOn(f, league, 0);
+    await book(f, game0.id, league.player.id, 'denyingGoalscoringOpportunity', MATCH_DAYS[0]!);
+
+    // Play a game after the card
+    const game1 = await gameOn(f, league, 1);
+    await play(f, game1, MATCH_DAYS[1]!);
+
+    // asOf before the served game: sees the ban but no serving
+    const early = await api(f).get(
+      `/players/${league.player.id}/suspensions?asOf=2031-10-03`,
+    );
+    expect(early.body.matchesServed).toBe(0);
+    expect(early.body.matchesOutstanding).toBe(1);
+
+    // asOf after the served game: sees the serving
+    const late = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    expect(late.body.matchesServed).toBe(1);
+    expect(late.body.matchesOutstanding).toBe(0);
+  });
+
+  it('awarded games are not played so do not serve the ban', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const game0 = await gameOn(f, league, 0);
+    await book(f, game0.id, league.player.id, 'denyingGoalscoringOpportunity', MATCH_DAYS[0]!);
+
+    // Award game1 to home team (does not count as a played game for serving)
+    const game1 = await gameOn(f, league, 1);
+    await api(f)
+      .post(`/fixtures/${game1.id}/award`)
+      .send({ awardedToTeamId: league.home.id, awardedOn: MATCH_DAYS[1], reason: 'noShow' });
+
+    const res = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(1);
+  });
+
+  it('multiple cards are each tracked separately, oldest first', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+
+    // Card 1: 1-match ban
+    const game0 = await gameOn(f, league, 0);
+    const card1 = await book(f, game0.id, league.player.id, 'denyingGoalscoringOpportunity', MATCH_DAYS[0]!);
+
+    // Card 2: accumulation ban at 5 points - show 4 more dissent cards (4 pts total after card1's 3)
+    // persistentFouling = 2pts, so card1 is 3pts, plus 2pts = 5pts crossing threshold
+    const game1 = await gameOn(f, league, 1);
+    const card2 = await book(f, game1.id, league.player.id, 'persistentFouling', MATCH_DAYS[1]!);
+    // card2 should have accumulationBan = 1 (crosses 5)
+    expect(card2.body.accumulationBan).toBe(1);
+
+    // Play games 2 and 3
+    const game2 = await gameOn(f, league, 2);
+    await play(f, game2, MATCH_DAYS[2]!);
+
+    const game3 = await gameOn(f, league, 3);
+    await play(f, game3, MATCH_DAYS[3]!);
+
+    const res = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    expect(res.body.matchesBanned).toBe(2);
