+  /**
+   * Full suspension detail for a player as of a given day.
+   */
+  suspensions(playerId: number, asOf: string): SuspensionRecord {
+    this.players.get(playerId);
+    const day = requireRealDay(asOf, 'asOf');
+    const cards = this.repo.forPlayerUpTo(playerId, day);
+
+    let matchesBanned = 0;
+    for (const card of cards) {
+      matchesBanned += Math.max(card.straightBan, card.accumulationBan);
+    }
+
+    const entries = this.computeEntries(cards, day);
+    const matchesServed = entries.reduce((sum, e) => sum + e.served, 0);
+    const matchesOutstanding = entries.reduce((sum, e) => sum + e.outstanding, 0);
