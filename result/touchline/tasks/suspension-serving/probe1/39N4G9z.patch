+  /**
+   * Computes the serving detail for a player's active ban entries as of a given day.
+   *
+   * Rules:
+   * - A card is worth max(straightBan, accumulationBan) matches; zero means no entry.
+   * - Bans are served over played games of the team the card was shown for.
+   * - Each played game serves one match off the earliest outstanding card for that side
+   *   that was shown before the game was played.
+   * - Games are consumed in chronological order; a game consumed by an earlier card
+   *   is not available to a later one.
+   * - Rescinded cards are excluded and their games fall through to later cards.
+   */
+  private computeEntries(cards: Card[], asOf: string): SuspensionEntry[] {
+    // Only active cards with a ban, already ordered oldest first.
+    const banCards = cards.filter((c) => Math.max(c.straightBan, c.accumulationBan) > 0);
+    if (banCards.length === 0) return [];
+
+    // Build mutable entry state per card.
+    const entries: SuspensionEntry[] = banCards.map((card) => {
+      const matches = Math.max(card.straightBan, card.accumulationBan);
+      return {
+        cardId: card.id,
+        fixtureId: card.fixtureId,
+        teamId: card.teamId,
+        shownOn: card.shownOn,
+        matches,
+        served: 0,
+        outstanding: matches,
+        servedIn: [],
+        clearedOn: null,
+      };
+    });
+
+    // Process each unique team's games independently.
+    const teamIds = [...new Set(banCards.map((c) => c.teamId))];
