+   * The bar follows the player's current club, not the original team.
+   */
+  eligibility(fixtureId: number): EligibilityReport {
+    const fixture = this.fixtures.get(fixtureId);
+    // asOf is the day before the game.
+    const asOf = this.dayBefore(fixture.playedOn);
+
+    const home = this.teams.get(fixture.homeTeamId);
+    const away = this.teams.get(fixture.awayTeamId);
+
+    const homeClubId = home.clubId;
+    const awayClubId = away.clubId;
+
+    // Get all registered players at both clubs.
+    const homePlayers = this.repo.registeredPlayersAtClub(homeClubId);
+    const awayPlayers = this.repo.registeredPlayersAtClub(awayClubId);
+
+    const ineligible: IneligiblePlayer[] = [];
+
+    // Check home side first, then away, each ordered by playerId.
+    for (const { players, clubId, teamId } of [
+      { players: homePlayers.sort((a, b) => a - b), clubId: homeClubId, teamId: fixture.homeTeamId },
+      { players: awayPlayers.sort((a, b) => a - b), clubId: awayClubId, teamId: fixture.awayTeamId },
+    ]) {
+      for (const playerId of players) {
+        const cards = this.repo.forPlayerUpTo(playerId, asOf);
+        const entries = this.computeEntries(cards, asOf);
+        const outstanding = entries.reduce((sum, e) => sum + e.outstanding, 0);
+        if (outstanding > 0) {
+          ineligible.push({ playerId, clubId, teamId, outstanding });
+        }
+      }
+    }
+
+    return {
+      fixtureId,
+      playedOn: fixture.playedOn,
+      asOf,
+      ineligible,
+    };
+  }
+
+  /** Returns the day before a given YYYY-MM-DD string. */
+  private dayBefore(day: string): string {
+    const [year, month, date] = day.split('-').map(Number) as [number, number, number];
+    const d = new Date(Date.UTC(year, month - 1, date));
+    d.setUTCDate(d.getUTCDate() - 1);
+    const y = d.getUTCFullYear();
+    const m = String(d.getUTCMonth() + 1).padStart(2, '0');
+    const dd = String(d.getUTCDate()).padStart(2, '0');
+    return `${y}-${m}-${dd}`;
+  }
 }
diff --git a/src/modules/discipline/suspensions.routes.test.ts b/src/modules/discipline/suspensions.routes.test.ts
new file mode 100644
index 0000000..18328c3
--- /dev/null
+++ b/src/modules/discipline/suspensions.routes.test.ts
@@ -0,0 +1,581 @@
+/**
+ * Tests for the suspension-tracking routes:
+ *   GET /players/:playerId/suspensions
+ *   GET /fixtures/:fixtureId/eligibility
+ *
+ * Also verifies that GET /players/:playerId/record returns `suspended` only
+ * while matches are actually outstanding, not for the whole time after a ban
+ * was earned.
+ */
+import {
+  aFixedLeague,
+  aFixture,
+  api,
+  bare,
+  floor,
+  type Floor,
+} from '../../../tests/helpers';
+
+const MATCH_DAYS = [
+  '2031-09-06',
+  '2031-10-04',
+  '2031-11-01',
+  '2031-12-06',
+  '2032-01-10',
+  '2032-02-07',
+  '2032-03-06',
+];
+
+interface Fixture {
+  id: number;
+  homeTeamId: number;
+  awayTeamId: number;
+  playedOn: string;
+}
+
+async function aBookableLeague(f: Floor) {
+  const league = await aFixedLeague(f, 4, { teamCapacity: 10 });
+  const home = league.teams[0]!;
+  const others = league.teams.slice(1);
+  const homeClub = league.clubs[0]!;
+
+  const player = await api(f).post(`/clubs/${homeClub.id}/players`).send({
+    firstName: 'Owen',
+    lastName: 'Tasker',
+    bornOn: '2005-03-14',
+    position: 'midfielder',
+    squadNumber: 8,
+    registeredOn: '2031-07-20',
+  });
+
+  return { ...league, home, others, homeClub, player: player.body };
+}
+
+async function gameOn(
+  f: Floor,
+  league: Awaited<ReturnType<typeof aBookableLeague>>,
+  index: number,
+): Promise<Fixture> {
+  const opponent = league.others[index % league.others.length]!;
+  const atHome = index % 2 === 0;
+  return aFixture(
+    f,
+    league.division.id,
+    atHome ? league.home.id : opponent.id,
+    atHome ? opponent.id : league.home.id,
+    league.venue.id,
+    { playedOn: MATCH_DAYS[index] ?? '' },
+  ) as Promise<Fixture>;
+}
+
+async function book(
+  f: Floor,
+  fixtureId: number,
+  playerId: number,
+  offence: string,
+  shownOn: string,
+) {
+  return api(f).post(`/fixtures/${fixtureId}/cards`).send({ playerId, offence, shownOn });
+}
+
+/** Marks a scheduled fixture as played via a reported-then-confirmed result. */
+async function playGame(f: Floor, fixture: Fixture) {
+  const { id, homeTeamId, awayTeamId, playedOn } = fixture;
+  const report = await api(f)
+    .post(`/fixtures/${id}/result`)
+    .send({ homeGoals: 1, awayGoals: 0, reportedByTeamId: homeTeamId, reportedOn: playedOn });
+  if (report.status !== 201) return report;
+  return api(f)
+    .post(`/results/${report.body.id}/confirm`)
+    .send({ confirmedByTeamId: awayTeamId, confirmedOn: playedOn });
+}
+
+// ---------------------------------------------------------------------------
+// record standing
+// ---------------------------------------------------------------------------
+
+describe('record standing after serving', () => {
+  it('stays suspended while matches are outstanding', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const fixture = await gameOn(f, league, 0);
+    await book(f, fixture.id, league.player.id, 'violentConduct', MATCH_DAYS[0]!);
+    // Three-match ban; no game has been played yet.
+    const rec = await api(f).get(`/players/${league.player.id}/record?asOf=${MATCH_DAYS[1]}`);
+    expect(rec.body.standing).toBe('suspended');
+    expect(rec.body.matchesBanned).toBe(3);
+  });
+
+  it('becomes clear once all matches have been served', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const g0 = await gameOn(f, league, 0);
+    await book(f, g0.id, league.player.id, 'seriousFoulPlay', MATCH_DAYS[0]!);
+    // Two-match ban. Play two games and it should clear.
+    const g1 = await gameOn(f, league, 1);
+    const g2 = await gameOn(f, league, 2);
+    await playGame(f, g1);
+    await playGame(f, g2);
+    const rec = await api(f).get(`/players/${league.player.id}/record?asOf=${MATCH_DAYS[2]}`);
+    expect(rec.body.standing).toBe('warned'); // 4 points means warned even after ban served
+  });
+
+  it('is still suspended with one match remaining', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const g0 = await gameOn(f, league, 0);
+    await book(f, g0.id, league.player.id, 'seriousFoulPlay', MATCH_DAYS[0]!);
+    // Two-match ban. Play only one game.
+    const g1 = await gameOn(f, league, 1);
+    await playGame(f, g1);
+    const rec = await api(f).get(`/players/${league.player.id}/record?asOf=${MATCH_DAYS[1]}`);
+    expect(rec.body.standing).toBe('suspended');
+  });
+});
+
+// ---------------------------------------------------------------------------
+// GET /players/:playerId/suspensions
+// ---------------------------------------------------------------------------
+
+describe('GET /players/:playerId/suspensions', () => {
+  it('answers the full shape for a player with no bans', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const res = await api(f).get(
+      `/players/${league.player.id}/suspensions?asOf=2032-05-16`,
+    );
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.body).sort()).toEqual([
+      'asOf',
+      'entries',
+      'matchesBanned',
+      'matchesOutstanding',
+      'matchesServed',
+      'playerId',
+      'suspended',
+    ]);
+    expect(res.body.matchesBanned).toBe(0);
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(0);
+    expect(res.body.suspended).toBe(false);
+    expect(res.body.entries).toEqual([]);
+  });
+
+  it('produces no entry for a yellow card with no ban', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const fixture = await gameOn(f, league, 0);
+    await book(f, fixture.id, league.player.id, 'dissent', MATCH_DAYS[0]!);
+    const res = await api(f).get(
+      `/players/${league.player.id}/suspensions?asOf=2032-05-16`,
+    );
+    expect(res.status).toBe(200);
+    expect(res.body.matchesBanned).toBe(0);
+    expect(res.body.entries).toEqual([]);
+    expect(res.body.suspended).toBe(false);
+  });
+
+  it('produces an entry for a straight red with the right shape', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const fixture = await gameOn(f, league, 0);
+    const card = await book(f, fixture.id, league.player.id, 'seriousFoulPlay', MATCH_DAYS[0]!);
+    const res = await api(f).get(
+      `/players/${league.player.id}/suspensions?asOf=2032-05-16`,
+    );
+    expect(res.status).toBe(200);
+    expect(res.body.entries).toHaveLength(1);
+    const entry = res.body.entries[0];
+    expect(Object.keys(entry).sort()).toEqual([
+      'cardId',
+      'clearedOn',
+      'fixtureId',
+      'matches',
+      'outstanding',
+      'served',
+      'servedIn',
+      'shownOn',
+      'teamId',
+    ]);
+    expect(entry.cardId).toBe(card.body.id);
+    expect(entry.fixtureId).toBe(fixture.id);
+    expect(entry.teamId).toBe(league.home.id);
+    expect(entry.shownOn).toBe(MATCH_DAYS[0]);
+    expect(entry.matches).toBe(2);
+    expect(entry.served).toBe(0);
+    expect(entry.outstanding).toBe(2);
+    expect(entry.servedIn).toEqual([]);
+    expect(entry.clearedOn).toBeNull();
+    expect(res.body.matchesBanned).toBe(2);
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(2);
+    expect(res.body.suspended).toBe(true);
+  });
+
+  it('tracks games served and remaining', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const g0 = await gameOn(f, league, 0);
+    await book(f, g0.id, league.player.id, 'seriousFoulPlay', MATCH_DAYS[0]!);
+    const g1 = await gameOn(f, league, 1);
+    const g2 = await gameOn(f, league, 2);
+    await playGame(f, g1);
+
+    const res = await api(f).get(
+      `/players/${league.player.id}/suspensions?asOf=${MATCH_DAYS[1]}`,
+    );
+    expect(res.body.matchesServed).toBe(1);
+    expect(res.body.matchesOutstanding).toBe(1);
+    expect(res.body.suspended).toBe(true);
+    const entry = res.body.entries[0];
+    expect(entry.served).toBe(1);
+    expect(entry.outstanding).toBe(1);
+    expect(entry.servedIn).toEqual([g1.id]);
+    expect(entry.clearedOn).toBeNull();
+
+    // Now play the second game and check it clears.
+    await playGame(f, g2);
+    const res2 = await api(f).get(
+      `/players/${league.player.id}/suspensions?asOf=${MATCH_DAYS[2]}`,
+    );
+    expect(res2.body.matchesServed).toBe(2);
+    expect(res2.body.matchesOutstanding).toBe(0);
