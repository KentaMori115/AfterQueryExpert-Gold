+      // The earliest card for this team tells us the earliest a serving game could occur.
+      const firstShownOn = teamEntries[0]!.shownOn;
+
+      const games = this.repo.playedForTeamAfter(teamId, firstShownOn, asOf);
+
+      for (const game of games) {
+        // Find the earliest card for this team that was shown before this game and still has matches to serve.
+        const target = teamEntries.find(
+          (e) => e.shownOn < game.playedOn && e.outstanding > 0,
+        );
+        if (target !== undefined) {
+          target.served += 1;
+          target.servedIn.push(game.id);
+          target.outstanding -= 1;
+          if (target.outstanding === 0) {
+            target.clearedOn = game.playedOn;
+          }
+        }
+      }
+    }
+
+    return entries;
+  }
