+  /**
+   * Played fixtures for a given team on or before a cutoff and strictly after a
+   * given day, oldest first. Used to work out which games served a ban.
+   */
+  playedForTeamAfter(
+    teamId: number,
+    afterDay: string,
+    upToDay: string,
+  ): { id: number; playedOn: string }[] {
+    const found = asRows<{ id: number; played_on: string }>(
+      this.db
+        .prepare(
+          `SELECT id, played_on FROM fixtures
+            WHERE (home_team_id = ? OR away_team_id = ?)
+              AND status = 'played'
+              AND played_on > ?
+              AND played_on <= ?
+            ORDER BY played_on ASC, id ASC`,
+        )
+        .all(teamId, teamId, afterDay, upToDay),
+    );
+    return found.map((r) => ({ id: r.id, playedOn: r.played_on }));
+  }
+
+  /** Every team id belonging to a club. */
+  teamIdsForClub(clubId: number): number[] {
+    const found = asRows<{ id: number }>(
+      this.db.prepare(`SELECT id FROM teams WHERE club_id = ?`).all(clubId),
+    );
+    return found.map((r) => r.id);
+  }
+
+  /** All registered players at a club. */
+  registeredPlayersAtClub(clubId: number): number[] {
+    const found = asRows<{ id: number }>(
+      this.db
+        .prepare(`SELECT id FROM players WHERE club_id = ? AND status = 'registered'`)
+        .all(clubId),
+    );
+    return found.map((r) => r.id);
+  }
 }
