@@ -0,0 +1,569 @@
+import {
+  aFixedLeague,
+  aFixture,
+  api,
+  bare,
+  floor,
+  type Floor,
+} from '../../../tests/helpers';
+
+const MATCH_DAYS = [
+  '2031-09-06',
+  '2031-10-04',
+  '2031-11-01',
+  '2031-12-06',
+  '2032-01-10',
+  '2032-02-07',
+  '2032-03-06',
+];
+
+/**
+ * A league with a player at the home club, and a run of games that player's
+ * side is in, so cards can be piled up across ordered fixtures.
+ */
+async function aBookableLeague(f: Floor) {
+  const league = await aFixedLeague(f, 4, { teamCapacity: 10 });
+  const home = league.teams[0];
+  const others = league.teams.slice(1);
+  const homeClub = league.clubs[0];
+
+  const player = await api(f).post(`/clubs/${homeClub?.id}/players`).send({
+    firstName: 'Owen',
+    lastName: 'Tasker',
+    bornOn: '2005-03-14',
+    position: 'midfielder',
+    squadNumber: 8,
+    registeredOn: '2031-07-20',
+  });
+
+  return { ...league, home, others, homeClub, player: player.body };
+}
+
+/** Puts the home side in a game on the given match day. */
+async function gameOn(
+  f: Floor,
+  league: Awaited<ReturnType<typeof aBookableLeague>>,
+  index: number,
+) {
+  const opponent = league.others[index % league.others.length];
+  const atHome = index % 2 === 0;
+  return aFixture(
+    f,
+    league.division.id,
+    atHome ? league.home?.id : opponent?.id,
+    atHome ? opponent?.id : league.home?.id,
+    league.venue.id,
+    { playedOn: MATCH_DAYS[index] ?? '' },
+  );
+}
+
+async function book(
+  f: Floor,
+  fixtureId: number,
+  playerId: number,
+  offence: string,
+  shownOn: string,
+) {
+  return api(f).post(`/fixtures/${fixtureId}/cards`).send({ playerId, offence, shownOn });
+}
+
+/** Reports and confirms a result to make the fixture 'played'. */
+async function confirmResult(
+  f: Floor,
+  fixture: { id: number; homeTeamId: number; awayTeamId: number },
+  playedOn: string,
+) {
+  const reported = await api(f).post(`/fixtures/${fixture.id}/result`).send({
+    homeGoals: 1,
+    awayGoals: 0,
+    reportedByTeamId: fixture.homeTeamId,
+    reportedOn: playedOn,
+  });
+  await api(f)
+    .post(`/results/${reported.body.id}/confirm`)
+    .send({ confirmedByTeamId: fixture.awayTeamId, confirmedOn: playedOn });
+}
+
+describe('GET /players/:playerId/suspensions', () => {
+  it('answers the shape with empty entries when no banning cards', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const fixture = await gameOn(f, league, 0);
+    // A dissent card has no ban
+    await book(f, fixture.id, league.player.id, 'dissent', MATCH_DAYS[0] ?? '');
+
+    const res = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    expect(res.status).toBe(200);
+    expect(res.body.matchesBanned).toBe(0);
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(0);
+    expect(res.body.suspended).toBe(false);
+    expect(res.body.entries).toEqual([]);
+  });
+
+  it('answers the full shape for a banning card', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+    const fixture = await gameOn(f, league, 0);
+    const card = await book(
+      f,
+      fixture.id,
+      league.player.id,
+      'violentConduct',
+      MATCH_DAYS[0] ?? '',
+    );
+
+    const res = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.body).sort()).toEqual([
+      'asOf',
+      'entries',
+      'matchesBanned',
+      'matchesOutstanding',
+      'matchesServed',
+      'playerId',
+      'suspended',
+    ]);
+    expect(res.body.playerId).toBe(league.player.id);
+    expect(res.body.asOf).toBe('2032-05-16');
+    expect(res.body.matchesBanned).toBe(3);
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(3);
+    expect(res.body.suspended).toBe(true);
+
+    expect(res.body.entries).toHaveLength(1);
+    const entry = res.body.entries[0];
+    expect(entry.cardId).toBe(card.body.id);
+    expect(entry.fixtureId).toBe(fixture.id);
+    expect(entry.teamId).toBe(card.body.teamId);
+    expect(entry.shownOn).toBe(MATCH_DAYS[0]);
+    expect(entry.matches).toBe(3);
+    expect(entry.served).toBe(0);
+    expect(entry.outstanding).toBe(3);
+    expect(entry.servedIn).toEqual([]);
+    expect(entry.clearedOn).toBe(null);
+  });
+
+  it('counts served matches from played games after the card was shown', async () => {
+    const f = floor();
+    const league = await aBookableLeague(f);
+
+    // Show a red card in game 0 (3-match ban)
+    const fixture0 = await gameOn(f, league, 0);
+    const card = await book(
+      f,
+      fixture0.id,
+      league.player.id,
+      'violentConduct',
+      MATCH_DAYS[0] ?? '',
+    );
+
+    // Play game 1 (serves match 1)
+    const fixture1 = await gameOn(f, league, 1);
+    await confirmResult(f, fixture1, MATCH_DAYS[1] ?? '');
+
+    // Play game 2 (serves match 2)
+    const fixture2 = await gameOn(f, league, 2);
+    await confirmResult(f, fixture2, MATCH_DAYS[2] ?? '');
+
+    const res = await api(f).get(`/players/${league.player.id}/suspensions?asOf=2032-05-16`);
+    expect(res.status).toBe(200);
+    expect(res.body.matchesBanned).toBe(3);
+    expect(res.body.matchesServed).toBe(2);
+    expect(res.body.matchesOutstanding).toBe(1);
+    expect(res.body.suspended).toBe(true);
+
+    const entry = res.body.entries[0];
+    expect(entry.cardId).toBe(card.body.id);
+    expect(entry.served).toBe(2);
+    expect(entry.outstanding).toBe(1);
+    expect(entry.servedIn).toEqual([fixture1.id, fixture2.id]);
+    expect(entry.clearedOn).toBe(null);
+  });
