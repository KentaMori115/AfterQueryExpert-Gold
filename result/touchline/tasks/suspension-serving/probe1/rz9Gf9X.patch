+             JOIN teams ht ON ht.id = f.home_team_id
+             JOIN teams at2 ON at2.id = f.away_team_id
+            WHERE p.status = 'registered'
+              AND (p.club_id = ht.club_id OR p.club_id = at2.club_id)`,
+        )
+        .all(fixtureId),
+    );
+    return found.map((r) => ({
