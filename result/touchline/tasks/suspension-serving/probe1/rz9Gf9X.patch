+      const outstanding = entries.reduce((sum, e) => sum + e.outstanding, 0);
+
+      if (outstanding > 0) {
+        const teamId = p.clubId === homeTeam.clubId ? fixture.homeTeamId : fixture.awayTeamId;
+        ineligible.push({
+          playerId: p.playerId,
+          clubId: p.clubId,
+          teamId,
+          outstanding,
+        });
+      }
+    }
+
+    // Sort: home side first, then by playerId
+    ineligible.sort((a, b) => {
+      const aIsHome = a.clubId === homeTeam.clubId ? 0 : 1;
+      const bIsHome = b.clubId === homeTeam.clubId ? 0 : 1;
+      if (aIsHome !== bIsHome) return aIsHome - bIsHome;
+      return a.playerId - b.playerId;
+    });
+
+    return {
+      fixtureId,
+      playedOn,
+      asOf,
+      ineligible,
