+   * then away side, both in player id order.
+   */
+  eligibility(fixtureId: number): EligibilityResult {
+    const fixture = this.fixtures.get(fixtureId);
+    const playedOn = fixture.playedOn;
+
+    // The eligibility check reads the day before the game
+    const asOf = dayBefore(playedOn);
+
+    const homeTeam = this.teams.get(fixture.homeTeamId);
+    const awayTeam = this.teams.get(fixture.awayTeamId);
+
+    // Get all registered players at either club
+    const registeredPlayers = this.repo.playersAtFixtureClubs(fixtureId);
+
+    const ineligible: IneligiblePlayer[] = [];
+
+    for (const p of registeredPlayers) {
