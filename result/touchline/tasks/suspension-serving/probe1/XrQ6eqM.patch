+
+/** Reports and confirms a result, leaving the fixture with status `played`. */
+export async function playGame(
+  f: Floor,
+  fixtureId: number,
+  homeTeamId: number,
+  awayTeamId: number,
+  playedOn: string,
+  overrides: Overrides = {},
+) {
+  const reportedOn = overrides.reportedOn as string ?? playedOn;
+  const confirmedOn = overrides.confirmedOn as string ?? playedOn;
+  const report = await api(f)
+    .post(`/fixtures/${fixtureId}/result`)
+    .send({
+      homeGoals: 1,
+      awayGoals: 0,
+      reportedByTeamId: homeTeamId,
+      reportedOn,
+      ...overrides,
+    });
+  const result = report.body;
+  await api(f)
+    .post(`/results/${result.id}/confirm`)
+    .send({ confirmedByTeamId: awayTeamId, confirmedOn });
+  return (await api(f).get(`/fixtures/${fixtureId}`)).body;
+}
