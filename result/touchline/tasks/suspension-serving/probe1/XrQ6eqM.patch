+
+  /**
+   * All played fixtures for a team, played strictly after a given day and on or
+   * before asOf, ordered chronologically. Used to compute how many ban-matches
+   * have been served.
+   */
+  playedFixturesForTeamAfter(teamId: number, afterDay: string, asOf: string): Fixture[] {
+    const found = asRows<FixtureRow>(
+      this.db
+        .prepare(
+          `SELECT * FROM fixtures
+            WHERE (home_team_id = ? OR away_team_id = ?)
+              AND status = 'played'
+              AND played_on > ?
+              AND played_on <= ?
+            ORDER BY played_on ASC, id ASC`,
+        )
+        .all(teamId, teamId, afterDay, asOf),
+    );
+    return found.map(toFixture);
+  }
+
+  /**
+   * All registered players at a club, for the eligibility check.
+   */
+  registeredPlayersAtClub(clubId: number): Player[] {
+    const found = asRows<PlayerRow>(
+      this.db
+        .prepare(
+          `SELECT * FROM players
+            WHERE club_id = ? AND status = 'registered'
+            ORDER BY id ASC`,
+        )
+        .all(clubId),
+    );
+    return found.map(toPlayer);
+  }
+
+  /**
+   * All teams at a club (entered, not withdrawn), for eligibility.
+   */
+  teamsForClub(clubId: number): { id: number }[] {
+    const found = asRows<{ id: number }>(
+      this.db
+        .prepare(
+          `SELECT id FROM teams WHERE club_id = ? AND status = 'entered'`,
+        )
+        .all(clubId),
+    );
+    return found;
+  }
+
+  /**
+   * The two clubs in a fixture (via their teams).
+   */
+  clubsInFixture(fixtureId: number): { homeClubId: number; awayClubId: number; playedOn: string } | undefined {
+    const row = asRow<{ home_club_id: number; away_club_id: number; played_on: string }>(
+      this.db
+        .prepare(
+          `SELECT ht.club_id AS home_club_id, at.club_id AS away_club_id, f.played_on
+             FROM fixtures f
+             JOIN teams ht ON ht.id = f.home_team_id
+             JOIN teams at ON at.id = f.away_team_id
+            WHERE f.id = ?`,
+        )
+        .get(fixtureId),
+    );
+    if (!row) return undefined;
+    return {
+      homeClubId: row.home_club_id,
+      awayClubId: row.away_club_id,
+      playedOn: row.played_on,
+    };
+  }
 }
