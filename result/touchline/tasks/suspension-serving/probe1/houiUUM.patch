+/**
+ * Working out how much of a suspension a player has served and what remains.
+ *
+ * Bans are served over games of the side the card was shown for. Only played
+ * games serve anything. Each played game serves one match off the earliest
+ * outstanding card shown to that side BEFORE it (strictly: shown on an earlier
+ * day than the game was played). Rescinded cards drop out and any games they
+ * had consumed fall through to later cards.
+ */
+import type { Card } from './discipline.types';
+import type { Fixture } from '../fixtures/fixture.types';
+
+export interface SuspensionEntry {
+  cardId: number;
+  fixtureId: number;
+  teamId: number;
+  shownOn: string;
+  matches: number;
+  served: number;
+  outstanding: number;
+  servedIn: number[];
+  clearedOn: string | null;
+}
+
+export interface SuspensionSummary {
+  matchesBanned: number;
+  matchesServed: number;
+  matchesOutstanding: number;
+  suspended: boolean;
+  entries: SuspensionEntry[];
+}
+
+/**
+ * Computes the suspension state from a set of cards (already filtered to
+ * non-rescinded cards on or before asOf) and played games indexed by team.
+ *
+ * `playedByTeam` maps teamId -> fixtures played by that team, sorted oldest
+ * first, on or before asOf.
+ *
+ * Only games played STRICTLY AFTER a card was shown can serve that card
+ * ("shown to that side before it" in the spec). The game where a card is shown
+ * does not count towards serving the ban it carries.
+ */
+export function computeSuspensions(
+  cards: Card[],
+  playedByTeam: Map<number, Fixture[]>,
+): SuspensionSummary {
+  // Only cards that actually carry a ban matter.
+  const banningCards = cards.filter(
+    (c) => Math.max(c.straightBan, c.accumulationBan) > 0,
+  );
+
+  if (banningCards.length === 0) {
+    return {
+      matchesBanned: 0,
+      matchesServed: 0,
+      matchesOutstanding: 0,
+      suspended: false,
+      entries: [],
+    };
+  }
+
+  // For each team, maintain a cursor into the sorted played-games list.
+  // Games are consumed in order; once a game serves a card it cannot serve another.
+  // We track the position (index) within the per-team array so that each card
+  // only picks up games not yet used by earlier cards.
+  const teamCursors = new Map<number, number>();
+  for (const [teamId] of playedByTeam) {
+    teamCursors.set(teamId, 0);
+  }
+
+  const entries: SuspensionEntry[] = [];
+  let totalBanned = 0;
+  let totalServed = 0;
+
+  for (const card of banningCards) {
+    const ban = Math.max(card.straightBan, card.accumulationBan);
+    const teamId = card.teamId;
+    const fixtures = playedByTeam.get(teamId) ?? [];
+    let cursor = teamCursors.get(teamId) ?? 0;
+
+    // Advance the cursor past any games that are NOT strictly after the card was shown.
+    // A game on the same day as the card (the game where the card was shown) does not serve.
+    while (cursor < fixtures.length && (fixtures[cursor]?.playedOn ?? '') <= card.shownOn) {
+      cursor += 1;
+    }
+
+    // Take up to `ban` games from the remaining pool.
+    const servedIn: number[] = [];
+    let clearedOn: string | null = null;
+
+    while (servedIn.length < ban && cursor < fixtures.length) {
+      const fixture = fixtures[cursor]!;
+      servedIn.push(fixture.id);
+      if (servedIn.length === ban) {
+        clearedOn = fixture.playedOn;
+      }
+      cursor += 1;
+    }
+
+    // Update the cursor so the next card doesn't re-use these games.
+    teamCursors.set(teamId, cursor);
+
+    const served = servedIn.length;
+    const outstanding = ban - served;
+
+    entries.push({
+      cardId: card.id,
+      fixtureId: card.fixtureId,
+      teamId: card.teamId,
+      shownOn: card.shownOn,
+      matches: ban,
+      served,
+      outstanding,
+      servedIn,
+      clearedOn,
+    });
+
+    totalBanned += ban;
+    totalServed += served;
+  }
+
+  const totalOutstanding = totalBanned - totalServed;
+
+  return {
+    matchesBanned: totalBanned,
+    matchesServed: totalServed,
+    matchesOutstanding: totalOutstanding,
+    suspended: totalOutstanding > 0,
+    entries,
+  };
+}
