+              AND status = 'played'
+              AND played_on <= ?
+            ORDER BY played_on ASC, kick_off ASC, id ASC`,
+        )
+        .all(teamId, teamId, asOf),
+    );
+    return found.map(toFixture);
+  }
+
+  /**
+   * The club ids of both sides in a fixture, for the eligibility check.
+   * Returns undefined when the fixture does not exist.
+   */
+  clubsForFixture(
+    fixtureId: number,
+  ): { homeTeamId: number; awayTeamId: number; homeClubId: number; awayClubId: number } | undefined {
+    const row = asRow<{
+      home_team_id: number;
+      away_team_id: number;
+      home_club_id: number;
+      away_club_id: number;
+    }>(
+      this.db
+        .prepare(
+          `SELECT f.home_team_id, f.away_team_id,
+                  ht.club_id AS home_club_id,
+                  at.club_id AS away_club_id
+             FROM fixtures f
+             JOIN teams ht ON ht.id = f.home_team_id
+             JOIN teams at ON at.id = f.away_team_id
+            WHERE f.id = ?`,
+        )
+        .get(fixtureId),
+    );
+    if (!row) return undefined;
+    return {
+      homeTeamId: row.home_team_id,
+      awayTeamId: row.away_team_id,
+      homeClubId: row.home_club_id,
+      awayClubId: row.away_club_id,
+    };
+  }
+
+  /**
+   * All registered players at a club, for the eligibility check.
+   * Returns player ids only, sorted ascending.
+   */
+  registeredPlayersAtClub(clubId: number): number[] {
+    const rows = asRows<{ id: number }>(
+      this.db
+        .prepare(
+          `SELECT id FROM players WHERE club_id = ? AND status = 'registered' ORDER BY id ASC`,
+        )
+        .all(clubId),
+    );
+    return rows.map((r) => r.id);
+  }
 }
