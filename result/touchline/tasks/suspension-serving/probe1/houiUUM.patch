diff --git a/src/modules/discipline/suspension.routes.test.ts b/src/modules/discipline/suspension.routes.test.ts
new file mode 100644
index 0000000..d3bffc4
--- /dev/null
+++ b/src/modules/discipline/suspension.routes.test.ts
@@ -0,0 +1,643 @@
+/**
+ * Tests for the suspension-aware endpoints:
+ *  GET /players/:playerId/suspensions?asOf=
+ *  GET /fixtures/:fixtureId/eligibility
+ *
+ * Also verifies that the record endpoint's `standing` and the two new fields
+ * work correctly now that serving is computed properly.
+ */
+import {
+  aFixedLeague,
+  aFixture,
+  api,
+  bare,
+  floor,
+  type Floor,
+} from '../../../tests/helpers';
+
+const MATCH_DAYS = [
+  '2031-09-06',
+  '2031-10-04',
+  '2031-11-01',
+  '2031-12-06',
+  '2032-01-10',
+  '2032-02-07',
+  '2032-03-06',
+];
+
+/** A league with two players (one home, one away) we can show cards to. */
+async function aLeagueWithPlayers(f: Floor) {
+  const league = await aFixedLeague(f, 4, { teamCapacity: 10 });
+  const home = league.teams[0]!;
+  const away = league.teams[1]!;
+  const homeClub = league.clubs[0]!;
+  const awayClub = league.clubs[1]!;
+
+  const homePlayer = (
+    await api(f).post(`/clubs/${homeClub.id}/players`).send({
+      firstName: 'Owen',
+      lastName: 'Tasker',
+      bornOn: '2005-03-14',
+      position: 'midfielder',
+      squadNumber: 8,
+      registeredOn: '2031-07-20',
+    })
+  ).body;
+
+  const awayPlayer = (
+    await api(f).post(`/clubs/${awayClub.id}/players`).send({
+      firstName: 'Neil',
+      lastName: 'Burns',
+      bornOn: '2004-06-22',
+      position: 'defender',
+      squadNumber: 5,
+      registeredOn: '2031-07-20',
+    })
+  ).body;
+
+  return { ...league, home, away, homeClub, awayClub, homePlayer, awayPlayer };
+}
+
+/**
+ * Schedules a specific game between two given teams on a given day.
+ */
+async function scheduleGame(
+  f: Floor,
+  league: Awaited<ReturnType<typeof aLeagueWithPlayers>>,
+  homeTeamId: number,
+  awayTeamId: number,
+  dayIndex: number,
+) {
+  return aFixture(
+    f,
+    league.division.id,
+    homeTeamId,
+    awayTeamId,
+    league.venue.id,
+    { playedOn: MATCH_DAYS[dayIndex] ?? '' },
+  );
+}
+
+/** Shows a card in a fixture. */
+async function book(
+  f: Floor,
+  fixtureId: number,
+  playerId: number,
+  offence: string,
+  shownOn: string,
+) {
+  return api(f).post(`/fixtures/${fixtureId}/cards`).send({ playerId, offence, shownOn });
+}
+
+/**
+ * Reports and confirms a result, making the fixture status `played`.
+ */
+async function playGame(
+  f: Floor,
+  fixtureId: number,
+  homeTeamId: number,
+  awayTeamId: number,
+  dayIndex: number,
+) {
+  const playedOn = MATCH_DAYS[dayIndex]!;
+  const result = (
+    await api(f).post(`/fixtures/${fixtureId}/result`).send({
+      homeGoals: 1,
+      awayGoals: 0,
+      reportedByTeamId: homeTeamId,
+      reportedOn: playedOn,
+    })
+  ).body;
+  const confirmRes = await api(f)
+    .post(`/results/${result.id}/confirm`)
+    .send({ confirmedByTeamId: awayTeamId, confirmedOn: playedOn });
+  return confirmRes;
+}
+
+describe('GET /players/:playerId/suspensions', () => {
+  it('answers the right shape with no banning cards', async () => {
+    const f = floor();
+    const league = await aLeagueWithPlayers(f);
+    const res = await api(f).get(
+      `/players/${league.homePlayer.id}/suspensions?asOf=2032-05-16`,
+    );
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.body).sort()).toEqual([
+      'asOf',
+      'entries',
+      'matchesBanned',
+      'matchesOutstanding',
+      'matchesServed',
+      'playerId',
+      'suspended',
+    ]);
+    expect(res.body.playerId).toBe(league.homePlayer.id);
+    expect(res.body.asOf).toBe('2032-05-16');
+    expect(res.body.matchesBanned).toBe(0);
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(0);
+    expect(res.body.suspended).toBe(false);
+    expect(res.body.entries).toEqual([]);
+  });
+
+  it('carries a full ban entry when no subsequent games have been played', async () => {
+    const f = floor();
+    const league = await aLeagueWithPlayers(f);
+    // game0: home team hosts away team
+    const game0 = await scheduleGame(f, league, league.home.id, league.away.id, 0);
+    await book(f, game0.id, league.homePlayer.id, 'violentConduct', MATCH_DAYS[0]!);
+
+    const res = await api(f).get(
+      `/players/${league.homePlayer.id}/suspensions?asOf=2032-05-16`,
+    );
+    expect(res.status).toBe(200);
+    expect(res.body.matchesBanned).toBe(3);
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(3);
+    expect(res.body.suspended).toBe(true);
+    expect(res.body.entries).toHaveLength(1);
+
+    const entry = res.body.entries[0];
+    expect(entry.cardId).toBeGreaterThan(0);
+    expect(entry.fixtureId).toBe(game0.id);
+    expect(entry.teamId).toBe(league.home.id);
+    expect(entry.shownOn).toBe(MATCH_DAYS[0]);
+    expect(entry.matches).toBe(3);
+    expect(entry.served).toBe(0);
+    expect(entry.outstanding).toBe(3);
+    expect(entry.servedIn).toEqual([]);
+    expect(entry.clearedOn).toBe(null);
+  });
+
+  it('does NOT count the game where the card was shown as serving the ban', async () => {
+    const f = floor();
+    const league = await aLeagueWithPlayers(f);
+    // game0: home vs away - card shown for home player
+    const game0 = await scheduleGame(f, league, league.home.id, league.away.id, 0);
+    await book(f, game0.id, league.homePlayer.id, 'denyingGoalscoringOpportunity', MATCH_DAYS[0]!);
+    // Play game0 (the game where the card was shown)
+    await playGame(f, game0.id, league.home.id, league.away.id, 0);
+
+    // Check at asOf = day of game0: no game strictly after the card shown yet
+    const res = await api(f).get(
+      `/players/${league.homePlayer.id}/suspensions?asOf=${MATCH_DAYS[0]}`,
+    );
+    expect(res.body.matchesServed).toBe(0);
+    expect(res.body.matchesOutstanding).toBe(1);
+    expect(res.body.suspended).toBe(true);
+  });
+
+  it('serves one match per subsequent played game for the card team', async () => {
+    const f = floor();
+    const league = await aLeagueWithPlayers(f);
+    // game0: home team vs away - card shown for home player
+    const game0 = await scheduleGame(f, league, league.home.id, league.away.id, 0);
+    await book(f, game0.id, league.homePlayer.id, 'denyingGoalscoringOpportunity', MATCH_DAYS[0]!);
+    // Play game0 (doesn't serve the ban)
+    await playGame(f, game0.id, league.home.id, league.away.id, 0);
+
+    // game1: home team plays again (different opponent)
+    const opp2 = league.teams[2]!;
+    const game1 = await scheduleGame(f, league, league.home.id, opp2.id, 1);
+    await playGame(f, game1.id, league.home.id, opp2.id, 1);
+
+    // Now game1 should serve the 1-match ban
+    const res = await api(f).get(
+      `/players/${league.homePlayer.id}/suspensions?asOf=${MATCH_DAYS[1]}`,
+    );
+    expect(res.body.matchesBanned).toBe(1);
+    expect(res.body.matchesServed).toBe(1);
+    expect(res.body.matchesOutstanding).toBe(0);
+    expect(res.body.suspended).toBe(false);
+    expect(res.body.entries[0].servedIn).toEqual([game1.id]);
+    expect(res.body.entries[0].clearedOn).toBe(MATCH_DAYS[1]);
+    expect(res.body.entries[0].outstanding).toBe(0);
+  });
+
+  it('serves matches across multiple games for a multi-match ban', async () => {
+    const f = floor();
+    const league = await aLeagueWithPlayers(f);
+    const opp2 = league.teams[2]!;
+    const opp3 = league.teams[3]!;
+
+    // game0: card shown - 3 match ban
+    const game0 = await scheduleGame(f, league, league.home.id, league.away.id, 0);
+    await book(f, game0.id, league.homePlayer.id, 'violentConduct', MATCH_DAYS[0]!);
+    await playGame(f, game0.id, league.home.id, league.away.id, 0);
+
+    // game1: serves 1 of 3
+    const game1 = await scheduleGame(f, league, league.home.id, opp2.id, 1);
+    await playGame(f, game1.id, league.home.id, opp2.id, 1);
+
+    // game2: serves 2 of 3
+    const game2 = await scheduleGame(f, league, league.home.id, opp3.id, 2);
+    await playGame(f, game2.id, league.home.id, opp3.id, 2);
+
+    // game3 not yet played
+    const game3 = await scheduleGame(f, league, league.away.id, league.home.id, 3);
+
+    // After game2: 2 served, 1 outstanding
+    const mid = await api(f).get(
+      `/players/${league.homePlayer.id}/suspensions?asOf=${MATCH_DAYS[2]}`,
+    );
+    expect(mid.body.matchesServed).toBe(2);
+    expect(mid.body.matchesOutstanding).toBe(1);
+    expect(mid.body.entries[0].servedIn).toEqual([game1.id, game2.id]);
+    expect(mid.body.entries[0].clearedOn).toBe(null); // not yet cleared
+
+    // Play game3 to serve the last match
+    await playGame(f, game3.id, league.away.id, league.home.id, 3);
+    const done = await api(f).get(
+      `/players/${league.homePlayer.id}/suspensions?asOf=${MATCH_DAYS[3]}`,
+    );
+    expect(done.body.matchesServed).toBe(3);
+    expect(done.body.matchesOutstanding).toBe(0);
+    expect(done.body.suspended).toBe(false);
+    expect(done.body.entries[0].servedIn).toEqual([game1.id, game2.id, game3.id]);
+    expect(done.body.entries[0].clearedOn).toBe(MATCH_DAYS[3]);
+    expect(done.body.entries[0].outstanding).toBe(0);
+  });
+
+  it('only counts played games - awarded, postponed and abandoned serve nothing', async () => {
+    const f = floor();
+    const league = await aLeagueWithPlayers(f);
