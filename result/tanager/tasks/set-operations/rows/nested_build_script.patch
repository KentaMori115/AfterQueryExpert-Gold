+//! Set operations over two materialized branches.
+//!
+//! Both branches arrive as rows of the operator's own output schema, so the
+//! operator never evaluates an expression: it pairs rows and decides which of
+//! them reach the result.
+//!
+//! Two properties shape the implementation. Rows pair through
+//! [`crate::types::Value::group_key`], the same canonical key `DISTINCT` and
+//! `GROUP BY` use, so `NULL` pairs with `NULL` and `-0.0` with `0.0`. And the
+//! result follows the left branch: rows leave in the order they were first
+//! seen there, with a union's unpaired right-branch rows after them.
+
+use std::collections::HashMap;
+
+use crate::ast::statement::SetOperator;
+use crate::error::Result;
+use crate::storage::Row;
+use crate::types::GroupKey;
+
+/// The canonical pairing key of a whole row.
+fn row_key(row: &Row) -> Vec<GroupKey> {
+    row.values().iter().map(|v| v.group_key()).collect()
+}
+
+/// How many times each row appears in `rows`.
+fn tally(rows: &[Row]) -> HashMap<Vec<GroupKey>, usize> {
+    let mut counts: HashMap<Vec<GroupKey>, usize> = HashMap::new();
+    for row in rows {
+        *counts.entry(row_key(row)).or_insert(0) += 1;
+    }
+    counts
+}
+
+/// Apply `op` to two branch results.
+///
+/// `all` selects multiset behavior: `UNION ALL` concatenates, `INTERSECT ALL`
+/// keeps a row as many times as it appears in both branches, and `EXCEPT ALL`
+/// keeps the surplus copies of the left branch. Without it every operator
+/// reports each distinct row at most once.
+pub fn execute_set_op(
+    left: Vec<Row>,
+    right: Vec<Row>,
+    op: SetOperator,
+    all: bool,
+) -> Result<Vec<Row>> {
+    Ok(match (op, all) {
+        (SetOperator::Union, true) => concat(left, right),
+        (SetOperator::Union, false) => dedup(concat(left, right)),
+        (SetOperator::Intersect, true) => keep_copies(left, &right, Quota::Shared),
+        (SetOperator::Intersect, false) => keep_present(left, &right, true),
+        (SetOperator::Except, true) => keep_copies(left, &right, Quota::Surplus),
+        (SetOperator::Except, false) => keep_present(left, &right, false),
+    })
+}
+
+fn concat(mut left: Vec<Row>, right: Vec<Row>) -> Vec<Row> {
+    left.extend(right);
+    left
+}
+
+/// Keep the first copy of each distinct row, in first-seen order.
+fn dedup(rows: Vec<Row>) -> Vec<Row> {
+    let mut seen: HashMap<Vec<GroupKey>, ()> = HashMap::new();
+    let mut out = Vec::new();
+    for row in rows {
+        if seen.insert(row_key(&row), ()).is_none() {
+            out.push(row);
+        }
+    }
+    out
+}
+
+/// How many copies of a row an `ALL` operator is allowed to keep.
+#[derive(Clone, Copy)]
+enum Quota {
+    /// As many as both branches hold: the smaller of the two counts.
+    Shared,
+    /// As many as the left branch holds over the right, floored at zero.
+    Surplus,
+}
+
+/// Keep the leading copies of each row, as many as `quota` allows.
+///
+/// Which copies survive is not arbitrary: they are the first ones, so the
+/// result reads in the order the left branch produced it, the same rule
+/// `DISTINCT` follows.
+fn keep_copies(left: Vec<Row>, right: &[Row], quota: Quota) -> Vec<Row> {
+    let available = tally(right);
+    let mut budget: HashMap<Vec<GroupKey>, usize> = HashMap::new();
+    for (key, held) in tally(&left) {
+        let other = available.get(&key).copied().unwrap_or(0);
+        let allowed = match quota {
+            Quota::Shared => held.min(other),
+            Quota::Surplus => held.saturating_sub(other),
+        };
+        budget.insert(key, allowed);
+    }
+
+    let mut out = Vec::new();
+    for row in left {
+        if let Some(remaining) = budget.get_mut(&row_key(&row)) {
+            if *remaining > 0 {
+                *remaining -= 1;
+                out.push(row);
+            }
+        }
+    }
+    out
+}
+
+/// Keep the first copy of each distinct left row the right branch does or does
+/// not hold.
+fn keep_present(left: Vec<Row>, right: &[Row], present: bool) -> Vec<Row> {
+    let other = tally(right);
+    let mut taken: HashMap<Vec<GroupKey>, ()> = HashMap::new();
+    let mut out = Vec::new();
+    for row in left {
+        let key = row_key(&row);
+        if other.contains_key(&key) != present {
+            continue;
+        }
+        if taken.insert(key, ()).is_none() {
+            out.push(row);
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::types::Value;
+
+    fn rows(values: &[i64]) -> Vec<Row> {
+        values
+            .iter()
+            .map(|v| Row::new(vec![Value::Integer(*v)]))
+            .collect()
+    }
+
+    fn ints(rows: Vec<Row>) -> Vec<i64> {
+        rows.iter()
+            .map(|r| match r.get(0) {
+                Some(Value::Integer(i)) => *i,
+                other => panic!("expected an integer, got {:?}", other),
+            })
+            .collect()
+    }
+
+    fn run(left: &[i64], right: &[i64], op: SetOperator, all: bool) -> Vec<i64> {
+        ints(execute_set_op(rows(left), rows(right), op, all).unwrap())
+    }
+
+    #[test]
+    fn union_all_concatenates_in_branch_order() {
+        assert_eq!(
+            run(&[3, 1, 3], &[1, 2], SetOperator::Union, true),
+            vec![3, 1, 3, 1, 2]
+        );
+    }
+
+    #[test]
+    fn union_keeps_first_sighting_of_each_row() {
+        assert_eq!(
+            run(&[3, 1, 3], &[1, 2], SetOperator::Union, false),
+            vec![3, 1, 2]
+        );
+    }
+
+    #[test]
+    fn intersect_all_keeps_the_smaller_count() {
+        assert_eq!(
+            run(&[1, 1, 1, 2], &[1, 1, 2, 2], SetOperator::Intersect, true),
+            vec![1, 1, 2]
+        );
+    }
+
+    #[test]
+    fn intersect_reports_each_row_once() {
+        assert_eq!(
+            run(&[1, 1, 1, 2], &[1, 1, 2, 2], SetOperator::Intersect, false),
+            vec![1, 2]
+        );
+    }
+
+    #[test]
+    fn except_all_removes_one_copy_per_right_row() {
+        assert_eq!(
+            run(&[1, 1, 1, 2], &[1, 2], SetOperator::Except, true),
+            vec![1, 1]
+        );
+    }
+
+    #[test]
+    fn except_all_keeps_the_leading_copies() {
+        // The third 1 is the one that goes, not the first.
+        assert_eq!(
+            run(&[1, 2, 1, 1], &[1, 5], SetOperator::Except, true),
+            vec![1, 2, 1]
+        );
+    }
+
+    #[test]
+    fn except_drops_a_row_the_right_branch_holds_at_all() {
+        assert_eq!(
+            run(&[1, 1, 1, 2], &[1], SetOperator::Except, false),
+            vec![2]
+        );
+    }
+
+    #[test]
+    fn except_reports_surviving_rows_once() {
+        assert_eq!(
+            run(&[1, 1, 3], &[2], SetOperator::Except, false),
+            vec![1, 3]
+        );
+    }
+
+    #[test]
+    fn nulls_pair_with_nulls() {
+        let left = vec![Row::new(vec![Value::Null]), Row::new(vec![Value::Null])];
+        let right = vec![Row::new(vec![Value::Null])];
+        let out = execute_set_op(left, right, SetOperator::Except, true).unwrap();
+        assert_eq!(out.len(), 1);
+        assert!(out[0].get(0).unwrap().is_null());
+    }
+
+    #[test]
+    fn signed_zeros_are_the_same_row() {
+        let left = vec![Row::new(vec![Value::Float(0.0)])];
+        let right = vec![Row::new(vec![Value::Float(-0.0)])];
+        let out = execute_set_op(left, right, SetOperator::Intersect, false).unwrap();
+        assert_eq!(out.len(), 1);
+    }
+}
