+/// Widen a set-operation branch to the operator's output schema.
+///
+/// Branch column types are unified by the type lattice, and a branch on the
+/// narrow side of a promotion has to carry its *values* over too: rows are
+/// paired by value and type, so an `INTEGER` 1 and a `FLOAT` 1.0 are different
+/// rows until the integer branch is cast. A branch already at the output types
+/// is returned untouched.
+pub(crate) fn widen_branch(plan: LogicalPlan, schema: &Schema) -> LogicalPlan {
+    let branch_schema = plan.schema();
+    let already_wide = branch_schema
+        .fields()
+        .iter()
+        .zip(schema.fields())
+        .all(|(have, want)| have.data_type() == want.data_type());
+    if already_wide {
+        return plan;
+    }
+
+    let mut expressions = Vec::with_capacity(schema.len());
+    let mut aliases = Vec::with_capacity(schema.len());
+    for (index, want) in schema.fields().iter().enumerate() {
+        let have = branch_schema.field(index).unwrap();
+        let column = BoundExpr::Column {
+            index,
+            data_type: have.data_type(),
+        };
+        expressions.push(if have.data_type() == want.data_type() {
+            column
+        } else {
+            BoundExpr::Cast {
+                expr: Box::new(column),
+                data_type: want.data_type(),
+            }
+        });
+        aliases.push(want.name().to_string());
+    }
+    LogicalPlan::Project {
+        input: Box::new(plan),
+        expressions,
+        aliases,
+        schema: schema.clone(),
+    }
+}
