diff --git a/tests/domain/harvest/schedule.test.ts b/tests/domain/harvest/schedule.test.ts
new file mode 100644
index 0000000..a15af9f
--- /dev/null
+++ b/tests/domain/harvest/schedule.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from 'vitest';
+
+import { planHarvest } from '@/domain/harvest/schedule';
+
+describe('the planner', () => {
+  it('has nothing to plan for a site with no pens', () => {
+    const plan = planHarvest({
+      at: 0,
+      maxBiomassT: 100,
+      weeklyCapacityT: [500, 500],
+      minHarvestWeightG: 3_000,
+      temperatures: [],
+      pens: [],
+    });
+    expect(plan.bookings).toEqual([]);
+    expect(plan.shortfall).toBeNull();
+    expect(plan.skipped).toEqual([]);
+  });
+});
