# Which backend the interface talks to.
#   demo  in-process dataset, no server needed
#   http  the real service
VITE_BACKEND=demo

# Required when VITE_BACKEND=http. Must be https unless it is localhost.
VITE_API_BASE_URL=

# The site this deployment is for.
VITE_SITE_CODE=FS-0412

# How often the interface advances its clock. Coarse on purpose.
VITE_CLOCK_TICK_MS=60000
