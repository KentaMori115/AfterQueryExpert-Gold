{
  "name": "netpen",
  "version": "0.1.0",
  "private": true,
  "description": "Grow-out operations for marine salmon net pens: biomass, feed, water, lice and harvest",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "vue-tsc --build && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.vue --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --build --force",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.64.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "pinia": "^2.3.0",
    "vue": "3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.5",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "0.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "26.0.0",
    "prettier": "^3.4.2",
    "typescript": "5.7.3",
    "vite": "5.4.11",
    "vitest": "2.1.9",
    "vue-tsc": "2.2.0"
  }
}
