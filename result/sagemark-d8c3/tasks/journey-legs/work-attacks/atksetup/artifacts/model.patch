@@ -0,0 +1,37 @@
+// Ration ledger for a party away from town.
+
+export interface SupplyState {
+  rations: number
+  hungryDays: number
+}
+
+export interface SupplyDraw {
+  state: SupplyState
+  drawn: number
+  short: number
+}
+
+function whole(n: number): number {
+  return Number.isFinite(n) && n > 0 ? Math.trunc(n) : 0
+}
+
+export function startingSupply(rations: number): SupplyState {
+  return { rations: whole(rations), hungryDays: 0 }
+}
+
+export function drawRations(state: SupplyState, mouths: number): SupplyDraw {
+  const need = whole(mouths)
+  const stock = whole(state.rations)
+  const drawn = need > stock ? stock : need
+  const short = need - drawn
+  const next: SupplyState = {
+    rations: stock - drawn,
+    hungryDays: state.hungryDays + (short === 0 ? 0 : 1),
+  }
+  return { state: next, drawn, short }
+}
+
+export function daysOfFood(state: SupplyState, mouths: number): number {
+  const need = whole(mouths)
+  return need === 0 ? 0 : Math.trunc(whole(state.rations) / need)
+}
