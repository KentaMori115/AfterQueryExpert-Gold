index 0000000..2655b79
--- /dev/null
+++ b/src/core/rules/journey.ts
@@ -0,0 +1,155 @@
+// Day by day overland travel.
+
+import type { RandomSource } from '../dice/roll'
+import { type CalendarDay, type CalendarShape, advanceDays } from '../lib/inworld-calendar'
+
+import type { ExhaustionLevel } from './conditions'
+import { type SupplyState, drawRations, startingSupply } from './supply'
+import { type Climate, type Season, type TravelPace, type WeatherSeverity, rollWeather } from './weather'
+
+export interface JourneyLeg {
+  name: string
+  miles: number
+  costPerMile: number
+  climate: Climate
+  season: Season
+  pace: TravelPace
+}
+
+export interface JourneyParty {
+  size: number
+  milesPerDay: number
+  rations: number
+  exhaustion: ExhaustionLevel
+}
+
+export interface JourneyPlan {
+  legs: ReadonlyArray<JourneyLeg>
+  party: JourneyParty
+  start: CalendarDay
+  calendar: CalendarShape
+  rng?: RandomSource
+}
+
+export interface JourneyDay {
+  date: CalendarDay
+  legName: string
+  weather: string
+  severity: WeatherSeverity
+  allowance: number
+  covered: number
+  rationsLeft: number
+  hungry: boolean
+  exhaustion: ExhaustionLevel
+}
+
+export interface JourneyReport {
+  days: ReadonlyArray<JourneyDay>
+  arrived: boolean
+  stalled: boolean
+  arrivalDate: CalendarDay | null
+  milesLeft: number
+  rationsLeft: number
+  hungryDays: number
+  exhaustion: ExhaustionLevel
+}
+
+const PACE: Record<TravelPace, number> = { slow: 0.75, normal: 1, fast: 1.25, forced: 1.5 }
+
+function tenth(n: number): number {
+  return Number(n.toFixed(1))
+}
+
+function wear(level: number): number {
+  if (level >= 5) return 0
+  return level >= 2 ? 0.5 : 1
+}
+
+function cap(level: number): ExhaustionLevel {
+  const n = Math.max(0, Math.min(6, Math.floor(level)))
+  return n as ExhaustionLevel
+}
+
+export function planJourney(plan: JourneyPlan): JourneyReport {
+  const draw = plan.rng ?? Math.random
+  const queue = plan.legs.map((l) => ({
+    leg: l,
+    left: Number.isFinite(l.miles) && l.miles > 0 ? l.miles : 0,
+    cost: Number.isFinite(l.costPerMile) && l.costPerMile > 0 ? l.costPerMile : 0,
+  }))
+  const speed = Math.max(0, plan.party.milesPerDay)
+  const mouths = Math.max(0, Math.floor(plan.party.size))
+
+  let pack: SupplyState = startingSupply(plan.party.rations)
+  let worn = cap(plan.party.exhaustion)
+  let at = 0
+  const days: JourneyDay[] = []
+  let halted = false
+
+  const skip = () => {
+    while (at < queue.length && queue[at]!.left <= 0) at += 1
+  }
+  skip()
+
+  for (let n = 0; at < queue.length && n < 5000; n += 1) {
+    const here = queue[at]!
+    const sky = rollWeather(here.leg.climate, here.leg.season, draw)
+    const budget = tenth(speed * PACE[here.leg.pace] * (1 - Math.min(0.9, sky.travelPenalty)) * wear(worn))
+
+    let purse = budget
+    let walked = 0
+    while (purse > 0 && at < queue.length) {
+      const step = queue[at]!
+      const whole = step.left * step.cost
+      if (whole <= purse + 1e-9) {
+        walked += step.left
+        purse -= whole
+        step.left = 0
+        at += 1
+        skip()
+      } else {
+        const part = purse / step.cost
+        step.left -= part
+        walked += part
+        purse = 0
+      }
+    }
+
+    const meal = drawRations(pack, mouths)
+    pack = meal.state
+    if (sky.severity === 'severe' && pack.rations > 0) {
+      pack = { ...pack, rations: pack.rations - 1 }
+    }
+    const hungry = meal.short > 0
+    worn = cap(worn + (here.leg.pace === 'forced' ? 1 : 0) + (hungry ? 1 : 0))
+
+    days.push({
+      date: advanceDays(plan.start, n, plan.calendar),
+      legName: here.leg.name,
+      weather: sky.label,
+      severity: sky.severity,
+      allowance: budget,
+      covered: tenth(walked),
+      rationsLeft: pack.rations,
+      hungry,
+      exhaustion: worn,
+    })
+
+    if (tenth(walked) <= 0) {
+      halted = true
+      break
+    }
+  }
+
+  const done = !halted && at >= queue.length
+  return {
+    days,
+    arrived: done,
+    stalled: halted,
+    arrivalDate: done ? (days.length ? days[days.length - 1]!.date : plan.start) : null,
+    milesLeft: tenth(queue.reduce((t, q) => t + Math.max(0, q.left), 0)),
+    rationsLeft: pack.rations,
+    hungryDays: pack.hungryDays,
+    exhaustion: worn,
+  }
+}
