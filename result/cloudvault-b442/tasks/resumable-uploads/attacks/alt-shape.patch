--- /dev/null
+++ b/lib/upload-parts.ts
@@ -0,0 +1,29 @@
+import { PART_BYTES, spanCovers, type UploadSession } from "./upload-session"
+
+export function partsFor(totalSize: number) {
+    const count = Math.ceil(totalSize / PART_BYTES)
+    return Array.from({ length: count }, (_, index) => ({
+        index,
+        start: index * PART_BYTES,
+        end: Math.min((index + 1) * PART_BYTES, totalSize) - 1,
+    }))
+}
+
+export function nextUploadBatch(session: UploadSession) {
+    const parts = partsFor(session.totalSize)
+    return parts
+        .filter((part) => !session.sent.has(part.index) && spanCovers(session, part.start, part.end + 1))
+        .map((part) => {
+            session.sent.add(part.index)
+            return {
+                index: part.index,
+                name:
+                    parts.length === 1
+                        ? session.filename
+                        : session.filename + ".part" + (part.index + 1) + "_of_" + parts.length,
+                start: part.start,
+                end: part.end,
+                size: part.end - part.start + 1,
+            }
+        })
+}
diff --git a/lib/upload-session.ts b/lib/upload-session.ts
new file mode 100644
index 0000000..0b329e5
--- /dev/null
+++ b/lib/upload-session.ts
@@ -0,0 +1,76 @@
+import { MAX_FILE_SIZE } from "./file-utils"
+
+export const PART_BYTES = 45 * 1024 * 1024
+export const IDLE_AFTER = 21600000
+
+// Half open spans, [from, to), kept in a flat list of pairs.
+export class UploadSession {
+    id: string
+    userId: string
+    filename: string
+    totalSize: number
+    startedAt: number
+    lastSeen: number
+    spans: number[][]
+    sent: Set<number>
+
+    constructor(id: string, userId: string, filename: string, totalSize: number, startedAt: number) {
+        this.id = id
+        this.userId = userId
+        this.filename = filename
+        this.totalSize = totalSize
+        this.startedAt = startedAt
+        this.lastSeen = startedAt
+        this.spans = []
+        this.sent = new Set<number>()
+    }
+}
+
+export function createUploadSession(
+    id: string,
+    userId: string,
+    filename: string,
+    totalSize: number,
+    startedAt: number,
+): UploadSession {
+    const name = String(filename).trim()
+    if (name.length === 0) throw new Error("blank name")
+    if (!Number.isInteger(totalSize)) throw new Error("size must be whole")
+    if (totalSize < 1 || totalSize > MAX_FILE_SIZE) throw new Error("size out of range")
+    return new UploadSession(id, userId, name, totalSize, startedAt)
+}
+
+export function recordChunk(session: UploadSession, start: number, end: number, at: number): void {
+    if (!Number.isInteger(start) || !Number.isInteger(end)) throw new Error("whole offsets only")
+    if (start < 0 || end < start || end >= session.totalSize) throw new Error("outside the file")
+
+    const spans = session.spans.concat([[start, end + 1]])
+    spans.sort((a, b) => a[0] - b[0])
+    const kept: number[][] = []
+    for (const span of spans) {
+        if (kept.length && span[0] <= kept[kept.length - 1][1]) {
+            kept[kept.length - 1][1] = Math.max(kept[kept.length - 1][1], span[1])
+        } else {
+            kept.push([span[0], span[1]])
+        }
+    }
+    session.spans = kept
+    session.lastSeen = at
+}
+
+export function uploadStatus(session: UploadSession) {
+    const held = session.spans.reduce((sum, span) => sum + span[1] - span[0], 0)
+    const missing: Array<{ start: number; end: number }> = []
+    let at = 0
+    for (const span of session.spans) {
+        if (span[0] > at) missing.push({ start: at, end: span[0] - 1 })
+        at = span[1]
+    }
+    if (at < session.totalSize) missing.push({ start: at, end: session.totalSize - 1 })
+    const leading = session.spans.length && session.spans[0][0] === 0 ? session.spans[0][1] : 0
+    return { receivedBytes: held, nextOffset: leading, missing, complete: held === session.totalSize }
+}
+
+export function spanCovers(session: UploadSession, from: number, toExclusive: number): boolean {
+    return session.spans.some((span) => span[0] <= from && span[1] >= toExclusive)
+}
diff --git a/lib/upload-store.ts b/lib/upload-store.ts
