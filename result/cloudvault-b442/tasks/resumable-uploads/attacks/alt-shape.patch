--- /dev/null
+++ b/lib/upload-store.ts
@@ -0,0 +1,38 @@
+import { IDLE_AFTER, type UploadSession } from "./upload-session"
+
+export interface SessionStore {
+    byId: Record<string, UploadSession>
+}
+
+export function createSessionStore(): SessionStore {
+    return { byId: {} }
+}
+
+function alive(session: UploadSession, now: number): boolean {
+    return now - session.lastSeen < IDLE_AFTER
+}
+
+export function openSession(store: SessionStore, session: UploadSession, now: number): void {
+    if (Object.prototype.hasOwnProperty.call(store.byId, session.id)) throw new Error("id in use")
+    const mine = listSessions(store, session.userId, now)
+    if (mine.length > 3) throw new Error("too many")
+    store.byId[session.id] = session
+}
+
+export function getSession(store: SessionStore, userId: string, id: string, now: number) {
+    const found = store.byId[id]
+    if (found === undefined) return null
+    return found.userId === userId && alive(found, now) ? found : null
+}
+
+export function listSessions(store: SessionStore, userId: string, now: number): UploadSession[] {
+    return Object.values(store.byId)
+        .filter((session) => session.userId === userId && alive(session, now))
+        .sort((a, b) => a.startedAt - b.startedAt)
+}
+
+export function sweepSessions(store: SessionStore, now: number): string[] {
+    const gone = Object.values(store.byId).filter((session) => !alive(session, now)).map((s) => s.id)
+    for (const id of gone) delete store.byId[id]
+    return gone.sort()
+}
