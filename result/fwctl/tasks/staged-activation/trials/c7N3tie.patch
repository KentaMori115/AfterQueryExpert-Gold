+pub fn stage(
+    args: &UpdateArgs,
+    target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let package = read_package(&args.package)?;
+    let trusted_key = TrustStore::new(&config.trust_store).load(&package.manifest.signing_key)?;
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target)?;
+    let device_id = selected.info.device_id.clone();
+    let chunk_size = transfer_chunk_size(args, config)?;
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        timeout.unwrap_or(config.default_timeout),
+        config.reconnect_timeout,
+        chunk_size,
+    );
+    let journal = StagingJournal::new(&config.staging_file);
+    let mut progress = Progress::new(output);
+    let staged = engine.stage(
+        &device_id,
+        &package,
+        &trusted_key,
+        UpdatePolicy {
+            allow_downgrade: args.allow_downgrade,
+        },
+        &journal,
+        |event| progress.observe(event),
+    )?;
+    output.success(
+        &staged,
+        format_args!(
+            "Staged {} for {}\n  Running firmware: {}\n  Target slot: {}\n  Image: {} bytes\n  Update id: {}\n  Staged at: {}\n  Run `fwctl activate` when a reboot is safe",
+            staged.new_version,
+            staged.device_id,
+            staged.old_version,
+            staged.target_slot,
+            staged.image_size,
+            staged.update_id,
+            staged.staged_at
+        ),
+    )
+}
+
+pub fn activate(
+    target: &DeviceTarget,
+    global_target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target.device.as_deref().or(global_target))?;
+    let device_id = selected.info.device_id.clone();
+    let journal = StagingJournal::new(&config.staging_file);
+    let mut history = journal.get(&device_id)?.as_ref().map(history_record);
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        timeout.unwrap_or(config.default_timeout),
+        config.reconnect_timeout,
+        config.chunk_size,
+    );
+    let mut progress = Progress::new(output);
+    let activation = engine.activate(&device_id, &journal, |event| progress.observe(event));
+    let report = match activation {
+        Ok(report) => {
+            if let Some(history) = history.as_mut() {
+                history.result = HistoryResult::Completed;
+                history.duration_ms = report.duration_ms;
+            }
+            report
+        }
+        Err(err) => {
+            if let Some(history) = history.as_mut() {
+                record_failure(history, &err);
+                append_history(config, history, output);
+            }
+            return Err(err);
+        }
+    };
+    if let Some(history) = history.as_ref() {
+        append_history(config, history, output);
+    }
+    output.success(
+        &report,
+        format_args!(
+            "Activated {} on {}\n  Previous firmware: {}\n  Active slot: {}\n  Image: {} bytes\n  Duration: {} ms",
+            report.new_version,
+            report.device_id,
+            report.old_version,
+            report.target_slot,
+            report.image_size,
+            report.duration_ms
+        ),
+    )
+}
+
+struct Progress<'a> {
+    output: &'a mut StdOutput,
+    last_state: UpdateState,
+    last_percent: u32,
+}
+
+impl<'a> Progress<'a> {
+    fn new(output: &'a mut StdOutput) -> Self {
+        Self {
+            output,
+            last_state: UpdateState::Idle,
+            last_percent: 0,
+        }
+    }
+
+    fn observe(&mut self, event: UpdateEvent) {
+        let percent = event
+            .bytes_transferred
+            .saturating_mul(100)
+            .checked_div(event.image_size)
+            .unwrap_or(0);
+        if event.state != self.last_state || percent >= self.last_percent.saturating_add(5) {
+            let _ = self
+                .output
+                .progress(format_args!("{:?}  {percent}%", event.state));
+            self.last_state = event.state;
+            self.last_percent = percent;
+        }
+    }
+}
+
+fn transfer_chunk_size(args: &UpdateArgs, config: &Config) -> Result<usize> {
+    let chunk_size = args.chunk_size.unwrap_or(config.chunk_size);
+    if (MIN_CHUNK_SIZE..=MAX_CHUNK_SIZE).contains(&chunk_size) {
+        Ok(chunk_size)
+    } else {
+        Err(FwctlError::Configuration(
+            "update chunk size must be between 256 and 16384 bytes".into(),
+        ))
+    }
+}
