+use std::fs::{self, File};
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+use crate::device::{Slot, UpdateId};
+use crate::package::ImageDigest;
+use crate::{FwctlError, Result};
+
+const MAX_STAGING_BYTES: u64 = 4 * 1024 * 1024;
+
+/// A firmware image that is already resident and verified in a device slot but
+/// has not been selected as the candidate, so the device still runs confirmed
+/// firmware.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StagedUpdate {
+    pub device_id: String,
+    pub product: String,
+    pub update_id: UpdateId,
+    pub old_version: String,
+    pub new_version: String,
+    pub target_slot: Slot,
+    pub image_size: u32,
+    pub image_digest: ImageDigest,
+    pub rollback_counter: u64,
+    pub confirmed_counter: u64,
+    pub signing_key: String,
+    pub staged_at: String,
+}
+
+/// Durable record of staged, not yet activated updates. At most one record is
+/// kept per device: staging again replaces the older record.
+#[derive(Debug, Clone)]
+pub struct StagingJournal {
+    path: PathBuf,
+}
+
+impl StagingJournal {
+    #[must_use]
+    pub fn new(path: impl Into<PathBuf>) -> Self {
+        Self { path: path.into() }
+    }
+
+    #[must_use]
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+
+    /// Every staged update, oldest first.
+    pub fn list(&self) -> Result<Vec<StagedUpdate>> {
+        if !self.path.exists() {
+            return Ok(Vec::new());
+        }
+        let file = File::open(&self.path).map_err(|err| FwctlError::io(&self.path, err))?;
+        let length = file
+            .metadata()
+            .map_err(|err| FwctlError::io(&self.path, err))?
+            .len();
+        if length > MAX_STAGING_BYTES {
+            return Err(FwctlError::Configuration(format!(
+                "staging journal exceeds {MAX_STAGING_BYTES} bytes"
+            )));
+        }
+        let mut records: Vec<StagedUpdate> = Vec::new();
+        for (line_index, line) in BufReader::new(file).lines().enumerate() {
+            let line = line.map_err(|err| FwctlError::io(&self.path, err))?;
+            if line.trim().is_empty() {
+                continue;
+            }
+            let record: StagedUpdate = serde_json::from_str(&line).map_err(|err| {
+                FwctlError::Configuration(format!(
+                    "invalid staged update at line {}: {err}",
+                    line_index + 1
+                ))
+            })?;
+            records.retain(|kept| kept.device_id != record.device_id);
+            records.push(record);
+        }
+        Ok(records)
+    }
+
+    /// The staged update held for one device, if any.
+    pub fn get(&self, device_id: &str) -> Result<Option<StagedUpdate>> {
+        Ok(self
+            .list()?
+            .into_iter()
+            .find(|record| record.device_id == device_id))
+    }
+
+    /// Store one staged update, replacing any older record for the same device.
+    pub fn record(&self, staged: &StagedUpdate) -> Result<()> {
+        let mut records = self.list()?;
+        records.retain(|kept| kept.device_id != staged.device_id);
+        records.push(staged.clone());
+        self.write(&records)
+    }
+
+    /// Drop the staged update held for one device and return it.
+    pub fn remove(&self, device_id: &str) -> Result<Option<StagedUpdate>> {
+        let mut records = self.list()?;
+        let Some(position) = records
+            .iter()
+            .position(|record| record.device_id == device_id)
+        else {
+            return Ok(None);
+        };
+        let removed = records.remove(position);
+        self.write(&records)?;
+        Ok(Some(removed))
+    }
+
+    fn write(&self, records: &[StagedUpdate]) -> Result<()> {
+        if let Some(parent) = self
+            .path
+            .parent()
+            .filter(|parent| !parent.as_os_str().is_empty())
+        {
+            fs::create_dir_all(parent).map_err(|err| FwctlError::io(parent, err))?;
+        }
+        let mut body = Vec::new();
+        for record in records {
+            serde_json::to_writer(&mut body, record)
+                .map_err(|err| FwctlError::Configuration(err.to_string()))?;
+            body.push(b'\n');
+        }
+        let temporary = self.path.with_extension("tmp");
+        {
+            let mut file =
+                File::create(&temporary).map_err(|err| FwctlError::io(&temporary, err))?;
+            file.write_all(&body)
+                .map_err(|err| FwctlError::io(&temporary, err))?;
+            file.sync_data()
+                .map_err(|err| FwctlError::io(&temporary, err))?;
+        }
+        fs::rename(&temporary, &self.path).map_err(|err| FwctlError::io(&self.path, err))
+    }
+}
+
