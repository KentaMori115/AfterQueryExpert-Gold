+#[test]
+fn staged_listing_reports_an_empty_journal() {
+    let dir = tempfile::tempdir().unwrap();
+    let config = dir.path().join("config.toml");
+    fs::write(&config, "staging_file = \"state/staging.jsonl\"\n").unwrap();
+    let config = config.to_str().unwrap();
+
+    let human = fwctl(&["--config", config, "staged"]);
+    assert!(human.status.success());
+    assert_eq!(
+        String::from_utf8(human.stdout).unwrap(),
+        "No staged firmware updates\n"
+    );
+
+    let machine = fwctl(&["--json", "--config", config, "staged"]);
+    assert!(machine.status.success());
+    let value: serde_json::Value = serde_json::from_slice(&machine.stdout).unwrap();
+    assert_eq!(value["staged"].as_array().unwrap().len(), 0);
