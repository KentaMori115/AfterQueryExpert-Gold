+
+pub fn stage(
+    args: &UpdateArgs,
+    target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let package = read_package(&args.package)?;
+    let trusted_key = TrustStore::new(&config.trust_store).load(&package.manifest.signing_key)?;
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target)?;
+    let device_id = selected.info.device_id.clone();
+    let chunk_size = transfer_chunk_size(args.chunk_size, config)?;
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        timeout.unwrap_or(config.default_timeout),
+        config.reconnect_timeout,
+        chunk_size,
+    );
+    let journal = StagingJournal::new(&config.staging_file);
+    let mut last_state = UpdateState::Idle;
+    let mut last_percent = 0_u32;
+    let staged = engine.stage(
+        &device_id,
+        &package,
+        &trusted_key,
+        UpdatePolicy {
+            allow_downgrade: args.allow_downgrade,
+        },
+        &journal,
+        |event| report_progress(output, event, &mut last_state, &mut last_percent),
+    )?;
+    output.success(
+        &staged,
+        format_args!(
+            "Staged {} on {} without rebooting\n  Running: {}\n  Target slot: {}\n  Image: {} bytes\n  Digest: {}\n  Staged at: {}\n  Activate with: fwctl --device {} activate",
+            staged.new_version,
+            staged.device_id,
+            staged.old_version,
+            staged.target_slot,
+            staged.image_size,
+            staged.image_digest,
+            staged.staged_at,
+            staged.device_id
+        ),
+    )
+}
+
+pub fn activate(
+    target: &DeviceTarget,
+    global_target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target.device.as_deref().or(global_target))?;
+    let device_id = selected.info.device_id.clone();
+    let journal = StagingJournal::new(&config.staging_file);
+    let mut history = journal.get(&device_id)?.map(|staged| {
+        HistoryRecord::now(
+            staged.device_id.clone(),
+            staged.product.clone(),
+            staged.old_version.clone(),
+            staged.new_version.clone(),
+            staged.image_digest.to_hex(),
+            staged.signing_key.clone(),
+        )
+    });
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        timeout.unwrap_or(config.default_timeout),
+        config.reconnect_timeout,
+        config.chunk_size,
+    );
+    let mut last_state = UpdateState::Idle;
+    let mut last_percent = 0_u32;
+    let started = Instant::now();
+    let activate_result = engine.activate(&device_id, &journal, |event| {
+        report_progress(output, event, &mut last_state, &mut last_percent);
+    });
+    if let Some(record) = history.as_mut() {
+        record.duration_ms = started.elapsed().as_millis();
+    }
+    let report = match activate_result {
+        Ok(report) => {
+            if let Some(record) = history.as_mut() {
+                record.result = HistoryResult::Completed;
+                record.duration_ms = report.duration_ms;
+            }
+            report
+        }
+        Err(err) => {
+            if let Some(record) = history.as_mut() {
+                record.error_category = Some(err.category());
+                if matches!(err, FwctlError::AutomaticRollback) {
+                    record.result = HistoryResult::RolledBack;
+                    record.rollback_result = Some("automatic rollback completed".into());
+                }
+            }
+            if let Some(record) = history.as_ref() {
+                append_history(config, record, output);
+            }
+            return Err(err);
+        }
+    };
+    if let Some(record) = history.as_ref() {
+        append_history(config, record, output);
+    }
+    output.success(
+        &report,
+        format_args!(
+            "Activated {} on {} from {}\n  Active slot: {}\n  Image: {} bytes\n  Duration: {} ms",
+            report.new_version,
+            report.device_id,
+            report.old_version,
+            report.target_slot,
+            report.image_size,
+            report.duration_ms
+        ),
+    )
+}
+
+pub fn staged(config: &Config, output: &mut StdOutput) -> Result<()> {
+    let records = StagingJournal::new(&config.staging_file).list()?;
+    let human = render_staged(&records);
+    output.success(&StagedOutput { staged: records }, format_args!("{human}"))
+}
+
+fn render_staged(records: &[StagedUpdate]) -> String {
+    if records.is_empty() {
+        return "No staged firmware updates".into();
+    }
+    let mut lines = String::from(
+        "STAGED AT                       DEVICE              UPDATE                 SLOT\n",
+    );
+    for record in records {
+        let _ = writeln!(
+            lines,
+            "{:<31} {:<19} {:<22} {}",
+            record.staged_at,
+            record.device_id,
+            format!("{} -> {}", record.old_version, record.new_version),
+            record.target_slot
+        );
+    }
+    lines.pop();
+    lines
+}
+
+fn transfer_chunk_size(requested: Option<usize>, config: &Config) -> Result<usize> {
+    let chunk_size = requested.unwrap_or(config.chunk_size);
+    if (256..=16 * 1024).contains(&chunk_size) {
+        Ok(chunk_size)
+    } else {
+        Err(FwctlError::Configuration(
+            "update chunk size must be between 256 and 16384 bytes".into(),
+        ))
+    }
+}
+
+fn report_progress(
+    output: &mut StdOutput,
+    event: UpdateEvent,
+    last_state: &mut UpdateState,
+    last_percent: &mut u32,
+) {
+    let percent = event
+        .bytes_transferred
+        .saturating_mul(100)
+        .checked_div(event.image_size)
+        .unwrap_or(0);
+    if event.state != *last_state || percent >= last_percent.saturating_add(5) {
+        let _ = output.progress(format_args!("{:?}  {percent}%", event.state));
+        *last_state = event.state;
+        *last_percent = percent;
+    }
+}
+
+#[derive(serde::Serialize)]
+struct StagedOutput {
+    staged: Vec<StagedUpdate>,
+}
