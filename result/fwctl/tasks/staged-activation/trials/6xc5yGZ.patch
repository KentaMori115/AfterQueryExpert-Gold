+fn validate_staged_device(
+    staged: &StagedUpdate,
+    info: &DeviceInfo,
+    status: &DeviceStatus,
+) -> Result<()> {
+    if info.product != staged.product {
+        return Err(FwctlError::StagedUpdateLost(format!(
+            "device now reports product `{}`, but the update was staged for `{}`",
+            info.product, staged.product
+        )));
+    }
+    if info.firmware_version != staged.old_version {
+        return Err(FwctlError::StagedUpdateLost(format!(
+            "device now runs firmware {}, but the update was staged against {}",
+            info.firmware_version, staged.old_version
+        )));
+    }
+    if info.rollback_counter != staged.confirmed_counter {
+        return Err(FwctlError::StagedUpdateLost(format!(
+            "device confirmed rollback counter is now {}, but it was {} when staged",
+            info.rollback_counter, staged.confirmed_counter
+        )));
+    }
+    if status.update_id != Some(staged.update_id) {
+        return Err(FwctlError::StagedUpdateLost(format!(
+            "device no longer holds staged transfer {}",
+            staged.update_id
+        )));
+    }
+    if status.accepted_offset != staged.image_size {
+        return Err(FwctlError::StagedUpdateLost(format!(
+            "device holds {} of {} staged image bytes",
+            status.accepted_offset, staged.image_size
+        )));
+    }
+    Ok(())
