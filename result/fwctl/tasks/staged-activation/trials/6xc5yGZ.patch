+use std::time::Duration;
+
+use fwctl_core::crypto::SigningIdentity;
+use fwctl_core::device::{Slot, UpdateId, UpdateState as DeviceState};
+use fwctl_core::package::{FirmwareManifest, FirmwarePackage, digest_bytes};
+use fwctl_core::update::{StagedUpdate, StagingJournal, UpdateEngine, UpdatePolicy, UpdateState};
+use fwctl_core::{ErrorCategory, FwctlError};
+use fwctl_sim::{Simulator, SimulatorConfig, SimulatorConnector, SimulatorTrustedKey};
+
+fn signed_package(signer: &SigningIdentity, image_len: usize, version: &str) -> FirmwarePackage {
+    let image = (0..image_len)
+        .map(|offset| u8::try_from(offset % 251).unwrap())
+        .collect::<Vec<_>>();
+    let manifest = FirmwareManifest::new(
+        "sensor-node".into(),
+        version.into(),
+        vec!["A1".into()],
+        image.len() as u64,
+        digest_bytes(&image),
+        2,
+        signer.key_id().into(),
+    )
+    .unwrap();
+    let signature = signer.sign_manifest(&manifest).unwrap();
+    FirmwarePackage {
+        manifest,
+        image,
+        signature,
+        release_notes: None,
+    }
+}
+
+fn engine(simulator: Simulator) -> UpdateEngine<SimulatorConnector> {
+    UpdateEngine::new(
+        SimulatorConnector::new(simulator),
+        Duration::from_millis(30),
+        Duration::from_secs(1),
+        512,
+    )
+}
+
+fn simulator(signer: &SigningIdentity) -> Simulator {
+    let config = SimulatorConfig {
+        trusted_keys: vec![SimulatorTrustedKey {
+            key_id: signer.key_id().into(),
+            public_key: signer.public_key().to_bytes(),
+        }],
+        ..SimulatorConfig::default()
+    };
+    Simulator::new(config).unwrap()
+}
+
+fn journal() -> (tempfile::TempDir, StagingJournal) {
+    let dir = tempfile::tempdir().unwrap();
+    let journal = StagingJournal::new(dir.path().join("state/staging.jsonl"));
+    (dir, journal)
+}
+
+#[test]
+fn staging_verifies_image_without_touching_boot_state() {
+    let signer = SigningIdentity::from_seed("release", [0x11; 32]);
+    let package = signed_package(&signer, 4096, "1.1.0");
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+    let mut states = Vec::new();
+
+    let staged = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |event| states.push(event.state),
+        )
+        .unwrap();
+
+    assert_eq!(engine.state(), UpdateState::Staged);
+    assert!(states.contains(&UpdateState::Verifying));
+    assert!(states.contains(&UpdateState::Staged));
+    assert!(!states.contains(&UpdateState::CandidateSet));
+    assert!(!states.contains(&UpdateState::Rebooting));
+
+    assert_eq!(staged.device_id, "sim-0001");
+    assert_eq!(staged.product, "sensor-node");
+    assert_eq!(staged.old_version, "1.0.0");
+    assert_eq!(staged.new_version, "1.1.0");
+    assert_eq!(staged.target_slot, Slot::B);
+    assert_eq!(staged.image_size, 4096);
+    assert_eq!(staged.image_digest, package.manifest.image.sha256);
+    assert_eq!(staged.rollback_counter, 2);
+    assert_eq!(staged.confirmed_counter, 1);
+    assert_eq!(staged.signing_key, "release");
+    assert!(!staged.staged_at.is_empty());
+
+    assert_eq!(journal.list().unwrap(), vec![staged.clone()]);
+    assert_eq!(journal.get("sim-0001").unwrap().unwrap(), staged);
+
+    let simulator = engine.into_connector().shutdown();
+    assert!(simulator.info().candidate_slot.is_none());
+    assert_eq!(simulator.info().active_slot, Slot::A);
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+    assert_eq!(simulator.info().rollback_counter, 1);
+    assert_eq!(simulator.status().accepted_offset, 4096);
+}
+
+#[test]
+fn activation_finishes_a_staged_update_from_the_journal() {
+    let signer = SigningIdentity::from_seed("release", [0x12; 32]);
+    let package = signed_package(&signer, 2048, "1.1.0");
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+    engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+
+    let mut states = Vec::new();
+    let report = engine
+        .activate("sim-0001", &journal, |event| states.push(event.state))
+        .unwrap();
+
+    assert_eq!(report.state, UpdateState::Completed);
+    assert_eq!(engine.state(), UpdateState::Completed);
+    assert_eq!(report.device_id, "sim-0001");
+    assert_eq!(report.old_version, "1.0.0");
+    assert_eq!(report.new_version, "1.1.0");
+    assert_eq!(report.target_slot, Slot::B);
+    assert_eq!(report.image_size, 2048);
+    assert!(states.contains(&UpdateState::CandidateSet));
+    assert!(states.contains(&UpdateState::Confirming));
+    assert!(journal.list().unwrap().is_empty());
+
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.1.0");
+    assert_eq!(simulator.info().active_slot, Slot::B);
+    assert_eq!(simulator.info().rollback_counter, 2);
+    assert_eq!(simulator.info().update_state, DeviceState::Confirmed);
+    assert!(simulator.info().candidate_slot.is_none());
+}
+
+#[test]
+fn device_digest_mismatch_stages_nothing() {
+    let signer = SigningIdentity::from_seed("release", [0x13; 32]);
+    let package = signed_package(&signer, 1024, "1.1.0");
+    let (_dir, journal) = journal();
+    let mut simulator = simulator(&signer);
+    simulator.faults_mut().force_verify_failure = true;
+    let mut engine = engine(simulator);
+
+    let err = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap_err();
+
+    assert!(matches!(err, FwctlError::ImageVerificationFailed));
+    assert_eq!(engine.state(), UpdateState::Failed);
+    assert!(journal.list().unwrap().is_empty());
+    let simulator = engine.into_connector().shutdown();
+    assert!(simulator.info().candidate_slot.is_none());
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+}
+
+#[test]
+fn policy_rejection_stages_nothing() {
+    let signer = SigningIdentity::from_seed("release", [0x14; 32]);
+    let mut package = signed_package(&signer, 512, "0.9.0");
+    package.signature = signer.sign_manifest(&package.manifest).unwrap();
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+
+    let err = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap_err();
+
+    assert_eq!(err.category(), ErrorCategory::DowngradeRejected);
+    assert!(journal.list().unwrap().is_empty());
+    let simulator = engine.into_connector().shutdown();
+    assert!(simulator.info().candidate_slot.is_none());
+    assert_eq!(simulator.status().accepted_offset, 0);
+}
+
+#[test]
+fn activation_without_a_record_reports_nothing_staged() {
+    let signer = SigningIdentity::from_seed("release", [0x15; 32]);
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
+
+    assert!(matches!(err, FwctlError::NothingStaged(_)));
+    assert_eq!(err.category(), ErrorCategory::NothingStaged);
+    let simulator = engine.into_connector().shutdown();
+    assert!(simulator.info().candidate_slot.is_none());
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+}
+
+#[test]
+fn diverged_device_loses_the_staged_update_before_reboot() {
+    let signer = SigningIdentity::from_seed("release", [0x16; 32]);
+    let package = signed_package(&signer, 1024, "1.1.0");
+
+    let mutations: Vec<(&str, fn(&mut StagedUpdate))> = vec![
+        ("product", |staged| staged.product = "motor-drive".into()),
+        ("running version", |staged| {
+            staged.old_version = "1.0.1".into();
+        }),
+        ("rollback counter", |staged| staged.confirmed_counter = 9),
+        ("held transfer", |staged| {
+            staged.update_id = UpdateId::from_bytes([0xcd; 16]);
+        }),
+        ("accepted bytes", |staged| staged.image_size += 512),
+    ];
+
+    for (name, mutate) in mutations {
+        let (_dir, journal) = journal();
+        let mut engine = engine(simulator(&signer));
+        let mut staged = engine
+            .stage(
+                "sim-0001",
+                &package,
+                &signer.public_key(),
+                UpdatePolicy::default(),
+                &journal,
+                |_| {},
+            )
+            .unwrap();
+        mutate(&mut staged);
+        journal.record(&staged).unwrap();
+
+        let mut states = Vec::new();
+        let err = engine
+            .activate("sim-0001", &journal, |event| states.push(event.state))
+            .unwrap_err();
+
+        assert!(
+            matches!(err, FwctlError::StagedUpdateLost(_)),
+            "{name}: {err}"
+        );
+        assert_eq!(err.category(), ErrorCategory::StagedUpdateLost);
+        assert!(!states.contains(&UpdateState::CandidateSet), "{name}");
+        assert!(!states.contains(&UpdateState::Rebooting), "{name}");
+        assert!(journal.list().unwrap().is_empty(), "{name}");
+
+        let simulator = engine.into_connector().shutdown();
+        assert!(simulator.info().candidate_slot.is_none(), "{name}");
+        assert_eq!(simulator.info().firmware_version, "1.0.0", "{name}");
+        assert_eq!(simulator.info().active_slot, Slot::A, "{name}");
+    }
+}
+
+#[test]
+fn staging_twice_keeps_only_the_newest_record_per_device() {
+    let signer = SigningIdentity::from_seed("release", [0x17; 32]);
+    let first = signed_package(&signer, 1024, "1.1.0");
+    let second = signed_package(&signer, 1536, "1.2.0");
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+
+    engine
+        .stage(
+            "sim-0001",
+            &first,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    let newest = engine
+        .stage(
+            "sim-0001",
+            &second,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+
+    assert_eq!(journal.list().unwrap(), vec![newest.clone()]);
+    assert_eq!(newest.new_version, "1.2.0");
+
+    let report = engine.activate("sim-0001", &journal, |_| {}).unwrap();
+    assert_eq!(report.new_version, "1.2.0");
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.2.0");
+}
+
+#[test]
+fn staged_image_survives_a_power_cycle_before_activation() {
+    let signer = SigningIdentity::from_seed("release", [0x18; 32]);
+    let package = signed_package(&signer, 1024, "1.1.0");
+    let (_dir, journal) = journal();
+    let mut staging = engine(simulator(&signer));
+    staging
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+
+    let mut simulator = staging.into_connector().shutdown();
+    simulator
+        .handle(fwctl_core::protocol::ProtocolMessage::Reboot)
+        .unwrap();
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+
+    let mut resumed = engine(simulator);
+    let report = resumed.activate("sim-0001", &journal, |_| {}).unwrap();
+    assert_eq!(report.state, UpdateState::Completed);
+    let simulator = resumed.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.1.0");
+    assert_eq!(simulator.info().active_slot, Slot::B);
+}
