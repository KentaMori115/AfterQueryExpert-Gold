+fn confirm_staged_image(
+    staged: &StagedUpdate,
+    info: &DeviceInfo,
+    status: &DeviceStatus,
+) -> Result<()> {
+    if info.product != staged.product {
+        return Err(FwctlError::StagedUpdateLost(format!(
+            "device `{}` now reports product `{}`, staged for `{}`",
+            staged.device_id, info.product, staged.product
+        )));
+    }
+    if info.firmware_version != staged.old_version {
+        return Err(FwctlError::StagedUpdateLost(format!(
+            "device `{}` now runs firmware {}, staged against {}",
+            staged.device_id, info.firmware_version, staged.old_version
+        )));
+    }
+    if info.rollback_counter != staged.confirmed_counter {
+        return Err(FwctlError::StagedUpdateLost(format!(
+            "device `{}` now reports rollback counter {}, staged at {}",
+            staged.device_id, info.rollback_counter, staged.confirmed_counter
+        )));
+    }
+    if status.update_id != Some(staged.update_id) {
+        return Err(FwctlError::StagedUpdateLost(format!(
+            "device `{}` no longer holds staged update {}",
+            staged.device_id, staged.update_id
+        )));
+    }
+    if status.accepted_offset != staged.image_size {
+        return Err(FwctlError::StagedUpdateLost(format!(
+            "device `{}` accepted {} of {} staged bytes",
+            staged.device_id, status.accepted_offset, staged.image_size
+        )));
+    }
+    Ok(())
+}
