diff --git a/crates/fwctl/src/commands/stage.rs b/crates/fwctl/src/commands/stage.rs
new file mode 100644
index 0000000..404ee9d
--- /dev/null
+++ b/crates/fwctl/src/commands/stage.rs
@@ -0,0 +1,250 @@
+use std::fmt::Write as _;
+use std::time::Duration;
+
+use fwctl_core::crypto::TrustStore;
+use fwctl_core::device::discover_serial_devices;
+use fwctl_core::history::{HistoryRecord, HistoryResult, HistoryStore};
+use fwctl_core::package::read_package;
+use fwctl_core::transport::SerialConnector;
+use fwctl_core::update::{
+    StagedUpdate, StagingJournal, UpdateEngine, UpdateEvent, UpdatePolicy, UpdateState,
+};
+use fwctl_core::{Config, FwctlError, Result};
+use serde::Serialize;
+
+use crate::cli::{DeviceTarget, UpdateArgs};
+use crate::commands::device::{probe_timeout, select_device};
+use crate::output::StdOutput;
+
+#[derive(Serialize)]
+struct StagedList {
+    staged: Vec<StagedUpdate>,
+}
+
+pub fn stage(
+    args: &UpdateArgs,
+    target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let package = read_package(&args.package)?;
+    let trusted_key = TrustStore::new(&config.trust_store).load(&package.manifest.signing_key)?;
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target)?;
+    let device_id = selected.info.device_id.clone();
+    let chunk_size = chunk_size(args, config)?;
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        timeout.unwrap_or(config.default_timeout),
+        config.reconnect_timeout,
+        chunk_size,
+    );
+    let journal = StagingJournal::new(&config.staging_file);
+    let mut reporter = ProgressReporter::default();
+    let staged = engine.stage(
+        &device_id,
+        &package,
+        &trusted_key,
+        UpdatePolicy {
+            allow_downgrade: args.allow_downgrade,
+        },
+        &journal,
+        |event| reporter.observe(event, output),
+    )?;
+    output.success(
+        &staged,
+        format_args!(
+            "Staged {} for {}\n  Slot: {}\n  Version: {} -> {}\n  Image: {} bytes\n  Staged at: {}\n  Activate with: fwctl --device {} activate",
+            staged.new_version,
+            staged.device_id,
+            staged.target_slot,
+            staged.old_version,
+            staged.new_version,
+            staged.image_size,
+            staged.staged_at,
+            staged.device_id
+        ),
+    )
+}
+
+pub fn activate(
+    target: &DeviceTarget,
+    global_target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let journal = StagingJournal::new(&config.staging_file);
+    let device_id = match target.device.as_deref().or(global_target) {
+        Some(device_id) => device_id.to_string(),
+        None => only_staged_device(&journal)?,
+    };
+    let staged = journal.get(&device_id)?;
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        timeout.unwrap_or(config.default_timeout),
+        config.reconnect_timeout,
+        config.chunk_size,
+    );
+    let mut reporter = ProgressReporter::default();
+    let result = engine.activate(&device_id, &journal, |event| {
+        reporter.observe(event, output);
+    });
+    if let Some(staged) = staged {
+        record_history(config, &staged, &result, output);
+    }
+    let report = result?;
+    output.success(
+        &report,
+        format_args!(
+            "Updated {} from {} to {}\n  Active slot: {}\n  Image: {} bytes\n  Duration: {} ms",
+            report.device_id,
+            report.old_version,
+            report.new_version,
+            report.target_slot,
+            report.image_size,
+            report.duration_ms
+        ),
+    )
+}
+
+pub fn list(config: &Config, output: &mut StdOutput) -> Result<()> {
+    let staged = StagingJournal::new(&config.staging_file).list()?;
+    let human = render(&staged);
+    output.success(&StagedList { staged }, format_args!("{human}"))
+}
+
+fn only_staged_device(journal: &StagingJournal) -> Result<String> {
+    let mut staged = journal.list()?;
+    if staged.len() > 1 {
+        return Err(FwctlError::Configuration(
+            "several devices hold staged updates, select one with --device".into(),
+        ));
+    }
+    let Some(staged) = staged.pop() else {
+        return Err(FwctlError::NothingStaged("any device".into()));
+    };
+    Ok(staged.device_id)
+}
+
+fn chunk_size(args: &UpdateArgs, config: &Config) -> Result<usize> {
+    let chunk_size = args.chunk_size.unwrap_or(config.chunk_size);
+    if (256..=16 * 1024).contains(&chunk_size) {
+        Ok(chunk_size)
+    } else {
+        Err(FwctlError::Configuration(
+            "update chunk size must be between 256 and 16384 bytes".into(),
+        ))
+    }
+}
+
+fn record_history(
+    config: &Config,
+    staged: &StagedUpdate,
+    result: &Result<fwctl_core::update::UpdateReport>,
+    output: &mut StdOutput,
+) {
+    let mut record = HistoryRecord::now(
+        staged.device_id.clone(),
+        staged.product.clone(),
+        staged.old_version.clone(),
+        staged.new_version.clone(),
+        staged.image_digest.to_hex(),
+        staged.signing_key.clone(),
+    );
+    match result {
+        Ok(report) => {
+            record.result = HistoryResult::Completed;
+            record.duration_ms = report.duration_ms;
+        }
+        Err(err) => {
+            record.error_category = Some(err.category());
+            if matches!(err, FwctlError::AutomaticRollback) {
+                record.result = HistoryResult::RolledBack;
+                record.rollback_result = Some("automatic rollback completed".into());
+            }
+        }
+    }
+    if let Err(err) = HistoryStore::new(&config.history_file).append(&record) {
+        let _ = output.warning(format_args!("could not record update history: {err}"));
+    }
+}
+
+fn render(staged: &[StagedUpdate]) -> String {
+    if staged.is_empty() {
+        return "No staged firmware updates".into();
+    }
+    let mut lines = String::from(
+        "STAGED AT                       DEVICE              UPDATE                 SLOT\n",
+    );
+    for record in staged.iter().rev() {
+        let _ = writeln!(
+            lines,
+            "{:<31} {:<19} {:<22} {}",
+            record.staged_at,
+            record.device_id,
+            format!("{} -> {}", record.old_version, record.new_version),
+            record.target_slot
+        );
+    }
+    lines.pop();
+    lines
+}
+
+#[derive(Default)]
+struct ProgressReporter {
+    last_state: Option<UpdateState>,
+    last_percent: u32,
+}
+
+impl ProgressReporter {
+    fn observe(&mut self, event: UpdateEvent, output: &mut StdOutput) {
+        let percent = event
+            .bytes_transferred
+            .saturating_mul(100)
+            .checked_div(event.image_size)
+            .unwrap_or(0);
+        if self.last_state != Some(event.state) || percent >= self.last_percent.saturating_add(5) {
+            let _ = output.progress(format_args!("{:?}  {percent}%", event.state));
+            self.last_state = Some(event.state);
+            self.last_percent = percent;
+        }
+    }
+}
+
