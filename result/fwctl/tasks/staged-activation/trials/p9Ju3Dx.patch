+    /// Activate an update staged earlier. The journal record is consumed
+    /// whatever the outcome.
+    pub fn activate(
+        &mut self,
+        device_id: &str,
+        journal: &StagingJournal,
+        mut observe: impl FnMut(UpdateEvent),
+    ) -> Result<UpdateReport> {
+        let started = Instant::now();
+        let staged = journal
+            .remove(device_id)?
+            .ok_or_else(|| FwctlError::NothingStaged(format!("device `{device_id}`")))?;
+        match self.activate_inner(device_id, &staged, &mut observe) {
+            Ok(mut report) => {
+                report.duration_ms = started.elapsed().as_millis();
+                Ok(report)
+            }
+            Err(err) => {
+                if matches!(err, FwctlError::AutomaticRollback) {
+                    self.state = UpdateState::RolledBack;
+                } else {
+                    self.state = UpdateState::Failed;
+                }
+                Err(err)
+            }
+        }
+    }
