+            update_id: UpdateId::from_bytes([3; 16]),
+            old_version: "1.0.0".into(),
+            new_version: version.into(),
+            target_slot: Slot::B,
+            image_size: 1024,
+            image_digest: digest_bytes(b"image"),
+            rollback_counter: 5,
+            confirmed_counter: 4,
+            signing_key: "release".into(),
+            staged_at: format!("2026-08-31T10:00:0{version}Z"),
+        }
+    }
+
+    #[test]
+    fn renders_empty_journal() {
+        assert_eq!(render(&[]), "No staged firmware updates");
+    }
+
+    #[test]
+    fn renders_newest_record_first() {
+        let text = render(&[staged("board-a", "1"), staged("board-b", "2")]);
+        assert!(text.find("board-b").unwrap() < text.find("board-a").unwrap());
+    }
+}
