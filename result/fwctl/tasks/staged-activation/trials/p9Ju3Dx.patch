+#[test]
+fn moved_device_state_loses_the_staged_update_before_boot_state_moves() {
+    let signer = SigningIdentity::from_seed("release", [0x61; 32]);
+    let package = signed_package(&signer, 1536);
+
+    for mutate in [
+        |staged: &mut fwctl_core::update::StagedUpdate| staged.product = "motor-drive".into(),
+        |staged: &mut fwctl_core::update::StagedUpdate| staged.old_version = "0.9.0".into(),
+        |staged: &mut fwctl_core::update::StagedUpdate| staged.confirmed_counter = 9,
+        |staged: &mut fwctl_core::update::StagedUpdate| {
+            staged.update_id = fwctl_core::device::UpdateId::from_bytes([0xcd; 16]);
+        },
+        |staged: &mut fwctl_core::update::StagedUpdate| staged.image_size = 512,
+    ] {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = journal(&dir);
+        let mut engine = engine(simulator(&signer));
+        let mut staged = engine
+            .stage(
+                "sim-0001",
+                &package,
+                &signer.public_key(),
+                UpdatePolicy::default(),
+                &journal,
+                |_| {},
+            )
+            .unwrap();
+        mutate(&mut staged);
+        journal.record(&staged).unwrap();
+
+        let mut states = Vec::new();
+        let err = engine
+            .activate("sim-0001", &journal, |event| states.push(event.state))
+            .unwrap_err();
+        assert_eq!(err.category(), ErrorCategory::StagedUpdateLost);
+        assert!(!states.contains(&UpdateState::CandidateSet));
+        assert!(!states.contains(&UpdateState::Rebooting));
+        assert!(
+            journal.list().unwrap().is_empty(),
+            "the record is consumed whatever the outcome"
+        );
+
+        let simulator = engine.into_connector().shutdown();
+        assert!(simulator.info().candidate_slot.is_none());
+        assert_eq!(simulator.info().firmware_version, "1.0.0");
+    }
+}
