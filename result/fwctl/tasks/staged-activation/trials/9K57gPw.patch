+#[test]
+fn policy_rejection_stages_nothing() {
+    let signer = SigningIdentity::from_seed("release", [0x41; 32]);
+    let mut update = package(&signer, "0.9.0", 2, 1024, 0);
+    update.signature = signer.sign_manifest(&update.manifest).unwrap();
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+
+    let err = engine
+        .stage(
+            "sim-0001",
+            &update,
+            &signer.public_key(),
+            UpdatePolicy::default(),
