+/// Transfers and verifies an image, leaving the device on its confirmed
+/// firmware until `fwctl activate` is run.
+pub fn stage(
+    args: &UpdateArgs,
+    target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let package = read_package(&args.package)?;
+    let trusted_key = TrustStore::new(&config.trust_store).load(&package.manifest.signing_key)?;
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target)?;
+    let device_id = selected.info.device_id.clone();
+    let chunk_size = resolve_chunk_size(args.chunk_size, config)?;
+    let response_timeout = timeout.unwrap_or(config.default_timeout);
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        response_timeout,
+        config.reconnect_timeout,
+        chunk_size,
+    );
+    let journal = StagingJournal::new(&config.staging_file);
+    let mut last_state = UpdateState::Idle;
+    let mut last_percent = 0_u32;
+    let staged = engine.stage(
+        &device_id,
+        &package,
+        &trusted_key,
+        UpdatePolicy {
+            allow_downgrade: args.allow_downgrade,
+        },
+        &journal,
+        |event| {
+            let percent = event
+                .bytes_transferred
+                .saturating_mul(100)
+                .checked_div(event.image_size)
+                .unwrap_or(0);
+            if event.state != last_state || percent >= last_percent.saturating_add(5) {
+                let _ = output.progress(format_args!("{:?}  {percent}%", event.state));
+                last_state = event.state;
+                last_percent = percent;
+            }
+        },
+    )?;
+    output.success(
+        &staged,
+        format_args!(
+            "Staged {} for {} (still running {})\n  Target slot: {}\n  Image: {} bytes\n  Digest: {}\n  Staged at: {}\n  Activate with: fwctl activate {}",
+            staged.new_version,
+            staged.device_id,
+            staged.old_version,
+            staged.target_slot,
+            staged.image_size,
+            staged.image_digest,
+            staged.staged_at,
+            staged.device_id
+        ),
+    )
+}
+
+/// Selects, reboots into and confirms an image staged earlier.
+pub fn activate(
+    args: &DeviceTarget,
+    target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let journal = StagingJournal::new(&config.staging_file);
+    let requested = args.device.as_deref().or(target);
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, requested)?;
+    let device_id = selected.info.device_id.clone();
+    let staged = journal
+        .get(&device_id)?
+        .ok_or_else(|| FwctlError::NothingStaged(device_id.clone()))?;
+    let response_timeout = timeout.unwrap_or(config.default_timeout);
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        response_timeout,
+        config.reconnect_timeout,
+        config.chunk_size,
+    );
+    let mut history = HistoryRecord::now(
+        device_id.clone(),
+        staged.product.clone(),
+        staged.old_version.clone(),
+        staged.new_version.clone(),
+        staged.image_digest.to_hex(),
+        staged.signing_key.clone(),
+    );
+    let mut last_state = UpdateState::Idle;
+    let started = Instant::now();
+    let activate_result = engine.activate(&device_id, &journal, |event| {
+        if event.state != last_state {
+            let _ = output.progress(format_args!("{:?}", event.state));
+            last_state = event.state;
+        }
+    });
+    history.duration_ms = started.elapsed().as_millis();
+    let report = match activate_result {
+        Ok(report) => {
+            history.result = HistoryResult::Completed;
+            history.duration_ms = report.duration_ms;
+            report
+        }
+        Err(err) => {
+            history.error_category = Some(err.category());
+            if matches!(err, FwctlError::AutomaticRollback) {
+                history.result = HistoryResult::RolledBack;
+                history.rollback_result = Some("automatic rollback completed".into());
+            }
+            append_history(config, &history, output);
+            return Err(err);
+        }
+    };
+    append_history(config, &history, output);
+    output.success(
+        &report,
+        format_args!(
+            "Activated {} on {} (was {})\n  Active slot: {}\n  Image: {} bytes\n  Duration: {} ms",
+            report.new_version,
+            report.device_id,
+            report.old_version,
+            report.target_slot,
+            report.image_size,
+            report.duration_ms
+        ),
+    )
+}
+
+/// Lists the images waiting for activation.
+pub fn staged(config: &Config, output: &mut StdOutput) -> Result<()> {
+    let records = StagingJournal::new(&config.staging_file).list()?;
+    let human = render_staged(&records);
+    output.success(&StagedOutput { records }, format_args!("{human}"))
+}
+
+#[derive(Serialize)]
+struct StagedOutput {
+    records: Vec<StagedUpdate>,
+}
+
+fn render_staged(records: &[StagedUpdate]) -> String {
+    if records.is_empty() {
+        return "No staged firmware updates".into();
+    }
+    let mut lines = String::from(
+        "STAGED AT                       DEVICE              UPDATE                 SLOT\n",
+    );
+    for record in records {
+        let _ = writeln!(
+            lines,
+            "{:<31} {:<19} {:<22} {}",
+            record.staged_at,
+            record.device_id,
+            format!("{} -> {}", record.old_version, record.new_version),
+            record.target_slot
+        );
+    }
+    lines.pop();
+    lines
+}
+
+fn resolve_chunk_size(requested: Option<usize>, config: &Config) -> Result<usize> {
+    let chunk_size = requested.unwrap_or(config.chunk_size);
+    if (256..=16 * 1024).contains(&chunk_size) {
+        Ok(chunk_size)
+    } else {
+        Err(FwctlError::Configuration(
+            "update chunk size must be between 256 and 16384 bytes".into(),
+        ))
+    }
+}
+
 fn append_history(config: &Config, record: &HistoryRecord, output: &mut StdOutput) {
     if let Err(err) = HistoryStore::new(&config.history_file).append(record) {
         let _ = output.warning(format_args!("could not record update history: {err}"));
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use fwctl_core::device::{Slot, UpdateId};
+    use fwctl_core::package::ImageDigest;
+
+    use super::*;
+
+    #[test]
+    fn renders_placeholder_without_staged_updates() {
+        assert_eq!(render_staged(&[]), "No staged firmware updates");
+    }
+
+    #[test]
+    fn renders_staged_rows_oldest_first() {
+        let record = |device_id: &str, staged_at: &str| StagedUpdate {
+            device_id: device_id.into(),
+            product: "sensor-node".into(),
+            update_id: UpdateId::from_bytes([1; 16]),
+            old_version: "1.0.0".into(),
+            new_version: "1.1.0".into(),
+            target_slot: Slot::B,
+            image_size: 2048,
+            image_digest: ImageDigest::from_bytes([2; 32]),
+            rollback_counter: 3,
+            confirmed_counter: 2,
+            signing_key: "release".into(),
+            staged_at: staged_at.into(),
+        };
+        let rendered = render_staged(&[
+            record("board-a", "2026-08-31T10:00:00Z"),
+            record("board-b", "2026-08-31T11:00:00Z"),
+        ]);
+        let lines = rendered.lines().collect::<Vec<_>>();
+        assert_eq!(lines.len(), 3);
+        assert!(lines[1].contains("board-a"));
+        assert!(lines[2].contains("board-b"));
+    }
+
+    #[test]
+    fn rejects_chunk_sizes_outside_the_protocol_window() {
+        let config = Config::default();
+        assert!(resolve_chunk_size(Some(64), &config).is_err());
+        assert_eq!(resolve_chunk_size(Some(512), &config).unwrap(), 512);
+        assert_eq!(resolve_chunk_size(None, &config).unwrap(), config.chunk_size);
+    }
+}
