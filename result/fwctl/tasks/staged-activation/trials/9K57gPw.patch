+++ b/crates/fwctl-core/src/update/staging.rs
@@ -0,0 +1,242 @@
+use std::fs::{self, File};
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+use crate::device::{Slot, UpdateId};
+use crate::package::ImageDigest;
+use crate::update::UpdatePlan;
+use crate::{FwctlError, Result};
+
+const MAX_STAGING_BYTES: u64 = 4 * 1024 * 1024;
+
+/// A firmware image that lives in a device's inactive slot, verified but not
+/// yet selected as the boot candidate.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StagedUpdate {
+    pub device_id: String,
+    pub product: String,
+    pub update_id: UpdateId,
+    pub old_version: String,
+    pub new_version: String,
+    pub target_slot: Slot,
+    pub image_size: u32,
+    pub image_digest: ImageDigest,
+    pub rollback_counter: u64,
+    pub confirmed_counter: u64,
+    pub signing_key: String,
+    pub staged_at: String,
+}
+
+impl StagedUpdate {
+    /// Rebuilds the plan the staging run validated, so activation can finish
+    /// the update from the journal alone.
+    #[must_use]
+    pub fn plan(&self) -> UpdatePlan {
+        UpdatePlan {
+            device_id: self.device_id.clone(),
+            product: self.product.clone(),
+            old_version: self.old_version.clone(),
+            new_version: self.new_version.clone(),
+            target_slot: self.target_slot,
+            image_size: self.image_size,
+            image_digest: self.image_digest,
+            rollback_counter: self.rollback_counter,
+            signing_key: self.signing_key.clone(),
+        }
+    }
+}
+
+/// Durable record of the images staged on devices, one entry per device.
+#[derive(Debug, Clone)]
+pub struct StagingJournal {
+    path: PathBuf,
+}
+
+impl StagingJournal {
+    #[must_use]
+    pub fn new(path: impl Into<PathBuf>) -> Self {
+        Self { path: path.into() }
+    }
+
+    #[must_use]
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+
+    /// Every staged update, oldest entry first.
+    pub fn list(&self) -> Result<Vec<StagedUpdate>> {
+        if !self.path.exists() {
+            return Ok(Vec::new());
+        }
+        let file = File::open(&self.path).map_err(|err| FwctlError::io(&self.path, err))?;
+        let length = file
+            .metadata()
+            .map_err(|err| FwctlError::io(&self.path, err))?
+            .len();
+        if length > MAX_STAGING_BYTES {
+            return Err(FwctlError::Configuration(format!(
+                "staging journal exceeds {MAX_STAGING_BYTES} bytes"
+            )));
+        }
+        let mut records: Vec<StagedUpdate> = Vec::new();
+        for (line_index, line) in BufReader::new(file).lines().enumerate() {
+            let line = line.map_err(|err| FwctlError::io(&self.path, err))?;
+            if line.trim().is_empty() {
+                continue;
+            }
+            let record: StagedUpdate = serde_json::from_str(&line).map_err(|err| {
+                FwctlError::Configuration(format!(
+                    "invalid staged update at line {}: {err}",
+                    line_index + 1
+                ))
+            })?;
+            records.retain(|kept| kept.device_id != record.device_id);
+            records.push(record);
+        }
+        Ok(records)
+    }
+
+    /// The update staged on one device, if any.
+    pub fn get(&self, device_id: &str) -> Result<Option<StagedUpdate>> {
+        Ok(self
+            .list()?
+            .into_iter()
+            .find(|record| record.device_id == device_id))
+    }
+
+    /// Stores one staged update, replacing any older entry for the same device.
+    pub fn record(&self, staged: &StagedUpdate) -> Result<()> {
+        let mut records = self.list()?;
+        records.retain(|record| record.device_id != staged.device_id);
+        records.push(staged.clone());
+        self.write_all(&records)
+    }
+
+    /// Drops the entry for one device and returns it.
+    pub fn remove(&self, device_id: &str) -> Result<Option<StagedUpdate>> {
+        let mut records = self.list()?;
+        let Some(position) = records.iter().position(|record| record.device_id == device_id) else {
+            return Ok(None);
+        };
+        let removed = records.remove(position);
+        self.write_all(&records)?;
+        Ok(Some(removed))
+    }
+
+    /// Reads and consumes the entry for one device in a single step.
+    pub fn take(&self, device_id: &str) -> Result<Option<StagedUpdate>> {
+        self.remove(device_id)
+    }
+
+    fn write_all(&self, records: &[StagedUpdate]) -> Result<()> {
+        if let Some(parent) = self.path.parent() && !parent.as_os_str().is_empty() {
+            fs::create_dir_all(parent).map_err(|err| FwctlError::io(parent, err))?;
+        }
+        let mut body = Vec::new();
+        for record in records {
+            let mut line = serde_json::to_vec(record)
+                .map_err(|err| FwctlError::Configuration(err.to_string()))?;
+            line.push(b'\n');
+            body.extend_from_slice(&line);
+        }
+        let temporary = self.path.with_extension("tmp");
+        let mut file = File::create(&temporary).map_err(|err| FwctlError::io(&temporary, err))?;
+        file.write_all(&body)
+            .map_err(|err| FwctlError::io(&temporary, err))?;
+        file.sync_data()
+            .map_err(|err| FwctlError::io(&temporary, err))?;
+        drop(file);
+        fs::rename(&temporary, &self.path).map_err(|err| FwctlError::io(&self.path, err))
+    }
+}
