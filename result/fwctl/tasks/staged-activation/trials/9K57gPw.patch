+#[test]
+fn activate_without_a_staged_record_reports_nothing_staged() {
+    let signer = SigningIdentity::from_seed("release", [0x51; 32]);
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
+
+    assert!(matches!(err, FwctlError::NothingStaged(_)));
+    assert_eq!(err.category(), ErrorCategory::NothingStaged);
+    let simulator = engine.into_connector().shutdown();
+    assert!(simulator.info().candidate_slot.is_none());
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+}
+
+#[test]
+fn diverged_device_loses_the_staged_update_before_boot_state_moves() {
+    let signer = SigningIdentity::from_seed("release", [0x61; 32]);
+    let first = package(&signer, "1.1.0", 2, 2048, 0);
+    let second = package(&signer, "1.2.0", 3, 1536, 7);
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+
+    let stale = engine
+        .stage(
+            "sim-0001",
+            &first,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    engine
+        .stage(
+            "sim-0001",
+            &second,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    assert_eq!(journal.list().unwrap().len(), 1);
+
+    journal.record(&stale).unwrap();
+    let mut states = Vec::new();
+    let err = engine
+        .activate("sim-0001", &journal, |event| states.push(event.state))
+        .unwrap_err();
+
+    assert!(matches!(err, FwctlError::StagedUpdateLost(_)));
+    assert_eq!(err.category(), ErrorCategory::StagedUpdateLost);
+    assert!(!states.contains(&UpdateState::CandidateSet));
+    assert!(!states.contains(&UpdateState::Rebooting));
+    assert!(
+        journal.list().unwrap().is_empty(),
+        "activation consumes the record whatever the outcome"
+    );
+
+    let simulator = engine.into_connector().shutdown();
+    assert!(simulator.info().candidate_slot.is_none());
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+}
+
+#[test]
+fn restaging_replaces_the_previous_record_for_the_device() {
+    let signer = SigningIdentity::from_seed("release", [0x71; 32]);
+    let first = package(&signer, "1.1.0", 2, 1024, 0);
+    let second = package(&signer, "1.2.0", 3, 1024, 3);
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+
+    for update in [&first, &second] {
+        engine
+            .stage(
+                "sim-0001",
+                update,
+                &signer.public_key(),
+                UpdatePolicy::default(),
+                &journal,
+                |_| {},
+            )
+            .unwrap();
+    }
+
+    let records = journal.list().unwrap();
+    assert_eq!(records.len(), 1);
+    assert_eq!(records[0].new_version, "1.2.0");
+
+    let report = engine.activate("sim-0001", &journal, |_| {}).unwrap();
+    assert_eq!(report.new_version, "1.2.0");
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.2.0");
+    assert_eq!(simulator.info().rollback_counter, 3);
+}
