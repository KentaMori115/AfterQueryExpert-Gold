+/// Transfers and verifies an image while the device keeps running its
+/// confirmed firmware.
+pub fn stage(
+    args: &UpdateArgs,
+    target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let package = read_package(&args.package)?;
+    let trusted_key = TrustStore::new(&config.trust_store).load(&package.manifest.signing_key)?;
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target)?;
+    let device_id = selected.info.device_id.clone();
+    let chunk_size = negotiated_chunk_size(args, config)?;
+    let response_timeout = timeout.unwrap_or(config.default_timeout);
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        response_timeout,
+        config.reconnect_timeout,
+        chunk_size,
+    );
+    let journal = StagingJournal::new(&config.staging_file);
+    let mut last_state = UpdateState::Idle;
+    let mut last_percent = 0_u32;
+    let staged = engine.stage(
+        &device_id,
+        &package,
+        &trusted_key,
+        UpdatePolicy {
+            allow_downgrade: args.allow_downgrade,
+        },
+        &journal,
+        |event| report_progress(output, event, &mut last_state, &mut last_percent),
+    )?;
+    output.success(
+        &staged,
+        format_args!(
+            "Staged {} on {} for {}\n  Target slot: {}\n  Image: {} bytes\n  Digest: {}\n  Activate with: fwctl activate {}",
+            staged.new_version,
+            staged.device_id,
+            staged.staged_at,
+            staged.target_slot,
+            staged.image_size,
+            staged.image_digest,
+            staged.device_id
+        ),
+    )
+}
+
+/// Boots and confirms an image that was staged earlier.
+pub fn activate(
+    target: &DeviceTarget,
+    global_target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target.device.as_deref().or(global_target))?;
+    let device_id = selected.info.device_id.clone();
+    let journal = StagingJournal::new(&config.staging_file);
+    let staged = journal
+        .get(&device_id)?
+        .ok_or_else(|| FwctlError::NothingStaged(device_id.clone()))?;
+    let response_timeout = timeout.unwrap_or(config.default_timeout);
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        response_timeout,
+        config.reconnect_timeout,
+        config.chunk_size,
+    );
+    let mut history = HistoryRecord::now(
+        device_id.clone(),
+        staged.product.clone(),
+        staged.old_version.clone(),
+        staged.new_version.clone(),
+        staged.image_digest.to_hex(),
+        staged.signing_key.clone(),
+    );
+    let mut last_state = UpdateState::Idle;
+    let mut last_percent = 0_u32;
+    let started = Instant::now();
+    let activate_result = engine.activate(&device_id, &journal, |event| {
+        report_progress(output, event, &mut last_state, &mut last_percent)
+    });
+    history.duration_ms = started.elapsed().as_millis();
+    let report = match activate_result {
+        Ok(report) => {
+            history.result = HistoryResult::Completed;
+            history.duration_ms = report.duration_ms;
+            report
+        }
+        Err(err) => {
+            history.error_category = Some(err.category());
+            if matches!(err, FwctlError::AutomaticRollback) {
+                history.result = HistoryResult::RolledBack;
+                history.rollback_result = Some("automatic rollback completed".into());
+            }
+            append_history(config, &history, output);
+            return Err(err);
+        }
+    };
+    append_history(config, &history, output);
+    output.success(
+        &report,
+        format_args!(
+            "Activated {} on {} from {}\n  Active slot: {}\n  Image: {} bytes\n  Duration: {} ms",
+            report.new_version,
+            report.device_id,
+            report.old_version,
+            report.target_slot,
+            report.image_size,
+            report.duration_ms
+        ),
+    )
+}
+
+/// Lists the images that are staged but not activated yet.
+pub fn staged(config: &Config, output: &mut StdOutput) -> Result<()> {
+    let staged = StagingJournal::new(&config.staging_file).list()?;
+    let human = render_staged(&staged);
+    output.success(&StagedList { staged }, format_args!("{human}"))
+}
+
+fn render_staged(records: &[StagedUpdate]) -> String {
+    if records.is_empty() {
+        return "No staged firmware updates".into();
+    }
+    let mut lines = String::from(
+        "STAGED AT                       DEVICE              UPDATE                 SLOT  BYTES\n",
+    );
+    for record in records.iter().rev() {
+        let _ = writeln!(
+            lines,
+            "{:<31} {:<19} {:<22} {:<5} {}",
+            record.staged_at,
+            record.device_id,
+            format!("{} -> {}", record.old_version, record.new_version),
+            record.target_slot,
+            record.image_size
+        );
+    }
+    lines.pop();
+    lines
+}
+
+fn negotiated_chunk_size(args: &UpdateArgs, config: &Config) -> Result<usize> {
+    let chunk_size = args.chunk_size.unwrap_or(config.chunk_size);
+    if (256..=16 * 1024).contains(&chunk_size) {
+        Ok(chunk_size)
+    } else {
+        Err(FwctlError::Configuration(
+            "update chunk size must be between 256 and 16384 bytes".into(),
+        ))
+    }
+}
+
+fn report_progress(
+    output: &mut StdOutput,
+    event: UpdateEvent,
+    last_state: &mut UpdateState,
+    last_percent: &mut u32,
+) {
+    let percent = event
+        .bytes_transferred
+        .saturating_mul(100)
+        .checked_div(event.image_size)
+        .unwrap_or(0);
+    if event.state != *last_state || percent >= last_percent.saturating_add(5) {
+        let _ = output.progress(format_args!("{:?}  {percent}%", event.state));
+        *last_state = event.state;
+        *last_percent = percent;
+    }
+}
+
 fn append_history(config: &Config, record: &HistoryRecord, output: &mut StdOutput) {
     if let Err(err) = HistoryStore::new(&config.history_file).append(record) {
         let _ = output.warning(format_args!("could not record update history: {err}"));
     }
 }
