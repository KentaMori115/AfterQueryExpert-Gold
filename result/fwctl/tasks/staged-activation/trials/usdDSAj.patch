+#[test]
+fn staged_listing_reads_the_configured_journal() {
+    let dir = tempfile::tempdir().unwrap();
+    let config = dir.path().join("fwctl.toml");
+    let staging = dir.path().join("state/staged.jsonl");
+    fs::write(&config, format!("staging_file = {staging:?}\n")).unwrap();
+    let config = config.to_str().unwrap();
+
+    let empty = fwctl(&["--json", "--config", config, "staged"]);
+    assert!(
+        empty.status.success(),
+        "{}",
+        String::from_utf8_lossy(&empty.stderr)
+    );
+    let value: serde_json::Value = serde_json::from_slice(&empty.stdout).unwrap();
+    assert_eq!(value["staged"], serde_json::json!([]));
+
+    StagingJournal::new(&staging)
+        .record(&StagedUpdate {
+            device_id: "board-7".into(),
+            product: "controller".into(),
+            update_id: UpdateId::from_bytes([0x2b; 16]),
+            old_version: "2.3.0".into(),
+            new_version: "2.4.0".into(),
+            target_slot: Slot::B,
+            image_size: 256,
+            image_digest: digest_bytes(b"image"),
+            rollback_counter: 9,
+            confirmed_counter: 8,
+            signing_key: "release".into(),
+            staged_at: "2026-09-02T07:30:00Z".into(),
+        })
+        .unwrap();
+
+    let listed = fwctl(&["--json", "--config", config, "staged"]);
+    assert!(listed.status.success());
+    let value: serde_json::Value = serde_json::from_slice(&listed.stdout).unwrap();
+    assert_eq!(value["staged"][0]["device_id"], "board-7");
+    assert_eq!(value["staged"][0]["new_version"], "2.4.0");
+
+    let human = fwctl(&["--config", config, "staged"]);
+    assert!(human.status.success());
+    let text = String::from_utf8(human.stdout).unwrap();
+    assert!(text.contains("board-7"), "{text}");
+    assert!(text.contains("2.3.0 -> 2.4.0"), "{text}");
+}
