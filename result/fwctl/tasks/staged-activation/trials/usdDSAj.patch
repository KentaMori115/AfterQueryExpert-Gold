@@ -0,0 +1,274 @@
+use std::time::Duration;
+
+use fwctl_core::crypto::SigningIdentity;
+use fwctl_core::device::{Slot, UpdateId};
+use fwctl_core::package::{FirmwareManifest, FirmwarePackage, digest_bytes};
+use fwctl_core::update::{StagedUpdate, StagingJournal, UpdateEngine, UpdatePolicy, UpdateState};
+use fwctl_core::{ErrorCategory, FwctlError};
+use fwctl_sim::{Simulator, SimulatorConfig, SimulatorConnector, SimulatorTrustedKey};
+
+fn signed_package(signer: &SigningIdentity, image_len: usize, product: &str) -> FirmwarePackage {
+    let image = (0..image_len)
+        .map(|offset| u8::try_from(offset % 251).unwrap())
+        .collect::<Vec<_>>();
+    let manifest = FirmwareManifest::new(
+        product.into(),
+        "1.1.0".into(),
+        vec!["A1".into()],
+        image.len() as u64,
+        digest_bytes(&image),
+        2,
+        signer.key_id().into(),
+    )
+    .unwrap();
+    let signature = signer.sign_manifest(&manifest).unwrap();
+    FirmwarePackage {
+        manifest,
+        image,
+        signature,
+        release_notes: None,
+    }
+}
+
+fn engine(simulator: Simulator) -> UpdateEngine<SimulatorConnector> {
+    UpdateEngine::new(
+        SimulatorConnector::new(simulator),
+        Duration::from_millis(30),
+        Duration::from_secs(1),
+        512,
+    )
+}
+
+fn simulator(signer: &SigningIdentity) -> Simulator {
+    let config = SimulatorConfig {
+        trusted_keys: vec![SimulatorTrustedKey {
+            key_id: signer.key_id().into(),
+            public_key: signer.public_key().to_bytes(),
+        }],
+        ..SimulatorConfig::default()
+    };
+    Simulator::new(config).unwrap()
+}
+
+fn journal(dir: &tempfile::TempDir) -> StagingJournal {
+    StagingJournal::new(dir.path().join("state/staged.jsonl"))
+}
+
+#[test]
+fn stage_transfers_and_verifies_without_touching_boot_configuration() {
+    let signer = SigningIdentity::from_seed("release", [0x11; 32]);
+    let package = signed_package(&signer, 3000, "sensor-node");
+    let dir = tempfile::tempdir().unwrap();
+    let journal = journal(&dir);
+    let mut engine = engine(simulator(&signer));
+    let mut states = Vec::new();
+
+    let staged = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |event| states.push(event.state),
+        )
+        .unwrap();
+
+    assert_eq!(engine.state(), UpdateState::Staged);
+    assert!(states.contains(&UpdateState::Verifying));
+    assert!(states.contains(&UpdateState::Staged));
+    assert!(!states.contains(&UpdateState::CandidateSet));
+    assert!(!states.contains(&UpdateState::Rebooting));
+    assert_eq!(staged.device_id, "sim-0001");
+    assert_eq!(staged.product, "sensor-node");
+    assert_eq!(staged.old_version, "1.0.0");
+    assert_eq!(staged.new_version, "1.1.0");
+    assert_eq!(staged.target_slot, Slot::B);
+    assert_eq!(staged.image_size, 3000);
+    assert_eq!(staged.image_digest, digest_bytes(&package.image));
+    assert_eq!(staged.rollback_counter, 2);
+    assert_eq!(staged.confirmed_counter, 1);
+    assert_eq!(staged.signing_key, "release");
+    assert!(!staged.staged_at.is_empty());
+
+    assert_eq!(journal.list().unwrap(), vec![staged.clone()]);
+    assert_eq!(journal.get("sim-0001").unwrap(), Some(staged));
+
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+    assert!(simulator.info().candidate_slot.is_none());
+    assert_eq!(simulator.info().rollback_counter, 1);
+}
+
+#[test]
+fn activate_finishes_the_staged_update_and_consumes_the_record() {
+    let signer = SigningIdentity::from_seed("release", [0x22; 32]);
+    let package = signed_package(&signer, 2048, "sensor-node");
+    let dir = tempfile::tempdir().unwrap();
+    let journal = journal(&dir);
+    let mut engine = engine(simulator(&signer));
+    engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+
+    let mut states = Vec::new();
+    let report = engine
+        .activate("sim-0001", &journal, |event| states.push(event.state))
+        .unwrap();
+
+    assert_eq!(report.state, UpdateState::Completed);
+    assert_eq!(report.device_id, "sim-0001");
+    assert_eq!(report.old_version, "1.0.0");
+    assert_eq!(report.new_version, "1.1.0");
+    assert_eq!(report.target_slot, Slot::B);
+    assert_eq!(report.image_size, 2048);
+    assert!(states.contains(&UpdateState::CandidateSet));
+    assert!(states.contains(&UpdateState::Confirming));
+    assert!(journal.get("sim-0001").unwrap().is_none());
+    assert!(journal.list().unwrap().is_empty());
+
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.1.0");
+    assert_eq!(simulator.info().rollback_counter, 2);
+}
+
+#[test]
+fn a_bad_device_digest_stages_nothing() {
+    let signer = SigningIdentity::from_seed("release", [0x33; 32]);
+    let package = signed_package(&signer, 1024, "sensor-node");
+    let dir = tempfile::tempdir().unwrap();
+    let journal = journal(&dir);
+    let mut simulator = simulator(&signer);
+    simulator.faults_mut().force_verify_failure = true;
+    let mut engine = engine(simulator);
+
+    let err = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap_err();
+
+    assert!(matches!(err, FwctlError::ImageVerificationFailed));
+    assert_eq!(engine.state(), UpdateState::Failed);
+    assert!(journal.list().unwrap().is_empty());
+    let simulator = engine.into_connector().shutdown();
+    assert!(simulator.info().candidate_slot.is_none());
+}
+
+#[test]
+fn a_policy_rejection_stages_nothing() {
+    let signer = SigningIdentity::from_seed("release", [0x44; 32]);
+    let package = signed_package(&signer, 1024, "gateway");
+    let dir = tempfile::tempdir().unwrap();
+    let journal = journal(&dir);
+    let mut engine = engine(simulator(&signer));
+
+    let err = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap_err();
+
+    assert!(matches!(err, FwctlError::WrongProduct { .. }));
+    assert!(journal.list().unwrap().is_empty());
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+}
+
+#[test]
+fn activate_without_a_staged_record_reports_nothing_staged() {
+    let signer = SigningIdentity::from_seed("release", [0x55; 32]);
+    let dir = tempfile::tempdir().unwrap();
+    let journal = journal(&dir);
+    let mut engine = engine(simulator(&signer));
+
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
+    assert!(matches!(err, FwctlError::NothingStaged(_)));
+    assert_eq!(err.category(), ErrorCategory::NothingStaged);
+}
+
+#[test]
+fn a_device_that_moved_on_loses_the_staged_update_before_reboot() {
+    let signer = SigningIdentity::from_seed("release", [0x66; 32]);
+    let dir = tempfile::tempdir().unwrap();
+    let journal = journal(&dir);
+    let stale = StagedUpdate {
+        device_id: "sim-0001".into(),
+        product: "sensor-node".into(),
+        update_id: UpdateId::from_bytes([0x5a; 16]),
+        old_version: "1.0.0".into(),
+        new_version: "1.1.0".into(),
+        target_slot: Slot::B,
+        image_size: 1024,
+        image_digest: digest_bytes(b"stale"),
+        rollback_counter: 2,
+        confirmed_counter: 1,
+        signing_key: "release".into(),
+        staged_at: "2026-09-01T09:00:00Z".into(),
+    };
+    journal.record(&stale).unwrap();
+    let mut engine = engine(simulator(&signer));
+
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
+    assert!(matches!(err, FwctlError::StagedUpdateLost(_)), "{err}");
+    assert_eq!(err.category(), ErrorCategory::StagedUpdateLost);
+    assert!(journal.get("sim-0001").unwrap().is_none());
+
+    let simulator = engine.into_connector().shutdown();
+    assert!(simulator.info().candidate_slot.is_none());
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+    assert_eq!(
+        simulator.status().boot_state,
+        fwctl_core::device::BootState::Confirmed
+    );
+}
+
+#[test]
+fn staging_twice_keeps_only_the_newest_record() {
+    let signer = SigningIdentity::from_seed("release", [0x77; 32]);
+    let package = signed_package(&signer, 1024, "sensor-node");
+    let dir = tempfile::tempdir().unwrap();
+    let journal = journal(&dir);
+    let mut engine = engine(simulator(&signer));
+    let first = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    let second = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+
+    assert_ne!(first.update_id, second.update_id);
+    assert_eq!(journal.list().unwrap(), vec![second]);
+    let _ = engine.into_connector().shutdown();
+}
