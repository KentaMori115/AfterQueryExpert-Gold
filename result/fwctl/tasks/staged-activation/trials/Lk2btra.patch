diff --git a/crates/fwctl/src/commands/staging.rs b/crates/fwctl/src/commands/staging.rs
new file mode 100644
index 0000000..bd14c6d
--- /dev/null
+++ b/crates/fwctl/src/commands/staging.rs
@@ -0,0 +1,252 @@
+use std::fmt::Write as _;
+use std::time::Duration;
+
+use fwctl_core::crypto::TrustStore;
+use fwctl_core::device::discover_serial_devices;
+use fwctl_core::history::{HistoryRecord, HistoryResult};
+use fwctl_core::package::read_package;
+use fwctl_core::transport::SerialConnector;
+use fwctl_core::update::{StagedUpdate, StagingJournal, UpdateEngine, UpdatePolicy, UpdateState};
+use fwctl_core::{Config, FwctlError, Result};
+use serde::Serialize;
+
+use crate::cli::{DeviceTarget, UpdateArgs};
+use crate::commands::device::{probe_timeout, select_device};
+use crate::commands::update::append_history;
+use crate::output::StdOutput;
+
+#[derive(Serialize)]
+struct StagedList {
+    staged: Vec<StagedUpdate>,
+}
+
+pub fn stage(
+    args: &UpdateArgs,
+    target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let package = read_package(&args.package)?;
+    let trusted_key = TrustStore::new(&config.trust_store).load(&package.manifest.signing_key)?;
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target)?;
+    let device_id = selected.info.device_id.clone();
+    let chunk_size = chunk_size(args, config)?;
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        timeout.unwrap_or(config.default_timeout),
+        config.reconnect_timeout,
+        chunk_size,
+    );
+    let journal = StagingJournal::new(&config.staging_file);
+    let mut reporter = ProgressReporter::default();
+    let staged = engine.stage(
+        &device_id,
+        &package,
+        &trusted_key,
+        UpdatePolicy {
+            allow_downgrade: args.allow_downgrade,
+        },
+        &journal,
+        |event| reporter.observe(event, output),
+    )?;
+    output.success(
+        &staged,
+        format_args!(
+            "Staged {} for {}\n  Slot: {}\n  Image: {} bytes\n  Digest: {}\n  Activate with: fwctl activate {}",
+            staged.new_version,
+            staged.device_id,
+            staged.target_slot,
+            staged.image_size,
+            staged.image_digest,
+            staged.device_id
+        ),
+    )
+}
+
+pub fn activate(
+    target: &DeviceTarget,
+    global_target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let journal = StagingJournal::new(&config.staging_file);
+    let selection = target.device.as_deref().or(global_target);
+    let staged = select_staged(&journal, selection)?;
+    let device_id = staged.device_id.clone();
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        timeout.unwrap_or(config.default_timeout),
+        config.reconnect_timeout,
+        config.chunk_size,
+    );
+    let mut history = HistoryRecord::now(
+        device_id.clone(),
+        staged.product.clone(),
+        staged.old_version.clone(),
+        staged.new_version.clone(),
+        staged.image_digest.to_hex(),
+        staged.signing_key.clone(),
+    );
+    let mut reporter = ProgressReporter::default();
+    let report = match engine.activate(&device_id, &journal, |event| {
+        reporter.observe(event, output);
+    }) {
+        Ok(report) => {
+            history.result = HistoryResult::Completed;
+            history.duration_ms = report.duration_ms;
+            report
+        }
+        Err(err) => {
+            history.error_category = Some(err.category());
+            if matches!(err, FwctlError::AutomaticRollback) {
+                history.result = HistoryResult::RolledBack;
+                history.rollback_result = Some("automatic rollback completed".into());
+            }
+            append_history(config, &history, output);
+            return Err(err);
+        }
+    };
+    append_history(config, &history, output);
+    output.success(
+        &report,
+        format_args!(
+            "Activated {} on {}\n  Active slot: {}\n  Image: {} bytes\n  Duration: {} ms",
+            report.new_version,
+            report.device_id,
+            report.target_slot,
+            report.image_size,
+            report.duration_ms
+        ),
+    )
+}
+
+pub fn list(config: &Config, output: &mut StdOutput) -> Result<()> {
+    let staged = StagingJournal::new(&config.staging_file).list()?;
+    let human = render(&staged);
+    output.success(&StagedList { staged }, format_args!("{human}"))
+}
+
+fn select_staged(journal: &StagingJournal, device_id: Option<&str>) -> Result<StagedUpdate> {
+    if let Some(device_id) = device_id {
+        return journal.get(device_id)?.ok_or(FwctlError::NothingStaged);
+    }
+    let mut staged = journal.list()?;
+    match staged.len() {
+        0 => Err(FwctlError::NothingStaged),
+        1 => Ok(staged.remove(0)),
+        _ => Err(FwctlError::Configuration(
+            "several devices have staged updates, select one with --device".into(),
+        )),
+    }
+}
+
+fn chunk_size(args: &UpdateArgs, config: &Config) -> Result<usize> {
+    let chunk_size = args.chunk_size.unwrap_or(config.chunk_size);
+    if (256..=16 * 1024).contains(&chunk_size) {
+        Ok(chunk_size)
+    } else {
+        Err(FwctlError::Configuration(
+            "update chunk size must be between 256 and 16384 bytes".into(),
+        ))
+    }
+}
+
+fn render(staged: &[StagedUpdate]) -> String {
+    if staged.is_empty() {
+        return "No staged firmware updates".into();
+    }
+    let mut lines = String::from(
+        "STAGED AT                       DEVICE              UPDATE                 SLOT\n",
+    );
+    for record in staged {
+        let _ = writeln!(
+            lines,
+            "{:<31} {:<19} {:<22} {}",
+            record.staged_at,
+            record.device_id,
+            format!("{} -> {}", record.old_version, record.new_version),
+            record.target_slot
+        );
+    }
+    lines.pop();
+    lines
+}
+
+#[derive(Default)]
+struct ProgressReporter {
+    last_state: Option<UpdateState>,
+    last_percent: u32,
+}
+
+impl ProgressReporter {
+    fn observe(&mut self, event: fwctl_core::update::UpdateEvent, output: &mut StdOutput) {
+        let percent = event
+            .bytes_transferred
+            .saturating_mul(100)
+            .checked_div(event.image_size)
+            .unwrap_or(0);
+        if self.last_state != Some(event.state) || percent >= self.last_percent.saturating_add(5) {
+            let _ = output.progress(format_args!("{:?}  {percent}%", event.state));
+            self.last_state = Some(event.state);
+            self.last_percent = percent;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use fwctl_core::device::{Slot, UpdateId};
+    use fwctl_core::package::ImageDigest;
+
+    use super::*;
+
+    fn staged(device_id: &str) -> StagedUpdate {
+        StagedUpdate {
+            device_id: device_id.into(),
+            product: "sensor-node".into(),
+            update_id: UpdateId::from_bytes([3; 16]),
+            old_version: "1.0.0".into(),
+            new_version: "1.1.0".into(),
+            target_slot: Slot::B,
+            image_size: 2048,
+            image_digest: ImageDigest::from_bytes([0x11; 32]),
+            rollback_counter: 3,
+            confirmed_counter: 2,
+            signing_key: "release".into(),
+            staged_at: "2026-08-31T10:00:00Z".into(),
+        }
+    }
+
+    #[test]
+    fn renders_empty_and_populated_journal() {
+        assert_eq!(render(&[]), "No staged firmware updates");
+        let text = render(&[staged("board-a")]);
+        assert!(text.contains("board-a"));
+        assert!(text.contains("1.0.0 -> 1.1.0"));
+    }
+
+    #[test]
+    fn selects_the_only_staged_device_without_a_target() {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = StagingJournal::new(dir.path().join("staging.jsonl"));
+        assert!(matches!(
+            select_staged(&journal, None),
+            Err(FwctlError::NothingStaged)
+        ));
+        journal.record(&staged("board-a")).unwrap();
+        assert_eq!(select_staged(&journal, None).unwrap().device_id, "board-a");
+        journal.record(&staged("board-b")).unwrap();
+        assert!(select_staged(&journal, None).is_err());
+        assert_eq!(
+            select_staged(&journal, Some("board-b")).unwrap().device_id,
+            "board-b"
+        );
+        assert!(matches!(
+            select_staged(&journal, Some("board-c")),
+            Err(FwctlError::NothingStaged)
+        ));
+    }
+}
