+#[test]
+fn staged_journal_commands_report_an_empty_journal() {
+    let dir = tempfile::tempdir().unwrap();
+    let staging = dir.path().join("state/staging.jsonl");
+    let config = dir.path().join("config.toml");
+    fs::write(
+        &config,
+        format!("staging_file = {:?}\n", staging.to_str().unwrap()),
+    )
+    .unwrap();
+    let config = config.to_str().unwrap();
+
+    let listed = fwctl(&["--json", "--config", config, "staged"]);
+    assert!(listed.status.success());
+    let listed: serde_json::Value = serde_json::from_slice(&listed.stdout).unwrap();
+    assert_eq!(listed["staged"], serde_json::json!([]));
+
+    let human = fwctl(&["--config", config, "staged"]);
+    assert_eq!(
+        String::from_utf8(human.stdout).unwrap(),
+        "No staged firmware updates\n"
+    );
+
+    let activated = fwctl(&["--json", "--config", config, "activate", "sensor-0042"]);
+    assert_eq!(activated.status.code(), Some(6));
+    let activated: serde_json::Value = serde_json::from_slice(&activated.stdout).unwrap();
+    assert_eq!(activated["ok"], false);
+    assert_eq!(activated["category"], "nothing_staged");
+}
