@@ -0,0 +1,213 @@
+use std::borrow::Borrow;
+use std::fs::{self, File, OpenOptions};
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+use crate::device::{Slot, UpdateId};
+use crate::package::ImageDigest;
+use crate::{FwctlError, Result};
+
+const MAX_STAGING_BYTES: u64 = 4 * 1024 * 1024;
+
+/// A firmware image that already sits in the inactive slot of a device, verified
+/// on the device side but not yet selected as boot candidate.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StagedUpdate {
+    pub device_id: String,
+    pub product: String,
+    pub update_id: UpdateId,
+    pub old_version: String,
+    pub new_version: String,
+    pub target_slot: Slot,
+    pub image_size: u32,
+    pub image_digest: ImageDigest,
+    pub rollback_counter: u64,
+    pub confirmed_counter: u64,
+    pub signing_key: String,
+    pub staged_at: String,
+}
+
+/// Durable record of staged updates, one record per device.
+#[derive(Debug, Clone)]
+pub struct StagingJournal {
+    path: PathBuf,
+}
+
+impl StagingJournal {
+    #[must_use]
+    pub fn new(path: impl Into<PathBuf>) -> Self {
+        Self { path: path.into() }
+    }
+
+    #[must_use]
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+
+    /// Every staged update, oldest first.
+    pub fn list(&self) -> Result<Vec<StagedUpdate>> {
+        if !self.path.exists() {
+            return Ok(Vec::new());
+        }
+        let file = File::open(&self.path).map_err(|err| FwctlError::io(&self.path, err))?;
+        let length = file
+            .metadata()
+            .map_err(|err| FwctlError::io(&self.path, err))?
+            .len();
+        if length > MAX_STAGING_BYTES {
+            return Err(FwctlError::Configuration(format!(
+                "staging file exceeds {MAX_STAGING_BYTES} bytes"
+            )));
+        }
+        let mut records: Vec<StagedUpdate> = Vec::new();
+        for (line_index, line) in BufReader::new(file).lines().enumerate() {
+            let line = line.map_err(|err| FwctlError::io(&self.path, err))?;
+            if line.trim().is_empty() {
+                continue;
+            }
+            let record: StagedUpdate = serde_json::from_str(&line).map_err(|err| {
+                FwctlError::Configuration(format!(
+                    "invalid staged update at line {}: {err}",
+                    line_index + 1
+                ))
+            })?;
+            records.retain(|existing| existing.device_id != record.device_id);
+            records.push(record);
+        }
+        Ok(records)
+    }
+
+    /// The staged update held for one device, if any.
+    pub fn get(&self, device_id: &str) -> Result<Option<StagedUpdate>> {
+        Ok(self
+            .list()?
+            .into_iter()
+            .find(|record| record.device_id == device_id))
+    }
+
+    /// Store one staged update, replacing any older record for the same device.
+    pub fn record(&self, staged: impl Borrow<StagedUpdate>) -> Result<()> {
+        let staged = staged.borrow();
+        let mut records = self.list()?;
+        records.retain(|existing| existing.device_id != staged.device_id);
+        records.push(staged.clone());
+        self.rewrite(&records)
+    }
+
+    /// Drop the staged update held for one device and hand it back.
+    pub fn remove(&self, device_id: &str) -> Result<Option<StagedUpdate>> {
+        let records = self.list()?;
+        let (removed, kept): (Vec<StagedUpdate>, Vec<StagedUpdate>) = records
+            .into_iter()
+            .partition(|record| record.device_id == device_id);
+        if removed.is_empty() {
+            return Ok(None);
+        }
+        self.rewrite(&kept)?;
+        Ok(removed.into_iter().next_back())
+    }
+
+    fn rewrite(&self, records: &[StagedUpdate]) -> Result<()> {
+        if let Some(parent) = self.path.parent() {
+            fs::create_dir_all(parent).map_err(|err| FwctlError::io(parent, err))?;
+        }
+        let mut buffer = Vec::new();
+        for record in records {
+            let mut line = serde_json::to_vec(record)
+                .map_err(|err| FwctlError::Configuration(err.to_string()))?;
+            line.push(b'\n');
+            buffer.extend_from_slice(&line);
+        }
+        let mut file = OpenOptions::new()
+            .create(true)
+            .write(true)
+            .truncate(true)
+            .open(&self.path)
+            .map_err(|err| FwctlError::io(&self.path, err))?;
+        file.write_all(&buffer)
+            .map_err(|err| FwctlError::io(&self.path, err))?;
+        file.sync_data()
+            .map_err(|err| FwctlError::io(&self.path, err))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn staged(device_id: &str, version: &str) -> StagedUpdate {
+        StagedUpdate {
+            device_id: device_id.into(),
+            product: "sensor-node".into(),
+            update_id: UpdateId::from_bytes([7; 16]),
+            old_version: "1.0.0".into(),
+            new_version: version.into(),
+            target_slot: Slot::B,
+            image_size: 4096,
+            image_digest: ImageDigest::from_bytes([0xab; 32]),
+            rollback_counter: 4,
+            confirmed_counter: 3,
+            signing_key: "release".into(),
+            staged_at: "2026-08-31T10:00:00Z".into(),
+        }
+    }
+
+    #[test]
+    fn lists_records_oldest_first() {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = StagingJournal::new(dir.path().join("state/staging.jsonl"));
+        assert!(journal.list().unwrap().is_empty());
+        journal.record(&staged("board-a", "1.1.0")).unwrap();
+        journal.record(&staged("board-b", "1.2.0")).unwrap();
+        let records = journal.list().unwrap();
+        assert_eq!(records.len(), 2);
+        assert_eq!(records[0].device_id, "board-a");
+        assert_eq!(records[1].device_id, "board-b");
+    }
+
+    #[test]
+    fn keeps_one_record_per_device() {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = StagingJournal::new(dir.path().join("staging.jsonl"));
+        journal.record(&staged("board-a", "1.1.0")).unwrap();
+        journal.record(&staged("board-a", "1.4.0")).unwrap();
+        assert_eq!(journal.list().unwrap().len(), 1);
+        assert_eq!(
+            journal.get("board-a").unwrap().unwrap().new_version,
+            "1.4.0"
+        );
+        assert!(journal.get("board-b").unwrap().is_none());
+    }
+
+    #[test]
+    fn removes_only_the_selected_device() {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = StagingJournal::new(dir.path().join("staging.jsonl"));
+        journal.record(&staged("board-a", "1.1.0")).unwrap();
+        journal.record(&staged("board-b", "1.2.0")).unwrap();
+        let removed = journal.remove("board-a").unwrap().unwrap();
+        assert_eq!(removed.device_id, "board-a");
+        assert!(journal.remove("board-a").unwrap().is_none());
+        assert_eq!(journal.list().unwrap().len(), 1);
+    }
+
+    #[test]
+    fn survives_a_round_trip_through_json() {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = StagingJournal::new(dir.path().join("staging.jsonl"));
+        let record = staged("board-a", "1.1.0");
+        journal.record(&record).unwrap();
+        assert_eq!(journal.get("board-a").unwrap().unwrap(), record);
+    }
+
+    #[test]
+    fn rejects_corrupt_record_with_line_number() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("staging.jsonl");
+        fs::write(&path, "{broken}\n").unwrap();
+        let err = StagingJournal::new(path).list().unwrap_err();
+        assert!(err.to_string().contains("line 1"));
+    }
+}
