diff --git a/crates/fwctl-sim/tests/staged_update.rs b/crates/fwctl-sim/tests/staged_update.rs
new file mode 100644
index 0000000..a84f29c
--- /dev/null
+++ b/crates/fwctl-sim/tests/staged_update.rs
@@ -0,0 +1,290 @@
+use std::time::Duration;
+
+use fwctl_core::crypto::SigningIdentity;
+use fwctl_core::device::Slot;
+use fwctl_core::package::{FirmwareManifest, FirmwarePackage, digest_bytes};
+use fwctl_core::update::{StagingJournal, UpdateEngine, UpdatePolicy, UpdateState};
+use fwctl_core::{ErrorCategory, FwctlError};
+use fwctl_sim::{Simulator, SimulatorConfig, SimulatorConnector, SimulatorTrustedKey};
+
+fn signed_package(signer: &SigningIdentity, image_len: usize, version: &str) -> FirmwarePackage {
+    let image = (0..image_len)
+        .map(|offset| u8::try_from(offset % 251).unwrap())
+        .collect::<Vec<_>>();
+    let manifest = FirmwareManifest::new(
+        "sensor-node".into(),
+        version.into(),
+        vec!["A1".into()],
+        image.len() as u64,
+        digest_bytes(&image),
+        2,
+        signer.key_id().into(),
+    )
+    .unwrap();
+    let signature = signer.sign_manifest(&manifest).unwrap();
+    FirmwarePackage {
+        manifest,
+        image,
+        signature,
+        release_notes: None,
+    }
+}
+
+fn engine(simulator: Simulator) -> UpdateEngine<SimulatorConnector> {
+    UpdateEngine::new(
+        SimulatorConnector::new(simulator),
+        Duration::from_millis(30),
+        Duration::from_secs(1),
+        512,
+    )
+}
+
+fn simulator(signer: &SigningIdentity) -> Simulator {
+    let config = SimulatorConfig {
+        trusted_keys: vec![SimulatorTrustedKey {
+            key_id: signer.key_id().into(),
+            public_key: signer.public_key().to_bytes(),
+        }],
+        ..SimulatorConfig::default()
+    };
+    Simulator::new(config).unwrap()
+}
+
+fn journal() -> (tempfile::TempDir, StagingJournal) {
+    let dir = tempfile::tempdir().unwrap();
+    let journal = StagingJournal::new(dir.path().join("state/staging.jsonl"));
+    (dir, journal)
+}
+
+#[test]
+fn stage_transfers_without_touching_boot_state() {
+    let signer = SigningIdentity::from_seed("release", [0x11; 32]);
+    let package = signed_package(&signer, 4096, "1.1.0");
+    let mut engine = engine(simulator(&signer));
+    let (_dir, journal) = journal();
+    let mut states = Vec::new();
+    let staged = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |event| states.push(event.state),
+        )
+        .unwrap();
+
+    assert_eq!(engine.state(), UpdateState::Staged);
+    assert_eq!(staged.device_id, "sim-0001");
+    assert_eq!(staged.product, "sensor-node");
+    assert_eq!(staged.old_version, "1.0.0");
+    assert_eq!(staged.new_version, "1.1.0");
+    assert_eq!(staged.target_slot, Slot::B);
+    assert_eq!(staged.image_size, 4096);
+    assert_eq!(staged.image_digest, package.manifest.image.sha256);
+    assert_eq!(staged.rollback_counter, 2);
+    assert_eq!(staged.confirmed_counter, 1);
+    assert_eq!(staged.signing_key, "release");
+    assert!(!staged.staged_at.is_empty());
+    assert!(states.contains(&UpdateState::Verifying));
+    assert!(states.contains(&UpdateState::Staged));
+    assert!(!states.contains(&UpdateState::CandidateSet));
+    assert!(!states.contains(&UpdateState::Rebooting));
+
+    assert_eq!(journal.list().unwrap(), vec![staged.clone()]);
+    assert_eq!(journal.get("sim-0001").unwrap(), Some(staged));
+
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+    assert_eq!(simulator.info().candidate_slot, None);
+    assert_eq!(simulator.status().accepted_offset, 4096);
+}
+
+#[test]
+fn activate_finishes_a_staged_update_from_the_journal() {
+    let signer = SigningIdentity::from_seed("release", [0x12; 32]);
+    let package = signed_package(&signer, 4096, "1.1.0");
+    let mut engine = engine(simulator(&signer));
+    let (_dir, journal) = journal();
+    engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+
+    let mut states = Vec::new();
+    let report = engine
+        .activate("sim-0001", &journal, |event| states.push(event.state))
+        .unwrap();
+    assert_eq!(report.state, UpdateState::Completed);
+    assert_eq!(report.device_id, "sim-0001");
+    assert_eq!(report.old_version, "1.0.0");
+    assert_eq!(report.new_version, "1.1.0");
+    assert_eq!(report.target_slot, Slot::B);
+    assert_eq!(report.image_size, 4096);
+    assert!(states.contains(&UpdateState::CandidateSet));
+    assert!(states.contains(&UpdateState::Confirming));
+    assert!(journal.list().unwrap().is_empty());
+
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.1.0");
+    assert_eq!(simulator.info().rollback_counter, 2);
+}
+
+#[test]
+fn activate_without_a_record_reports_nothing_staged() {
+    let signer = SigningIdentity::from_seed("release", [0x13; 32]);
+    let mut engine = engine(simulator(&signer));
+    let (_dir, journal) = journal();
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
+    assert!(matches!(err, FwctlError::NothingStaged));
+    assert_eq!(err.category(), ErrorCategory::NothingStaged);
+}
+
+#[test]
+fn rejected_policy_stages_nothing() {
+    let signer = SigningIdentity::from_seed("release", [0x14; 32]);
+    let package = signed_package(&signer, 2048, "0.9.0");
+    let mut engine = engine(simulator(&signer));
+    let (_dir, journal) = journal();
+    let err = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap_err();
+    assert!(matches!(err, FwctlError::DowngradeRejected { .. }));
+    assert_eq!(engine.state(), UpdateState::Failed);
+    assert!(journal.list().unwrap().is_empty());
+}
+
+#[test]
+fn device_digest_mismatch_stages_nothing() {
+    let signer = SigningIdentity::from_seed("release", [0x15; 32]);
+    let package = signed_package(&signer, 2048, "1.1.0");
+    let mut simulator = simulator(&signer);
+    simulator.faults_mut().force_verify_failure = true;
+    let mut engine = engine(simulator);
+    let (_dir, journal) = journal();
+    let err = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap_err();
+    assert!(matches!(err, FwctlError::ImageVerificationFailed));
+    assert!(journal.list().unwrap().is_empty());
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().candidate_slot, None);
+}
+
+#[test]
+fn drifted_device_loses_its_staged_update() {
+    let signer = SigningIdentity::from_seed("release", [0x16; 32]);
+    let package = signed_package(&signer, 2048, "1.1.0");
+    let mut engine = engine(simulator(&signer));
+    let (_dir, journal) = journal();
+    engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    // Somebody else pushes the very same image again: the held transfer that the
+    // staged record refers to is gone.
+    engine
+        .run(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            |_| {},
+        )
+        .unwrap();
+
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
+    assert!(matches!(err, FwctlError::StagedUpdateLost));
+    assert_eq!(err.category(), ErrorCategory::StagedUpdateLost);
+    // The record is consumed whatever the outcome.
+    assert!(journal.list().unwrap().is_empty());
+    let _ = engine.into_connector().shutdown();
+}
+
+#[test]
+fn restaging_replaces_the_journal_record() {
+    let signer = SigningIdentity::from_seed("release", [0x21; 32]);
+    let package = signed_package(&signer, 2048, "1.1.0");
+    let mut engine = engine(simulator(&signer));
+    let (_dir, journal) = journal();
+    let first = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    let second = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    assert_ne!(first.update_id, second.update_id);
+    assert_eq!(journal.list().unwrap(), vec![second]);
+
+    let report = engine.activate("sim-0001", &journal, |_| {}).unwrap();
+    assert_eq!(report.new_version, "1.1.0");
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.1.0");
+}
+
+#[test]
+fn failed_activation_still_consumes_the_record() {
+    let signer = SigningIdentity::from_seed("release", [0x22; 32]);
+    let package = signed_package(&signer, 2048, "1.1.0");
+    let mut simulator = simulator(&signer);
+    simulator.faults_mut().candidate_healthy = false;
+    let mut engine = engine(simulator);
+    let (_dir, journal) = journal();
+    engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
+    assert!(matches!(
+        err,
+        FwctlError::HealthCheckFailed | FwctlError::AutomaticRollback
+    ));
+    assert!(journal.list().unwrap().is_empty());
+    let _ = engine.into_connector().shutdown();
+}
