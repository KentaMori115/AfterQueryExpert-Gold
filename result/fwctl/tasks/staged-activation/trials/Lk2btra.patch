+
+fn confirm_staged_update(
+    staged: &StagedUpdate,
+    info: &DeviceInfo,
+    status: &DeviceStatus,
+) -> Result<()> {
+    let unchanged = info.product == staged.product
+        && info.firmware_version == staged.old_version
+        && info.rollback_counter == staged.confirmed_counter
+        && status.update_id == Some(staged.update_id)
+        && status.accepted_offset == staged.image_size;
+    if unchanged {
+        Ok(())
+    } else {
+        Err(FwctlError::StagedUpdateLost)
+    }
+}
