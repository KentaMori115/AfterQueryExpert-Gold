+/// Transfer and verify an image without rebooting the device.
+pub fn stage(
+    args: &UpdateArgs,
+    target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let package = read_package(&args.package)?;
+    let trusted_key = TrustStore::new(&config.trust_store).load(&package.manifest.signing_key)?;
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target)?;
+    let device_id = selected.info.device_id.clone();
+    let chunk_size = transfer_chunk_size(args, config)?;
+    let mut engine = engine(timeout, config, chunk_size);
+    let mut reporter = ProgressReporter::default();
+    let staged = engine.stage(
+        &device_id,
+        &package,
+        &trusted_key,
+        UpdatePolicy {
+            allow_downgrade: args.allow_downgrade,
+        },
+        &StagingJournal::new(&config.staging_file),
+        |event| reporter.observe(event, output),
+    )?;
+    output.success(
+        &staged,
+        format_args!(
+            "Staged {} on {} for {}\n  Target slot: {}\n  Image: {} bytes\n  Staged at: {}\n  Run `fwctl activate {}` inside the next maintenance window",
+            staged.new_version,
+            staged.device_id,
+            staged.old_version,
+            staged.target_slot,
+            staged.image_size,
+            staged.staged_at,
+            staged.device_id
+        ),
+    )
+}
