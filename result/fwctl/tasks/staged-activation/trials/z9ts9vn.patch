+#[test]
+fn activation_consumes_the_record_even_when_it_fails() {
+    let dir = tempfile::tempdir().unwrap();
+    let journal = journal(&dir);
+    let signer = SigningIdentity::from_seed("release", [0x71; 32]);
+    let package = signed_package(&signer, 1024, "1.1.0");
+    let mut staging_engine = engine(simulator(&signer));
+    staging_engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    let mut simulator = staging_engine.into_connector().shutdown();
+    simulator.faults_mut().candidate_healthy = false;
+
+    let mut engine = engine(simulator);
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
