+#[test]
+fn activation_without_a_record_fails_before_connecting() {
+    let dir = tempfile::tempdir().unwrap();
+    let journal = journal(&dir);
+    let signer = SigningIdentity::from_seed("release", [0x31; 32]);
+    let mut engine = engine(simulator(&signer));
+
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
+    assert!(matches!(err, FwctlError::NothingStaged(_)));
+    assert_eq!(err.category(), ErrorCategory::NothingStaged);
+
+    let simulator = engine.into_connector().shutdown();
+    assert!(simulator.info().candidate_slot.is_none());
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+}
+
+#[test]
+fn stale_record_never_moves_boot_state() {
+    let dir = tempfile::tempdir().unwrap();
+    let journal = journal(&dir);
+    let signer = SigningIdentity::from_seed("release", [0x41; 32]);
+    let first = signed_package(&signer, 1024, "1.1.0");
+    let second = signed_package(&signer, 2048, "1.2.0");
+
+    let mut staging_engine = engine(simulator(&signer));
+    let stale = staging_engine
+        .stage(
+            "sim-0001",
+            &first,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    let simulator = staging_engine.into_connector().shutdown();
+
+    let mut staging_engine = engine(simulator);
+    staging_engine
+        .stage(
+            "sim-0001",
+            &second,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    let simulator = staging_engine.into_connector().shutdown();
+
+    // The device now holds the newer transfer, so the older record is lost.
+    journal.record(&stale).unwrap();
+    let mut engine = engine(simulator);
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
+    assert_eq!(err.category(), ErrorCategory::StagedUpdateLost);
+    assert!(matches!(err, FwctlError::StagedUpdateLost(_)));
+    assert_eq!(engine.state(), UpdateState::Failed);
+    assert!(journal.list().unwrap().is_empty());
+
+    let simulator = engine.into_connector().shutdown();
+    assert!(simulator.info().candidate_slot.is_none());
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+}
