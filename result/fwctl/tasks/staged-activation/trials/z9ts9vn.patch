+fn validate_staged_device(
+    staged: &StagedUpdate,
+    info: &DeviceInfo,
+    status: &DeviceStatus,
+) -> Result<()> {
+    let device_id = staged.device_id.as_str();
+    if info.product != staged.product {
+        return Err(staged_update_lost(format!(
+            "device `{device_id}` now reports product `{}`, staged for `{}`",
+            info.product, staged.product
+        )));
+    }
+    if info.firmware_version != staged.old_version {
+        return Err(staged_update_lost(format!(
+            "device `{device_id}` now runs firmware {}, staged against {}",
+            info.firmware_version, staged.old_version
+        )));
+    }
+    if info.rollback_counter != staged.confirmed_counter {
+        return Err(staged_update_lost(format!(
+            "device `{device_id}` now reports rollback counter {}, staged against {}",
+            info.rollback_counter, staged.confirmed_counter
+        )));
+    }
+    if status.update_id != Some(staged.update_id) {
+        return Err(staged_update_lost(format!(
+            "device `{device_id}` no longer holds staged transfer {}",
+            staged.update_id
+        )));
+    }
+    if status.accepted_offset != staged.image_size {
+        return Err(staged_update_lost(format!(
+            "device `{device_id}` accepted {} of {} staged bytes",
+            status.accepted_offset, staged.image_size
+        )));
+    }
+    Ok(())
+}
+
+fn staged_update_lost(reason: String) -> FwctlError {
+    FwctlError::StagedUpdateLost(reason)
