+        let path = dir.path().join("staging.jsonl");
+        fs::write(&path, "{broken}\n").unwrap();
+        let err = StagingJournal::new(path).list().unwrap_err();
+        assert!(err.to_string().contains("line 1"));
+    }
+
+    #[test]
+    fn plan_round_trips_through_a_record() {
+        let record = staged("board-a", "1.1.0");
+        let plan = record.to_plan();
+        let rebuilt = StagedUpdate::from_plan(&plan, record.update_id, record.confirmed_counter);
+        assert_eq!(rebuilt.to_plan(), plan);
+    }
