+/// Transfers and verifies an image, leaving the device on confirmed firmware.
+pub fn stage(
+    args: &UpdateArgs,
+    target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let package = read_package(&args.package)?;
+    let trusted_key = TrustStore::new(&config.trust_store).load(&package.manifest.signing_key)?;
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, target)?;
+    let device_id = selected.info.device_id.clone();
+    let chunk_size = resolve_chunk_size(args, config)?;
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        timeout.unwrap_or(config.default_timeout),
+        config.reconnect_timeout,
+        chunk_size,
+    );
+    let journal = StagingJournal::new(&config.staging_file);
+    let mut progress = Progress::default();
+    let staged = engine.stage(
+        &device_id,
+        &package,
+        &trusted_key,
+        UpdatePolicy {
+            allow_downgrade: args.allow_downgrade,
+        },
+        &journal,
+        |event| progress.report(event, output),
+    )?;
+    output.success(
+        &staged,
+        format_args!(
+            "Staged {} for {}\n  Target slot: {}\n  Image: {} bytes\n  Digest: {}\n  Staged at: {}\n  Device still runs {}; finish with `fwctl --device {} activate`",
+            staged.new_version,
+            staged.device_id,
+            staged.target_slot,
+            staged.image_size,
+            staged.image_digest,
+            staged.staged_at,
+            staged.old_version,
+            staged.device_id
+        ),
+    )
+}
+
+/// Activates the image a previous `stage` left in the inactive slot.
+pub fn activate(
+    target: &DeviceTarget,
+    global_target: Option<&str>,
+    timeout: Option<Duration>,
+    config: &Config,
+    output: &mut StdOutput,
+) -> Result<()> {
+    let journal = StagingJournal::new(&config.staging_file);
+    let requested = target.device.as_deref().or(global_target);
+    // A named device with nothing staged needs no port scan.
+    if let Some(device_id) = requested {
+        staged_record(&journal, device_id)?;
+    }
+    let devices = discover_serial_devices(probe_timeout(timeout, config))?;
+    let selected = select_device(&devices, requested)?;
+    let device_id = selected.info.device_id.clone();
+    let staged = staged_record(&journal, &device_id)?;
+    let mut engine = UpdateEngine::new(
+        SerialConnector::default(),
+        timeout.unwrap_or(config.default_timeout),
+        config.reconnect_timeout,
+        config.chunk_size,
+    );
+    let mut history = HistoryRecord::now(
+        device_id.clone(),
+        staged.product.clone(),
+        staged.old_version.clone(),
+        staged.new_version.clone(),
+        staged.image_digest.to_hex(),
+        staged.signing_key.clone(),
+    );
+    let mut progress = Progress::default();
+    let started = Instant::now();
+    let activate_result = engine.activate(&device_id, &journal, |event| {
+        progress.report(event, output);
+    });
+    history.duration_ms = started.elapsed().as_millis();
+    let report = match activate_result {
+        Ok(report) => {
+            history.result = HistoryResult::Completed;
+            history.duration_ms = report.duration_ms;
+            report
+        }
+        Err(err) => {
+            history.error_category = Some(err.category());
+            if matches!(err, FwctlError::AutomaticRollback) {
+                history.result = HistoryResult::RolledBack;
+                history.rollback_result = Some("automatic rollback completed".into());
+            }
+            append_history(config, &history, output);
+            return Err(err);
+        }
+    };
+    append_history(config, &history, output);
+    output.success(
+        &report,
+        format_args!(
+            "Activated {} on {} from {}\n  Active slot: {}\n  Image: {} bytes\n  Duration: {} ms",
+            report.new_version,
+            report.device_id,
+            report.old_version,
+            report.target_slot,
+            report.image_size,
+            report.duration_ms
+        ),
+    )
+}
+
+fn staged_record(journal: &StagingJournal, device_id: &str) -> Result<StagedUpdate> {
+    journal.get(device_id)?.ok_or(FwctlError::NothingStaged)
+}
+
+fn resolve_chunk_size(args: &UpdateArgs, config: &Config) -> Result<usize> {
+    let chunk_size = args.chunk_size.unwrap_or(config.chunk_size);
+    if (256..=16 * 1024).contains(&chunk_size) {
+        Ok(chunk_size)
+    } else {
+        Err(FwctlError::Configuration(
+            "update chunk size must be between 256 and 16384 bytes".into(),
+        ))
+    }
+}
+
+struct Progress {
+    last_state: UpdateState,
+    last_percent: u32,
+}
+
+impl Default for Progress {
+    fn default() -> Self {
+        Self {
+            last_state: UpdateState::Idle,
+            last_percent: 0,
+        }
+    }
+}
+
+impl Progress {
+    fn report(&mut self, event: UpdateEvent, output: &mut StdOutput) {
+        let percent = event
+            .bytes_transferred
+            .saturating_mul(100)
+            .checked_div(event.image_size)
+            .unwrap_or(0);
+        if event.state != self.last_state || percent >= self.last_percent.saturating_add(5) {
+            let _ = output.progress(format_args!("{:?}  {percent}%", event.state));
+            self.last_state = event.state;
+            self.last_percent = percent;
+        }
+    }
+}
