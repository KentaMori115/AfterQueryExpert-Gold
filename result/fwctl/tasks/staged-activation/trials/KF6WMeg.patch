+use std::fs::{self, File};
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+
+use crate::device::{Slot, UpdateId};
+use crate::package::ImageDigest;
+use crate::update::UpdatePlan;
+use crate::{FwctlError, Result};
+
+const MAX_STAGING_BYTES: u64 = 4 * 1024 * 1024;
+
+/// A firmware image that already sits verified in a device's inactive slot.
+///
+/// The record carries everything [`crate::update::UpdateEngine::activate`] needs
+/// to finish the update later, without the package being present again.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct StagedUpdate {
+    pub device_id: String,
+    pub product: String,
+    pub update_id: UpdateId,
+    pub old_version: String,
+    pub new_version: String,
+    pub target_slot: Slot,
+    pub image_size: u32,
+    pub image_digest: ImageDigest,
+    pub rollback_counter: u64,
+    pub confirmed_counter: u64,
+    pub signing_key: String,
+    pub staged_at: String,
+}
+
+impl StagedUpdate {
+    /// Builds a record for a plan whose image finished device-side verification.
+    #[must_use]
+    pub fn from_plan(plan: &UpdatePlan, update_id: UpdateId, confirmed_counter: u64) -> Self {
+        Self {
+            device_id: plan.device_id.clone(),
+            product: plan.product.clone(),
+            update_id,
+            old_version: plan.old_version.clone(),
+            new_version: plan.new_version.clone(),
+            target_slot: plan.target_slot,
+            image_size: plan.image_size,
+            image_digest: plan.image_digest,
+            rollback_counter: plan.rollback_counter,
+            confirmed_counter,
+            signing_key: plan.signing_key.clone(),
+            staged_at: jiff::Timestamp::now().to_string(),
+        }
+    }
+
+    /// Rebuilds the update plan the staged image was transferred under.
+    #[must_use]
+    pub fn to_plan(&self) -> UpdatePlan {
+        UpdatePlan {
+            device_id: self.device_id.clone(),
+            product: self.product.clone(),
+            old_version: self.old_version.clone(),
+            new_version: self.new_version.clone(),
+            target_slot: self.target_slot,
+            image_size: self.image_size,
+            image_digest: self.image_digest,
+            rollback_counter: self.rollback_counter,
+            signing_key: self.signing_key.clone(),
+        }
+    }
+}
+
+/// Durable list of staged updates, one record per device.
+#[derive(Debug, Clone)]
+pub struct StagingJournal {
+    path: PathBuf,
+}
+
+impl StagingJournal {
+    #[must_use]
+    pub fn new(path: impl Into<PathBuf>) -> Self {
+        Self { path: path.into() }
+    }
+
+    #[must_use]
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+
+    /// Every staged update, oldest first.
+    pub fn list(&self) -> Result<Vec<StagedUpdate>> {
+        if !self.path.exists() {
+            return Ok(Vec::new());
+        }
+        let file = File::open(&self.path).map_err(|err| FwctlError::io(&self.path, err))?;
+        let length = file
+            .metadata()
+            .map_err(|err| FwctlError::io(&self.path, err))?
+            .len();
+        if length > MAX_STAGING_BYTES {
+            return Err(FwctlError::Configuration(format!(
+                "staging file exceeds {MAX_STAGING_BYTES} bytes"
+            )));
+        }
+        let mut records = Vec::new();
+        for (line_index, line) in BufReader::new(file).lines().enumerate() {
+            let line = line.map_err(|err| FwctlError::io(&self.path, err))?;
+            if line.trim().is_empty() {
+                continue;
+            }
+            let record: StagedUpdate = serde_json::from_str(&line).map_err(|err| {
+                FwctlError::Configuration(format!(
+                    "invalid staged update at line {}: {err}",
+                    line_index + 1
+                ))
+            })?;
+            records.push(record);
+        }
+        Ok(records)
+    }
+
+    /// The staged update held for one device, if any.
+    pub fn get(&self, device_id: &str) -> Result<Option<StagedUpdate>> {
+        Ok(self
+            .list()?
+            .into_iter()
+            .find(|record| record.device_id == device_id))
+    }
+
+    /// Stores one record, replacing any older record for the same device.
+    pub fn record(&self, staged: &StagedUpdate) -> Result<()> {
+        let mut records = self.list()?;
+        records.retain(|record| record.device_id != staged.device_id);
+        records.push(staged.clone());
+        self.write_all(&records)
+    }
+
+    /// Drops the record held for one device and reports whether one existed.
+    pub fn remove(&self, device_id: &str) -> Result<bool> {
+        let records = self.list()?;
+        let retained = records
+            .iter()
+            .filter(|record| record.device_id != device_id)
+            .cloned()
+            .collect::<Vec<_>>();
+        if retained.len() == records.len() {
+            return Ok(false);
+        }
+        self.write_all(&retained)?;
+        Ok(true)
+    }
+
+    /// Removes and returns the record held for one device.
+    pub fn take(&self, device_id: &str) -> Result<Option<StagedUpdate>> {
+        let staged = self.get(device_id)?;
+        if staged.is_some() {
+            self.remove(device_id)?;
+        }
+        Ok(staged)
+    }
+
+    fn write_all(&self, records: &[StagedUpdate]) -> Result<()> {
+        if let Some(parent) = self.path.parent() {
+            fs::create_dir_all(parent).map_err(|err| FwctlError::io(parent, err))?;
+        }
+        let mut body = Vec::new();
+        for record in records {
+            let mut line = serde_json::to_vec(record)
+                .map_err(|err| FwctlError::Configuration(err.to_string()))?;
+            line.push(b'\n');
+            body.extend_from_slice(&line);
+        }
+        let temporary = self.path.with_extension("tmp");
+        let mut file = File::create(&temporary).map_err(|err| FwctlError::io(&temporary, err))?;
+        file.write_all(&body)
+            .map_err(|err| FwctlError::io(&temporary, err))?;
+        file.sync_data()
+            .map_err(|err| FwctlError::io(&temporary, err))?;
+        drop(file);
+        fs::rename(&temporary, &self.path).map_err(|err| FwctlError::io(&self.path, err))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::package::digest_bytes;
+
+    fn staged(device_id: &str, version: &str) -> StagedUpdate {
+        StagedUpdate {
+            device_id: device_id.into(),
+            product: "sensor-node".into(),
+            update_id: UpdateId::from_bytes([7; 16]),
+            old_version: "1.0.0".into(),
+            new_version: version.into(),
+            target_slot: Slot::B,
+            image_size: 4096,
+            image_digest: digest_bytes(b"image"),
+            rollback_counter: 3,
+            confirmed_counter: 2,
+            signing_key: "release".into(),
+            staged_at: "2026-09-02T10:00:00Z".into(),
+        }
+    }
+
+    #[test]
+    fn keeps_one_record_per_device_oldest_first() {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = StagingJournal::new(dir.path().join("state/staging.jsonl"));
+        assert!(journal.list().unwrap().is_empty());
+        journal.record(&staged("board-a", "1.1.0")).unwrap();
+        journal.record(&staged("board-b", "1.2.0")).unwrap();
+        journal.record(&staged("board-a", "1.3.0")).unwrap();
+        let records = journal.list().unwrap();
+        assert_eq!(records.len(), 2);
+        assert_eq!(records[0].device_id, "board-b");
+        assert_eq!(
+            journal.get("board-a").unwrap().unwrap().new_version,
+            "1.3.0"
+        );
+        assert!(journal.get("board-c").unwrap().is_none());
+    }
+
+    #[test]
+    fn take_consumes_a_single_record() {
+        let dir = tempfile::tempdir().unwrap();
+        let journal = StagingJournal::new(dir.path().join("staging.jsonl"));
+        journal.record(&staged("board-a", "1.1.0")).unwrap();
+        journal.record(&staged("board-b", "1.2.0")).unwrap();
+        let taken = journal.take("board-a").unwrap().unwrap();
+        assert_eq!(taken.device_id, "board-a");
+        assert!(journal.take("board-a").unwrap().is_none());
+        assert_eq!(journal.list().unwrap().len(), 1);
+    }
+
+    #[test]
+    fn rejects_corrupt_record_with_line_number() {
