+}
+
+#[test]
+fn rejected_policy_stages_nothing() {
+    let signer = SigningIdentity::from_seed("release", [0x55; 32]);
+    let mut package = signed_package(&signer, 1024);
+    package.manifest.product = "other-product".into();
+    package.signature = signer.sign_manifest(&package.manifest).unwrap();
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+    let err = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap_err();
+    assert!(matches!(err, FwctlError::WrongProduct { .. }));
+    assert!(journal.list().unwrap().is_empty());
+    let _ = engine.into_connector().shutdown();
+}
+
+#[test]
+fn drifted_device_loses_the_staged_update_before_boot_changes() {
+    let signer = SigningIdentity::from_seed("release", [0x56; 32]);
+    let package = signed_package(&signer, 2048);
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+    let staged = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+
+    // A record whose held transfer no longer matches the device.
+    journal
+        .record(&StagedUpdate {
+            update_id: UpdateId::from_bytes([0xaa; 16]),
+            ..staged
+        })
+        .unwrap();
+    let err = engine.activate("sim-0001", &journal, |_| {}).unwrap_err();
+    assert!(matches!(err, FwctlError::StagedUpdateLost));
+    assert_eq!(err.category(), ErrorCategory::StagedUpdateLost);
+    assert_eq!(engine.state(), UpdateState::Failed);
+    assert!(journal.list().unwrap().is_empty());
+
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().candidate_slot, None);
+    assert_eq!(simulator.info().firmware_version, "1.0.0");
+    assert_eq!(simulator.status().state, DeviceUpdateState::Verifying);
+}
+
+#[test]
+fn newer_staging_replaces_the_previous_record_for_one_device() {
+    let signer = SigningIdentity::from_seed("release", [0x57; 32]);
+    let package = signed_package(&signer, 1024);
+    let (_dir, journal) = journal();
+    let mut engine = engine(simulator(&signer));
+    let first = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    let second = engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    assert_ne!(first.update_id, second.update_id);
+    assert_eq!(journal.list().unwrap(), vec![second]);
+
+    let report = engine.activate("sim-0001", &journal, |_| {}).unwrap();
+    assert_eq!(report.state, UpdateState::Completed);
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.1.0");
+}
+
+#[test]
+fn a_later_session_activates_from_the_journal_alone() {
+    let signer = SigningIdentity::from_seed("release", [0x58; 32]);
+    let package = signed_package(&signer, 3072);
+    let (_dir, journal) = journal();
+    let mut staging_engine = engine(simulator(&signer));
+    let staged = staging_engine
+        .stage(
+            "sim-0001",
+            &package,
+            &signer.public_key(),
+            UpdatePolicy::default(),
+            &journal,
+            |_| {},
+        )
+        .unwrap();
+    let connector = staging_engine.into_connector();
+
+    // A new engine, without the package, finishes from the journal record.
+    let mut engine = UpdateEngine::new(
+        connector,
+        Duration::from_millis(30),
+        Duration::from_secs(1),
+        512,
+    );
+    let report = engine.activate("sim-0001", &journal, |_| {}).unwrap();
+    assert_eq!(report.new_version, staged.new_version);
+    assert_eq!(report.state, UpdateState::Completed);
+    assert!(journal.get("sim-0001").unwrap().is_none());
+    let simulator = engine.into_connector().shutdown();
+    assert_eq!(simulator.info().firmware_version, "1.1.0");
+    assert_eq!(simulator.info().active_slot, Slot::B);
+}
