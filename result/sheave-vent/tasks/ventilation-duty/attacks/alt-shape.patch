+/** `sheave ventilation` — what the air costs once the winding has had its share. */
+
+import type { Args } from "../args.ts";
+import { number, onlyKnown, option, quantity } from "../args.ts";
+import { shaft } from "../../shaft/shaft.ts";
+import {
+  decidedBy,
+  fan,
+  fanPower,
+  inSeries,
+  operatingPoint,
+  resistance,
+  shaftAirway,
+  wanted,
+} from "../../air/index.ts";
+import { heading, line, places } from "../../report/format.ts";
+
+const KNOWN = ["diameter", "depth", "width", "across", "pipes", "men", "tonnes", "gas", "shutoff", "delivery", "workings"];
+
+/** Run it. */
+export function ventilationCommand(args: Args): string[] {
+  onlyKnown(args, KNOWN);
+  const one = shaft(
+    "the downcast",
+    option(args, "diameter") === undefined ? 7.3 : quantity(args, "diameter"),
+    option(args, "depth") === undefined ? 942 : quantity(args, "depth"),
+  );
+  const width = option(args, "width") === undefined ? 2.2 : quantity(args, "width");
+  const across = option(args, "across") === undefined ? 1.5 : quantity(args, "across");
+  const pipes = option(args, "pipes") === undefined ? 1.2 : quantity(args, "pipes");
+  const blowing = fan("the fan", number(args, "shutoff", 3500), number(args, "delivery", 400));
+  const circuit = inSeries([resistance(shaftAirway(one, width, across, pipes)), number(args, "workings", 0.03)]);
+  const at = operatingPoint(blowing, circuit);
+  const men = number(args, "men", 900);
+  const tonnes = number(args, "tonnes", 3000);
+  const gas = number(args, "gas", 1.5);
+  return [
+    ...heading(`${one.name}: ${places(resistance(shaftAirway(one, width, across, pipes)), 6)} of resistance`),
+    line("the fan and the pit settle at", `${places(at.quantity, 1)} m³/s`),
+    line("against a pressure of", `${places(at.pressure, 0)} Pa`),
+    line("which costs at the fan shaft", `${places(fanPower(blowing, circuit), 1)} kW`),
+    line("the pit is asking for", `${places(wanted(men, tonnes, gas), 1)} m³/s`),
+    line("and it is", `the ${decidedBy(men, tonnes, gas)} asking`),
+  ];
+}
