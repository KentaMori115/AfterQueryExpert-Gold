diff --git a/src/cli/commands/ventilation.ts b/src/cli/commands/ventilation.ts
new file mode 100644
index 0000000..ad7dca3
--- /dev/null
+++ b/src/cli/commands/ventilation.ts
@@ -0,0 +1,196 @@
+/**
+ * `sheave ventilation` — where the fan settles, and which of the three
+ * things asks for the air.
+ *
+ * A fan has no duty of its own: it has a curve, the pit has a
+ * resistance, and the colliery gets the one point where the two cross.
+ * And what the colliery needs is not decided by the fan at all but by
+ * whichever of the men, the coal and the gas asks for most — which on a
+ * gassy pit is the gas, by a very long way.
+ */
+
+import type { Args } from "../args.ts";
+import { flag, number, onlyKnown, option, quantity } from "../args.ts";
+import {
+  A_MAN,
+  A_TONNE,
+  FRICTION,
+  GAS_LIMIT,
+  airPower,
+  airway,
+  characteristic,
+  decidedBy,
+  deepestVentilated,
+  describeFan,
+  everyDuty,
+  fan,
+  fanPower,
+  inParallel,
+  inSeries,
+  naturalPressure,
+  operatingPoint,
+  pressureFor,
+  regulatorFor,
+  resistance,
+  shaftAirway,
+  splitBetween,
+  wanted,
+} from "../../air/index.ts";
+import { airSpeed, shaft } from "../../shaft/shaft.ts";
+import { heading, line, metres, places, power, share, speed, verdict, wrapped } from "../../report/format.ts";
+import { blocks, left, right, table } from "../../report/table.ts";
+
+const KNOWN = [
+  "diameter",
+  "depth",
+  "width",
+  "across",
+  "pipes",
+  "men",
+  "tonnes",
+  "gas",
+  "limit",
+  "shutoff",
+  "delivery",
+  "efficiency",
+  "workings",
+  "sweep",
+];
+
+/** A pressure, said the way a fan maker says it. */
+function pascals(value: number): string {
+  return `${places(value, 0)} Pa`;
+}
+
+/** A resistance, which is a small number with a long unit. */
+function atkinson(value: number): string {
+  return `${places(value, 4)} Ns²/m⁸`;
+}
+
+/** A quantity of air. */
+function cubic(value: number): string {
+  return `${places(value, 1)} m³/s`;
+}
+
+/** Run it. */
+export function ventilationCommand(args: Args): string[] {
+  onlyKnown(args, KNOWN);
+  const hole = shaft(
+    "the upcast",
+    option(args, "diameter") === undefined ? 7.3 : quantity(args, "diameter"),
+    option(args, "depth") === undefined ? 942 : quantity(args, "depth"),
+  );
+  const width = option(args, "width") === undefined ? 2.6 : quantity(args, "width");
+  const across = option(args, "across") === undefined ? 1.5 : quantity(args, "across");
+  const pipes = number(args, "pipes", 1.2);
+  const men = number(args, "men", 400);
+  const tonnes = number(args, "tonnes", 2000);
+  const gas = number(args, "gas", 0.6);
+  const limit = number(args, "limit", GAS_LIMIT);
+  const workings = number(args, "workings", 0.03);
+
+  const road = shaftAirway(hole, width, across, pipes);
+  const shaftResistance = resistance(road);
+  const whole = inSeries([shaftResistance, workings]);
+  const blower = fan(
+    "the fan",
+    number(args, "shutoff", 3500),
+    number(args, "delivery", 400),
+    number(args, "efficiency", 0.75),
+  );
+  const natural = naturalPressure(hole.depth);
+  const point = operatingPoint(blower, whole);
+  const asked = wanted(men, tonnes, gas, limit);
+  const each = everyDuty(men, tonnes, gas, limit);
+
+  const deepest = deepestVentilated(blower, road.area, road.perimeter, asked, workings, FRICTION);
+
+  const out: string[] = [
+    ...heading(describeFan(blower)),
+    ...table(
+      [left("the shaft as an airway"), right("")],
+      [
+        ["diameter inside the lining", metres(hole.diameter, 2)],
+        ["depth, which is the length", metres(road.length)],
+        ["free area for the air", `${places(road.area, 1)} m²`],
+        ["rubbing surface round it", metres(road.perimeter, 2)],
+        ["friction of what it is lined with", places(road.friction, 4)],
+        ["its resistance", atkinson(shaftResistance)],
+        ["the workings beyond it", atkinson(workings)],
+        ["in series", atkinson(whole)],
+      ],
+    ),
+    "",
+    ...table(
+      [left("where the fan settles"), right("")],
+      [
+        ["shut-off pressure", pascals(blower.shutoff)],
+        ["free delivery", cubic(blower.delivery)],
+        ["natural ventilating pressure", pascals(natural)],
+        ["quantity it passes", cubic(point.quantity)],
+        ["at a pressure of", pascals(point.pressure)],
+        ["of which the fan itself makes", pascals(characteristic(blower, point.quantity))],
+        ["air speed in the shaft", speed(airSpeed(hole, point.quantity, width, across))],
+        ["air power in the pit", power(airPower(point.pressure, point.quantity))],
+        ["what the fan takes at the shaft", power(fanPower(blower, whole, natural))],
+      ],
+    ),
+    "",
+    ...table(
+      [left("what the pit asks for"), right("")],
+      [
+        [`${places(men, 0)} men at ${places(A_MAN, 2)} m³/s each`, cubic(each.men)],
+        [`${places(tonnes, 0)} tonnes a day at ${places(A_TONNE, 2)}`, cubic(each.coal)],
+        [`${places(gas, 2)} m³/s of gas held below ${places(limit, 2)}%`, cubic(each.gas)],
+        ["so the air is decided by", decidedBy(men, tonnes, gas, limit)],
+        ["which wants", cubic(asked)],
+        ["and the fan sends", cubic(point.quantity)],
+        ["enough", verdict(point.quantity >= asked)],
+      ],
+    ),
+    "",
+    line("the pressure the air wanted wants", pascals(pressureFor(whole, asked))),
+    line("the deepest it would ventilate", deepest === 0 ? "not at any depth at all" : metres(deepest)),
+  ];
+
+  if (flag(args, "sweep")) {
+    const districts = [
+      airway("the main district", 2000, 12, 14),
+      airway("the far district", 3500, 9, 12),
+    ];
+    const split = districts.map((one) => resistance(one));
+    const shares = splitBetween(point.quantity, split);
+    out.push(
+      "",
+      ...heading("the air split between two districts"),
+      ...table(
+        [left("district"), right("resistance"), right("gets"), right("share"), right("regulator to halve it")],
+        districts.map((one, at) => [
+          one.name,
+          atkinson(split[at] as number),
+          cubic(shares[at] as number),
+          share((shares[at] as number) / point.quantity),
+          atkinson(
+            regulatorFor(
+              pressureFor(inParallel(split), point.quantity),
+              Math.max(1, (shares[at] as number) / 2),
+              split[at] as number,
+            ),
+          ),
+        ]),
+      ),
+      "",
+      line("the two districts together resist", atkinson(inParallel(split))),
+    );
+  }
+
+  return blocks(
+    out,
+    wrapped(
+      "Resistance goes as the cube of the section, so the two metres taken off a roadway are not " +
+        "a fifth of the air but half of it, and no fan recovers it. And a fan bought on its " +
+        "shut-off pressure has been bought on a figure it never works at: the answer is where its " +
+        "curve crosses the pit, which is always somewhere in the middle of the line.",
+    ),
+  );
+}
