diff --git a/test/air.test.ts b/test/air.test.ts
new file mode 100644
index 0000000..37204ee
--- /dev/null
+++ b/test/air.test.ts
@@ -0,0 +1,312 @@
+/**
+ * The air, the fan, and the three things that ask for it.
+ *
+ * The cube law is the whole of ventilation arithmetic: resistance goes
+ * as the length and the rubbing surface and inversely as the cube of
+ * the section, so what a fan sends is decided by a dimension nobody
+ * measures twice. And a fan has no duty of its own — it has a curve,
+ * the pit has a resistance, and the colliery gets the crossing.
+ */
+
+import { describe, expect, it } from "vitest";
+import {
+  A_MAN,
+  A_TONNE,
+  DEEPEST_SHAFT,
+  DOWNCAST_AIR,
+  FRICTION,
+  GAS_LIMIT,
+  UPCAST_AIR,
+  airPower,
+  airway,
+  characteristic,
+  decidedBy,
+  deepestVentilated,
+  describeFan,
+  everyDuty,
+  fan,
+  fanPower,
+  inParallel,
+  inSeries,
+  naturalPressure,
+  operatingPoint,
+  pressureFor,
+  quantityFor,
+  regulatorFor,
+  resistance,
+  shaftAirway,
+  withDrag,
+  splitBetween,
+  wanted,
+} from "../src/air/index.ts";
+import { shaft } from "../src/shaft/shaft.ts";
+import { buntonDrag, guides } from "../src/shaft/guides.ts";
+import { WindingError } from "../src/errors.ts";
+
+const road = airway("the main return", 2000, 12, 14);
+const blower = fan("the fan", 3500, 400, 0.75);
+
+describe("an airway", () => {
+  it("keeps what it was given", () => {
+    expect(road.name).toBe("the main return");
+    expect(road.length).toBe(2000);
+    expect(road.area).toBe(12);
+    expect(road.perimeter).toBe(14);
+    expect(road.friction).toBe(FRICTION);
+  });
+
+  it("resists as k C L over the cube of the area", () => {
+    expect(resistance(road)).toBeCloseTo((FRICTION * 14 * 2000) / 12 ** 3, 6);
+  });
+
+  it("loses half the air for a fifth off the section, which is the cube law", () => {
+    const smaller = airway("the same road, lowered", 2000, 12 * 0.8, 14);
+    expect(resistance(smaller) / resistance(road)).toBeCloseTo(1 / 0.8 ** 3, 3);
+  });
+
+  it("wants a pressure of RQ², and gives the quantity back again", () => {
+    const found = pressureFor(resistance(road), 40);
+    expect(found).toBeCloseTo(resistance(road) * 1600, 2);
+    expect(quantityFor(resistance(road), found)).toBeCloseTo(40, 2);
+  });
+
+  it("puts the air power in kilowatts", () => {
+    expect(airPower(2000, 100)).toBeCloseTo(200, 3);
+  });
+
+  it("adds in series and beats the sum in parallel", () => {
+    expect(inSeries([0.01, 0.02, 0.03])).toBeCloseTo(0.06, 6);
+    expect(inSeries(0.01, 0.02, 0.03)).toBeCloseTo(0.06, 6);
+    expect(inParallel(0.04, 0.04)).toBeCloseTo(0.01, 6);
+    expect(inParallel([0.04, 0.04])).toBeCloseTo(0.01, 6);
+    expect(inParallel([0.04, 0.04])).toBeLessThan(0.04);
+  });
+
+  it("refuses an airway with nothing to it", () => {
+    expect(() => airway("", 100, 10, 12)).toThrow(WindingError);
+    expect(() => airway("a road", 0, 10, 12)).toThrow(WindingError);
+    expect(() => airway("a road", 100, 0, 12)).toThrow(WindingError);
+    expect(() => airway("a road", 100, 10, -1)).toThrow(WindingError);
+    expect(() => airway("a road", 100, 10, 12, 0)).toThrow(WindingError);
+    expect(() => inSeries([])).toThrow(WindingError);
+    expect(() => inParallel([])).toThrow(WindingError);
+  });
+
+  it("names the argument that was wrong", () => {
+    try {
+      airway("a road", 100, 10, 12, -1);
+      expect.unreachable();
+    } catch (thrown) {
+      expect(thrown).toBeInstanceOf(WindingError);
+      expect((thrown as WindingError).quantity).toBe("friction");
+    }
+  });
+});
+
+describe("the shaft as an airway", () => {
+  const hole = shaft("the upcast", 7.3, 942);
+  const found = shaftAirway(hole, 2.6);
+
+  it("takes the depth for the length and the free area for the section", () => {
+    expect(found.length).toBe(942);
+    expect(found.area).toBeLessThan((Math.PI * 7.3 ** 2) / 4);
+  });
+
+  it("rubs on the whole lining whatever is hanging in it", () => {
+    expect(found.perimeter).toBeCloseTo(Math.PI * 7.3, 2);
+  });
+
+  it("spends the share the buntons cost on the resistance", () => {
+    expect(withDrag(resistance(found), buntonDrag(guides("rigid", 4, 6, 0), 942, 7.3))).toBeGreaterThan(
+      resistance(found),
+    );
+    expect(withDrag(0.002, 0.2)).toBeCloseTo(0.0024, 6);
+    expect(withDrag(0.002, 0)).toBeCloseTo(0.002, 6);
+    expect(() => withDrag(0.002, 1.5)).toThrow(WindingError);
+  });
+
+  it("is a worse airway with the conveyances in it than without", () => {
+    const empty = airway("an empty shaft", 942, (Math.PI * 7.3 ** 2) / 4, Math.PI * 7.3);
+    expect(resistance(found)).toBeGreaterThan(resistance(empty));
+  });
+});
+
+describe("the fan", () => {
+  it("keeps what it was given and says so in a line", () => {
+    expect(blower.shutoff).toBe(3500);
+    expect(blower.delivery).toBe(400);
+    expect(blower.efficiency).toBe(0.75);
+    expect(describeFan(blower)).toContain("3500");
+  });
+
+  it("makes its shut-off pressure at nothing and nothing at its free delivery", () => {
+    expect(characteristic(blower, 0)).toBeCloseTo(3500, 2);
+    expect(characteristic(blower, 400)).toBe(0);
+    expect(characteristic(blower, 200)).toBeCloseTo(3500 * 0.75, 2);
+  });
+
+  it("makes nothing at all past its free delivery", () => {
+    expect(characteristic(blower, 500)).toBe(0);
+  });
+
+  it("settles where its curve crosses the pit", () => {
+    const found = operatingPoint(blower, 0.02);
+    expect(found.pressure).toBeCloseTo(0.02 * found.quantity ** 2, 1);
+    expect(characteristic(blower, found.quantity)).toBeCloseTo(found.pressure, 0);
+    expect(found.quantity).toBeLessThan(blower.delivery);
+  });
+
+  it("passes less air the harder the pit is", () => {
+    expect(operatingPoint(blower, 0.05).quantity).toBeLessThan(operatingPoint(blower, 0.01).quantity);
+  });
+
+  it("counts natural ventilation on its own side, or against it", () => {
+    const helped = operatingPoint(blower, 0.02, 400);
+    const alone = operatingPoint(blower, 0.02);
+    const fought = operatingPoint(blower, 0.02, -400);
+    expect(helped.quantity).toBeGreaterThan(alone.quantity);
+    expect(fought.quantity).toBeLessThan(alone.quantity);
+  });
+
+  it("passes nothing when the natural pressure has beaten it", () => {
+    const found = operatingPoint(blower, 0.02, -3500);
+    expect(found.quantity).toBe(0);
+    expect(found.pressure).toBe(0);
+    expect(fanPower(blower, 0.02, -3500)).toBe(0);
+  });
+
+  it("takes the air power over its efficiency", () => {
+    const found = operatingPoint(blower, 0.02);
+    expect(fanPower(blower, 0.02)).toBeCloseTo(airPower(found.pressure, found.quantity) / 0.75, 1);
+    expect(fanPower(blower, 0.02)).toBeGreaterThan(airPower(found.pressure, found.quantity));
+  });
+
+  it("refuses a fan that is not one", () => {
+    expect(() => fan("", 3500, 400, 0.75)).toThrow(WindingError);
+    expect(() => fan("a fan", 0, 400, 0.75)).toThrow(WindingError);
+    expect(() => fan("a fan", 3500, 0, 0.75)).toThrow(WindingError);
+    expect(() => fan("a fan", 3500, 400, 0)).toThrow(WindingError);
+    expect(() => fan("a fan", 3500, 400, 1.4)).toThrow(WindingError);
+    expect(() => operatingPoint(blower, 0)).toThrow(WindingError);
+  });
+});
+
+describe("natural ventilation, which is a fan nobody bought", () => {
+  it("is the density difference by gravity by the depth", () => {
+    expect(naturalPressure(900, 1.2, 1.15)).toBeCloseTo(0.05 * 9.80665 * 900, 1);
+  });
+
+  it("grows with the depth and turns round with the columns", () => {
+    expect(naturalPressure(1800)).toBeCloseTo(2 * naturalPressure(900), 1);
+    expect(naturalPressure(900, UPCAST_AIR, DOWNCAST_AIR)).toBeLessThan(0);
+  });
+
+  it("refuses a depth that is not one", () => {
+    expect(() => naturalPressure(0)).toThrow(WindingError);
+  });
+});
+
+describe("what the pit asks for", () => {
+  it("is the largest of the three and not their sum", () => {
+    expect(wanted(400, 2000, 0.6)).toBeCloseTo(100, 2);
+    expect(wanted(400, 0, 0)).toBeCloseTo(400 * A_MAN, 2);
+    expect(wanted(0, 2000, 0)).toBeCloseTo(2000 * A_TONNE, 2);
+    expect(wanted(0, 0, 1)).toBeCloseTo(1 / (GAS_LIMIT / 100), 2);
+  });
+
+  it("says which of the three decided it", () => {
+    expect(decidedBy(600, 100, 0)).toBe("men");
+    expect(decidedBy(400, 2000, 0.1)).toBe("coal");
+    expect(decidedBy(400, 2000, 3)).toBe("gas");
+  });
+
+  it("takes a limit other than the general body one", () => {
+    expect(wanted(0, 0, 1, 2.5)).toBeCloseTo(40, 2);
+    expect(wanted(0, 0, 1, 0.5)).toBeCloseTo(200, 2);
+  });
+
+  it("shows the working", () => {
+    const each = everyDuty(400, 2000, 0.6);
+    expect(each.men).toBeCloseTo(40, 2);
+    expect(each.coal).toBeCloseTo(100, 2);
+    expect(each.gas).toBeCloseTo(48, 2);
+  });
+
+  it("refuses half a man and a negative tonnage", () => {
+    expect(() => wanted(400.5, 2000, 0)).toThrow(WindingError);
+    expect(() => wanted(400, -1, 0)).toThrow(WindingError);
+    expect(() => wanted(400, 2000, -1)).toThrow(WindingError);
+    expect(() => wanted(400, 2000, 1, 0)).toThrow(WindingError);
+  });
+});
+
+describe("splitting the air", () => {
+  const roads = [0.04, 0.09];
+
+  it("gives every road in the split the same pressure", () => {
+    const found = splitBetween(100, roads);
+    expect(pressureFor(roads[0] as number, found[0] as number)).toBeCloseTo(
+      pressureFor(roads[1] as number, found[1] as number),
+      0,
+    );
+  });
+
+  it("adds up to what was sent, and sends more down the easier road", () => {
+    const found = splitBetween(100, roads);
+    expect((found[0] as number) + (found[1] as number)).toBeCloseTo(100, 1);
+    expect(found[0] as number).toBeGreaterThan(found[1] as number);
+  });
+
+  it("makes a regulator the difference between what a road wants and what it has", () => {
+    expect(regulatorFor(400, 100, 0.02)).toBeCloseTo(400 / 10_000 - 0.02, 6);
+    expect(regulatorFor(pressureFor(0.04, 50), 50, 0.04)).toBe(0);
+  });
+
+  it("gives no regulator to a road that already resists too much", () => {
+    expect(regulatorFor(100, 100, 0.5)).toBe(0);
+  });
+
+  it("refuses a split of nothing", () => {
+    expect(() => splitBetween(0, roads)).toThrow(WindingError);
+    expect(() => splitBetween(100, [0.04, 0])).toThrow(WindingError);
+    expect(() => regulatorFor(400, 0, 0.02)).toThrow(WindingError);
+  });
+});
+
+describe("how deep a fan will ventilate", () => {
+  const hole = shaftAirway(shaft("the upcast", 7.3, 942), 2.6);
+
+  it("gives whole metres", () => {
+    const found = deepestVentilated(blower, hole.area, hole.perimeter, 250, 0.03);
+    expect(Number.isInteger(found)).toBe(true);
+    expect(found).toBeGreaterThan(0);
+  });
+
+  it("goes shallower the more air is asked for", () => {
+    const easy = deepestVentilated(blower, hole.area, hole.perimeter, 150, 0.03);
+    const hard = deepestVentilated(blower, hole.area, hole.perimeter, 250, 0.03);
+    expect(hard).toBeLessThan(easy);
+  });
+
+  it("sends the wanted air at that depth and not much past it", () => {
+    const found = deepestVentilated(blower, hole.area, hole.perimeter, 250, 0.03);
+    const at = (depth: number): number =>
+      operatingPoint(blower, (FRICTION * hole.perimeter * depth) / hole.area ** 3 + 0.03).quantity;
+    expect(at(found)).toBeGreaterThanOrEqual(250);
+    expect(at(found + 5)).toBeLessThan(250);
+  });
+
+  it("never goes past the deepest shaft this library takes", () => {
+    expect(deepestVentilated(blower, 40, 23, 20, 0)).toBe(DEEPEST_SHAFT);
+  });
+
+  it("gives nothing at all to a fan already beaten by the workings", () => {
+    expect(deepestVentilated(blower, 10, 12, 300, 0.5)).toBe(0);
+  });
+
+  it("refuses a section that is not one", () => {
+    expect(() => deepestVentilated(blower, 0, 23, 100)).toThrow(WindingError);
+    expect(() => deepestVentilated(blower, 30, 23, 0)).toThrow(WindingError);
+    expect(() => deepestVentilated(blower, 30, 23, 100, -1)).toThrow(WindingError);
+  });
+});
