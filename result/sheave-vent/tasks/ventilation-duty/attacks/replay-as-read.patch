@@ -0,0 +1,181 @@
+/**
+ * The fan, and where it settles against the pit.
+ *
+ * A fan has no duty of its own. It has a characteristic — a curve of
+ * pressure against quantity — and the pit has a resistance, and what
+ * the colliery actually gets is the one point where the two cross.
+ * Order a fan by its shut-off pressure and you have ordered a figure it
+ * never works at; order it by its free delivery and you have ordered
+ * another. Both are the ends of a line and the answer is in the middle.
+ *
+ * The other thing in here is natural ventilation, which is a fan
+ * nobody bought: warm air in the upcast weighs less than cold air in
+ * the downcast, and the difference over the depth of the shaft is a
+ * pressure. It works with the fan in winter and against it in summer,
+ * and a colliery that has stood its fan down in July has found out why.
+ */
+
+import { insist, nonNegative, positive, real, share } from "../errors.ts";
+import { GRAVITY } from "../units/measure.ts";
+import { round } from "../units/round.ts";
+import { FRICTION, airPower } from "./airway.ts";
+
+/** A fan, as bought. */
+export interface Fan {
+  /** What it is called. */
+  readonly name: string;
+  /** The pressure it makes against a closed door, in pascals. */
+  readonly shutoff: number;
+  /** The quantity it passes against no resistance at all, in m³/s. */
+  readonly delivery: number;
+  /** How much of the shaft power comes out as air power, as a share. */
+  readonly efficiency: number;
+}
+
+/** A fan, checked. */
+export function fan(name: string, shutoff = 3500, delivery = 400, efficiency = 0.75): Fan {
+  insist(name.trim().length > 0, "a fan has to be called something", "name");
+  positive(shutoff, "shutoff");
+  positive(delivery, "delivery");
+  share(efficiency, "efficiency");
+  insist(efficiency > 0, "a fan that turns nothing into air power ventilates nothing", "efficiency");
+  return { name: name.trim(), shutoff, delivery, efficiency };
+}
+
+/**
+ * The pressure a fan makes at a stated quantity, in pascals.
+ *
+ * A parabola from the shut-off pressure at no quantity to nothing at
+ * the free delivery, which is what a fan maker's curve looks like
+ * closely enough to size a pit on. Past the free delivery there is
+ * nothing: the fan is not driving the air, and asking it for more is
+ * asking the wrong question.
+ */
+export function characteristic(one: Fan, quantity: number): number {
+  nonNegative(quantity, "quantity");
+  if (quantity >= one.delivery) return 0;
+  const part = quantity / one.delivery;
+  return round(one.shutoff * (1 - part * part), 2);
+}
+
+/** The density of cool air going down a shaft, in kg/m³. */
+export const DOWNCAST_AIR = 1.2;
+
+/** And of the warmer, wetter air coming back up it. */
+export const UPCAST_AIR = 1.15;
+
+/**
+ * The natural ventilating pressure of a shaft pair, in pascals.
+ *
+ * The difference in density, by gravity, by the depth. Positive when
+ * the upcast is the lighter column, which is to say when nature is
+ * helping; negative when the pit has warmed the downcast instead, and
+ * then it is one more resistance for the fan to beat.
+ */
+export function naturalPressure(depth: number, downcast = DOWNCAST_AIR, upcast = UPCAST_AIR): number {
+  positive(depth, "depth");
+  positive(downcast, "downcast");
+  positive(upcast, "upcast");
+  return round((downcast - upcast) * GRAVITY * depth, 2);
+}
+
+/** Where a fan settles against a pit: the quantity it passes and the pressure it passes it at. */
+export interface Operating {
+  /** The quantity, in m³/s. */
+  readonly quantity: number;
+  /** The pressure across the resistance at that quantity, in pascals. */
+  readonly pressure: number;
+}
+
+/**
+ * Where the fan's curve crosses the pit's resistance.
+ *
+ * The fan gives p₀(1 − (Q/Q₀)²), the pit wants RQ², and nature adds or
+ * takes away a pressure of its own, so
+ *
+ *     Q = √((p₀ + natural) / (R + p₀/Q₀²))
+ *
+ * which is the whole of fan selection in one line. A fan whose shut-off
+ * pressure natural ventilation more than cancels is beaten and passes
+ * nothing; and if nature alone would drive more than the free delivery,
+ * the fan is out of the way of it and the air settles where RQ² meets
+ * the natural pressure by itself.
+ */
+export function operatingPoint(one: Fan, resistance: number, natural = 0): Operating {
+  positive(resistance, "resistance");
+  real(natural, "natural");
+  const driving = one.shutoff + natural;
+  if (driving <= 0) return { quantity: 0, pressure: 0 };
+  const steepness = one.shutoff / (one.delivery * one.delivery);
+  let quantity = Math.sqrt(driving / (resistance + steepness));
+  if (quantity > one.delivery) quantity = Math.sqrt(Math.max(0, natural) / resistance);
+  return { quantity: round(quantity, 3), pressure: round(resistance * quantity * quantity, 2) };
+}
+
+/**
+ * What the fan takes at the shaft, in kilowatts.
+ *
+ * The air power where it settles, over its efficiency. A big fan is a
+ * standing charge on a colliery for as long as the colliery exists —
+ * it runs when nothing else does, because a pit that stops ventilating
+ * stops being a pit.
+ */
+export function fanPower(one: Fan, resistance: number, natural = 0): number {
+  const found = operatingPoint(one, resistance, natural);
+  if (found.quantity <= 0) return 0;
+  const pressure = characteristic(one, found.quantity);
+  if (pressure <= 0) return 0;
+  return round(airPower(pressure, found.quantity) / one.efficiency, 3);
+}
+
+/** The deepest shaft this library will speak about, in metres. */
+export const DEEPEST_SHAFT = 4200;
+
+/**
+ * How deep a fan will still ventilate, in whole metres.
+ *
+ * The resistance of a shaft goes up with its depth and the quantity a
+ * fan passes goes down with the resistance, so somewhere there is a
+ * depth at which that fan no longer sends the air the workings want.
+ * It is the sinking engineer's question and it has one answer, found by
+ * walking the depth up until the fan gives out — never past the deepest
+ * shaft anybody has sunk, because past that the arithmetic is honest
+ * and the shaft is not.
+ */
+export function deepestVentilated(
+  one: Fan,
+  section: number,
+  perimeter: number,
+  wanted: number,
+  workings = 0,
+  friction = FRICTION,
+): number {
+  positive(section, "section");
+  positive(perimeter, "perimeter");
+  positive(wanted, "wanted");
+  nonNegative(workings, "workings");
+  positive(friction, "friction");
+  const passes = (depth: number): number => {
+    const shaft = (friction * perimeter * depth) / (section * section * section);
+    const total = shaft + workings;
+    return total <= 0 ? one.delivery : operatingPoint(one, total).quantity;
+  };
+  if (passes(0) < wanted) return 0;
+  if (passes(DEEPEST_SHAFT) >= wanted) return DEEPEST_SHAFT;
+  let low = 0;
+  let high = DEEPEST_SHAFT;
+  for (let i = 0; i < 60; i += 1) {
+    const middle = (low + high) / 2;
+    if (passes(middle) >= wanted) low = middle;
+    else high = middle;
+  }
+  return Math.floor(low);
+}
+
+/** The fan in a line, for the top of a report. */
+export function describeFan(one: Fan): string {
+  return (
+    `${one.name}: ${round(one.shutoff, 0)} Pa shut off, ` +
+    `${round(one.delivery, 0)} m³/s free, ${round(one.efficiency * 100, 0)}% efficient`
+  );
+}
