@@ -0,0 +1,71 @@
+/**
+ * What the pit asks for, which is three sums and the largest of them.
+ *
+ * A colliery's air is not decided by the fan and not by the shaft. It
+ * is decided by whichever of three things asks for most: the men, who
+ * want a hundred litres a second each and are entitled to it by
+ * statute; the coal, whose dust and whose engines want a twentieth of a
+ * cubic metre a second for every tonne raised in a day; and the gas,
+ * which wants whatever it takes to keep the return below its limit.
+ *
+ * Which of the three it is says what sort of colliery it is. A thin dry
+ * seam worked by many men is ventilated for the men, a heavily
+ * mechanised one for the coal, and a gassy one for the gas — and a
+ * gassy one is ventilated for the gas by a very long way, which is why
+ * a colliery that starts making firedamp has a ventilation problem and
+ * not merely a gas problem.
+ */
+
+import { count, nonNegative, positive, within } from "../errors.ts";
+import { round } from "../units/round.ts";
+
+/** The air a man is entitled to, in m³/s. */
+export const A_MAN = 0.1;
+
+/** The air a tonne a day of output wants, in m³/s. */
+export const A_TONNE = 0.05;
+
+/** The general body limit for firedamp in a return airway, as a percentage. */
+export const GAS_LIMIT = 0.0125;
+
+/**
+ * The air the colliery wants, in m³/s.
+ *
+ * The largest of the three, because they are not added: the same air
+ * that dilutes the gas sweeps the dust and breathes the men.
+ */
+export function wanted(men: number, tonnes: number, gas = 0, limit = GAS_LIMIT): number {
+  count(men, "men");
+  nonNegative(tonnes, "tonnes");
+  nonNegative(gas, "gas");
+  within(limit, 0.000001, 1, "limit");
+  positive(limit, "limit");
+  return round(Math.max(men * A_MAN, tonnes * A_TONNE, gas / limit), 2);
+}
+
+/** Which of the three the air is decided by. */
+export function decidedBy(men: number, tonnes: number, gas = 0, limit = GAS_LIMIT): "men" | "coal" | "gas" {
+  const whole = wanted(men, tonnes, gas, limit);
+  const each = everyDuty(men, tonnes, gas, limit);
+  if (each.men >= whole) return "men";
+  if (each.coal >= whole) return "coal";
+  return "gas";
+}
+
+/** What each of the three asks for, for a sheet that shows the working. */
+export function everyDuty(
+  men: number,
+  tonnes: number,
+  gas = 0,
+  limit = GAS_LIMIT,
+): Readonly<Record<"men" | "coal" | "gas", number>> {
+  count(men, "men");
+  nonNegative(tonnes, "tonnes");
+  nonNegative(gas, "gas");
+  within(limit, 0.000001, 1, "limit");
+  return {
+    men: round(men * A_MAN, 2),
+    coal: round(tonnes * A_TONNE, 2),
+    gas: round(gas / limit, 2),
+  };
+}
