@@ -0,0 +1,203 @@
+/**
+ * The airway, and the resistance a road offers the air in it.
+ *
+ * Ventilation is the one duty on a colliery that never stops. The coal
+ * can stand at the bank and the men can wait at the shaft, but the air
+ * has to keep moving, and what decides how much of it moves is the
+ * resistance of the roads it moves through — which goes as the length
+ * and as the rubbing surface, and inversely as the cube of the area.
+ *
+ * The cube is the whole of it. Two metres taken off a roadway's height
+ * are not a fifth of the section lost, they are half the air, and no
+ * fan that was ever built recovers it. That is why a colliery driving a
+ * new district drives it large, and why a shaft with cages in it is a
+ * poor airway however big the hole was.
+ */
+
+import type { Shaft } from "../shaft/shaft.ts";
+import { freeArea } from "../shaft/shaft.ts";
+import { insist, positive, share } from "../errors.ts";
+import { round } from "../units/round.ts";
+
+/**
+ * The coefficient of friction of a lined shaft, in kg/m³.
+ *
+ * Atkinson's k, which is not dimensionless and is not the same for two
+ * roads that look alike. A concrete-lined shaft is about four
+ * thousandths; a shaft with buntons across it is two or three times
+ * that, and a timbered coal road worse again.
+ */
+export const FRICTION = 0.004;
+
+/** A road the air goes along. */
+export interface Airway {
+  /** What it is called. */
+  readonly name: string;
+  /** How far the air goes along it, in metres. */
+  readonly length: number;
+  /** The section it goes through, in square metres. */
+  readonly area: number;
+  /** The rubbing surface round that section, in metres. */
+  readonly perimeter: number;
+  /** Atkinson's coefficient of friction for what it is lined with, in kg/m³. */
+  readonly friction: number;
+}
+
+/** An airway, checked. */
+export function airway(
+  name: string,
+  length: number,
+  area: number,
+  perimeter: number,
+  friction = FRICTION,
+): Airway {
+  insist(name.trim().length > 0, "an airway has to be called something", "name");
+  positive(length, "length");
+  positive(area, "area");
+  positive(perimeter, "perimeter");
+  positive(friction, "friction");
+  return { name: name.trim(), length, area, perimeter, friction };
+}
+
+/**
+ * The resistance of an airway, in Ns²/m⁸.
+ *
+ * Atkinson: k C L over A cubed. The length and the rubbing surface are
+ * the honest part of it and the cube is where a colliery's money goes.
+ */
+export function resistance(one: Airway): number {
+  return round((one.friction * one.perimeter * one.length) / (one.area * one.area * one.area), 6);
+}
+
+/** The pressure a stated quantity wants through a stated resistance, in pascals. */
+export function pressureFor(resistance: number, quantity: number): number {
+  positive(resistance, "resistance");
+  positive(quantity, "quantity");
+  return round(resistance * quantity * quantity, 2);
+}
+
+/** The quantity a stated pressure drives through a stated resistance, in m³/s. */
+export function quantityFor(resistance: number, pressure: number): number {
+  positive(resistance, "resistance");
+  positive(pressure, "pressure");
+  return round(Math.sqrt(pressure / resistance), 3);
+}
+
+/** The air power a pressure and a quantity come to, in kilowatts. */
+export function airPower(pressure: number, quantity: number): number {
+  positive(pressure, "pressure");
+  positive(quantity, "quantity");
+  return round((pressure * quantity) / 1000, 3);
+}
+
+/** The resistances given, whether as a list or one after another. */
+function listed(given: readonly (number | readonly number[])[]): number[] {
+  const out: number[] = [];
+  for (const each of given) {
+    if (typeof each === "number") out.push(each);
+    else out.push(...each);
+  }
+  return out;
+}
+
+/** Roads one after another, whose resistances simply add. */
+export function inSeries(...given: readonly (number | readonly number[])[]): number {
+  const resistances = listed(given);
+  insist(resistances.length > 0, "a road with no lengths in it resists nothing", "resistances");
+  let sum = 0;
+  for (const each of resistances) sum += positive(each, "resistance");
+  return round(sum, 6);
+}
+
+/**
+ * Roads beside one another, which is the sum of the square roots
+ * inverted and squared.
+ *
+ * The reason a colliery splits its air. Two roads of the same
+ * resistance in parallel come to a quarter of one of them, not a half,
+ * and the fan that was straining on one takes the same air through both
+ * for a quarter of the pressure.
+ */
+export function inParallel(...given: readonly (number | readonly number[])[]): number {
+  const resistances = listed(given);
+  insist(resistances.length > 0, "a split with no roads in it passes nothing", "resistances");
+  let sum = 0;
+  for (const each of resistances) sum += 1 / Math.sqrt(positive(each, "resistance"));
+  return round(1 / (sum * sum), 6);
+}
+
+/**
+ * The shaft as an airway.
+ *
+ * The depth is the length, the free area is the section — and the
+ * perimeter is the whole of the lining, because the air rubs on the
+ * wall whatever is hanging in the middle of it. A shaft is therefore a
+ * worse airway than its free area alone suggests: the conveyances take
+ * the section away and give nothing back.
+ */
+export function shaftAirway(
+  one: Shaft,
+  width: number,
+  depthOf = 1.5,
+  pipes = 1.2,
+  friction = FRICTION,
+): Airway {
+  return airway(
+    one.name,
+    one.depth,
+    freeArea(one, width, depthOf, pipes),
+    round(Math.PI * one.diameter, 3),
+    friction,
+  );
+}
+
+/**
+ * A resistance with an obstruction's share of it added, in Ns²/m⁸.
+ *
+ * `shaft.buntonDrag` gives what the girders across a rigid-guided shaft
+ * cost the ventilation, as a share of the shaft's own resistance, and
+ * this is where that share is spent: a shaft resisting two and a half
+ * thousandths with a fifth of a share of buntons in it resists three.
+ * It is the argument for rope guides put as a pressure rather than as a
+ * preference.
+ */
+export function withDrag(resistance: number, drag: number): number {
+  positive(resistance, "resistance");
+  share(drag, "drag");
+  return round(resistance * (1 + drag), 6);
+}
+
+/**
+ * How a quantity divides between roads beside one another, in m³/s.
+ *
+ * Every road in a split has the same pressure across it — that is what
+ * makes it a split — so the air goes where the resistance is low, as
+ * the square root of it. Nobody has to arrange this and nobody can
+ * prevent it except with a regulator.
+ */
+export function splitBetween(quantity: number, resistances: readonly number[]): number[] {
+  positive(quantity, "quantity");
+  const together = inParallel(resistances);
+  const pressure = together * quantity * quantity;
+  return resistances.map((each) => round(Math.sqrt(pressure / each), 3));
+}
+
+/**
+ * The regulator a road wants, in Ns²/m⁸.
+ *
+ * A split gives a road the air its resistance asks for, which is rarely
+ * the air the district needs. The cure is a door with a hole in it: the
+ * resistance the road wants at the quantity wanted, less the resistance
+ * it already has. It is always a loss and it is always cheaper than the
+ * alternative, which is another fan.
+ *
+ * A road already resisting more than the pressure allows wants no
+ * regulator — nothing a regulator does can send more air, so the
+ * answer is nought rather than a negative resistance.
+ */
+export function regulatorFor(pressure: number, wanted: number, branch: number): number {
+  positive(pressure, "pressure");
+  positive(wanted, "wanted");
+  positive(branch, "branch");
+  return round(pressure / (wanted * wanted) - branch, 6);
+}
