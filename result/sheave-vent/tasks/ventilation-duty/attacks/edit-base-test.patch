-function walk(from: string): string[] {
-  const out: string[] = [];
-  for (const each of readdirSync(from)) {
-    const path = join(from, each);
-    if (statSync(path).isDirectory()) out.push(...walk(path));
-    else if (path.endsWith(".ts")) out.push(path);
-  }
-  return out;
-}
-
